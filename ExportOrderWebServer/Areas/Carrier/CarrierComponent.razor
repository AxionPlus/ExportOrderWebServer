@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICarrierProvider _carrierProvider

<style>

</style>

<MudForm @ref="@FilterForm">
    <div class="Container-item">
        <div class="container-content">
            <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData"
                       Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="@(async () => { await AddItem_Click(); })">Add New</MudButton>
            <MudSpacer />
            <MudAutocomplete Class="Autocomplete" T="string" Label="Full Name" Style="width: 400px" SearchFunc="@SearchNames"
                             Value="Filter.Name"
                             ValueChanged="(e)=> { Filter.Name = e; }"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             CloseIcon="" OpenIcon=""
                             ResetValueOnEmptyText="true" Clearable />
             <MudSpacer />
             <MudAutocomplete Class="Autocomplete" T="string" Label="Short Name" Style="width: 400px" SearchFunc="@SearchNamesEn"
                              Value="Filter.NameEn"
                              ValueChanged="(e)=> { Filter.NameEn = e; }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              CloseIcon="" OpenIcon=""
                              ResetValueOnEmptyText="true" Clearable />
             <MudSpacer />
             <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData"
                        Variant="Variant.Filled" Color="Color.Secondary"
                        OnClick="@(async () => { await GetItems(); })">Search</MudButton>
         </div>
     </div>
 </MudForm>

 <div class="Container-table">
     @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }

    <MudTable Class="Table" @ref="mudTable" Items="@Items" T="CarrierCatalog" Context="carrier"
              Loading="IsLoadingData" Virtualize="true" RowsPerPage="20">

        <HeaderContent>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:400px">
                <MudTableSortLabel SortBy="new Func<CarrierCatalog, object>(x=>x.FullName!)">Full Name</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:400px">
                <MudTableSortLabel SortBy="new Func<CarrierCatalog, object>(x=>x.ShortName!)">Short Name</MudTableSortLabel>
            </MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(carrier.Id); })"></MudIconButton></MudTd>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async()=>{ await RemoveItem_Click(carrier); })"></MudIconButton></MudTd>
            <MudTd>@carrier.FullName</MudTd>
            <MudTd>@carrier.ShortName</MudTd>
            <MudTd></MudTd>
        </RowTemplate>

        <PagerContent></PagerContent>

    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudForm? FilterForm;
    private MudTable<CarrierCatalog>? mudTable;

    private IEnumerable<CarrierCatalog>? Items { get; set; } = new List<CarrierCatalog>();
    private FilterParameters Filter { get; set; } = new();

    bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    private async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _carrierProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<CarrierCatalog>)response.Object!).ToArray();

        await Task.Delay(500);

        await InvokeAsync(StateHasChanged);

        IsLoadingData = false;
    }

    private async Task ShowItem_Click(long Id)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["Id"] = Id };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<CarrierItem_Dialog>("Carrier", parameters, options);

        DialogResult result = await dialog.Result;
    }

    private async Task AddItem_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<CarrierItem_Dialog>("New Carrier", parameters, options);

        DialogResult result = await dialog.Result;

        if (result.Canceled)
            if (Items!.Count() > 0)
                await GetItems();
    }

    private async Task RemoveItem_Click(CarrierCatalog item)
    {
        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE  Record",
                          (MarkupString)$"<b>Do you want to remove record?</b> <br/>Carrier: {item.ShortName}",
                          yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _carrierProvider.RemoveItemAsync(item);

                if (!response.HasError)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);
            }

        await GetItems();
    }


    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchNames(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _carrierProvider.GetNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchNamesEn(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _carrierProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
