@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICarrierProvider _carrierProvider

<style></style>

<div class="Container-item">
    <div class="container-content">
        <MudAutocomplete Class="Autocomplete" T="string" Label="Name" Style="width: 380px" @bind-Value="Filter.Name"
                         SearchFunc="@SearchNames"                            
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon=""
                         ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Label="Name En" Style="width: 380px" @bind-Value="Filter.NameEn"
                         SearchFunc="@SearchNamesEn"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon=""
                         ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData"
                    Variant="Variant.Filled" Color="Color.Secondary"
                    OnClick="@(async () => { await GetItems(); })">Search</MudButton>
    </div>
</div>
    
@if (Items is not null && Items.Any())
{
    <div class="Container-table">        
        <div class="tableMenu">
            <MudSpacer />
            <TablePager T="CarrierCatalog" Table="mudTable" ItemsCount="@Items.Count()" />
        </div>
        <MudTable Class="Table" @ref="mudTable" Items="@Items" Loading="IsLoadingData" Virtualize="true" RowsPerPage="20">
            <HeaderContent>
                <MudTh Style="width:30px"></MudTh>            
                <MudTh Style="width:400px">
                    <MudTableSortLabel SortBy="new Func<CarrierCatalog, object>(x=>x.Name!)">Name Ru</MudTableSortLabel>
                </MudTh>
                <MudTh Style="width:400px">
                    <MudTableSortLabel SortBy="new Func<CarrierCatalog, object>(x=>x.NameEn!)">Name En</MudTableSortLabel>
                </MudTh>
                    <MudTh Style="width:30px"></MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.Id); })"></MudIconButton></MudTd>            
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.NameEn</MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async()=>{ await RemoveItem_Click(context.Name!, context.Id); })" /></MudTd>
                <MudTd></MudTd>
            </RowTemplate>
            <PagerContent></PagerContent>
        </MudTable>
    </div>
}

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    
    private MudTable<CarrierCatalog>? mudTable;

    private IEnumerable<CarrierCatalog>? Items { get; set; } = new List<CarrierCatalog>();
    private FilterParameters Filter { get; set; } = new();
    bool IsLoadingData = false;


    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _carrierProvider.GetItemsAsync(Filter);
        if (!response.HasErrors)
            Items = ((IEnumerable<CarrierCatalog>)response.Object!).ToArray();

        await Task.Delay(500);

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowItem_Click(long Id)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["Id"] = Id };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = true, BackdropClick = false};
        dialog = await DialogService.ShowAsync<Carrier_ItemDialog>("Carrier", parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await GetItems();
    }

    private async Task RemoveItem_Click(string name, long id)
    {
        bool? msgResult = await DialogService.ShowMessageBox("REMOVE  Record",
                                                                (MarkupString)$"<b>Удалить запись?</b> <br/>Carrier: {name}",
                                                                yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _carrierProvider.RemoveItemAsync(id);

                if (!response.HasErrors)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);
            }

        await GetItems();
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchNames(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _carrierProvider.GetNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchNamesEn(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _carrierProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
