@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider authenticationStateProvider
@inject ICarrierProvider _carrierProvider

<style>
    .DatePicker > .mud-input-control {
        margin-top: unset;
    }

    .Table * .mud-table-cell .mud-picker * .mud-icon-button-edge-end {
        margin-inline-end:unset;
    }

    .Table * .mud-table-cell .mud-input-control * .mud-icon-button {
        padding: unset;
    }
</style>

@if (Item is not null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content" ReadOnly="!IsNewItem">
        <div class="Container-item">

            <div class="container-content">
                <MudTextField T="string" Style="width: 400px" Label="Name" Text="@Item.Name"
                              TextChanged="async (e)=> { Item.Name = e.ToUpper(); }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"
                              Required RequiredError=""
                              ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                 <MudButton Class="Button" Style="width: 100px; margin-left: 10px" Disabled="!IsNewItem" OnClick="SaveItem_Click"
                            Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">
                     Save
                 </MudButton>
             </div>

            <div class="container-content">
                 <MudTextField T="string" Style="width: 400px" Label="Name En" Text="@Item.NameEn"
                               TextChanged="@(async (e)=> { Item.NameEn = e.ToUpper(); })"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Immediate="true"
                               Required RequiredError=""
                               ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                 <MudButton Class="Button" Style="width: 100px; margin-left: 10px" Disabled="!IsNewItem" OnClick="ClearItem_Click"
                            Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small">
                     Clear
                 </MudButton>
             </div>

             <div class="container-content">
                 <MudSelect Class="wrapper-input " T="BLTemplate" Style="width:120px" Label="BL Template" @bind-Value="@Item.BlTemplate"
                            ToStringFunc="@(str=>str.ToString())"
                            Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (BLTemplate template in Enum.GetValues(typeof(BLTemplate)))
                    {
                        <MudSelectItem Value="@template" />
                    }
                </MudSelect>
            </div>

            <div class="Container-table">
                <MudTable Class="Table" @ref="mudTable" T="CarrierTerminalDetails" Items="@Item.CarrierDetails" Context="details"
                          Virtualize="true" RowsPerPage="5">
                   
                   <HeaderContent>
                       <MudTh Style="width:30px">
                            <div class="controlIconButtons">
                                <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddDetails_Click" Size="Size.Small" Disabled="!IsNewItem"></MudIconButton>
                            </div>
                       </MudTh>
                       <MudTh Style="width:150px">Terminal</MudTh>
                       <MudTh Style="width:100px">Contract</MudTh>
                       <MudTh Style="width:130px">Dated</MudTh>
                       <MudTh Style="width:150px">Agent</MudTh>
                   </HeaderContent>

                   <RowTemplate>
                       <MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async()=>{ await RemoveDetails_Click(details); })" /></MudTd>
                       <MudTd>
                            <MudAutocomplete Class="Autocomplete" T="string" Style="width: 150px" SearchFunc="@SearchTerminalNames"
                                             Value="details.TerminalName"
                                             ValueChanged="(e)=> { details.TerminalName = e; }"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             CloseIcon="" OpenIcon=""
                                             ResetValueOnEmptyText="true" Clearable />
                       </MudTd>
                       <MudTd>
                            <MudTextField Class="TextField" T="string" @bind-Value="details.Contract"
                                          Style="width: 100px"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Required RequiredError="" />
                       </MudTd>
                       <MudTd>
                            <MudDatePicker Class="DatePicker" @bind-Date="@details.DateContract"
                                           Style="width: 115px"
                                           DateFormat="dd.MM.yy"
                                           ShowWeekNumbers="true"
                                           Variant="Variant.Outlined"
                                           IconSize=Size.Small
                                           AutoClose=true
                                           DisableToolbar=false
                                           Required                                            
                                           Clearable />
                       </MudTd>
                         <MudTd>
                             <MudTextField Class="TextField" T="string" @bind-Value="details.POLAgent"
                                           Style="width: 150px"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Required RequiredError="" />
                         </MudTd>
                   </RowTemplate>
               </MudTable>
            </div>
        </div>
    </MudForm>
}

@code {
    private MudForm? Form { get; set; }
    private MudTable<CarrierTerminalDetails>? mudTable;

    [Parameter]
    public long Id { get; set; } = 0;
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private CarrierCatalog? Item { get; set; }

    private bool IsAuth = false;


    protected override async Task OnInitializedAsync()
    {
        await GetItem();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("TopManager") || user.User.IsInRole("ExpDept"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        if (IsNewItem)
            Item = new();
        else
        {
            var response = await _carrierProvider.GetItemAsync(Id);
            if (!response.HasError)
                Item = (CarrierCatalog)response.Object!;
        }
    }

    public async Task SaveItem_Click()
    {
        await Form!.Validate();

        if (Form.IsValid)
        {
            if (IsNewItem)
            {
                var response = await _carrierProvider.NewItemAsync(Item!);
                if (!response.HasError)
                {
                    Snackbar.Add("Saved successfully", Severity.Success);
                    IsNewItem = false;
                    Id = Item!.Id;
                }
                else
                    Snackbar.Add(response.Error.LastOrDefault(), Severity.Error);
            }
            else
            {
                // var response = await _countryProvider.ModifyItemAsync(Item!);
                // if (!response.HasError)
                // {
                //     await GetItem();
                //     Snackbar.Add("Save Successed", Severity.Success);
                // }
                // else
                //     Snackbar.Add(response.Error.Last(), Severity.Error);
            }

            await GetItem();
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task ClearItem_Click()
    {
        if (IsNewItem)
        {
            Item!.Name = null;
            Item.NameEn = null;

            // foreach (var details in Item.CarrierDetails)
            //     await RemoveDetails_Click(details);
        }

        await Task.Delay(50);
    }


    #region DETAILS

    private async Task AddDetails_Click()
    {
        await Task.Delay(50);

        if (Item is not null)
            Item.CarrierDetails.Add(new());

        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveDetails_Click(CarrierTerminalDetails item)
    {
        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE  Record",
                          (MarkupString)$"<b>Do you want to remove record?</b> <br/>{item.TerminalName}<br/>",
                          yesText: "YES", cancelText: "NO");

        var response = new AppObjectResponse();

        if (item is null)
            return;

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                if (IsNewItem)
                    Item!.CarrierDetails.Remove(item);
                else
                {
                    response = await _carrierProvider.RemoveDetailsAsync(item);

                    if (!response.HasError)
                        Snackbar.Add($"Deleted Successfully", Severity.Success);
                    else
                        Snackbar.Add($"Unable to delete", Severity.Warning);
                }
            }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<IEnumerable<string>> SearchTerminalNames(string value)
    {
        var result = await _carrierProvider.GetTerminalNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
