@page "/carrier"
@attribute [Authorize(Roles = "Admin, Top Manager, Manager")]

@inject IDialogService DialogService

<PageTitle>Country</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">
            <ShowMainMenuButton Class="ToolBar-IconButton" ExitHref="/" />
            <MudSpacer />
            <div class="ToolBar-Title"><span>carriers</span></div>            
            <MudSpacer />
            <div class="ToolBar-iconbutton" style="margin-right: 20px">
                <MudTooltip Text="add a new carrier">
                    <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.AddBox" OnClick="AddItem_Click" />
                </MudTooltip>
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
            </div>
        </MudToolBar>
    </div>

    <CarrierComponent @ref="component" />

</MudContainer>


@code {
    public CarrierComponent? component;

    private async Task AddItem_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = true, BackdropClick = false };
        dialog = await DialogService.ShowAsync<Carrier_ItemDialog>("New Carrier", parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await component!.GetItems();
    }
}