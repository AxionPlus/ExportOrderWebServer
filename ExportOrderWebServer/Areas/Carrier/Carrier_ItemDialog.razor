@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider authenticationStateProvider
@inject ICarrierProvider _carrierProvider
@inject ILocationProvider _locationProvider

<style>
    .DatePicker > .mud-input-control {
        margin-top: unset;
    }

    .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-inline-end: 4px;
        padding-right: 4px;
    }

    .Table * .mud-table-cell .mud-picker * .mud-icon-button-edge-end {
        margin-inline-end:unset;
    }

    .Table * .mud-table-cell .mud-input-control * .mud-icon-button {
        padding: unset;
    }
</style>

@if (Item is not null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content" ReadOnly="IsFormReadOnly">

        <div class="ToolBar-container">
            <MudToolBar Class="ToolBar ToolBar-new">
                <MudSpacer />
                <div class="ToolBar-iconbutton" style="margin-right: 20px">
                    <MudTooltip Text=@(IsFormReadOnly ? "Edit" : "Save")>
                        @if (IsFormReadOnly)
                        {
                            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Edit" OnClick="EditItem_Click" />
                        }
                        else
                        {
                            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" OnClick="SaveItem_Click" />
                        }
                    </MudTooltip>
                </div>
            </MudToolBar>
        </div>

        <div class="Container-item">
            <div class="container-content">
                <MudTextField T="string" Style="width: 410px" Label="Name Ru" Text="@Item.Name"
                              TextChanged="async (e)=> { Item.Name = e.ToUpper(); }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"
                              Required RequiredError=""
                               Clearable="!IsFormReadOnly" />
             </div>
            <div class="container-content">
                 <MudTextField T="string" Style="width: 410px" Label="Name En" Text="@Item.NameEn"
                               TextChanged="@(async (e)=> { Item.NameEn = e.ToUpper(); })"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Immediate="true"
                               Required RequiredError=""
                               Clearable="!IsFormReadOnly" />
             </div>
             <div class="container-content" style="justify-content: flex-start">
                 <MudAutocomplete Class="Autocomplete" T="LocationCatalog" Style="width: 270px; margin-right:20px" Label="Location" @bind-Value="Item.Location"
                                  ToStringFunc="@(e => e != null ? e.Name : "")"
                                  SearchFunc="@SearchLocation"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required RequiredError=""
                                  CloseIcon="" OpenIcon="" IconSize="Size.Small"
                                  ResetValueOnEmptyText="true"
                                  Placeholder="Location"
                                  MaxItems="20"                                  
                                  AdornmentIcon="@Icons.Material.Filled.AddCircle"
                                  AdornmentColor="Color.Primary"
                                  Adornment="Adornment.End"
                                  OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddLocation_Click(); })"
                                  Clearable="!IsFormReadOnly" />
                
                 <MudSelect Class="wrapper-input" T="BLTemplate" Style="width:120px" Label="BL Template" @bind-Value="@Item.BlTemplate"
                            ToStringFunc="@(str=>str.ToString())"
                            Variant="Variant.Outlined" Margin="Margin.Dense">
                     @foreach (BLTemplate template in Enum.GetValues(typeof(BLTemplate)))
                    {
                        <MudSelectItem Value="@template" />
                    }
                </MudSelect>
             </div>
            <div class="Container-table">
                <MudTable Class="Table" @ref="mudTable" Items="@Item.CarrierDetails" Virtualize="true" RowsPerPage="5">
                   
                   <HeaderContent>
                       <MudTh Style="width:30px">
                            <div class="controlIconButtons">
                                <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddDetails_Click" Size="Size.Small" Disabled="IsFormReadOnly"></MudIconButton>
                            </div>
                       </MudTh>
                       <MudTh Style="width:150px">Terminal</MudTh>
                       <MudTh Style="width:170px">Contract</MudTh>
                       <MudTh Style="width:130px">Dated</MudTh>
                       <MudTh Style="width:150px">Agent</MudTh>
                   </HeaderContent>

                   <RowTemplate>
                       <MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async()=>{ await RemoveDetails_Click(context); })" /></MudTd>
                       <MudTd>
                            <MudAutocomplete Class="Autocomplete" T="string" Style="width: 150px" SearchFunc="@SearchTerminalNames"
                                             Value="context.TerminalName"
                                             ValueChanged="(e)=> { context.TerminalName = e; }"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             CloseIcon="" OpenIcon=""
                                             ResetValueOnEmptyText="true"
                                             AdornmentIcon="@Icons.Material.Filled.AddCircle"
                                             AdornmentColor="Color.Primary"
                                             Adornment="Adornment.End"
                                             OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddTerminal_Click(); })"
                                             Clearable="!IsFormReadOnly" />
                       </MudTd>
                       <MudTd>
                            <MudTextField Class="TextField" T="string" @bind-Value="context.Contract"
                                          Style="width: 170px"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Required RequiredError="" />
                       </MudTd>
                       <MudTd>
                            <MudDatePicker Class="DatePicker" @bind-Date="@context.DateContract"
                                           Style="width: 115px"
                                           DateFormat="dd.MM.yy"
                                           ShowWeekNumbers="true"
                                           Variant="Variant.Outlined"
                                           IconSize=Size.Small
                                           AutoClose=true
                                           DisableToolbar=false
                                           Required
                                           Clearable="!IsFormReadOnly" />
                       </MudTd>
                       <MudTd>
                           <MudTextField Class="TextField" Style="width: 150px" T="string" @bind-Value="context.AgentPOL"                                           
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Required RequiredError="" />
                       </MudTd>
                   </RowTemplate>
               </MudTable>
            </div>

        </div>

    </MudForm>
}

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudForm? Form { get; set; }
    private MudTable<CarrierTerminalDetails>? mudTable;

    [CascadingParameter]
    private MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public long Id { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private CarrierCatalog? Item { get; set; }
    private bool IsFormReadOnly { get; set; } = true;
    private bool IsLoadingData = false;
    private bool IsAuth = false;


    protected override async Task OnInitializedAsync()
    {
        await GetItem();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("Top Manager") || user.User.IsInRole("Manager"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        if (IsNewItem)
        {
            IsFormReadOnly = false;
            Item = new();
        }        
        else
        {
            var response = await _carrierProvider.GetItemAsync(Id);
            if (!response.HasError)
                Item = (CarrierCatalog)response.Object!;
        }
    }

    private async Task SaveItem_Click()
    {
        IsLoadingData = true;

        await Form!.Validate();

        if (Form.IsValid)
        {
            if (IsNewItem)
            {
                var response = await _carrierProvider.NewItemAsync(Item!);
                if (!response.HasError)
                {
                    Id = Item!.Id;
                    Snackbar.Add("Saved successfully", Severity.Success);                    
                }
                else
                    Snackbar.Add(response.Error.LastOrDefault(), Severity.Error);
            }
            else
            {
                var response = await _carrierProvider.ModifyItemAsync(Item!);
                if (!response.HasError)
                {
                    Snackbar.Add("Save Successed", Severity.Success);
                }
                else
                    Snackbar.Add(response.Error.Last(), Severity.Error);
            }

            IsNewItem = false;
            IsFormReadOnly = true;            

            await GetItem();
            IsLoadingData = false;
        }
        else
        {
            Snackbar.Add("Fill up all reqired fields", Severity.Error);
            IsLoadingData = false;
        }
    }

    private async Task AddLocation_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<Location_ItemDialog>("New Locaion", parameters, options);

        DialogResult result = await dialog.Result;
    }

    private async Task AddTerminal_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<Terminal_ItemDialog>("New Terminal", parameters, options);

        DialogResult result = await dialog.Result;
    }

    private async Task EditItem_Click()
    {
        await Task.Delay(50);
        IsFormReadOnly = false;
    }

    private async Task AddDetails_Click()
    {
        await Task.Delay(50);

        if (Item is not null)
            Item.CarrierDetails.Add(new());

        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveDetails_Click(CarrierTerminalDetails item)
    {
        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE  Record",
                          (MarkupString)$"<b>Do you want to remove record?</b> <br/>{item.TerminalName}<br/>",
                          yesText: "YES", cancelText: "NO");

        var response = new AppObjectResponse();

        if (item is null) return;

        if (msgResult.HasValue)
            if (msgResult.Value)
                Item!.CarrierDetails.Remove(item);

        await InvokeAsync(StateHasChanged);
    }

    #region SEARCH FUNCTIONS
    private async Task<IEnumerable<string>> SearchTerminalNames(string value)
    {
        var result = await _carrierProvider.GetTerminalNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    
    private async Task<IEnumerable<LocationCatalog>> SearchLocation(string value)
    {
        var Locations = new List<LocationCatalog>();

        var response = await _locationProvider.GetItemsAsync();
        if (!response.HasError)
            Locations = ((IEnumerable<LocationCatalog>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Locations;

        return Locations.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }
    #endregion
}
