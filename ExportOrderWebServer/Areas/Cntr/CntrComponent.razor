@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICntrProvider _cntrProvider
@inject ICarrierProvider _carrierProvider

<style>
</style>

<MudForm @ref="@FilterForm">
    <div class="Container-item">
        <div class="container-content">
            <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData"
                       Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="@(async () => { await AddItem_Click(); })">Add New</MudButton>
            <MudSpacer />
            <MudTextField Class="TextField" Style="width: 180px" @bind-Value="Filter.CntrNum"
                          Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="11" Placeholder="ABCU1234567" Clearable />

@*             <MudAutocomplete Class="Autocomplete" T="string" Label="Name" Style="width: 300px" SearchFunc="@SearchCntr"
                             Value="Filter.Name"
                             ValueChanged="(e)=> { Filter.Name = e; }"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             CloseIcon="" OpenIcon=""
                             ResetValueOnEmptyText="true" Clearable /> *@
            <MudSpacer />
            <MudSelect Label="Type" T="string" Style="width: 120px" @bind-Value="@Filter.CntrType"                        
                       Variant="Variant.Outlined" Margin="Margin.Dense" CloseIcon="" OpenIcon="" Clearable>
                @if (CntrTypes is not null)
                    @foreach (var type in CntrTypes)
                    {
                        <MudSelectItem T="string" Value="@type.Normolize!.ToString()"></MudSelectItem>
                    }
            </MudSelect>
            <MudSpacer />
            <MudAutocomplete Class="Autocomplete" Label="Carrier" T="string" @bind-Value="@Filter.Carrier" SearchFunc="@SearchCarrier"
                             Style="width: 300px"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             CloseIcon="" OpenIcon="" MaxItems="20"
                             ResetValueOnEmptyText="true" Clearable />

            <MudSpacer />
            <MudCheckBox Label="SOC" @bind-Checked="Filter.CntrIsSOC"></MudCheckBox>
            <MudSpacer />
            <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData"
                       Variant="Variant.Filled" Color="Color.Secondary"
                       OnClick="@(async () => { await GetItems(); })">Search</MudButton>
         </div>
     </div>
 </MudForm>

 <div class="Container-table">
     @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudButton Class="Button" StartIcon="@Icons.Material.Filled.Upload" OnClick="PathInput"
                       Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">
                Upload New List
            </MudButton>
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }

    <MudTable Class="Table" @ref="mudTable" Items="@Items" T="CntrEntity"
              Loading="IsLoadingData" Virtualize="true" RowsPerPage="20">

        <HeaderContent>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:180px">
                <MudTableSortLabel SortBy="new Func<CntrEntity, object>(x=>x.Num!)">Number</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width: 105px">Type</MudTh>
            <MudTh Style="width: 105px">Tare</MudTh>
            <MudTh Style="width: 105px">Max PayLoad</MudTh>
            <MudTh Style="width: 400px">
                <MudTableSortLabel SortBy="new Func<CarrierCatalog, object>(x=>x.ShortName!)">Short Name</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width: 40px">SOC</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.Num); })"></MudIconButton></MudTd>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async()=>{ await RemoveItem_Click(context); })"></MudIconButton></MudTd>
            <MudTd>@context.Num</MudTd>
            <MudTd>@context.TpSz.Normolize</MudTd>
            <MudTd>@context.TareWt</MudTd>
            <MudTd>@context.MaxPayLoad</MudTd>
            <MudTd>@context.Carrier.ShortName</MudTd>
            <MudTd><MudCheckBox @bind-Checked="context.IsSOC" /></MudTd>
            <MudTd></MudTd>
        </RowTemplate>

        <PagerContent></PagerContent>

    </MudTable>
</div>

 @code {
    private MudForm? FilterForm;
    private MudTable<CntrEntity>? mudTable;

    private IEnumerable<CntrEntity>? Items { get; set; } = new List<CntrEntity>();
    //private List<CntrEntity>? Items { get; set; } = new List<CntrEntity>();
    private IEnumerable<CntrTpSz>? CntrTypes;
    private IEnumerable<CarrierCatalog>? Carriers;
    private FilterParameters Filter { get; set; } = new();

    bool IsLoadingData = false;


    protected override async Task OnParametersSetAsync()
    {
        CntrTypes = await _cntrProvider.GetCntrTypes();
        var result = await _carrierProvider.GetItemsAsync();
        if (!result.HasError)
            Carriers = ((IEnumerable<CarrierCatalog>)result.Object!).ToList();
    }

    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    private async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _cntrProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<CntrEntity>)response.Object!).ToArray();

        await Task.Delay(500);

        await InvokeAsync(StateHasChanged);

        IsLoadingData = false;
    }

    private async Task ShowItem_Click(string num)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["Num"] = num };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<CntrItem_Dialog>("Container", parameters, options);

        DialogResult result = await dialog.Result;
    }

    private async Task AddItem_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<CntrItem_Dialog>("New Container", parameters, options);

        DialogResult result = await dialog.Result;

        if (result.Canceled)
            if (Items!.Count() > 0)
                await GetItems();
    }

    private async Task RemoveItem_Click(CntrEntity item)
    {
        // bool? msgResult = await DialogService.ShowMessageBox(
        //                   "REMOVE  Record",
        //                   (MarkupString)$"<b>Do you want to remove record?</b> <br/>Container:<br/>{item.Num}<br/>",
        //                   yesText: "YES", cancelText: "NO");

        // if (msgResult.HasValue)
        //     if (msgResult.Value)
        //     {
        //         var response = await _cntrProvider.RemoveItemAsync(item);

        //         if (!response.HasError)
        //             Snackbar.Add($"Deleted Successfully", Severity.Success);
        //         else
        //             Snackbar.Add($"Unable to delete", Severity.Warning);
        //     }

        // await GetItems();
    }

    private async Task PathInput()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);
        DialogOptions dialogOptions = new DialogOptions() { MaxWidth = MaxWidth.Large, CloseButton = true, FullWidth = true, CloseOnEscapeKey = true, DisableBackdropClick = true };

        dialog = DialogService.Show<PathInputCntr_Dialog>("INPUT: List of Containers", dialogOptions);

        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var DTOitems = (List<CntrDTO>)result.Data;
            if (DTOitems is null)
                return;

            Items = new List<CntrEntity>();
            foreach (var item in DTOitems)
                Items!.Append(new CntrEntity()
                {
                    Carrier = Carriers?.FirstOrDefault(s => s.ShortName.ToUpper() == item.Carrier.ToUpper()),
                    Num = item.Num!,
                    TpSz = CntrTypes?.FirstOrDefault(s => s.ToString() == item.TpSz.ToUpper()),
                    TareWt = item.TareWt,
                    MaxPayLoad = item.MaxPayLoad,
                    IsSOC = item.IsSOC,
                });
        }
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchCntr(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _cntrProvider.GetCntrNums();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchCarrier(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _carrierProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
