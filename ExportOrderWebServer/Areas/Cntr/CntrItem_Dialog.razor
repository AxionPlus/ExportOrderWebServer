@inject ISnackbar Snackbar
@inject AuthenticationStateProvider authenticationStateProvider
@inject ICntrProvider _cntrProvider
@inject ICarrierProvider _carrierProvider
@inject ICntrProvider _cntrProvider

<style>

</style>

@if (Item is not null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content">
        <div class="Container-item" style="width: 570px">
            <div class="container-content">
                <MudSelect T="CarrierCatalog" Label="Carrier" Style="width: 400px; text-align:left" @bind-Value="@Item.Carrier"
                           Variant="Variant.Outlined" Margin="Margin.Dense" CloseIcon="" OpenIcon="" Clearable>
                     @if (Carriers is not null)
                        @foreach (var carrier in Carriers)
                        {
                            <MudSelectItem T="CarrierCatalog" Value="@carrier">@carrier.ShortName</MudSelectItem>
                        }
                </MudSelect>                
                <MudSpacer />
                <MudButton Class="Button" Style="width: 100px" Disabled="!IsNewItem" OnClick="SaveItem_Click"                        
                           Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Save">
                    Save
                </MudButton>
            </div>
            <div class="container-content">
                <MudTextField Class="TextField" Label="Number" Style="width: 180px" @bind-Value="@Item.Num"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" MaxLength="11"
                              Required RequiredError="" Clearable />
                <div style="width: 20px"></div>
                <MudSelect T="CntrTpSz" Label="Type" Style="width: 120px" @bind-Value="@Item.TpSz"
                           Variant="Variant.Outlined" Margin="Margin.Dense" CloseIcon="" OpenIcon="" Clearable>
                    @if (CntrTypes is not null)
                        @foreach (var type in CntrTypes)
                        {
                            <MudSelectItem T="CntrTpSz" Value="@type">@type.Normolize</MudSelectItem>
                        }
                </MudSelect>
                <div style="width: 80px"></div>
                <MudSpacer />
                <div style="width: 100px"></div>
            </div>
            <div class="container-content">
                <MudTextField Class="TextField" Label="Max PayLoad" Style="width: 180px" @bind-Value="@Item.MaxPayLoad"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
                <div style="width: 20px"></div>
                <MudTextField Class="TextField" Label="Tare" Style="width: 120px" @bind-Value="@Item.TareWt"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
                <MudCheckBox Class="CheckBox" Style="width: 80px" @bind-Checked="Item.IsSOC">SOC</MudCheckBox>
                <MudSpacer />
                <MudButton Class="Button" Style="width: 100px" Disabled="!IsNewItem" OnClick="ClearItem_Click"
                           Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Clear">
                    Clear
                </MudButton>
             </div>
         </div>
     </MudForm>
}

@code {
    private MudForm? Form { get; set; }
    [Parameter]
    public string? Num { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private CntrEntity? Item { get; set; }
    private IEnumerable<CarrierCatalog>? Carriers;
    private IEnumerable<CntrTpSz>? CntrTypes;

    private bool IsAuth = false;


    protected override async Task OnInitializedAsync()
    {
        await GetItem();

        var result = await _carrierProvider.GetItemsAsync();
        if (!result.HasError)
            Carriers = ((IEnumerable<CarrierCatalog>)result.Object!).ToList();

        CntrTypes = await _cntrProvider.GetCntrTypes();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("TopManager") || user.User.IsInRole("ExpDept"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        if (IsNewItem)
            Item = new();
        else
        {
            var response = await _cntrProvider.GetItemAsync(Num!);
            if (!response.HasError)
                Item = (CntrEntity)response.Object!;
        }
    }

    public async Task SaveItem_Click()
    {
        await Form!.Validate();

        if (Form.IsValid)
        {
            if (IsNewItem)
            {
                var response = await _cntrProvider.NewItemAsync(Item!);
                if (!response.HasError)
                {
                    Snackbar.Add("Saved successfully", Severity.Success);
                    IsNewItem = false;
                }
                else
                    Snackbar.Add(response.Error.LastOrDefault(), Severity.Error);
            }
            else
            {
                // var response = await _cntrProvider.ModifyItemAsync(Item!);
                // if (!response.HasError)
                // {
                //     await GetItem();
                //     Snackbar.Add("Save Successed", Severity.Success);
                // }
                // else
                //     Snackbar.Add(response.Error.Last(), Severity.Error);
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task ClearItem_Click()
    {
        if (IsNewItem)
        {
            Item!.Num = null;
            Item.TpSz = null;
            Item!.TareWt = 0;
            Item!.MaxPayLoad = 0;
            Item.IsSOC = false;
            Item!.Carrier = null;
        }

        await Task.Delay(50);
    }
}
