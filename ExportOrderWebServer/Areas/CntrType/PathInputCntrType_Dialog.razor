@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    .Body {
        margin: 0px 10px 10px 10px
    }

    .wrapper-button {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 10px;
        margin-inline-end: 24px
    }
</style>

<div class="Body">
    <MudTextField T="string" Lines="25" Variant="Variant.Outlined" @bind-Value="InputData" />
</div>
<div>
    <div class="wrapper-button">
        <MudFab StartIcon="@Icons.Material.Filled.Save" Label="Save" Color="Color.Primary" Size="Size.Small" Disabled="@btnIsDisabled"
                OnClick="@(async () => { await UploadData(); })" />
    </div>
</div>

@code
{
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    private string? InputData { get; set; }
    bool btnIsDisabled = false;

    private async Task UploadData()
    {
        btnIsDisabled = true;

        if (string.IsNullOrWhiteSpace(InputData))
            return;
        var lines = InputData.Replace("\"", "").Split("\n");
        var records = new List<CntrTpSz>();

        foreach (var item in lines)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(item))
                    continue;
                var str = item.Split('\t');

                var cntrISO = str[0].Length == 4 ? str[0] : string.Empty;
                var cntrNormolize = str[1].Length < 8 ? str[1] : string.Empty;

                if (string.IsNullOrWhiteSpace(cntrISO) || string.IsNullOrWhiteSpace(cntrNormolize))
                {
                    bool? result = await DialogService.ShowMessageBox(
                    "Found out ERROR, skip record?",
                    $"==={item}===",
                    yesText: "Skip & Continue", cancelText: "Break");

                    if (result.HasValue)
                    {
                        if (!result.Value)
                            return;
                        else
                            continue;
                    }
                    else
                        return;
                }
                records.Add(new CntrTpSz()
                {
                    ISO = cntrISO,
                    Normolize = cntrNormolize,
                });
            }
            catch (Exception ex)
            {
                var res = ex;
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }

        await Task.Delay(500);
        btnIsDisabled = false;

        MudDialog?.Close(DialogResult.Ok(records));
    }
}
