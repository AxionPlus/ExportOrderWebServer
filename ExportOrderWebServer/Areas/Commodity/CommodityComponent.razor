@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICommodityProvider _commodityProvider

<style>


</style>

<MudForm @ref="@FilterForm">
    <div class="Container-item">
        <div class="container-content">
            <MudButton Class="Button" Style="max-width: 100px;"
                       Variant="Variant.Filled" Color="Color.Primary" Disabled="@IsLoadingData"
                       OnClick="@(async () => { await AddItem_Click(); })">Add New</MudButton>
            <MudSpacer />
            <MudAutocomplete Class="Autocomplete" T="string" @bind-Value="Filter.HScode" SearchFunc="@SearchHScodes"
                             Label="HS code"
                             Variant="Variant.Outlined"                              
                             AutoFocus=true
                             ResetValueOnEmptyText="true"
                             Margin="Margin.Dense"
                             MaxLength="10"
                             Clearable Style="width: 180px" />
            <MudSpacer />
            <MudAutocomplete Class="Autocomplete" T="string" @bind-Value="Filter.Name" SearchFunc="@SearchNames"
                             Label="Name"
                             Variant="Variant.Outlined"
                             ResetValueOnEmptyText="true"
                             Margin="Margin.Dense"
                             Clearable Style="width: 400px"/>
            <MudSpacer />
            <MudAutocomplete Class="Autocomplete" T="string" @bind-Value="Filter.NameEn" SearchFunc="@SearchNamesEn"
                             Label="NameEng"
                             Variant="Variant.Outlined"
                             ResetValueOnEmptyText="true"
                             Margin="Margin.Dense"
                             Clearable Style="width: 400px" />
            <MudSpacer />
            <MudButton Class="Button" Style="max-width: 100px;"
                       Variant="Variant.Filled" Color="Color.Secondary" Disabled="@IsLoadingData"
                       OnClick="@(async () => { await SearchItems_Click(); })">Search</MudButton>
        </div>
    </div>
</MudForm>

<div class="Container-table">
    @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }

    <MudTable Class="Table" @ref="mudTable" Items="@Items" T="CommodityCatalog" Context="commodity"
              Loading="IsLoadingData" Virtualize="true" RowsPerPage="20" >

        <HeaderContent>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:120px">
                <MudTableSortLabel SortBy="new Func<CommodityCatalog, object>(x=>int.Parse(x.HSCode))">HS code</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:400px">Name</MudTh>
            <MudTh Style="width:400px">Name En</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(commodity.Id, commodity.HSCode); })"></MudIconButton></MudTd>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async()=>{ await RemoveItem_Click(commodity); })"></MudIconButton></MudTd>
            <MudTd>@commodity.HSCode</MudTd>
            <MudTd>@commodity.Name</MudTd>
            <MudTd>@commodity.EngName</MudTd>
        </RowTemplate>

        <PagerContent></PagerContent>

    </MudTable>
</div>


 @code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    private MudForm? FilterForm;
    private MudTable<CommodityCatalog>? mudTable;

    private IEnumerable<CommodityCatalog>? Items { get; set; } = new List<CommodityCatalog>();
    private FilterParameters Filter { get; set; } = new();

    bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);
    
       

    private async Task SearchItems_Click()
    {
        IsLoadingData = true;

        // await FilterForm!.Validate();

        // if (!FilterForm.IsValid)
        //     return;

        var response = await _commodityProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<CommodityCatalog>)response.Object!).ToArray();

        await Task.Delay(500);

        await InvokeAsync(StateHasChanged);

        IsLoadingData = false;
    }

    private async Task AddItem_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Large, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<CommodityItem_Dialog>("New COMMODITY", parameters, options);

        DialogResult result = await dialog.Result;

        if (!result.Canceled)
        {
            await SearchItems_Click();
        }
    }

    private async Task ShowItem_Click(long Id, string hsCode)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["Id"] = Id };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Large, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<CommodityItem_Dialog>(hsCode, parameters, options);

        // DialogResult result = await dialog.Result;

        // if (!result.Canceled)
        // {
        //     await SearchItems_Click();
        // }
    }

    private async Task RemoveItem_Click(CommodityCatalog item)
    {
         // if (item is not null)
         //     Items?.Remove(item);

        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE  Record",
                          (MarkupString)$"<b>Do you to remove commodity?</b> <br />HS code:<br/>{item.HSCode} <br />",
                          yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _commodityProvider.RemoveItemAsync(item);

                if (!response.HasError)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);
            }

        await SearchItems_Click();
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchHScodes(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _commodityProvider.GetHScodes();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchNames(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _commodityProvider.GetSearchNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchNamesEn(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _commodityProvider.GetSearchNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
