@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICommodityProvider _CommodityProvider

<style>
    .Commodity * div > .mud-dialog-content {
        padding: 8px 0px;
    }

    .Autocomplete * .mud-input-label-outlined.mud-input-label-margin-dense {
        transform: translate(10px,8px) scale(1);
    }

    .Autocomplete * .mud-input>input.mud-input-root-outlined.mud-input-root-adorned-end {
        padding-inline-start: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        padding-inline-end: 4px;
    }

    .Autocomplete * .mud-icon-button-size-small.mud-icon-button-edge-end {
        margin-inline-end: -10px;
        margin-inline-start: unset;
    }

</style>

<div class="Container-item">
    <div class="container-content">
        <MudAutocomplete Class="Autocomplete HSCode" T="string" Label="HS code" @bind-Value="Filter.HScode" SearchFunc="@SearchHScodes"
                         Style="width: 145px" 
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         AutoFocus=true
                         MaxLength="10" MinCharacters="4" Format="0"
                         CloseIcon="" OpenIcon=""
                         ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Label="Name" @bind-Value="Filter.Name" SearchFunc="@SearchNames"
                         Style="width: 380px"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         MinCharacters="4"
                         CloseIcon="" OpenIcon=""
                         ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Label="NameEng" @bind-Value="Filter.NameEn" SearchFunc="@SearchNamesEn"
                         Style="width: 380px"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         MinCharacters="4"
                         CloseIcon="" OpenIcon=""
                         ResetValueOnEmptyText="true" Clearable />
         <MudSpacer />
         <MudCheckBox Class="wrapper-checkBox" Label="Is IMO" LabelPosition="LabelPosition.End" TriState @bind-Value="@Filter.IsIMO"></MudCheckBox>
         <MudSpacer />
         <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData" OnClick="GetItems"
                    Variant="Variant.Filled" Color="Color.Secondary">Search</MudButton>
    </div>
</div>

@if (Items != null && Items.Any())
{
    <div class="Container-table">
    @if (mudTable != null && !IsSelectable)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items.Count())</span>
        </div>
    }

    <MudTable Class="Table" @ref="mudTable" Items="@Items" Loading="IsLoadingData" Virtualize="true" RowsPerPage="18" >

        <HeaderContent>
            @if (!IsSelectable)
            {
                <MudTh Style="width:30px"></MudTh>
            }                    
            else
            {
                <MudTh Style="width:30px">
                    <MudTooltip Text="add new">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Size="Size.Small" OnClick="AddItem_Click" />
                    </MudTooltip>
                </MudTh>
            }
            <MudTh Style="width: 130px">
                <MudTableSortLabel SortBy="new Func<CommodityCatalog, object>(x=>x.HSCode!)">HS code</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:430px">
                    <MudTableSortLabel SortBy="new Func<CommodityCatalog, object>(x=>x.Name!)">Name</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:430px">Name En</MudTh>
            <MudTh Style="width:65px">Is IMO</MudTh>
            <MudTh Style="width:65px">UNNO</MudTh>
            @if (!IsSelectable)
            {
                <MudTh Style="width:30px"></MudTh>
            }
        </HeaderContent>

        <RowTemplate>
            @if (!IsSelectable)
            {
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.Id); })"/></MudTd>                
            }
            else
            {                
                <MudTd>
                    <MudTooltip Text="select">
                        <MudIconButton Icon="@Icons.Material.Filled.Upload" Color="Color.Secondary" OnClick="@(()=>SelectItem_Click(context))" />
                    </MudTooltip>
                </MudTd>                
            }
            <MudTd>@context.HSCode</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.NameEn</MudTd>            
            <MudTd>@context.IMO</MudTd>
            <MudTd>@context.UNNO</MudTd>
            @if (!IsSelectable)
            {
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Secondary"
                                    OnClick="@(async()=>{ await RemoveItem_Click(context.HSCode, context.Id); })" />
                </MudTd>
            }
        </RowTemplate>

        <PagerContent></PagerContent>

    </MudTable>
</div>
}

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    private MudTable<CommodityCatalog>? mudTable;

    [Parameter]
    public bool IsSelectable { get; set; } = false;

    private IEnumerable<CommodityCatalog>? Items { get; set; } = new List<CommodityCatalog>();
    private FilterParameters Filter { get; set; } = new();

    bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    public async Task GetItems()
    {
        if (string.IsNullOrEmpty(Filter.HScode) &
            string.IsNullOrEmpty(Filter.Name) &
            string.IsNullOrEmpty(Filter.NameEn))
        {
            Snackbar.Add("One of the search fields should be used.", Severity.Warning);
            return;
        }

        IsLoadingData = true;

        var response = await _CommodityProvider.GetItemsAsync(Filter);

        if (!response.HasError)
            Items = (IEnumerable<CommodityCatalog>)response.Object!;
        else
            Snackbar.Add(response.Error.First(), Severity.Warning);

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowItem_Click(long Id)
    {
        DialogParameters parameters = new DialogParameters { ["Id"] = Id };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Large, CloseButton = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Commodity_ItemDialog>("Commodity", parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await GetItems();
    }

    private async Task AddItem_Click()
    {
        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Large, CloseButton = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Commodity_ItemDialog>("New Commodity", parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await GetItems();
    }

    private async Task RemoveItem_Click(string name, long id)
    {
        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE  Record",
                          (MarkupString)$"<b>Do you want to remove commodity?</b> <br/>HS code:<br/>{name}<br/>",
                          yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _CommodityProvider.RemoveItemAsync(id);

                if (!response.HasError)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);
            }

        await GetItems();
    }

    private void SelectItem_Click(CommodityCatalog item)
    {
        MudDialog!.Close(item);
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchHScodes(string value, CancellationToken token)
    {
        var result = await _CommodityProvider.GetHScodes();

        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchNames(string value, CancellationToken token)
    {
        var result = await _CommodityProvider.GetNames();
        
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchNamesEn(string value, CancellationToken token)
    {
        var result = await _CommodityProvider.GetNamesEn();
        
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
