@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICommodityProvider _commodityProvider

<style>
    .Commodity * div > .mud-dialog-content {
        padding: 8px 0px;
    }
</style>

<MudForm @ref="@FilterForm">

    <div class="Container-item">
        <div class="container-content">
            <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData"
                        Variant="Variant.Filled" Color="Color.Primary" 
                        OnClick="@(async () => { await AddItem_Click(); })">Add New</MudButton>
            <MudSpacer />
            <MudAutocomplete Class="Autocomplete" T="string" Label="HS code" Style="width: 180px" SearchFunc="@SearchHScodes"
                                Value="Filter.HScode"
                                ValueChanged="(e)=> { Filter.HScode = e; }"
                                Variant="Variant.Outlined" Margin="Margin.Dense"
                                AutoFocus=true
                                MaxLength="10"
                                CloseIcon="" OpenIcon=""
                                ResetValueOnEmptyText="true" Clearable />
            <MudSpacer />
            <MudAutocomplete Class="Autocomplete" T="string" Label="Name" Style="width: 400px" SearchFunc="@SearchNames"
                                Value="Filter.Name"
                                ValueChanged="(e)=> { Filter.Name =e; }"
                                Variant="Variant.Outlined" Margin="Margin.Dense"
                                CloseIcon="" OpenIcon=""
                                ResetValueOnEmptyText="true" Clearable />
            <MudSpacer />
            <MudAutocomplete Class="Autocomplete" T="string" Label="NameEng" Style="width: 400px" SearchFunc="@SearchNamesEn"
                                Value="Filter.NameEn"
                                ValueChanged="(e)=> { Filter.NameEn =e; }"
                                Variant="Variant.Outlined" Margin="Margin.Dense"
                                CloseIcon="" OpenIcon=""
                                ResetValueOnEmptyText="true" Clearable />
            <MudSpacer />
            <MudCheckBox Label="Is IMO" LabelPosition="LabelPosition.End" TriState @bind-Checked="@Filter.IsIMO"></MudCheckBox>
            <MudSpacer />
            <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData"
                        Variant="Variant.Filled" Color="Color.Secondary" 
                        OnClick="@(async () => { await GetItems(); })">Search</MudButton>
        </div>
    </div>

    <div class="Container-table">
    @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }

    <MudTable Class="Table" @ref="mudTable" Items="@Items" T="CommodityCatalog"
                Loading="IsLoadingData" Virtualize="true" RowsPerPage="20" >

        <HeaderContent>
            @if (!IsSelectable)
            {
                <MudTh Style="width:30px"></MudTh>
            }                    
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width: 130px">
                <MudTableSortLabel SortBy="new Func<CommodityCatalog, object>(x=>x.HSCode)">HS code</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:400px">
                    <MudTableSortLabel SortBy="new Func<CommodityCatalog, object>(x=>x.Name!)">Name</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:400px">Name En</MudTh>
            <MudTh Style="width:65px">Is IMO</MudTh>
            <MudTh Style="width:65px">IMO</MudTh>
            <MudTh Style="width:65px">UNNO</MudTh>
        </HeaderContent>

        <RowTemplate>
            @if (!IsSelectable)
            {
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.Id); })"/></MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async()=>{ await RemoveItem_Click(context); })"/></MudTd>
            }
            else
            {
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.AddCircle" OnClick="@(async()=>{ await SelectItem_Click(context); })" /></MudTd>
            }
            <MudTd>@context.HSCode</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.EngName</MudTd>
            <MudTd>@context.IsIMO</MudTd>
            <MudTd>@context.IMO</MudTd>
            <MudTd>@context.UNNO</MudTd>
        </RowTemplate>

        <PagerContent></PagerContent>

    </MudTable>
</div>

</MudForm>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    private MudForm? FilterForm;
    private MudTable<CommodityCatalog>? mudTable;

    [Parameter]
    public bool IsSelectable { get; set; } = false;

    private IEnumerable<CommodityCatalog>? Items { get; set; } = new List<CommodityCatalog>();
    private FilterParameters Filter { get; set; } = new();

    bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    private async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _commodityProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<CommodityCatalog>)response.Object!).ToArray();

        await Task.Delay(500);

        await InvokeAsync(StateHasChanged);

        IsLoadingData = false;
    }

    private async Task AddItem_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Large, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<CommodityItem_Dialog>("New Commodity", parameters, options);

        DialogResult result = await dialog.Result;

        if (result.Canceled)
            if (Items!.Count() > 0)
                await GetItems();        
    }

    private async Task ShowItem_Click(long Id)
    {
        // if (MudDialog is not null)
        //     MudDialog.Close(DialogResult.Ok(Id));

        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["Id"] = Id };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Large, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<CommodityItem_Dialog>("Commodity", parameters, options);
    }

    private async Task RemoveItem_Click(CommodityCatalog item)
    {
         // if (item is not null)
         //     Items?.Remove(item);

        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE  Record",
                          (MarkupString)$"<b>Do you want to remove commodity?</b> <br/>HS code:<br/>{item.HSCode}<br/>",
                          yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _commodityProvider.RemoveItemAsync(item);

                if (!response.HasError)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);
            }

        await GetItems();
    }

    private async Task SelectItem_Click(CommodityCatalog item)
    {
        await Task.Delay(50);
        MudDialog.Close(item);
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchHScodes(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _commodityProvider.GetHScodes();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchNames(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _commodityProvider.GetNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchNamesEn(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _commodityProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
