@inject ISnackbar Snackbar
@inject AuthenticationStateProvider authenticationStateProvider
@inject ICommodityProvider _commodityProvider

@if (Item is not null)
{
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudForm @ref="@Form">
            <div class="Container-item">
                <div class="container-head"></div>
                <div class="container-content">
                    <MudTextField T="string" Style="width:200px" Label="HS code" @bind-Value="@Item.HSCode"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Validation="HSCodeValidation"
                                  MaxLength="10" Mask="@( IsNewItem? new PatternMask("0000000000") : null)"
                                  AutoFocus="true"
                                  Immediate="true"
                                  Required RequiredError=""
                                  ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                    <MudSpacer/>
                   <MudButton Class="Button" Style="min-width: 100px; max-width: 100px; margin-left: 10px" Disabled="!IsNewItem" 
                              Variant="Variant.Filled" Color="Color.Primary"
                                OnClick="SaveItem_Click">
                         Save
                   </MudButton>

                </div>
                <div class="container-content">             
                    <MudTextField T="string" Style="width: 400px" Label="Name" Text="@Item.Name"
                                  TextChanged=" (e)=> { Item.Name = e.ToUpper(); }"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Lines="3"
                                  Immediate="true"
                                  Required RequiredError=""
                                  ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                    <MudSpacer/>
                     <MudTextField T="string" Style="width: 400px; margin-left: 10px" Label="Name En" Text="@Item.EngName"
                                   TextChanged="(e)=> { Item.EngName = e.ToUpper(); StateHasChanged();}"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Lines="3"
                                   Immediate="true"
                                   Required RequiredError=""
                                   ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                    <MudSpacer />
                    <MudButton Class="Button" Style="min-width: 100px; max-width: 100px; margin-left: 10px" Disabled="!IsNewItem"
                                Variant="Variant.Filled" Color="Color.Secondary"
                                OnClick="ClearItem_Click">
                         Clear
                    </MudButton>
                 </div>
             </div>
         </MudForm>
    </MudContainer>
}

@code {
    private MudForm? Form { get; set; }    
    [Parameter]
    public long Id { get; set; } = 0;
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private CommodityCatalog? Item { get; set; }

    private bool IsAuth = false;


    protected override async Task OnInitializedAsync()
    {
        await GetItem();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("TopManager") || user.User.IsInRole("ExpDept"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        if (IsNewItem)
            Item = new();
        else
        {
            var response = await _commodityProvider.GetItemAsync(Id);
            if (!response.HasError)
                Item = (CommodityCatalog)response.Object!;
        }
    }

    public async Task SaveItem_Click()
    {
        await Form!.Validate();

        if (Form.IsValid)
        {
            if (IsNewItem)
            {
                var response = await _commodityProvider.NewItemAsync(Item!);
                if (!response.HasError)
                {                    
                    Snackbar.Add("Saved successfully", Severity.Success);
                    IsNewItem = false;
                }                
                else
                    Snackbar.Add(response.Error.LastOrDefault(), Severity.Error);
            }
            else
            {
                // var response = await _commodityProvider.ModifyItemAsync(Item!);
                // if (!response.HasError)
                // {
                //     await GetItem();
                //     Snackbar.Add("Save Successed", Severity.Success);
                // }
                // else
                //     Snackbar.Add(response.Error.Last(), Severity.Error);
            }

                  
        }
        await InvokeAsync(StateHasChanged);
    }

    public async Task ClearItem_Click()
    {
        if (IsNewItem)
        {
            Item!.HSCode = null;
            Item.Name = null;
            Item.EngName = null;
            //await InvokeAsync(StateHasChanged);
        }

        await Task.Delay(50);
    }

    Func<string, string?> HSCodeValidation = (str) =>
    {
        if (string.IsNullOrWhiteSpace(str))
            return string.Empty;
        if (str.Length < 10)
            return "pls insert 10 digits";

        return null;
    };
}
