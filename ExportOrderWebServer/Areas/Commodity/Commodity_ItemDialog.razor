@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider authenticationStateProvider
@inject ICommodityProvider _CommodityProvider

<MudContainer MaxWidth="MaxWidth.Large">
    <MudForm @ref="@Form">
        <DialogToolBar ToolBarTitle="Товар" SaveButtonDisabled="IsLoadingData" SaveItem="@SaveItem_Click"
                       CloseDialog="@(() => MudDialog?.Close(DialogResult.Ok(IsDialogResultOk)))"></DialogToolBar>        
        <div class="Container-item">
            <div class="container-content">
                <MudTextField Class="TextField" T="string" Style="width:200px" Label="HS code" @ref="@Hscode" @bind-Value="@Item.HSCode"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"                                  
                              Mask="@(new PatternMask("0000000000"))"                                                                    
                              Required RequiredError="" Clearable />
                <MudSpacer />               
                @if (Item.IsIMO)
                {
                    <MudTextField Class="TextField" T="string" Style="width:100px" Label="IMO" @bind-Value="@Item.IMO"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  MaxLength="3"
                                  Required RequiredError="" Clearable />
                    <MudTextField Class="TextField" T="string" Style="width:100px; margin-inline:10px" Label="UNNO" @ref="@Unno" @bind-Value="@Item.UNNO"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Mask="@(new PatternMask("0000"))"
                                  Required RequiredError="" Clearable />
                }
                <MudCheckBox Class="CheckBox" T="bool" Label="Is IMO" LabelPosition="LabelPosition.Start"
                             Value="@Item.IsIMO" ValueChanged="@((e) => { Item.IsIMO = e; IsIMOChanged(); })" />
            </div>
            <div class="container-content" style="gap:10px">
                <TextField Class="TextField" Style="width: 450px" Label="Name" Value="@Item.Name"
                           ValueChanged="(e) => Item.Name = ExtraSymbolReplacer.ReplaceExtraSymbols(e).ToUpper()"
                           Lines="6"
                           Required Clearable />
                <TextField Class="TextField" Style="width: 450px" Label="Name En" Value="@Item.NameEn"
                           ValueChanged="(e) => Item.NameEn = ExtraSymbolReplacer.ReplaceExtraSymbols(e).ToUpper()"
                           Lines="6"
                           Required Clearable />
            </div>
        </div>
    </MudForm>
</MudContainer>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private string? ApplicationUser { get; set; }
    private MudForm Form { get; set; } = new();
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    private bool IsDialogResultOk { get; set; } = false;

    [Parameter]
    public long Id { get; set; }
    private CommodityCatalog Item { get; set; } = new();

    private bool IsLoadingData = false;

    private TextFieldReplaceService ExtraSymbolReplacer { get; set; } = new();
    private MudTextField<string> Hscode = new();
    private MudTextField<string?> Unno = new();

    protected override async Task OnAfterRenderAsync(bool first)  //OnInitializedAsync
    {
        if (first)
        {
            var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
            ApplicationUser = authState.User.Identity?.Name;

            await GetItem();
        }
    }

    private async Task GetItem()
    {
        if (Id == 0) return;

        IsLoadingData = true;

        var response = await _CommodityProvider.GetItemAsync(Id);
        if (!response.HasErrors && response.Object is not null)
            Item = (CommodityCatalog)response.Object;

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveItem_Click()
    {
        await Form.ValidateAsync();

        if (!Form.IsValid) return;

        if (!ValidatePageFields.IsValid_HSCode(Hscode.Text))
        {
            Snackbar.Add("HS Code is not valid", Severity.Warning);
            return;
        }

        if (Item.IsIMO)
            if (!ValidatePageFields.IsValid_UNNO(Unno.Text))
            {
                Snackbar.Add("UNNO is not valid", Severity.Warning);
                return;
            }

        /// SAVE
        IsLoadingData = true;

        AppObjectResponse appObjectResponse = new();

        if (Id == 0)
            appObjectResponse = await _CommodityProvider.NewItemAsync(Item, ApplicationUser);
        else
            appObjectResponse = await _CommodityProvider.ModifyItemAsync(Item, ApplicationUser);

        if (appObjectResponse.HasErrors)
            Snackbar.Add(string.Join(", ", appObjectResponse.Errors), Severity.Warning); 
        else
        {
            Id = Item.Id;
            IsDialogResultOk = true;
            Snackbar.Add("Saved Successfully", Severity.Success);
        }

        IsLoadingData = false;
        
        await InvokeAsync(StateHasChanged);
    }

    private async void IsIMOChanged()
    {
        if (Item is not null && !Item.IsIMO)
            if (!string.IsNullOrWhiteSpace(Item.IMO) || !string.IsNullOrWhiteSpace(Item.UNNO))
            {
                bool? result = await DialogService.ShowMessageBoxAsync(
                    "Delete IMO",
                    (MarkupString)$"Do you want to clear IMO data?",
                    yesText: "Yes", noText: "NO");

                if (result.HasValue)
                    if (result.Value)
                    {
                        Item.IMO = null;
                        Item.UNNO = null;
                    }
                    else
                    {
                        Item.IsIMO = true;
                        StateHasChanged();
                    }
            }
        ;
    }

