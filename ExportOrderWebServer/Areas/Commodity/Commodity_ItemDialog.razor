@inject ISnackbar Snackbar
@inject AuthenticationStateProvider authenticationStateProvider
@inject ICommodityProvider _commodityProvider

@if (Item is not null)
{
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudForm @ref="@Form" ReadOnly="IsFormReadOnly">

            <div class="ToolBar-container">
                <MudToolBar Class="ToolBar ToolBar-new">                    
                    <MudSpacer />
                    <div class="ToolBar-iconbutton" style="margin-right: 20px">
                        <MudTooltip Text=@(IsFormReadOnly ? "Edit" : "Save")>
                            @if (IsFormReadOnly)
                            {
                                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Edit" OnClick="EditItem_Click" />
                            }
                            else
                            {
                                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" OnClick="SaveItem_Click" />
                            }                            
                        </MudTooltip>
                    </div>
                </MudToolBar>
            </div>

            <div class="Container-item">
                <div class="container-head"></div>
                <div class="container-content">
                    <MudTextField T="string" Style="width:200px" Label="HS code" @bind-Value="@Item.HSCode"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Validation="HSCodeValidation"
                                  MaxLength="10" Mask="@( IsNewItem? new PatternMask("0000000000") : null)"
                                  AutoFocus="true" Immediate="true"
                                  Required RequiredError=""
                                   Clearable="!IsFormReadOnly" />
                    <MudSpacer />
                     
                    <div class="wrapper-checkBox" style="width:170px; margin-inline-start:10px; justify-content:start">
                        <MudCheckBox Label="Is IMO" LabelPosition="LabelPosition.Start" @bind-Checked="@Item.IsIMO"></MudCheckBox>
                    </div>                     
                    @if (Item.IsIMO)
                    {
                        <MudTextField T="string" Style="width:100px; margin-inline:10px" Label="IMO" @bind-Value="@Item.IMO"
                                        Variant="Variant.Outlined" Margin="Margin.Dense"
                                        MaxLength="3"
                                        Required RequiredError=""
                                        Clearable="!IsFormReadOnly" />
                        <MudTextField T="string" Style="width:100px" Label="UNNO" @bind-Value="@Item.UNNO"
                                        Variant="Variant.Outlined" Margin="Margin.Dense"
                                        MaxLength="4" Mask="@( IsNewItem? new PatternMask("0000") : null)"
                                        Required RequiredError=""
                                        Clearable="!IsFormReadOnly" />
                    }
                    else {<div style="width:220px"></div>}
                </div>
                <div class="container-content">             
                    <MudTextField T="string" Style="width: 450px" Label="Name" Text="@Item.Name"
                                  TextChanged=" (e)=> { Item.Name = e.ToUpper(); }"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Lines="6"
                                  Immediate="true"
                                  Required RequiredError=""
                                  Clearable="!IsFormReadOnly" />
                    <MudSpacer/>
                    <MudTextField T="string" Style="width: 450px; margin-left: 10px" Label="Name En" Text="@Item.NameEn"
                                   TextChanged="(e)=> { Item.NameEn = e.ToUpper(); StateHasChanged();}"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Lines="6"
                                   Immediate="true"
                                   Required RequiredError=""
                                   Clearable="!IsFormReadOnly" />
                 </div>
            </div>
        </MudForm>
    </MudContainer>
}

@code {
    private MudForm? Form { get; set; }    
    [Parameter]
    public long Id { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private CommodityCatalog? Item { get; set; }
    private bool IsFormReadOnly { get; set; } = true;
    private bool IsAuth = false;


    protected override async Task OnInitializedAsync()
    {
        await GetItem();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("TopManager") || user.User.IsInRole("ExpDept"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        if (IsNewItem)
        {
            Item = new();
            IsFormReadOnly = false;
        }        
        else
        {
            var response = await _commodityProvider.GetItemAsync(Id);
            if (!response.HasError)
                Item = (CommodityCatalog)response.Object!;
        }
    }

    public async Task SaveItem_Click()
    {
        await Form!.Validate();

        if (Form.IsValid)
        {
            if (IsNewItem)
            {
                var response = await _commodityProvider.NewItemAsync(Item!);
                if (!response.HasError)
                {
                    Id = Item!.Id;
                    Snackbar.Add("Saved successfully", Severity.Success);
                }
                else
                    Snackbar.Add(response.Error.LastOrDefault(), Severity.Error);
            }
            else
            {
                var response = await _commodityProvider.ModifyItemAsync(Item!);
                if (!response.HasError)
                {
                    Snackbar.Add("Save Successed", Severity.Success);
                }
                else
                    Snackbar.Add(response.Error.Last(), Severity.Error);
            }
        }
        else
            return;

        IsNewItem = false;
        IsFormReadOnly = true;

        await GetItem();
    }

    private async Task EditItem_Click()
    {
        await Task.Delay(50);
        IsFormReadOnly = false;
    }

    Func<string, string?> HSCodeValidation = (str) =>
    {
        if (string.IsNullOrWhiteSpace(str))
            return string.Empty;
        if (str.Length < 10)
            return "pls insert 10 digits";

        return null;
    };
}
