@inject ISnackbar Snackbar
@inject AuthenticationStateProvider authenticationStateProvider
@inject ICommodityProvider _CommodityProvider

@if (Item is not null)
{
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudForm @ref="@Form">

            <div class="ToolBar-container">
                <MudToolBar Class="ToolBar ToolBar-new">                    
                    <MudSpacer />
                    <div class="ToolBar-iconbutton" style="margin-right: 20px">
                        <MudTooltip Text="Save">
                            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" OnClick="SaveItem_Click" />                        
                        </MudTooltip>
                    </div>
                </MudToolBar>
            </div>

            <div class="Container-item">
                <div class="container-head"></div>
                <div class="container-content">
                    <MudTextField @ref="@Hscode" T="string" Style="width:200px" Label="HS code" @bind-Value="@Item.HSCode"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  AutoFocus="true" Immediate="true"
                                  Validation="HSCodeValidation"
                                  Mask="@(new PatternMask("0000000000"))"                                                                    
                                  Required RequiredError="" Clearable />
                    <MudSpacer />
                     
                    <div class="wrapper-checkBox" style="width:170px; margin-inline-start:10px; justify-content:start">
                        <MudCheckBox Label="Is IMO" LabelPosition="LabelPosition.Start" @bind-Value="@Item.IsIMO"></MudCheckBox>
                    </div>                     
                    @if (Item.IsIMO)
                    {
                        <MudTextField T="string" Style="width:100px; margin-inline:10px" Label="IMO" @bind-Value="@Item.IMO"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      MaxLength="3"
                                      Required RequiredError="" Clearable />
                        <MudTextField @ref="@Unno" T="string" Style="width:100px" Label="UNNO" @bind-Value="@Item.UNNO"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Mask="@(new PatternMask("0000"))"
                                      Required RequiredError="" Clearable />
                    }
                    else
                    {
                        <div style="width:220px"></div>
                    }
                </div>
                <div class="container-content">             
                    <MudTextField T="string" Style="width: 450px" Label="Name" Text="@Item.Name"
                                  TextChanged=" (e)=> { Item.Name = e.ToUpper(); }"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Lines="6"
                                  Immediate="true"
                                  Required RequiredError=""
                                  Clearable />
                    <MudSpacer/>
                    <MudTextField T="string" Style="width: 450px; margin-left: 10px" Label="Name En" Text="@Item.NameEn"
                                  TextChanged="(e)=> { Item.NameEn = e.ToUpper(); StateHasChanged();}"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Lines="6"
                                  Immediate="true"
                                  Required RequiredError=""
                                  Clearable />
                 </div>
            </div>
        </MudForm>
    </MudContainer>
}

@code {
    private MudForm Form { get; set; } = new();  
    [Parameter]
    public long Id { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private CommodityCatalog? Item { get; set; }
    private bool IsAuth = false;

    private MudTextField<string> Hscode = new();
    private MudTextField<string?> Unno = new();

    protected override async Task OnInitializedAsync()
    {
        await GetItem();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("Top Manager") || user.User.IsInRole("Manager"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        if (IsNewItem)
            Item = new() { Name = string.Empty, NameEn = string.Empty, HSCode = string.Empty };
        else
        {
            var response = await _CommodityProvider.GetItemAsync(Id);
            if (!response.HasErrors && response.Object is not null)
                Item = (CommodityCatalog)response.Object;
        }
    }

    public async Task SaveItem_Click()
    {
        if (Item is null) return;

        await Form.Validate();

        if (Form.IsValid)
        {
            if (!ValidatePageFields.IsValid_HSCode(Hscode.Text))
            {
                Snackbar.Add("HS Code is not valid", Severity.Warning);
                return;
            }

            if (Item.IsIMO)
                if (!ValidatePageFields.IsValid_UNNO(Unno.Text))
                {
                    Snackbar.Add("UNNO is not valid", Severity.Warning);
                    return;
                }            

            if (IsNewItem)
            {
                var response = await _CommodityProvider.NewItemAsync(Item!);
                if (!response.HasErrors)
                {
                    Id = Item.Id;
                    Snackbar.Add("Saved successfully", Severity.Success);
                }
                else
                    Snackbar.Add(string.Join(", ", response.Errors), Severity.Error);
            }
            else
            {
                var response = await _CommodityProvider.ModifyItemAsync(Item!);
                if (!response.HasErrors)
                {
                    Snackbar.Add("Save Successed", Severity.Success);
                }
                else
                    Snackbar.Add(string.Join(", ", response.Errors), Severity.Error);
            }
        }
        else
            return;

        IsNewItem = false;

        await GetItem();
    }

    Func<string, string?> HSCodeValidation = (str) =>
    {
        if (string.IsNullOrWhiteSpace(str))
            return string.Empty;
        if (str.Length < 10)
            return "pls insert 10 digits";

        return null;
    };


    // private PatternMask Mask_HSCode = new PatternMask("##########")
    // {
    //     MaskChars = new[] { new MaskChar('#', @"[0-9]") }
    // };

    // private PatternMask Mask_UNNO = new PatternMask("####")
    // {
    //     MaskChars = new[] { new MaskChar('#', @"\d") }
    // };

    // public IMask Mask_HSCode = new RegexMask(@"\d");     // work, but number of symbols not controlled
    // public IMask Mask_UNNO = new RegexMask(@"\d{4}");    // input dosn't work (only matching)
}
