
<div class="Container-item">
    <div class="container-head"></div>
    <div class="container-content column">

        <div class="container-content_row">
            <MudTextField T="string" Style="width:120px" Label="HS code" Value="@Value.HSCode"
                          ValueChanged="@(async(e)=> {
                                          Value.HSCode = e;
                                          await ValueChanged.InvokeAsync(Value);
                                      })"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Validation="HSCodeValidation"
                          MaxLength="10" Mask="@(new PatternMask("0000000000"))"                          
                                        Required RequiredError=""  Clearable />

            <MudSpacer/>
            <MudTextField T="string" Style="width: 400px" Label="Name" Value="@Value.Name" 
            ValueChanged="async (e)=> {
                                          Value.Name = e.ToUpper();                                     
                                          await ValueChanged.InvokeAsync(Value);
                                      }"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Immediate Lines="3"
                          Required RequiredError=""
                          Clearable />
             <MudSpacer />
             <MudTextField T="string" Style="width: 400px" Label="Name" Value="@Value.EngName"
             ValueChanged="@(async(e)=>{

                            Value.EngName = e.ToUpper();
                             await ValueChanged.InvokeAsync(Value);
                            
                            })"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Immediate Lines="3"
                           Required RequiredError=""
                           Clearable />
        </div>
    </div>
</div>

@code {
    MudTable<CommodityCatalog>? mudTable;

    [Parameter]
    public CommodityCatalog? Value { get; set; }
    [Parameter]
    public EventCallback<CommodityCatalog> ValueChanged { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; }




    Func<string, string> HSCodeValidation = (str) =>
    {
        if (string.IsNullOrWhiteSpace(str))
            return string.Empty;
        if (str.Length < 10)
            return "pls insert 10 digits";

        return null;
    };
}
