
<style>


    .HSCode {
        width: 160px;
    }

    .wrapper-input * .mud-input > input.mud-input-root-outlined, div.mud-input-slot.mud-input-root-outlined {
        text-align: left;
    }
</style>

@if (Item is not null)
{
    <MudContainer>
        <MudForm @ref="form">
            <div class="HSCode">
                <MudTextField Class="pt-3"
                          T="String"
                          Margin="Margin.Dense"
                          @bind-Value="Item.HSCode"
                          Mask="@(new PatternMask("0000000000"))"
                          Label="HS Code"
                          MaxLength="10"
                          Variant="Variant.Outlined"
                          Validation="@HSCodeValidation"
                          OnlyValidateIfDirty=true
                                    Required RequiredError=""
                                    Clearable></MudTextField>

            </div>
            <MudTextField T="string" Class="pt-3"
                      Margin="Margin.Dense"
                      Value="Item.Name"
                            Immediate
                      ValueChanged="@((e)=>{Item.Name = e.ToUpper();})"
                      Label="Name"
                      Lines="3"
                      Variant="Variant.Outlined"
                            Required RequiredError=""
                            Clearable></MudTextField>
            <MudTextField T="string" Class=" pt-3"
                      Margin="Margin.Dense"
                      Value="Item.EngName"
                            Immediate
                      ValueChanged="@((e)=>{Item.EngName=e.ToUpper();})"
                      Label="ENG Name"
                      Variant="Variant.Outlined"
                            Required RequiredError=""
                            Clearable></MudTextField>

        </MudForm>
        <br />
        <br />
        <div>
            <MudButton FullWidth Disabled="addBtnDisable" Class="wrapper-button " Variant="Variant.Filled" Color="Color.Secondary"
                   OnClick="@(async()=>{ addBtnDisable = true;
                        await AddItem_Click();
                        await Task.Delay(1000);
                        addBtnDisable = false;
        })">Add</MudButton>
        </div>
        </MudContainer>
    <br />
}
@code {

    MudForm? form;
    bool addBtnDisable = false;

    [Parameter]
    public CommodityCatalog? Item { get; set; }
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }


    protected override async Task OnInitializedAsync()
    {

    }


    private async Task AddItem_Click()
    {
        await form!.Validate();
        if (form.IsValid)
        {



            MudDialog?.Close(DialogResult.Ok(Item));


        }


    }



    #region FUNCS

    Func<string, string> HSCodeValidation = (str) =>
    {

        if (string.IsNullOrWhiteSpace(str))
            return string.Empty;
        if (str.Length < 10)
            return "pls insert 10 digits";

        return null;

    };
    #endregion
}
