

@inject IDialogService DialogService

<style>

    .filters {
        display: flex;
        width: 100%;
        align-items: center;
    }

    .min-width {
        width: 960px;
    }
</style>

<div class="item-container">

    <div class="container-head"></div>
    <div class="container-content column ">

        <div class="filters">

            <MudTextField Class="wrapper-input" @bind-Value="filter_NAME" Label="NAME" Variant="Variant.Outlined" Clearable></MudTextField>
            <MudSpacer />
            <MudTextField Class="wrapper-input" @bind-Value="filter_EngNAME" Label="ENG NAME" Variant="Variant.Outlined" Clearable></MudTextField>

            <MudSpacer />
            <MudButton Class="wrapper-button" Variant="Variant.Filled" Color="Color.Secondary" Disabled="@searchBtnDisable"
                       OnClick="@(async ()=>{searchBtnDisable=true; await SearchItems_Click(); await Task.Delay(1000); searchBtnDisable=false; })">Search</MudButton>
        </div>
        <div class="viewDataTable">
            <MudTable Items="@Items">
                <HeaderContent>
                    <MudTh></MudTh>
                    <MudTh>NAME</MudTh>
                    <MudTh>NAME ENG</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><MudIconButton Icon="@Icons.Material.Filled.AspectRatio"></MudIconButton></MudTd>
                    <MudTd DataLabel="Terminal">@context.RUS</MudTd>
                    <MudTd DataLabel="Name">@context.ENG</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    bool newItemBtnDisable = false;
    bool searchBtnDisable = false;

    string? filter_NAME;
    string? filter_EngNAME;


    [Parameter]
    public IEnumerable<CountryCatalog>? Items { get; set; } = new List<CountryCatalog>();

    private async Task SearchItems_Click()
    {


    }


}
