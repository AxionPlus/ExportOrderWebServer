@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICountryProvider _countryProvider

<style></style>

<div class="Container-item">
    <div class="container-content">
        <MudAutocomplete Class="Autocomplete" T="string" Label="Name" Style="width: 300px" SearchFunc="@SearchNames"
                         Value="Filter.Name" ValueChanged="(e)=> { Filter.Name = e.ToUpper().Trim(); }"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon=""
                         ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Label="NameEng" Style="width: 300px" SearchFunc="@SearchNamesEn"
                         Value="Filter.NameEn" ValueChanged="(e)=> { Filter.NameEn = e.ToUpper().Trim(); }"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon=""
                         ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData" OnClick="@GetItems"
                   Variant="Variant.Filled" Color="Color.Secondary" >Search</MudButton>
    </div>
</div>

<div class="Container-table">        
    <div class="tableMenu">
        <MudSpacer />
        <TablePager T="CountryCatalog" Table="mudTable" ItemsCount="@Items?.Count()" />
    </div>
    <MudTable Class="Table P4" @ref="mudTable" Items="@Items" Loading="IsLoadingData" Virtualize="true" RowsPerPage="20">
        <HeaderContent>
            <MudTh Style="width:36px"></MudTh>            
            <MudTh Style="width:400px"><MudTableSortLabel SortBy="new Func<CountryCatalog, object>(x=>x.RUS)">Name Ru</MudTableSortLabel></MudTh>
            <MudTh Style="width:400px"><MudTableSortLabel SortBy="new Func<CountryCatalog, object>(x=>x.ENG)">Name En</MudTableSortLabel></MudTh>
            <MudTh Style="width:36px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.Id); })"></MudIconButton></MudTd>            
            <MudTd>@context.RUS</MudTd>
            <MudTd>@context.ENG</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Secondary"
                               OnClick="@(async () => { await RemoveItem_Click(context.RUS, context.Id); })"></MudIconButton>
            </MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    [Parameter]
    public string? ApplicationUser { get; set; }
    private MudTable<CountryCatalog> mudTable = new();

    private IEnumerable<CountryCatalog> Items { get; set; } = new List<CountryCatalog>();
    private FilterParameters Filter { get; set; } = new();

    public bool IsLoadingData { get; set; } = false;

    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _countryProvider.GetItemsAsync(Filter);
        if (!response.HasErrors && response.Object is not null)
            Items = (IEnumerable<CountryCatalog>)response.Object;

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowItem_Click(long Id)
    {
        var parameters = new DialogParameters { ["Id"] = Id };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Country_ItemDialog>(null, parameters, options);

        var result = await dialog.Result;

        if (result != null && result.Data != null && (bool)result.Data == true)
            await GetItems();
    }

    private async Task RemoveItem_Click(string name, long id)
    {        
        bool? msgResult = await DialogService.ShowMessageBoxAsync(
            "REMOVE",
            (MarkupString)$"<b>Do you want to remove record?</b> <br/>Country: {name}<br/>",
            yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                IsLoadingData = true;
                var response = await _countryProvider.RemoveItemAsync(id, ApplicationUser);
                IsLoadingData = false;

                if (response.HasErrors)
                    Snackbar.Add($"Unable to delete", Severity.Warning);
                else
                {
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                    await GetItems();
                }
            }
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchNames(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _countryProvider.GetNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchNamesEn(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _countryProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
