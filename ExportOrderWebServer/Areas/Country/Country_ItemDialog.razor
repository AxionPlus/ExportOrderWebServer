@inject ISnackbar Snackbar

@inject AuthenticationStateProvider authenticationStateProvider
@inject ICountryProvider _countryProvider

@if (Item is not null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content" ReadOnly="IsFormReadOnly" o>
        <div class="ToolBar-container">
            <MudToolBar Class="ToolBar ToolBar-new">                
                <MudSpacer />
                <div class="ToolBar-iconbutton" style="margin-right: 20px">
                    <MudTooltip Text=@(IsFormReadOnly ? "Edit" : "Save")>
                        @if (IsFormReadOnly)
                        {
                            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Edit" OnClick="EditItem_Click" />
                        }
                        else
                        {
                            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" OnClick="SaveItem_Click" />
                        }                        
                    </MudTooltip>
                </div>
            </MudToolBar>
        </div>
        <div class="Container-item">
            <div class="container-head"></div>
            <div class="container-content">
                <MudTextField T="string" Style="width: 400px" Label="Name Ru" Text="@Item.RUS"
                              TextChanged="async (e)=> { Item.RUS = e.ToUpper(); }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"
                              Required RequiredError=""
                              Clearable="!IsFormReadOnly" />

            </div>
            <div class="container-content">
                <MudTextField T="string" Style="width: 400px" Label="Name En" Text="@Item.ENG"
                              TextChanged="@(async (e)=> { Item.ENG = e.ToUpper(); })"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"
                              Required RequiredError=""
                              Clearable="!IsFormReadOnly" />

            </div>
        </div>
    </MudForm>    
}


@code {
    private MudForm? Form { get; set; }

    [CascadingParameter]
    private MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public long Id { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private CountryCatalog? Item { get; set; }
    private bool IsFormReadOnly { get; set; } = true;
    private bool IsAuth = false;


    protected override async Task OnInitializedAsync()
    {
        await GetItem();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("Top Manager") || user.User.IsInRole("Manager"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        if (IsNewItem)
        {
            IsFormReadOnly = false;
            Item = new();
        }        
        else
        {
            var response = await _countryProvider.GetItemAsync(Id);
            if (!response.HasError)
                Item = (CountryCatalog)response.Object!;
        }
    }

    public async Task SaveItem_Click()
    {
        await Form!.Validate();

        if (Form.IsValid)
        {
            if (IsNewItem)
            {
                var response = await _countryProvider.NewItemAsync(Item!);
                if (!response.HasError)
                {
                    Id = Item!.Id;
                    Snackbar.Add("Saved successfully", Severity.Success);
                }

                else
                    Snackbar.Add(response.Error.LastOrDefault(), Severity.Error);
            }
            else
            {
                var response = await _countryProvider.ModifyItemAsync(Item!);
                if (!response.HasError)
                    Snackbar.Add("Save Successed", Severity.Success);
                else
                    Snackbar.Add(response.Error.Last(), Severity.Error);
            }

            IsNewItem = false;
            IsFormReadOnly = true;

            await GetItem();
            //await InvokeAsync(StateHasChanged);

            //MudDialog!.Close();
        }        
    }

    public async Task EditItem_Click()
    {
        await Task.Delay(50);
        IsFormReadOnly = false;
    }

}
