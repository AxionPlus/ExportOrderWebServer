    private async Task NewItem_Click()
    {
        //var parameters = new DialogParameters { ["server"] = server };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, DisableBackdropClick = true };
        var dialog = await DialogService.ShowAsync<ItemCustomerComponent>("NEW CUSTOMER", options);
        var result = await dialog.Result;

        if (!result.Canceled)
            if (MudDialog is not null)
            {

                MudDialog?.Close(DialogResult.Ok(result.Data));

            }
    }


    private async Task SelectItem(CustomerCatalog entity)
    {

        if (MudDialog is not null)
        {
            MudDialog.Close(DialogResult.Ok(entity));
            return;
        }

        var parameters = new DialogParameters() { ["Item"] = entity };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, DisableBackdropClick = true };
        var dialog = await DialogService.ShowAsync<ItemCustomerComponent>($"CUSTOMER", parameters, options);
        var result = await dialog.Result;

