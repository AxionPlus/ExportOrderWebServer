@inject IDialogService DialogService

<style>

    .filters {
        display: flex;
        width: 100%;
        align-items: center;
        padding-bottom:25px;
    }

    .min-width {
        width: 960px;
    }
</style>

<div class="@(MudDialog is null ? "item-container": "item-container min-width")">

    <div class="container-head"></div>
    <div class="container-content">
        <MudButton Class="wrapper-button" Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@(async ()=>{newItemBtnDisable=true; await NewItem_Click(); await Task.Delay(1000); newItemBtnDisable=false; })">New Customer</MudButton>
    </div>

</div>

<div class="item-container">

    <div class="container-head"></div>
    <div class="container-content column ">

        <div class="filters">

            <MudTextField Class="wrapper-input" @bind-Value="filter_NAME" Label="NAME" Variant="Variant.Outlined" Clearable></MudTextField>
            <MudSpacer />
            <MudTextField Class="wrapper-input" @bind-Value="filter_EngNAME" Label="Eng NAME" Variant="Variant.Outlined" Clearable></MudTextField>

            <MudSpacer />
            <MudButton Class="wrapper-button" Variant="Variant.Filled" Color="Color.Secondary" Disabled="@searchBtnDisable"
                       OnClick="@(async ()=>{searchBtnDisable=true; await SearchItems_Click(); await Task.Delay(1000); searchBtnDisable=false; })">Search</MudButton>
        </div>
        <div class="viewDataTable">
            <MudTable Items="@Items" Loading="searchBtnDisable">
                <HeaderContent>
                    <MudTh Style="width:30px"></MudTh>
                    <MudTh >Name</MudTh>
                    <MudTh Style="width:200px">Eng name</MudTh>
                    <MudTh Style="width:200px">Country</MudTh>

                </HeaderContent>
                <RowTemplate>
                    <MudTd><MudIconButton Icon="@Icons.Material.Filled.Check" OnClick="@(()=>{SelectItem(context);})"></MudIconButton></MudTd>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="VoyageCarrier">@context.EngName</MudTd>
                    <MudTd DataLabel="Terminal">@context.Country.RUS</MudTd>

                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    bool newItemBtnDisable = false;
    bool searchBtnDisable = false;

    string? filter_Country;
    string? filter_NAME;
    string? filter_EngNAME;


    [Parameter]
    public IEnumerable<CustomerCatalog>? Items { get; set; } = new List<CustomerCatalog>();

    private async Task SearchItems_Click()
    {
  

        if (Items is null)
            return;


