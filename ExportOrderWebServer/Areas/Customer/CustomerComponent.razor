@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICustomerProvider _customerProvider
@inject ICountryProvider _countryProvider

<div class="Container-item">
    <div class="container-content">
        <MudAutocomplete Class="Autocomplete" T="string" Label="Name" Style="width: 350px" SearchFunc="@SearchNames"
                            Value="Filter.Name"
                            ValueChanged="(e)=> { Filter.Name = e; }"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            CloseIcon="" OpenIcon=""
                            ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Label="NameEng" Style="width: 350px" SearchFunc="@SearchNamesEn"
                            Value="Filter.NameEn"
                            ValueChanged="(e)=> { Filter.NameEn = e; }"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            CloseIcon="" OpenIcon=""
                            ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Label="Country" Style="width: 250px" SearchFunc="@SearchCountries"
                            Value="Filter.Country"
                            ValueChanged="(e)=> { Filter.Country = e; }"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            CloseIcon="" OpenIcon=""
                            ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData" OnClick="@GetItems"
                   Variant="Variant.Filled" Color="Color.Secondary">
            Search
        </MudButton>
    </div>
</div>

<div class="Container-table">
    <div class="tableMenu">
        <MudSpacer />
        <TablePager T="CustomerCatalog" Table="mudTable" ItemsCount="@Items?.Count()" />
    </div>
    <MudTable Class="Table" @ref="mudTable" Items="@Items" Loading="IsLoadingData" Virtualize="true" RowsPerPage="10">
        <HeaderContent>               
            <MudTh Style="width:30px">
                @if (IsSelectable)
                {
                    <MudTooltip Text="add new" Duration="1500" Delay="1000" Placement="Placement.End">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Small" OnClick="@(async () => await ShowItem_Click(null))" />
                    </MudTooltip>
                }
            </MudTh>
            <MudTh Style="width:515px"><MudTableSortLabel SortBy="new Func<CustomerCatalog, object>(x=>x.Name!)">Name Ru</MudTableSortLabel></MudTh>
            <MudTh Style="width:515px"><MudTableSortLabel SortBy="new Func<CustomerCatalog, object>(x=>x.NameEn!)">Name En</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<CountryCatalog, object>(x=>x.RUS)">Country</MudTableSortLabel></MudTh>
            <MudTh Style="width:30px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                 <MudTooltip Text="@(IsSelectable ? "select" : "show")" Duration="1500" Delay="1000" Placement="Placement.End">
                     @if (IsSelectable)
                     {
                         <MudIconButton Icon="@Icons.Material.Filled.Upload" OnClick="@(() => SelectItem_Click(context))" />
                     }
                     else
                     {
                         <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => ShowItem_Click(context.Id))" />
                     }
                 </MudTooltip>
            </MudTd>               
            <MudTd Style="text-align: start">@context.Name</MudTd>
            <MudTd Style="text-align: start">@context.NameEn</MudTd>
            <MudTd>@context.Country?.RUS</MudTd>
            <MudTd>
                @if (!IsSelectable)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Secondary"
                                   OnClick="@(async () => { await RemoveItem_Click(context.NameEn, context.Id); })" />
                }                
            </MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    [Parameter]
    public string? ApplicationUser { get; set; }
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = new();
    [Parameter]
    public bool IsSelectable { get; set; } = false;

    private MudTable<CustomerCatalog> mudTable =  new();

    private IEnumerable<CustomerCatalog> Items { get; set; } = new List<CustomerCatalog>();
    private FilterParameters Filter { get; set; } = new();

    bool IsLoadingData = false;

    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _customerProvider.GetItemsAsync(Filter);

        if (!response.HasErrors && response.Object is not null)
            Items = (IEnumerable<CustomerCatalog>)response.Object;

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);        
    }

    private async Task ShowItem_Click(long? Id)
    {
        var parameters = new DialogParameters();

        if (Id != null)
            parameters.Add("Id", Id);

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Customer_ItemDialog>(null, parameters, options);

        var result = await dialog.Result;

        if (result != null && result.Data != null && (bool)result.Data == true)
            await GetItems();
    }

    private async Task RemoveItem_Click(string? name, long id)
    {
        bool? msgResult = await DialogService.ShowMessageBox("REMOVE",
                                        (MarkupString)$"<b>Do you want to remove record?</b> <br/>Customer: {name}<br/>",
                                        yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                IsLoadingData = true;
                var response = await _customerProvider.RemoveItemAsync(id, ApplicationUser);
                IsLoadingData = false;

                if (response.HasErrors)
                    Snackbar.Add($"Unable to delete", Severity.Warning); 
                else
                {
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                    await GetItems();
                }
            }
    }

    private void SelectItem_Click(CustomerCatalog item)
    {
        MudDialog.Close(item);
    }


    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchNames(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _customerProvider.GetNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
        {
            result = result.Distinct().Order().ToList();
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        }
    }

    private async Task<IEnumerable<string>> SearchNamesEn(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _customerProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
        {
            result = result.Distinct().Order().ToList();
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        }        
    }

    private async Task<IEnumerable<string>> SearchCountries(string value, CancellationToken token)
    {      
        IEnumerable<string> result = await _countryProvider.GetNames();

        if (string.IsNullOrWhiteSpace(value))
            if (result.Any())
                return result;
            else
                return Enumerable.Empty<string>();

        return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
