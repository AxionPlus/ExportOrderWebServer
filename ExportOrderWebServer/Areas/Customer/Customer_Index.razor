@page "/customer"
@attribute [Authorize(Roles = "Admin, Top Manager, Manager")]

@inject IDialogService DialogService

<PageTitle>Customers</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">

    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">
        <ShowMainMenuButton Class="ToolBar-IconButton" ExitHref="/" />
        <MudSpacer />
        <div class="ToolBar-Title"><span>customers</span></div>
        <MudSpacer />
        <div class="ToolBar-iconbutton" style="margin-right: 20px">
            <MudTooltip Text="add new Customer">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.AddBox" OnClick="AddItem_Click" />
            </MudTooltip>
        </div>
        <div class="ToolBar-iconbutton">
            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
        </div>
        <div class="ToolBar-iconbutton">
            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
        </div>
    </MudToolBar>
    </div>

    <CustomerComponent @ref="component" />

</MudContainer>

@code {
    [CascadingParameter] public string? ApplicationUser { get; set; }
    public CustomerComponent? component;

    private async Task AddItem_Click()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync <Customer_ItemDialog>(null, parameters, options);

        var result = await dialog.Result;

        if (result != null && result.Data != null && (bool)result.Data == true)
            await component!.GetItems();
    }
}
