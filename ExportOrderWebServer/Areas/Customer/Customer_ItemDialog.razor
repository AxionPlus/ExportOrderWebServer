@inject ISnackbar Snackbar
@inject AuthenticationStateProvider authenticationStateProvider
@inject IDialogService DialogService
@inject ICountryProvider _countryProvider
@inject ICustomerProvider _customerProvider

<style>

    .TextField_Names * .mud-input > textarea.mud-input-root-outlined {
        margin:10px;
    }

</style>

@if (Item is not null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content" ReadOnly="IsFormReadOnly">
        <div class="ToolBar-container">
            <MudToolBar Class="ToolBar ToolBar-new">
                <div class="ToolBar-iconbutton" style="margin-left: 20px">
                    <MudTooltip Text="Edit terminal">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Edit" Disabled="!IsFormReadOnly" OnClick="EditItem_Click" />
                    </MudTooltip>
                </div>
                <MudSpacer />
                <div class="ToolBar-iconbutton" style="margin-right: 20px">
                    <MudTooltip Text="Save terminal">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" Disabled="IsFormReadOnly" OnClick="SaveItem_Click" />
                    </MudTooltip>
                </div>
            </MudToolBar>
        </div>
        <div class="Container-item">
            <div class="container-head"></div>
            <div class="container-content">
                <MudTextField Class="TextField_Names" T="string" Style="width: 600px" Label="Name" Text="@Item.Name"
                              TextChanged="async (e)=> { Item.Name = e.ToUpper(); }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Lines="3"
                              Required RequiredError=""
                              Clearable="!IsFormReadOnly" />
             </div>
             <div class="container-content">
                <MudTextField Class="TextField_Names" T="string" Style="width: 600px" Label="Name En" Text="@Item.NameEn"
                              TextChanged="@(async (e)=> { Item.NameEn = e.ToUpper(); })"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Lines="3"
                              Required RequiredError=""
                              Clearable="!IsFormReadOnly" />
             </div>
             <div class="container-content" style="justify-content: flex-start">
                 <MudAutocomplete T="CountryCatalog" Style="width: 300px; margin-right:20px" Label="Country" @bind-Value="Item.Country"
                                  ToStringFunc="@(e => e != null ? e.RUS : "")"
                                  SearchFunc="@SearchCountry"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"                               
                                  Required RequiredError=""
                                  CloseIcon="" OpenIcon=""
                                  ResetValueOnEmptyText="true"
                                  Placeholder="Country"
                                  MaxItems="20"
                                  IconSize="Size.Small"
                                  Clearable="!IsFormReadOnly" />
                <MudTooltip Text="Add new Country">
                    <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Small" Disabled="IsFormReadOnly" OnClick="AddCountry_Click" />
                </MudTooltip>
             </div>
         </div>
    </MudForm>
}

@code {
    private MudForm? Form { get; set; }
    [Parameter]
    public long Id { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private CustomerCatalog? Item { get; set; }
    private bool IsFormReadOnly { get; set; } = true;
    private bool IsAuth = false;


    protected override async Task OnInitializedAsync()
    {
        await GetItem();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("TopManager") || user.User.IsInRole("ExpDept"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        if (IsNewItem)
        {
            Item = new();
            IsFormReadOnly = false;
        }        
        else
        {
            var response = await _customerProvider.GetItemAsync(Id);
            if (!response.HasError)
                Item = (CustomerCatalog)response.Object!;
        }
    }

    public async Task SaveItem_Click()
    {
        await Form!.Validate();

        if (Form.IsValid)
        {
            if (IsNewItem)
            {
                var response = await _customerProvider.NewItemAsync(Item!);
                if (!response.HasError)
                {
                    Id = Item!.Id;
                    Snackbar.Add("Saved successfully", Severity.Success);
                }
                else
                    Snackbar.Add(response.Error.LastOrDefault(), Severity.Error);
            }
            else
            {
                var response = await _customerProvider.ModifyItemAsync(Item!);
                if (!response.HasError)
                {
                    await GetItem();
                    Snackbar.Add("Save Successed", Severity.Success);
                }
                else
                    Snackbar.Add(response.Error.Last(), Severity.Error);
            }

            IsNewItem = false;
            IsFormReadOnly = true;

            await GetItem();
        }
    }

    private async Task EditItem_Click()
    {
        await Task.Delay(50);
        IsFormReadOnly = false;
    }

    private async Task AddCountry_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<Country_ItemDialog>("New Country", parameters, options);

        DialogResult result = await dialog.Result;

        // if (result.Canceled)
        //     await component!.GetItems();
    }

    private async Task<IEnumerable<CountryCatalog>> SearchCountry(string value)
    {
        var Countries = new List<CountryCatalog>();

        var response = await _countryProvider.GetItemsAsync();
        if (!response.HasError)
            Countries  = ((IEnumerable<CountryCatalog>)response.Object!).OrderBy(s => s.RUS).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Countries;

        return Countries.Where(x => x.RUS.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }
}