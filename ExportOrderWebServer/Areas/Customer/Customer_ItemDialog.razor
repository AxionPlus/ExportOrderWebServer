@inject ISnackbar Snackbar
@inject AuthenticationStateProvider authenticationStateProvider
@inject IDialogService DialogService
@inject ICountryProvider _countryProvider
@inject ICustomerProvider _customerProvider

<style>

    .TextField_Names * .mud-input > textarea.mud-input-root-outlined {
        margin:10px;
    }

    .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-inline-end: 4px;
        padding-right: 4px;
    }
</style>

@if (Item is not null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content" ReadOnly="IsFormReadOnly">
        <div class="ToolBar-container">
            <MudToolBar Class="ToolBar ToolBar-new">                
                <MudSpacer />
                <div class="ToolBar-iconbutton" style="margin-right: 20px">
                    <MudTooltip Text="Save">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" Disabled="!IsFormReadOnly" OnClick="SaveItem_Click" />
                    </MudTooltip>
                </div>
            </MudToolBar>
        </div>
        <div class="Container-item">
            <div class="container-head"></div>
            <div class="container-content">
                <MudTextField Class="TextField_Names" T="string" Style="width: 600px" Label="Name" Text="@Item.Name"
                              TextChanged="async (e)=> { Item.Name = e.ToUpper(); }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Lines="6"
                              Required RequiredError=""
                              Clearable="!IsFormReadOnly" />
             </div>
             <div class="container-content">
                <MudTextField Class="TextField_Names" T="string" Style="width: 600px" Label="Name En" Text="@Item.NameEn"
                              TextChanged="@(async (e)=> { Item.NameEn = e.ToUpper(); })"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Lines="6"
                              Required RequiredError=""
                              Clearable="!IsFormReadOnly" />
             </div>
             <div class="container-content" style="justify-content: flex-start">
                 <MudAutocomplete T="CountryCatalog" Style="width: 300px; margin-right:20px" Label="Country" @bind-Value="Item.Country"
                                  ToStringFunc="@(e => e != null ? e.RUS : "")"
                                  SearchFunc="@SearchCountry"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"                               
                                  Required RequiredError=""
                                  CloseIcon="" OpenIcon="" IconSize="Size.Small"
                                  ResetValueOnEmptyText="true"
                                  Placeholder="Country"
                                  AdornmentIcon="@Icons.Material.Filled.AddCircle"
                                  AdornmentColor="Color.Primary"
                                  Adornment="Adornment.End"
                                  OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddCountry_Click(); })"
                                  Clearable="!IsFormReadOnly" />
             </div>
         </div>
    </MudForm>
}

@code {
    private string? ApplicationUser { get; set; }
    private MudForm? Form { get; set; }
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = new();

    [Parameter]
    public long Id { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private CustomerCatalog? Item { get; set; }
    private bool IsFormReadOnly { get; set; } = true;


    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        ApplicationUser = authState.User.Identity?.Name;
        await GetItem();
    }

    private async Task GetItem()
    {
        if (IsNewItem)
            Item = new();
        else
        {
            var response = await _customerProvider.GetItemAsync(Id);
            if (!response.HasErrors && response.Object is not null)
                Item = (CustomerCatalog)response.Object;
        }
    }

    public async Task SaveItem_Click()
    {
        if (Item is null || Form is null) return;

        await Form.Validate();

        if (Form.IsValid)
        {
            IsFormReadOnly = true;

            AppObjectResponse appObjectResponse = new();

            if (IsNewItem)
                appObjectResponse = await _customerProvider.NewItemAsync(Item, ApplicationUser);
            else
                appObjectResponse = await _customerProvider.ModifyItemAsync(Item, ApplicationUser);

            if (!appObjectResponse.HasErrors)
                Snackbar.Add("Save Successed", Severity.Success);
            else
                Snackbar.Add(appObjectResponse.Errors.Last(), Severity.Error);

            IsNewItem = false;
            Id = Item.Id;

            IsFormReadOnly = false;

            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private async Task AddCountry_Click()
    {
        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Country_ItemDialog>("New Country", parameters, options);
    }

    private async Task<IEnumerable<CountryCatalog>> SearchCountry(string value, CancellationToken token)
    {
        var Countries = new List<CountryCatalog>();

        var response = await _countryProvider.GetItemsAsync();
        if (!response.HasErrors)
            Countries  = ((IEnumerable<CountryCatalog>)response.Object!).OrderBy(s => s.RUS).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Countries;

        return Countries.Where(x => x.RUS.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }
}