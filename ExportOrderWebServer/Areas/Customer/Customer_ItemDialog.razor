@inject ISnackbar Snackbar
@inject AuthenticationStateProvider authenticationStateProvider
@inject IDialogService DialogService
@inject ICountryProvider _countryProvider
@inject ICustomerProvider _customerProvider

<MudForm @ref="@Form" Style="max-width:fit-content">
    <DialogToolBar ToolBarTitle="Customer" SaveButtonDisabled="IsLoadingData" SaveItem="@SaveItem_Click"
                   CloseDialog="@(() => MudDialog?.Close(DialogResult.Ok(IsDialogResultOk)))"></DialogToolBar>
    <div class="Container-item">
        <div class="container-content">
            @* <MudTextField Class="TextField" T="string" Style="width: 600px" Label="Name" Text="@Item.Name"
                          TextChanged="@((e)=> { Item.Name = ExtraSymbolReplacer.ReplaceExtraSymbols(e).ToUpper(); })"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Lines="6"
                          Placeholder="Наименование на русском"
                          Required RequiredError="" Clearable /> *@            
            <TextField Class="TextField" Style="width: 600px" Label="Name" Value="@Item.Name"
                       ValueChanged="@((e)=> { Item.Name = ExtraSymbolReplacer.ReplaceExtraSymbols(e).ToUpper(); })"
                       Lines="6"
                       Placeholder="Наименование на русском"
                       Required Clearable />
         </div>
         <div class="container-content">            
            <TextField Class="TextField" Style="width: 600px" Label="Name En" Value="@Item.NameEn"
                       ValueChanged="@((e)=> { Item.NameEn = ExtraSymbolReplacer.ReplaceExtraSymbols(e).ToUpper(); })"
                       Lines="6"
                       Placeholder="Name in english"
                       Required Clearable />
        </div>
        <div class="container-content" style="justify-content: flex-start">
            <MudAutocomplete Class="Autocomplete" T="CountryCatalog" Style="width: 300px; margin-right:20px" Label="Country" @bind-Value="Item.Country"
                             ToStringFunc="@(e => e != null ? e.RUS : "")"
                             SearchFunc="@SearchCountry"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Required RequiredError="" Clearable
                             CloseIcon="" OpenIcon="" IconSize="Size.Small"
                             ResetValueOnEmptyText="true"
                             Placeholder="Country" />

            <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Size="Size.Small" Color="Color.Primary" Disabled="@IsLoadingData" OnClick="@AddCountry_Click" />
         </div>
     </div>
</MudForm>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private string? ApplicationUser { get; set; }
    private MudForm? Form { get; set; }
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    private bool IsDialogResultOk { get; set; } = false;

    [Parameter]
    public long Id { get; set; }

    private CustomerCatalog Item { get; set; } = new();
    private bool IsLoadingData { get; set; } = false;
    private TextFieldReplaceService ExtraSymbolReplacer { get; set; } = new();

    protected override async Task OnAfterRenderAsync(bool first) //OnInitializedAsync()
    {
        if (first)
        {
            var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
            ApplicationUser = authState.User.Identity?.Name;
            await GetItem();
        }        
    }

    private async Task GetItem()
    {
        if (Id == 0) return;

        IsLoadingData = true;

        var response = await _customerProvider.GetItemAsync(Id);
        if (!response.HasErrors && response.Object is not null)
            Item = (CustomerCatalog)response.Object;

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    public async Task SaveItem_Click()
    {
        if (Item is null || Form is null) return;

        await Form.Validate();

        if (!Form.IsValid) return;

        IsLoadingData = true;

        AppObjectResponse appObjectResponse = new();

        if (Id == 0)
            appObjectResponse = await _customerProvider.NewItemAsync(Item, ApplicationUser);
        else
            appObjectResponse = await _customerProvider.ModifyItemAsync(Item, ApplicationUser);

        if (appObjectResponse.HasErrors)
            Snackbar.Add(appObjectResponse.Errors.Last(), Severity.Warning); 
        else
        {
            Id = Item.Id;
            IsDialogResultOk = true;
            Snackbar.Add("Saved Successfully", Severity.Success);
        }

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task AddCountry_Click()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Country_ItemDialog>(null, parameters, options);
    }

    private async Task<IEnumerable<CountryCatalog>> SearchCountry(string value, CancellationToken token)
    {
        IEnumerable<CountryCatalog> Countries = new List<CountryCatalog>();

        var response = await _countryProvider.GetItemsAsync();
        if (!response.HasErrors && response.Object != null)
            Countries = (IEnumerable<CountryCatalog>)response.Object;

        if (string.IsNullOrWhiteSpace(value))
            return Countries.OrderBy(s => s.RUS).ToArray(); //ToList

        return Countries.Where(x => x.RUS.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}