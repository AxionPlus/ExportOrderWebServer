@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICatalogProvider _catalogProvider
@inject ICustomsProvider _customsOfficeProvider

<div class="Container-item">
    <div class="container-content">
        <MudAutocomplete Class="Autocomplete" T="string" Label="Code" Style="width: 170px" @bind-Value="@Filter.Num" SearchFunc="@SearchCodes"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon="" ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Label="Office Name" Style="width: 250px" @bind-Value="Filter.Name" SearchFunc="@SearchNames"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon="" ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData" OnClick="@GetItems"
                   Variant="Variant.Filled" Color="Color.Secondary">
            Search
        </MudButton>
    </div>
</div>
    
<div class="Container-table">
    <div class="tableMenu">
        <MudSpacer />
        <TablePager T="CustomsCatalog" Table="mudTable" ItemsCount="@Items?.Count()" />
    </div>
    <MudTable Class="Table" @ref="mudTable" Items="@Items" T="CustomsCatalog" Loading="IsLoadingData" Virtualize="true" RowsPerPage="10">
        <HeaderContent>
            <MudTh Style="width:30px"></MudTh>            
            <MudTh Style="width:170px">
                <MudTableSortLabel SortBy="new Func<CustomsCatalog, object>(x=>x.Code!)">Код поста</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:250px">
                <MudTableSortLabel SortBy="new Func<CustomsCatalog, object>(x=>x.OfficeShort!)">Таможенный пост</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:30px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.Id); })"></MudIconButton></MudTd>            
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.OfficeShort</MudTd>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async () => { await RemoveItem_Click(context.OfficeShort, context.Id); })"></MudIconButton></MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    [Parameter]
    public string? ApplicationUser { get; set; }
    private MudTable<CustomsCatalog>? mudTable;

    private IEnumerable<CustomsCatalog> Items { get; set; } = new List<CustomsCatalog>();
    private FilterParameters Filter { get; set; } = new();

    public bool IsLoadingData { get; set; } = false;


    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _customsOfficeProvider.GetItemsAsync(Filter);
        if (!response.HasErrors && response.Object is not null)
            Items = (IEnumerable<CustomsCatalog>)response.Object;

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowItem_Click(long Id)
    {
        DialogParameters parameters = new DialogParameters { ["Id"] = Id };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<CustomsOffice_ItemDialog>(null, parameters, options);

        var result = await dialog.Result;

        if (result is not null && result.Data != null && (bool)result.Data == true)
            await GetItems();
    }

    private async Task RemoveItem_Click(string? name, long id)
    {
        bool? msgResult = await DialogService.ShowMessageBoxAsync(
            "REMOVE",
            (MarkupString)$"<b>Do you want to remove record?</b> <br/>Customs Office: {name}<br/>",
            yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                IsLoadingData = true;
                var response = await _customsOfficeProvider.RemoveItemAsync(id, ApplicationUser);
                IsLoadingData = false;

                if (response.HasErrors)
                    Snackbar.Add($"Unable to delete", Severity.Warning);
                else
                {
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                    await GetItems();
                }
            }
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchCodes(string value, CancellationToken token)
    {
        var result = await _catalogProvider.GetCustomsOfficesCodes();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchNames(string value, CancellationToken token)
    {
        var result = await _catalogProvider.GetCustomsOfficesNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
