@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICustomsProvider _customsOfficeProvider


<div class="Container-item">
    <div class="container-content">
        <MudAutocomplete Class="Autocomplete" T="string" Label="Code" Style="width: 200px" @bind-Value="@Filter.Num" SearchFunc="@SearchCodes"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            CloseIcon="" OpenIcon=""
                            ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Label="Office Name" Style="width: 500px" SearchFunc="@SearchNames"
                        Value="Filter.Name"
                        ValueChanged="(e)=> { Filter.Name = e; }"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        CloseIcon="" OpenIcon=""
                        ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData"
                Variant="Variant.Filled" Color="Color.Secondary"
                OnClick="@(async () => { await GetItems(); })">
            Search
        </MudButton>
    </div>
</div>
    
<div class="Container-table">
    @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }

    <MudTable Class="Table" @ref="mudTable" Items="@Items" T="CustomsCatalog" Loading="IsLoadingData" Virtualize="true" RowsPerPage="20">

        <HeaderContent>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:200px">
                <MudTableSortLabel SortBy="new Func<CustomsCatalog, object>(x=>x.CustomsCode!)">Код поста</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:500px">
                <MudTableSortLabel SortBy="new Func<CustomsCatalog, object>(x=>x.CustomsOffice!)">Таможенный пост</MudTableSortLabel>
            </MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.Id); })"></MudIconButton></MudTd>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async()=>{ await RemoveItem_Click(context.CustomsOffice!, context.Id); })"></MudIconButton></MudTd>
            <MudTd>@context.CustomsCode</MudTd>
            <MudTd>@context.CustomsOffice</MudTd>
            <MudTd></MudTd>
        </RowTemplate>

        <PagerContent></PagerContent>

    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudTable<CustomsCatalog>? mudTable;

    private IEnumerable<CustomsCatalog>? Items { get; set; } = new List<CustomsCatalog>();
    private FilterParameters Filter { get; set; } = new();

    [Parameter]
    public bool IsLoadingData { get; set; } = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _customsOfficeProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<CustomsCatalog>)response.Object!).ToArray();

        await Task.Delay(500);

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowItem_Click(long Id)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["Id"] = Id };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<CustomsOffice_ItemDialog>("Customs Office", parameters, options);

        DialogResult result = await dialog.Result;

        if (result.Canceled)
            await GetItems();
    }

    private async Task RemoveItem_Click(string name, long id)
    {
        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE  Record",
                          (MarkupString)$"<b>Do you want to remove record?</b> <br/>Customs Office:<br/>{name}<br/>",
                          yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _customsOfficeProvider.RemoveItemAsync(id);

                if (!response.HasError)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);
            }

        await GetItems();
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchCodes(string value)
    {
        var result = await _customsOfficeProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchNames(string value)
    {
        var result = await _customsOfficeProvider.GetNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
