@inject ISnackbar Snackbar
@inject AuthenticationStateProvider authenticationStateProvider
@inject ICustomsProvider _customsProvider

<MudForm @ref="@Form" Style="max-width:fit-content">
    <DialogToolBar ToolBarTitle="Customs Office" SaveButtonDisabled="IsLoadingData" SaveItem="@SaveItem_Click"
                   CloseDialog="@(() => MudDialog?.Close(DialogResult.Ok(IsDialogResultOk)))"></DialogToolBar>        
    <div class="Container-item">
        <div class="container-content">
            <MudTextField Class="TextField" T="string" Style="width: 150px" Label="Код" @bind-Value="@Item.Code"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Required RequiredError="" Clearable />
         </div>
         <div class="container-content">
            <MudTextField Class="TextField" T="string" Style="width: 250px" Label="пост (кратко)" Value="@Item.OfficeShort"
                          ValueChanged="@(async (e)=> { Item.OfficeShort = e.ToUpper(); })"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Required RequiredError="" Clearable />
         </div>
         <div class="container-content">
            <MudTextField Class="TextField" T="string" Style="width: 500px" Label="Таможенный пост" Value="@Item.Office"
                          ValueChanged="@(async (e)=> { Item.Office = e.ToUpper(); })"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Required RequiredError="" Clearable />
         </div>
         <div class="container-content">
            <MudTextField Class="TextField" T="string" Style="width: 500px" Label="Таможенный орган" Value="@Item.Dapartment"
                          ValueChanged="@(async (e)=> { Item.Dapartment = e.ToUpper(); })"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Required RequiredError="" Clearable />
         </div>
         <div class="container-content">
            <MudTextField Class="TextField" T="string" Style="width: 500px;" @bind-Value="@Item!.Email"
                          Label="e-mail для отправки xml файла" Placeholder="mail@mail.ru"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Required RequiredError="" Clearable />
         </div>
    </div>
</MudForm>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private string? ApplicationUser { get; set; }
    private MudForm? Form { get; set; }
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    private bool IsDialogResultOk { get; set; } = false;

    [Parameter]
    public long Id { get; set; }    

    private CustomsCatalog Item { get; set; } = new();
    private bool IsLoadingData { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool first)    //OnInitializedAsync
    {
        if (first)
        {
            var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
            ApplicationUser = authState.User.Identity?.Name;
            await GetItem();
        }
    }

    private async Task GetItem()
    {
        if (Id == 0) return;

        IsLoadingData = true;

        var response = await _customsProvider.GetItemAsync(Id);
        if (!response.HasErrors && response.Object is not null)
            Item = (CustomsCatalog)response.Object;

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);        
    }

    public async Task SaveItem_Click()
    {
        if (Item is null || Form is null) return;

        await Form.Validate();

        if (Form.IsValid)
        {
            IsLoadingData = true;

            AppObjectResponse appObjectResponse = new();

            if (Id == 0)
                appObjectResponse = await _customsProvider.NewItemAsync(Item, ApplicationUser);
            else
                appObjectResponse = await _customsProvider.ModifyItemAsync(Item, ApplicationUser);

            if (appObjectResponse.HasErrors)
                Snackbar.Add($"No Success!. {appObjectResponse.Errors.Last()}", Severity.Warning);
            else
            {
                Id = Item.Id;
                IsDialogResultOk = true;
                Snackbar.Add("Saved Successfully", Severity.Success);
            }                

            IsLoadingData = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
