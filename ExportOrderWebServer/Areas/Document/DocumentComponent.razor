    private async Task NewItem_Click()
    {
        //await Task.Delay(1000);
        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { FullScreen = true, NoHeader = true, DisableBackdropClick = false };
        IDialogReference dialog = await DialogService.ShowAsync<DocumentItem_Dialog>(null, parameters, options);
        DialogResult result = await dialog.Result;

        // if (!result.Canceled)
        //     await SearchItems_Click();

    }

    private async Task ShowItem_Click(long id)
    {
        if (MudDialog is not null)
            MudDialog.Close(DialogResult.Ok(id));

        var parameters = new DialogParameters { ["Id"] = id };
        var options = new DialogOptions { FullScreen = true, NoHeader = true, DisableBackdropClick = false };
        var dialog = await DialogService.ShowAsync<DocumentItem_Dialog>(null, parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await SearchItems_Click();
    }
}
