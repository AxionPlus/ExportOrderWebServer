@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime jSRuntime
@inject IDocumentProvider _documentProvider

<style>

    .Table.MultiSelection * table tr > th:first-child {
        width: 30px;
    }

</style>

<div class="Container-item">
        <div class="container-content">
            <MudAutocomplete Class="Autocomplete" T="string" Style="width: 270px" Value="Filter.Document" SearchFunc="@SearchDocument"                             
                             ValueChanged="(e)=> { Filter.Document = e; }"
                             Placeholder="Декларация"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             CloseIcon="" OpenIcon=""
                             Dense = "true" AutoFocus="true"
                             MinCharacters="4"
                             ResetValueOnEmptyText="true" Clearable />
            <MudSpacer />
            <MudTextField Class="TextField" Placeholder="Shipper" Style="width: 300px" @bind-Value="@Filter.Shipper"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
            <MudSpacer />
            <MudTextField Class="TextField" Placeholder="Consignee" Style="width: 300px" @bind-Value="@Filter.Consignee"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
            <MudSpacer />
            <MudTextField Class="TextField" Placeholder="Cargo" Style="width: 270px" @bind-Value="@Filter.CargoDescriptionShort"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
            <MudSpacer />
            <MudButton Class="Button" Style="width: 80px" OnClick="@(async () => { await GetItems(); })"
                        Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary">
                 Search
            </MudButton>
        </div>
    </div>

<div class="Container-table">
    @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }
    <MudTable Class="Table MultiSelection" @ref="mudTable" Items="@Items" @bind-SelectedItems="SelectedItems"
              MultiSelection="IsSelectable" Loading="IsLoadingData" Virtualize="true" RowsPerPage="10">
        <HeaderContent>
            @if (!IsSelectable)
            {
                <MudTh Style="width:30px"></MudTh>
            }                
            <MudTh Style="width:30px">
                @if (IsSelectable)
                {
                    <MudTooltip Text="upload selected">
                        <MudIconButton Icon="@Icons.Material.Filled.Upload" Color="Color.Primary" OnClick="@(async()=>{ await TakeItem_Click(); })" />
                    </MudTooltip>
                }
            </MudTh>
            <MudTh Style="width:50px">Type</MudTh>
            <MudTh Style="width:100px">
                <MudTableSortLabel SortBy="new Func<DocumentEntity, object>(x=>x.Name!)">Name</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DocumentEntity, object>(x=>x.Shipper!.Name!)">Shipper</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DocumentEntity, object>(x=>x.Consignee!.Name!)">Consignee</MudTableSortLabel>
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (!IsSelectable)
            {
                <MudTd><MudIconButton Icon="@Icons.Material.Outlined.Edit" OnClick="@(async()=>{ await OpenItem_Click(context.Id); })" /></MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(async()=>{ await RemoveItem_Click(context.Name!, context.Id); })" /></MudTd>
            }
            else
            {
                <MudTd></MudTd>                
            }            
            <MudTd>@context.Type.ToString()</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd Style="text-align: start">@context.Shipper!.Name</MudTd>
            <MudTd Style="text-align: start">@context.Consignee!.Name</MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudTable<DocumentEntity>? mudTable;

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public bool IsSelectable { get; set; } = false;

    public IEnumerable<DocumentEntity>? Items { get; set; } = new List<DocumentEntity>();
    private HashSet<DocumentEntity> SelectedItems = new HashSet<DocumentEntity>();
    private FilterParameters Filter { get; set; } = new();
    bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    public async Task GetItems()
    {        
        IsLoadingData = true;

        var response = await _documentProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<DocumentEntity>)response.Object!).OrderBy(d => d.Name).ToArray();

        await Task.Delay(500);

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveItem_Click(string name, long id)
    {
        // if (item is not null)
        //     Items?.Remove(item);

        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE  Record",
                          (MarkupString)$"<b>Do you want to remove record?</b> <br/>Declaration:<br/>{name}<br/>",
                          yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _documentProvider.RemoveItemAsync(id);

                if (!response.HasError)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);
            }

        await GetItems();
    }

    // private async Task ShowItem_Click(long id)
    // {
    //     // if (MudDialog is not null)
    //     //     MudDialog.Close(DialogResult.Ok(id));

    //     var parameters = new DialogParameters { ["Id"] = id };
    //     var options = new DialogOptions { FullScreen = true, NoHeader = true, DisableBackdropClick = false };
    //     var dialog = await DialogService.ShowAsync<Document_ItemDialog>(string.Empty, parameters, options);
    //     var result = await dialog.Result;

    //     if (!result.Canceled)
    //         await GetItems();
    // }

    private async Task OpenItem_Click(long id)
    {
        var result = await ValueTask.FromResult(jSRuntime.InvokeVoidAsync("open", $"{Navigation.BaseUri}document?Id={id}", "_blank"));

        // if (result.IsCompletedSuccessfully)
        //     await GetItems();
    }

    private async Task TakeItem_Click()
    {
        if (SelectedItems.Count == 0)
        {
            Snackbar.Add($"Nothing was selected. Try again or exit without a selection.", Severity.Warning);
            return;
        }        

        await Task.Delay(50);

        if (MudDialog != null)
            MudDialog!.Close(SelectedItems);
        else
            await jSRuntime.InvokeVoidAsync("window.close", SelectedItems);
    }

    #region SEARCHERS

    private async Task<IEnumerable<string>> SearchDocument(string value)
    {
        var result = await _documentProvider.GetNames();

        // if (result.Count() == 0)
        //     return Enumerable.Empty<string>();

        // if (string.IsNullOrWhiteSpace(value))
        //     return result;
        
        // return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).Distinct().Order().ToList();


        if (string.IsNullOrWhiteSpace(value))
            return result;

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).Distinct().Order().ToList();
    }

    #endregion

}
