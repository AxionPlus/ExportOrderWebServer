@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IDocumentProvider _documentProvider

<style>

    .Table.MultiSelection * table tr > th:first-child {
        width: 30px;
    }

</style>

<MudForm @ref="@FilterForm">

    <div class="Container-item">
        <div class="container-content">
            <MudTextField Class="TextField" Placeholder="Document" Style="width: 270px" @bind-Value="@Filter.Document"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
            <MudSpacer />
            <MudTextField Class="TextField" Placeholder="Shipper" Style="width: 300px" @bind-Value="@Filter.Shipper"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
            <MudSpacer />
            <MudTextField Class="TextField" Placeholder="Consignee" Style="width: 300px" @bind-Value="@Filter.Consignee"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
            <MudSpacer />
            <MudTextField Class="TextField" Placeholder="Cargo" Style="width: 270px" @bind-Value="@Filter.CargoDescriptionShort"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
            <MudSpacer />
            <MudButton Class="Button" Style="width: 80px" OnClick="@(async () => { await GetItems(); })"
                        Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary">
                 Search
            </MudButton>
        </div>
    </div>

    <div class="Container-table">
    @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }
    <MudTable Class="Table MultiSelection" @ref="mudTable" T="DocumentEntity" Items="@Items" @bind-SelectedItems="SelectedItems"
              MultiSelection="IsSelectable" Loading="IsLoadingData" Virtualize="true" RowsPerPage="20">

        <HeaderContent>
            @if (!IsSelectable)
            {
                <MudTh Style="width:30px"></MudTh>
            }                
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:50px">Type</MudTh>
            <MudTh Style="width:100px">Name</MudTh>
            <MudTh>Shipper</MudTh>
            <MudTh>Consignee</MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (!IsSelectable)
            {
                <MudTd><MudIconButton Icon="@Icons.Material.Outlined.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.Id); })" /></MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(async()=>{ await RemoveItem_Click(context); })" /></MudTd>
            }
            else
            {
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.AddCircle" OnClick="@(async()=>{ await SendItems_Click(); })" /></MudTd>
            }            
            <MudTd>@context.Type.ToString()</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Shipper!.Name</MudTd>
            <MudTd>@context.Consignee!.Name</MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

</MudForm>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudForm? FilterForm;
    private MudTable<DocumentEntity>? mudTable;

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    
    [Parameter] // ???
    public IEnumerable<DocumentEntity>? Items { get; set; } = new List<DocumentEntity>();
    [Parameter]
    public bool IsSelectable { get; set; } = false;
    private HashSet<DocumentEntity> SelectedItems = new HashSet<DocumentEntity>();


    private FilterParameters Filter { get; set; } = new();
    bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    public async Task GetItems()
    {        
        IsLoadingData = true;

        var response = await _documentProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<DocumentEntity>)response.Object!).ToArray();

        await Task.Delay(500);

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);        
    }

    private async Task RemoveItem_Click(DocumentEntity item)
    {
        // if (item is not null)
        //     Items?.Remove(item);

        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE  Record",
                          (MarkupString)$"<b>Do you want to remove record?</b> <br/>Declaration:<br/>{item.Name}<br/>",
                          yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _documentProvider.RemoveItemAsync(item);

                if (!response.HasError)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);
            }

        await GetItems();
    }

    private async Task ShowItem_Click(long id)
    {
        if (MudDialog is not null)
            MudDialog.Close(DialogResult.Ok(id));

        var parameters = new DialogParameters { ["Id"] = id, ["IsNewItem"] = false };
        var options = new DialogOptions { FullScreen = true, NoHeader = true, DisableBackdropClick = false };
        var dialog = await DialogService.ShowAsync<Document_ItemDialog>(null, parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await GetItems();
    }

    private async Task SendItems_Click()
    {
        await Task.Delay(50);
        MudDialog!.Close(SelectedItems);
    }
}
