@inject ISnackbar Snackbar
@inject IJSRuntime jSRuntime
@inject IDialogService DialogService
@inject IDocumentProvider _DocumentProvider
@inject IExportOrderProvider _ExportOrderProvider

<style>

    .Table.MultiSelection * table tr > th:first-child {
    width: 30px;
    }

    .wrapper-input * .mud-input > input.mud-input-root-outlined.mud-input-root-adorned-end {
    padding-inline-start: 4px;
    }

    .mud-input-control.mud-input-control-margin-dense {
    margin: unset;
    }

    .mud-input > input.mud-input-root-outlined.mud-input-root-margin-dense {
    padding: 8px;
    }

    .mud-input-control.mud-input-control-margin-dense.mud-input-outlined-with-label {
    margin-top: unset;
    margin-bottom: unset;
    }

    .mud-select.mud-autocomplete * .mud-input.mud-input-outlined.mud-input-adorned-end {
    padding-inline-end: 6px;
    padding-inline-start: unset;
    }
</style>

<div class="Container-item">
    <div class="container-content">
        <MudButton Class="Button" Style="width: 80px" OnClick="@(async () => { await GetItems(); })"
                   Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary">
            Search
        </MudButton>            
        <MudAutocomplete Class="Autocomplete" T="string" Style="width: 270px" @bind-Value="Filter.Document" SearchFunc="@SearchDocument"
                         Label="Декларация"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon=""
                         AutoFocus="true"
                         MinCharacters="3" MaxItems="20"
                         ResetValueOnEmptyText="true" Clearable />            
        <MudTextField Class="TextField" Label="Shipper" Style="width: 300px" @bind-Value="@Filter.Shipper"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />            
        <MudTextField Class="TextField" Label="Consignee" Style="width: 300px" @bind-Value="@Filter.Consignee"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />            
        <MudTextField Class="TextField" Label="Cargo" Style="width: 270px" @bind-Value="@Filter.CargoDescriptionShort"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
        <MudSelect Class="wrapper-input-select" T="EntityStatus?" Label="Status" @bind-Value="Filter.Status"
                   Style="width:145px"
                   ToStringFunc="@(s => s == null ? string.Empty : s.ToString())"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable
                   Disabled="IsSelectable">
            @foreach (EntityStatus? status in Enum.GetValues(typeof(EntityStatus)))
            {
                if (status == EntityStatus.New || status == EntityStatus.Completed)
                {
                    <MudSelectItem Value="@status" />
                }
            }
        </MudSelect>            
    </div>
</div>

<div class="Container-table">    
    <div class="tableMenu">
        <MudSpacer />
        <TablePager T="DocumentEntity" Table="mudTable" ItemsCount="@Items?.Count()" />
    </div>
    <MudTable Class="Table MultiSelection" @ref="mudTable" Items="@Items" @bind-SelectedItems="SelectedItems"
              MultiSelection="IsSelectable" SelectOnRowClick="false" Virtualize="true" Loading="IsLoadingData" RowsPerPage="10">
        <HeaderContent>
            @if (!IsSelectable)
            {
                <MudTh Style="width:30px"></MudTh>
            }                
            <MudTh Style="width:30px">
                @if (IsSelectable)
                {
                    <MudTooltip Text="upload selected">
                        <MudIconButton Icon="@Icons.Material.Filled.Upload" Color="Color.Primary" OnClick="@(SelectItems_Click)" />
                    </MudTooltip>
                }
            </MudTh>
            <MudTh Style="width:50px">Type</MudTh>
            <MudTh Style="width:230px">
                <MudTableSortLabel SortBy="new Func<DocumentEntity, object>(x=>x.Name!)">Name</MudTableSortLabel>
            </MudTh>
            <MudTh Style="text-align:start">
                <MudTableSortLabel SortBy="new Func<DocumentEntity, object>(x=>x.Shipper!.Name!)">Shipper</MudTableSortLabel>
            </MudTh>
            <MudTh Style="text-align:start">
                <MudTableSortLabel SortBy="new Func<DocumentEntity, object>(x=>x.Consignee!.Name!)">Consignee</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:80px">Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (!IsSelectable)
            {
                <MudTd><MudIconButton Icon="@Icons.Material.Outlined.Edit" OnClick="@(async () => await OpenItem_Click(context.Id))" /></MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(async () => await RemoveItem_Click(context.Name, context.Id))" /></MudTd>
            }
            else
            {
                <MudTd></MudTd>                
            }            
            <MudTd>@context.Type.ToString()</MudTd>
            <MudTd>
                <MudLink OnClick="@(()=> ShowExportOrderNums_Click(context.Name))">@context.Name</MudLink>
                <PopoverExpOrderList DocumentName="@context.Name" IsPopoverOpen="@IsPopoverOpen" ExportOrderNums="@ExportOrderNums"
                                     ExportOrdersTotalNetWt="@ExportOrdersTotalNetWt" ExportOrdersTotalGrossWt="@ExportOrdersTotalGrossWt"
                                     CloseButton_Click="@(()=> IsPopoverOpen = false)" />
            </MudTd>
            <MudTd Style="text-align: start">@(context.Shipper == null ? "---" : context.Shipper.Name)</MudTd>
            <MudTd Style="text-align: start">@(context.Consignee == null ? "---" : context.Consignee.Name)</MudTd>
            <MudTd>@context.Status.ToString()</MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudTable<DocumentEntity>? mudTable;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public bool IsSelectable { get; set; } = false;    
    private bool IsLoadingData = false;
    private bool IsPopoverOpen { get; set; } = false;

    public IEnumerable<DocumentEntity>? Items { get; set; } = new List<DocumentEntity>();
    private HashSet<DocumentEntity> SelectedItems = new();
    private FilterParameters Filter { get; set; } = new();    
    private IEnumerable<string> ExportOrderNums { get; set; } = new List<string>();
    private string? ExportOrdersTotalNetWt { get; set; } = null;
    private string? ExportOrdersTotalGrossWt { get; set; } = null;


    public async Task GetItems()
    {        
        if (string.IsNullOrEmpty(Filter.Document) & 
            string.IsNullOrEmpty(Filter.Shipper) &
            string.IsNullOrEmpty(Filter.Consignee) &
            string.IsNullOrEmpty(Filter.CargoDescriptionShort) &
            Filter.Status.Equals(null))
        {
            Snackbar.Add("One of the search fields should be used.", Severity.Warning);
            return;
        }

        IsLoadingData = true;

        if (IsSelectable) Filter.Status = EntityStatus.New;

        var response = await _DocumentProvider.GetItemsAsync(Filter);

        if (!response.HasErrors && response.Object is not null)
            Items = (IEnumerable<DocumentEntity>)response.Object;
        else
            Snackbar.Add(response.Errors.First(), Severity.Warning);

        IsLoadingData = false;

        StateHasChanged();
    }

    private async Task RemoveItem_Click(string? name, long id)
    {
        if (string.IsNullOrWhiteSpace(name) || id == 0) return;

        bool? msgResult = await DialogService.ShowMessageBox("REMOVE  Record",                          
                                                (MarkupString)$"<b>Do you want to remove record?</b> <br/>Declaration:<br/>{name}<br/>",
                                                yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _DocumentProvider.RemoveItemAsync(id);

                if (!response.HasErrors)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);

                await GetItems();
            }
    }

    private async Task OpenItem_Click(long id)
    {
        //var result = await ValueTask.FromResult(jSRuntime.InvokeVoidAsync("open", $"{Navigation.BaseUri}document?Id={id}", "_blank"));
        
        await jSRuntime.InvokeVoidAsync("window.open", $"{ApplicationParameter.OpenPageUrl}document?Id={id}");
        
        // var parameters = new DialogParameters { ["Id"] = id };
        // var options = new DialogOptions { FullScreen = true, NoHeader = true, BackdropClick = false };
        // var dialog = await DialogService.ShowAsync<Document_Item>("Document", parameters, options);
    }

    private async void SelectItems_Click()
    {
        if (!SelectedItems.Any())
        {
            Snackbar.Add($"Nothing was selected. Try again or exit without a selection.", Severity.Warning);
            return;
        }

        long[] ids = SelectedItems.Select(s => s.Id).ToArray();

        var documents = await _DocumentProvider.GetItemsAsync(ids);

        if (MudDialog != null)
            MudDialog.Close(documents);
        // else
        //     await jSRuntime.InvokeVoidAsync("window.close", documents);
    }

    #region SEARCHERS

    private async void ShowExportOrderNums_Click(string? docName)
    {
        if (!string.IsNullOrWhiteSpace(docName))
        {
            IsPopoverOpen = !IsPopoverOpen;

            if (IsPopoverOpen)
            {
                var exportOrders = await _ExportOrderProvider.GetDocumentExportOrderNums(docName);
                double[] totals = await _ExportOrderProvider.GetDocumentExportOrderTotalWeights(docName);

                if (exportOrders != Enumerable.Empty<string>())
                {
                    ExportOrderNums = exportOrders;
                    ExportOrdersTotalNetWt = totals[0].ToString("### ### ###.###");
                    ExportOrdersTotalGrossWt = totals[1].ToString("### ### ###.###");
                }

                IsPopoverOpen = false;
                await InvokeAsync(StateHasChanged);
            }
            else
                ExportOrderNums = Enumerable.Empty<string>();
        }
    }

    private async Task<IEnumerable<string>> SearchDocument(string value, CancellationToken token)
    {
        var result = await _DocumentProvider.GetDocumentNames(IsSelectable);

        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        return result.Distinct().Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToArray();        
    }

    #endregion
}
