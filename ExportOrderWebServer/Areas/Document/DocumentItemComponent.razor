@using ExportOrderWebServer.Areas.Commodity;
@using ExportOrderWebServer.Areas.Customer;
@inject IDialogService DialogService;

<style>

    .ItemType {
        width: 77px;
    }

    .ItemName {
        padding-inline: 2px;
        width: 260px;
    }

    .ItemDiscription {
        padding-inline: 2px;
    }

    .ItemContarctNo {
        padding-inline: 2px;
        width: 200px;
    }

    .wrapper-input.Dense * .mud-input > input.mud-input-root-outlined {
        padding: 5px 2px 1px 2px;
    }

    .GoodMeasures {
        display: flex;
        padding-top: 3px;
        padding-bottom: 8px;
        justify-content: flex-start;
        align-items: center;
    }

    h6 {
        margin: auto;
    }

    .splitRow {
        border-bottom: 1px solid red;
    }

    .totalFooter {
        display: flex;
        width: 100%;
        justify-content: space-between;
        align-items: center;
    }



    .HScode * .mud-input-adornment .mud-icon-button-edge-end {
        margin-inline-end: -4px !important;
    }

    .HScode * .mud-input-adornment-end {
        margin-inline-start: 0px;
    }

</style>

@if (Item is not null)
{
    <MudContainer>
        <MudForm @ref="form">
            <div class="d-flex">
                <div class="ItemType">
                    <MudSelect Class="wrapper-input " T="DocumentType" Label="Type"
                    @bind-Value="@Item.Type" ToStringFunc="@(str=>str.ToString())"
                               Variant="Variant.Outlined">
                        @foreach (DocumentType type in Enum.GetValues(typeof(DocumentType)))
                        {
                            <MudSelectItem Value="@type" />
                        }
                    </MudSelect>
                </div>
                <div class="ItemName">
                    <MudTextField Class="wrapper-input "
                    @bind-Value="Item.Name"
                                  Mask="MaskDocumentName"
                                  Label="Name"
                                  Variant="Variant.Outlined"
                                  Disabled="@(!IsNewItem)"
                                            Required RequiredError=""
                                            Clearable></MudTextField>
                 </div>

                 <MudTextField Class="wrapper-input ItemDiscription"
                 @bind-Value="Item.Description"
                               Label="Description"
                               Variant="Variant.Outlined"
                                    Required RequiredError=""
                                    Clearable></MudTextField>

                 <div class="ItemContarctNo">
                     <MudTextField Class="wrapper-input "
                     @bind-Value="Item.ContarctNo"
                                   Label="Contarct No"
                                   Variant="Variant.Outlined"
                                            Required RequiredError=""
                                            Clearable></MudTextField>
                 </div>
             </div>

             <CustomerPartyComponent Class="wrapper-input pt-2" Label="Shipper" @bind-Value="@Item.Shipper" />
             <CustomerPartyComponent Class="wrapper-input pt-2" Label="Consignee" @bind-Value="@Item.Consignee" />
             
         </MudForm>
         <br />
         <div class="viewDataTable">
             <MudForm Class="h-100" @ref="form">
                 <MudTable Items="@Item.Records" Hover="false"
                           FixedHeader="true"
                           Height="565px">
                     <HeaderContent>
                         <MudTh Style="width:40px;">
                             <div class="controlIconButtons">
                                 <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddRecord_Click" Size="Size.Small"></MudIconButton>
                             </div>
                         </MudTh>
                         <MudTh Style="width:40px;">SEQ</MudTh>
                         <MudTh Style="width:130px;">HS CODE</MudTh>
                         <MudTh>COMMODITY NAME</MudTh>
                         <MudTh Style="width:200px;">ENGLISH  </MudTh>
                         <MudTh Style="width:40px;"></MudTh>
                     </HeaderContent>
                     <RowTemplate>
                         <MudTd>
                             <MudTh>
                                 <div class="controlIconButtons">
                                     <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                    OnClick="@(async ()=>{ await RemoveRecord(context);})"
                                                    Color="Color.Error"
                                                    Size="Size.Small"></MudIconButton>
                                 </div>
                             </MudTh>
                         </MudTd>
                         <MudTd>
                             <h6>
                                 @context.Seq.ToString("000")
                             </h6>
                         </MudTd>
                         <MudTd>
                             <div class="wrapper-input Dense EventType HScode">
                                 <MudTextField @bind-Value="@context.CommodityHSCode"
                                               Mask="@(new PatternMask("0000000000"))"
                                               MaxLength="10" Variant="Variant.Outlined"
                                               AdornmentIcon="@Icons.Material.Filled.Search"
                                               AdornmentColor="Color.Secondary"
                                               Adornment="Adornment.End"
                                               OnAdornmentClick="@( async ()=>{
                                                        getCommodityBtn_Disable = true;
                                                        await GetCommodity_Click(context);

                                                          await Task.Delay(1000);
                                                           getCommodityBtn_Disable = false;
                                                        })"
                                               Disabled="getCommodityBtn_Disable"
                                                            Required RequiredError="" />
                             </div>
                         </MudTd>
                         <MudTd>
                             <div class="wrapper-input Dense EventType">
                                 <MudTextField T="string" Immediate
                                               Value="@context.CommodityName"
                                               ValueChanged="@((e)=>{context.CommodityName =e.ToUpper();})"
                                               Lines=2 Variant="Variant.Outlined" Required RequiredError=""></MudTextField>
                             </div>
                         </MudTd>
                         <MudTd>
                             <div class="wrapper-input Dense EventType">
                                 <MudTextField T="string" Immediate
                                               Value="@context.CommodityEngName"
                                               ValueChanged="@((e)=>{context.CommodityEngName =e.ToUpper();})"
                                               Lines=2 Variant="Variant.Outlined" Required RequiredError=""></MudTextField>
                             </div>
                         </MudTd>

                         <MudTd>
                             <div class="controlIconButtons">

                                 <div class="wrapper-checkBox">
                                     <MudCheckBox @bind-Checked="@context.IsShowWT_Details"></MudCheckBox>
                                 </div>
                             </div>
                         </MudTd>

                     </RowTemplate>
                     <ChildRowContent>
                         <MudTr Class=@(!context.IsShowWT_Details ? "d-none" : "splitRow")>
                             <td />
                             <td colspan="4">
                                 <div class="GoodMeasures">
                                     <div class="d-flex">
                                         <h6>Net Wt</h6>
                                         <MudNumericField Class="wrapper-input NoHeader pl-2" @bind-Value="@context.NetWt"
                                                          HideSpinButtons="true" MaxLength="10"
                                                          Format="N3" Variant="Variant.Outlined" />
                                     </div>
                                     <div class="d-flex pl-4">
                                         <h6>Gross Wt</h6>
                                         <MudNumericField Class="wrapper-input NoHeader pl-2"
                                         @bind-Value="@context.GrossWt"
                                                          HideSpinButtons="true"
                                                          Format="N3" Variant="Variant.Outlined" MaxLength="10" />

                                     </div>
                                     <div class="d-flex pl-4">
                                         <h6>Volume</h6>
                                         <MudNumericField Class="wrapper-input NoHeader pl-2"
                                                          HideSpinButtons="true"
                                         @bind-Value="@context.Volume"
                                                          Variant="Variant.Outlined" MaxLength="10" />
                                     </div>
                                 </div>
                             </td>
                         </MudTr>
                     </ChildRowContent>
                 </MudTable>
             </MudForm>
         </div>

         <div class="totalFooter pt-3">
             <div>
                 <h6>Total commodity records: @Item.Records!.Count().ToString("000")</h6>
             </div>
             <MudButton Class="wrapper-button " Variant="Variant.Filled" Color="Color.Secondary"
                        OnClick="@(async() => { await AddItem_Click(); })">
                 Add
             </MudButton>
         </div>
     </MudContainer>
    <br />
}
@code {
    MudForm? form;
    private bool addBtnDisable = false;
    private bool getCommodityBtn_Disable = false;

    [Parameter]
    public bool IsNewItem { get; set; } = true;
    [Parameter]
    public DocumentEntity? Item { get; set; }
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Item is null)
            Item = new() { Records = new List<DocumentRecord>() { new() { Seq = 1 } } };
    }

    private async Task AddItem_Click()
    {
        await form!.Validate();
        if (form.IsValid)
        {
            addBtnDisable = false;

            //.....

            await Task.Delay(1000);
            addBtnDisable = true;
        }
    }

    private async Task<IEnumerable<string>> ShipperSearch(string value, CancellationToken token)
    {
        //var result = await HttpClient.GetFromJsonAsync<IEnumerable<string>>($"webapi/AmericanStates/searchWithDelay/{value ?? string.Empty}", token);
        return null!;

    }
    private async Task<IEnumerable<string>> ConsigneeSearch(string value, CancellationToken token)
    {
        // var result = await HttpClient.GetFromJsonAsync<IEnumerable<string>>($"webapi/AmericanStates/searchWithDelay/{value ?? string.Empty}", token);
        return null!;
    }

    private async Task SelectCutomer_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["SelectedItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Large, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<CustomerComponent>("Customer", parameters, options);

        DialogResult result = await dialog.Result;
    }


    private async Task GetCommodity_Click(DocumentRecord documentRecord)
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, DisableBackdropClick = true };
        var dialog = await DialogService.ShowAsync<CommodityComponent>("SELECT COMMODITY", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var commodity = (CommodityCatalog)result.Data;

            documentRecord.CommodityName = commodity.Name;
            documentRecord.CommodityEngName = commodity.EngName;
            documentRecord.CommodityHSCode = commodity.HSCode;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void AddRecord_Click()
    {
        Item!.Records!.Add(new() { Seq = Item!.Records.Count() + 1 });
    }

    private async Task RemoveRecord(DocumentRecord record)
    {
        if (record is null)
            return;


        bool? result = await DialogService.ShowMessageBox(
                 "Delete record",
                 (MarkupString)$"<b>Do you want to remove record No {record.Seq.ToString("000")}?<b>",
                 yesText: "REMOVE", cancelText: "NO");


        if (!result.HasValue) return;

        if (result.Value)
        {
            Item!.Records!.Remove(record);

            var seq = 1;
            foreach (var _record in Item!.Records!)
                _record.Seq = seq++;
        }



        await InvokeAsync(StateHasChanged);
    }

    #region PatternMask

    public PatternMask MaskDocumentName = new PatternMask("########/d#m###/#######")
        {
            MaskChars = new[] {
                  new MaskChar('#', @"[0-9]"),
                  new MaskChar('d', @"[0-3]") ,
                  new MaskChar('m', @"[0-1]") ,
            }
        };
    public PatternMask MaskWt = new PatternMask("# ### ###,###")
        {
            MaskChars = new[] { new MaskChar('#', @"[0-9]") }
        };
    public PatternMask MaskVlm = new PatternMask("##,##")
        {
            MaskChars = new[] { new MaskChar('#', @"[0-9]") }
        };


    //public IMask mask = new RegexMask(@"^[0-9]\d{0,5} ',' [0-9]\d{0,2}$");

    IMask mask = new BlockMask(delimiters: ",", new Block('0', 1, 9), new Block('0', 1, 4));
    #endregion

}
