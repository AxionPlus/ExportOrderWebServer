@page "/documents"
@attribute [Authorize(Roles = "Admin, Top Manager, Manager")]

@inject IJSRuntime jsRuntime
@inject IDialogService DialogService

<PageTitle>Documents</PageTitle>

<div class="ToolBar-container">
    <MudToolBar Class="ToolBar ToolBar-new">
        @if (MudDialog is null)
        {
            <ShowMainMenuButton Class="ToolBar-IconButton" ExitHref="/" />
        }
        else
        {
            <div class="ToolBar-iconbutton">
                <MudTooltip Text="EXIT">
                    <MudIconButton Class="ToolBar-IconButton" Style="transform: rotate(180deg)" Icon="@Icons.Material.Outlined.ExitToApp" OnClick="()=>MudDialog.Cancel()" />
                </MudTooltip>
            </div>
        }        
        <MudSpacer />
        <div class="ToolBar-Title"><span>documents</span></div>
        <MudSpacer />
        <div class="ToolBar-iconbutton" style="margin-right: 20px">
            <MudTooltip Text="add a new Document" Delay="1000" Duration="1500">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.AddBox" OnClick="OpenNewItem_Click" />
            </MudTooltip>        
        </div>        
        <div class="ToolBar-iconbutton">
            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
        </div>
        <div class="ToolBar-iconbutton">
            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
        </div>
    </MudToolBar>
</div>

<DocumentComponent IsSelectable="IsSelectable" />

@code {
    [CascadingParameter] public string? ApplicationUser { get; set; }
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [SupplyParameterFromQuery]
    [Parameter] public bool IsSelectable { get; set; } = false;

    private async Task OpenNewItem_Click()
    {        
        await jsRuntime.InvokeVoidAsync("open", $"{ApplicationParameter.MainPageUrl}document?IsNewItem={true}");    //await jsRuntime.InvokeVoidAsync("open", $"{Navigation.BaseUri}document?IsNewItem={true}", "_blank");
    }
}
