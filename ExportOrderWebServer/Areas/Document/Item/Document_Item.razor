@page "/document"
@page "/document/{Id:long}"
@attribute [Authorize(Roles = "Admin, Top Manager, Manager")]

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime jsRuntime
@inject IDocumentProvider _documentProvider

<PageTitle>Document</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">

    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">                     
            <div class="ToolBar-iconbutton">
                <MudTooltip Text="EXIT">
                    <MudIconButton Class="ToolBar-IconButton" Style="transform: rotate(180deg)" OnClick="CloseWindow_Click"
                                   Icon="@Icons.Material.Outlined.ExitToApp" />
                </MudTooltip>
            </div>            
            <div class="ToolBar-iconbutton" style="margin-left:20px">
                <MudTooltip Class="ExitIconButton" Text="Copy Declaration" Delay="500" Duration="1000">
                    <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.CopyAll" OnClick="CopyItem" />
                </MudTooltip>
            </div>
            <MudSpacer />
            <div class="ToolBar-Title"><span>@($"Document")</span></div>
            <MudSpacer />
            <div class="ToolBar-iconbutton" style="margin-right: 20px">
                <MudTooltip Text="Upload New Document" Delay="1000" Duration="1500">
                    <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.FileUpload" OnClick="UploadNewItemFromXml_Click" />
                </MudTooltip>
            </div>
            <div class="ToolBar-iconbutton" style="margin-right:20px">
                <MudTooltip Class="ExitIconButton" Text="SAVE" Delay="500" Duration="1000">
                    <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" Color="Color.Primary" OnClick="SaveItem" />
                </MudTooltip>
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
            </div>
        </MudToolBar>
    </div>

    <MudForm @ref="@Form">
        <Document_ItemComponent @bind-Value="Item" />
    </MudForm>
    
</MudContainer>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudForm Form { get; set; } = new();
    [CascadingParameter] public string? ApplicationUser { get; set; }
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    //[SupplyParameterFromQuery]
    [Parameter]
    public long Id { get; set; }

    private DocumentEntity Item { get; set; } = new();
    private bool IsLoadingData = false;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
            await GetItem();
    }

    private async Task GetItem()
    {
        if (Id <= 0) return;
        
        IsLoadingData = true;

        var response = await _documentProvider.GetItemAsync(Id);
        if (!response.HasErrors && response.Object != null)
            Item = (DocumentEntity)response.Object;
        else
            Snackbar.Add(response?.Errors.FirstOrDefault()!);

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    public async Task SaveItem()
    {
        if (Item is null) return;

        /// Validation
        await Form.Validate();

        if (!Form.IsValid)
        {
            Snackbar.Add("Fill up all required fields.", Severity.Warning);
            return;
        }        

        if (!ValidatePageFields.IsValid_DeclarationNum(Item.Name, Item.Type))
        {
            Snackbar.Add("Declaration Number is not valid", Severity.Warning);
            return;
        }

        /// SAVE
        IsLoadingData = true;

        AppObjectResponse appObjectResponse = new();

        if (Id == 0)
            appObjectResponse = await _documentProvider.NewItemAsync(Item, ApplicationUser);
        else
            appObjectResponse = await _documentProvider.ModifyItemAsync(Item, ApplicationUser);

        if (appObjectResponse.HasErrors)
            Snackbar.Add($"No Success! {appObjectResponse.Errors.FirstOrDefault()}", Severity.Warning); 
        else
        {
            Id = Item.Id;
            Snackbar.Add("Saved Successfully", Severity.Success);
        }

        IsLoadingData = false;

        await GetItem();
    }

    public void CopyItem()
    {
        var initialItem = Item;
        if (initialItem is null) return;

        List<DocumentRecord> records = new();
        foreach (DocumentRecord record in initialItem.Records.OrderBy(r => r.Seq))
        {
            records.Add(new DocumentRecord()
            {
                Seq = record.Seq,
                CommodityName = record.CommodityName,
                CommodityEngName = record.CommodityEngName,
                CommodityHSCode = record.CommodityHSCode,
                IMO = record.IMO,
                UNNO = record.UNNO,
                IsIMO = record.IsIMO,
                NetWt = record.NetWt,
                GrossWt = record.GrossWt,
                Volume = record.Volume
            });
        }

        Item = new()
        {
            Type = initialItem.Type,
            Description = initialItem.Description,
            Shipper = initialItem.Shipper,
            Consignee = initialItem.Consignee,
            Records = records
        };

        Id = 0;

        StateHasChanged();
    }

    private async Task UploadNewItemFromXml_Click()
    {
        if (Item is null) return;

        if (Item.Records.Any())
        {
            bool? msg = await DialogService.ShowMessageBox("Удаление записей",
                                                            (MarkupString)$"ДТ содержит товары.<br><b>Удалить текущие товары перед загрузкой новых?<b>",
                                                            yesText: "Да", cancelText: "Отмена");

            if (!msg.HasValue)
                return;
        }

        if (string.IsNullOrWhiteSpace(Item.Name))
        {
            Snackbar.Add("Сначала заполните поле с номером ДТ.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters { ["ApplicationUser"] = ApplicationUser, ["DocumentName"] = Item.Name };
        var options = new DialogOptions() { MaxWidth = MaxWidth.Small, CloseButton = true, CloseOnEscapeKey = true, BackdropClick = false };
        var dialog = DialogService.Show<UploadDocument>("Импорт списка товаров из ДТ", parameters, options);

        var dialogResult = await dialog.Result;

        if (dialogResult is not null && !dialogResult.Canceled && dialogResult.Data is not null)
        {
            if (Item.Records.Any())
                Item.Records.Clear();

            Item.Records = (List<DocumentRecord>)dialogResult.Data;
        }
    }

    private async Task CloseWindow_Click()
    {
        if (MudDialog is not null)
            MudDialog.Close();
        else
        {
            try
            {
                await jsRuntime.InvokeVoidAsync("window.close"); //await jsRuntime.InvokeVoidAsync("closeWindow");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка при закрытии окна: {ex.Message}");                
            }
        }        
    }
}
