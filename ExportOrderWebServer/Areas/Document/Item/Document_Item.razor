@page "/document"

@inject AuthenticationStateProvider authenticationStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime jsRuntime

@inject IDocumentProvider _documentProvider

<PageTitle>Document</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">

    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">
            @if (MudDialog != null)
            {
@*                 <div class="ToolBar-iconbutton">
                    <MudTooltip Text="EXIT">
                        <MudIconButton Class="ToolBar-IconButton" Style="transform: rotate(180deg);" Icon="@Icons.Material.Outlined.ExitToApp" OnClick="CloseDialog_Click" />
                    </MudTooltip>
                </div> *@
            }
            else
            {
                <div class="ToolBar-iconbutton">
                    <MudTooltip Text="EXIT">
                        <MudIconButton Class="ToolBar-IconButton" Style="transform: rotate(180deg)" Icon="@Icons.Material.Outlined.ExitToApp" OnClick="CloseWindow" />
                    </MudTooltip>
                </div>
            }

            @* @if (!IsNewItem) *@
            @if (IsFormReadOnly)
            {
@*                 <div class="ToolBar-iconbutton">
                    <MudTooltip Class="ExitIconButton" Text="REFRESH" Delay="500" Duration="1000">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Refresh" OnClick="GetItem" />
                    </MudTooltip>
                </div> *@

                <div class="ToolBar-iconbutton">
                    <MudTooltip Class="ExitIconButton" Text="copy" Delay="500" Duration="1000">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.CopyAll" OnClick="CopyItem" />
                    </MudTooltip>
                </div>
            }

            <MudSpacer />

            <div class="ToolBar-Title"><span>@($"Document")</span></div>

            <MudSpacer />

            @if (IsFormReadOnly)
            {
                <div class="ToolBar-iconbutton" style="margin-right:20px">
                    <MudTooltip Class="ExitIconButton" Text="edit" Delay="500" Duration="1000">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Edit" OnClick="EditItem" />
                    </MudTooltip>
                </div>
            }
            else
            {
                <div class="ToolBar-iconbutton" style="margin-right:20px">
                    <MudTooltip Class="ExitIconButton" Text="SAVE" Delay="500" Duration="1000">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" OnClick="SaveItem" />
                    </MudTooltip>
                </div>
            }

            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
            </div>
        </MudToolBar>
    </div>

    <MudForm @ref="@Form" ReadOnly="IsFormReadOnly">
        @if (Item != null)
        {
            <Document_ItemComponent @bind-Value="Item" IsFormReadOnly="IsFormReadOnly" />
        }
    </MudForm>

</MudContainer>

@code {
    private MudForm? Form { get; set; }

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    [SupplyParameterFromQuery]
    [Parameter]
    public long Id { get; set; }

    [SupplyParameterFromQuery]
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private DocumentEntity? Item { get; set; }
    private DocumentType Type { get; set; }
    private bool IsAuth = false;
    public bool IsFormReadOnly { get; set; } = true;


    protected override async Task OnInitializedAsync()
    {
        await GetItem();
    }

    private async Task GetItem()
    {
        if (IsNewItem)
        {
            Item = new() { Shipper = new(), Consignee = new() };
            IsFormReadOnly = false;
        }
        else
        {
            var response = await _documentProvider.GetItemAsync(Id);
            if (!response.HasError)
                Item = (DocumentEntity)response.Object!;
        }
    }

    public async Task SaveItem()
    {
        await Form!.Validate();

        if (Form.IsValid)
            if (IsNewItem)
            {
                var response = await _documentProvider.NewItemAsync(Item!);
                if (!response.HasError)
                    Snackbar.Add("Saved Successfully", Severity.Success);
                else
                {
                    Snackbar.Add($"No Success! {response.Error.FirstOrDefault()}", Severity.Error);
                    return;
                }
            }
            else
            {
                var response = await _documentProvider.ModifyItemAsync(Item!);
                if (!response.HasError)
                    Snackbar.Add("Save Successed", Severity.Success);
                else
                {
                    Snackbar.Add($"Not Successed:\n {string.Join(",\n", response.Error)}", Severity.Error);
                    return;
                }
            }
        else
        {
            Snackbar.Add("Fill up all reqired fields", Severity.Error);
            return;
        }

        IsNewItem = false;
        IsFormReadOnly = true;

        Id = Item!.Id;

        await GetItem();

        await Task.Delay(1500);
    }

    public async Task CopyItem()
    {
        if (Item is not null)
        {
            Item.Id = 0;

            foreach (var docRecord in Item.Records)
                docRecord.Id = 0;

            Item.Name = string.Empty;
            IsNewItem = true;
            await Task.Delay(50);
            IsFormReadOnly = false;
        }
    }

    public async Task EditItem()
    {
        await Task.Delay(10);
        IsFormReadOnly = false;
    }

    public async Task CloseDialog_Click()
    {
        await Task.Delay(50);
        MudDialog!.Close();
    }

    public void CloseWindow()
    {
        jsRuntime.InvokeVoidAsync("window.close");
    }
}
