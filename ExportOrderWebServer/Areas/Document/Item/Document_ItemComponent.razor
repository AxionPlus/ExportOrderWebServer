@inject IDialogService DialogService;

<style>

    .Table * .mud-table-cell {
        padding:4px;
    }

    .GoodMeasures {        
        width: 450px;
        display: flex;
        flex-direction: row-reverse;
    }    

    .GoodWeight {
        display: flex;
        margin-inline: 20px;
    }
        .GoodWeight > .numField_Label {
            width: 40px;
            margin: 4px;
            text-align: end;
        }

        .GoodWeight * .mud-input.mud-input-outlined {
            width: 130px;
        }

    .IMOWeight {
        display: flex;
        margin-inline-start: 20px;
    }

        .IMOWeight> .numField_Label {
            width:40px; margin:4px; text-align:end;
        }
        
        .IMOWeight * .mud-input.mud-input-outlined {
            width: 70px;
        }
        
    .mud-input-control.wrapper-input.NoHeader {
        margin-top: 1px;
    }

    .wrapper-input.NoHeader * .mud-input > input.mud-input-root-outlined {
        padding: 3px 1px 3px 3px;
    }

</style>

@if (Value is not null)
{

    <div class="Container-item">
        <div class="container-content">
            <MudSelect T="DocumentType" Label="Type" Style="width: 80px" @bind-Value="@Value.Type" 
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        ToStringFunc="@(s => s.ToString())" CloseIcon="" OpenIcon=""
                        Clearable="!IsFormReadOnly">
                @foreach (DocumentType type in Enum.GetValues(typeof(DocumentType)))
                {
                    <MudSelectItem Value="@type" />
                }
            </MudSelect>
            <MudTextField Class="TextField" Label="Name" Style="width: 360px" @bind-Value="Value.Name" 
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            Mask="MaskDocumentName"
                            Required RequiredError="" Clearable="!IsFormReadOnly" />

            <MudTextField Class="TextField" Label="Description" Style="width: 360px" @bind-Value="Value.Description"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        Required RequiredError="" Clearable="!IsFormReadOnly" />

            <MudTextField Class="TextField" Label="Contarct No" Style="width: 360px" @bind-Value="Value.ContarctNo"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        Required RequiredError="" Clearable="!IsFormReadOnly" />
        </div>
        <div class="container-content">
            <MudButton Class="Button" Style="width: 120px" OnClick="@(async () => { await GetCustomer_Click("Shipper"); } )"
                        Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.ArrowDropDownCircle" Disabled="IsFormReadOnly">
                Shipper
            </MudButton>
            <MudTextField Class="TextField" Placeholder="Shipper ru" Style="width: 520px" @bind-Value="@Value.Shipper!.Name"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        Required RequiredError="" Clearable="!IsFormReadOnly" />
            <MudTextField Class="TextField" Placeholder="Shipper en" Style="width: 520px" @bind-Value="@Value.Shipper!.NameEn"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        Required RequiredError="" Clearable="!IsFormReadOnly" />
        </div>
        <div class="container-content">
             <MudButton Class="Button" Style="width: 120px" OnClick="@(async () => { await GetCustomer_Click("Consignee"); } )"
                        Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.ArrowDropDownCircle" Disabled="IsFormReadOnly">
                Consignee
            </MudButton>
            <MudTextField Class="TextField" Placeholder="Consignee ru" Style="width: 520px" @bind-Value="@Value.Consignee!.Name"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            Required RequiredError="" Clearable="!IsFormReadOnly" />
            <MudTextField Class="TextField" Placeholder="Consignee en" Style="width: 520px" @bind-Value="@Value.Consignee.NameEn"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            Required RequiredError="" Clearable="!IsFormReadOnly" />
        </div>
    </div>    
    
    <div class="Container-table">
        <MudTable Class="Table" @ref="mudTable" Items="@Value.Records"
                    Virtualize="true" RowsPerPage="20" HorizontalScrollbar="true" Height="490px">

            <HeaderContent>
                <MudTh Style="width:40px;">
                    <div class="controlIconButtons">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddRecord_Click" Size="Size.Small" Disabled="IsFormReadOnly"></MudIconButton>
                    </div>
                </MudTh>
                <MudTh Style="width:35px;"></MudTh>
                <MudTh Style="width:40px;">SEQ</MudTh>
                <MudTh Style="width:140px;">HS CODE</MudTh>
                <MudTh Style="width:440px;">COMMODITY NAME</MudTh>
                <MudTh Style="width:440px;">ENGLISH </MudTh>
                <MudTh Style="width:50px;">Is IMO</MudTh>
                <MudTh></MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(async ()=>{ await RemoveRecord(context);})"
                                    Color="Color.Error" Size="Size.Small" Disabled="IsFormReadOnly"/>
                </MudTd>
                <MudTd>
                        <div class="controlIconButtons">
                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Style="@(context.IsShowWT_Details ? "transform: rotate(180deg);" : "")"
                                        OnClick="() => { context.IsShowWT_Details = !context.IsShowWT_Details; }" Size="Size.Small"></MudIconButton>
                        </div>
                </MudTd>
                <MudTd>
                    @context.Seq.ToString("000")
                </MudTd>
                <MudTd>
                    <div class="wrapper-input">
                        <MudTextField Style="width: 130px" @bind-Value="@context.CommodityHSCode"
                                        Mask="@(new PatternMask("0000000000"))"
                                        MaxLength="10" Variant="Variant.Outlined" Margin="Margin.Dense"
                                        AdornmentIcon="@Icons.Material.Filled.Search"
                                        AdornmentColor="Color.Secondary"
                                        Adornment="Adornment.End"
                                        OnAdornmentClick="@( async ()=>
                                        {
                                            if (!IsFormReadOnly)
                                                await GetCommodity_Click(context);
                                        })"
                                        Required RequiredError="" />
                    </div>
                </MudTd>
                <MudTd>
                    <div class="wrapper-input">
                            <MudTextField T="string" Style="width: 440px" Value="@context.CommodityName"
                                        ValueChanged="@((e)=>{context.CommodityName =e.ToUpper();})"
                                        Lines=2 Variant="Variant.Outlined" Margin="Margin.Dense"
                                        Required RequiredError="" Immediate />
                    </div>
                </MudTd>
                <MudTd>
                    <div class="wrapper-input">
                            <MudTextField T="string" Style="width: 440px" Value="@context.CommodityEngName"
                                        ValueChanged="@((e)=>{context.CommodityEngName =e.ToUpper();})"
                                        Lines=2 Variant="Variant.Outlined" Margin="Margin.Dense"
                                        Required RequiredError="" Immediate />
                    </div>
                </MudTd>
                <MudTd>
                    <div class="wrapper-checkBox">
                            <MudCheckBox @bind-Checked="@context.IsIMO"></MudCheckBox>
                    </div>
                </MudTd>
                <MudTd></MudTd>
            </RowTemplate>

            <ChildRowContent>
                <MudTr>
                    <td colspan="5" />
                    <td>
                        <div class="GoodMeasures">
                            <div class="GoodWeight">
                                <div class="numField_Label">Net</div>
                                <MudNumericField Class="wrapper-input NoHeader" @bind-Value="@context.NetWt"
                                                    Variant="Variant.Outlined" MaxLength="10"
                                                    Format="N3" HideSpinButtons="true" Required RequiredError="" />
                            </div>
                            <div class="IMOWeight" hidden="@(context.IsIMO==false)">
                                <div class="numField_Label">IMO</div>
                                <MudTextField Class="wrapper-input NoHeader" T="string" @bind-Value="@context.IMO"
                                                Variant="Variant.Outlined" Margin="Margin.Dense"
                                                MaxLength="4" />
                            </div>
                        </div>
                        <div class="GoodMeasures">
                            <div class="GoodWeight">
                                <div class="numField_Label">Gross</div>
                                <MudNumericField Class="wrapper-input NoHeader" @bind-Value="@context.GrossWt"
                                                    Variant="Variant.Outlined" MaxLength="10"
                                                Format="N3" HideSpinButtons="true" Required RequiredError="" />
                            </div>
                            <div class="IMOWeight" hidden="@(context.IsIMO==false)">
                                <div class="numField_Label">UNNO</div>
                                <MudTextField Class="wrapper-input NoHeader" T="string" @bind-Value="@context.UNNO"
                                                Variant="Variant.Outlined" Margin="Margin.Dense"
                                                MaxLength="4" />
                            </div>
                        </div>
                    </td>
                    <td></td>
                </MudTr>
            </ChildRowContent>

        </MudTable>
    </div>

    <div class="totalFooter pt-3">
        <div>
            <h6>Total commodity records: @Value.Records!.Count().ToString("000")</h6>
        </div>
    </div>    
}

@code {
    private MudForm? Form;
    private MudTable<DocumentRecord>? mudTable;

    [Parameter]
    public DocumentEntity? Value { get; set; }
    [Parameter]
    public EventCallback<DocumentEntity> ValueChanged { get; set; }    
    [Parameter]
    public bool IsFormReadOnly { get; set; }


    private async Task GetCustomer_Click(string ShipperOrConsignee)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsSelectable"] = true };
        DialogOptions options = new DialogOptions { CloseButton = true, DisableBackdropClick = true, MaxWidth = MaxWidth.ExtraLarge };
        dialog = await DialogService.ShowAsync<CustomerComponent>("Select Customer", parameters, options);
        DialogResult result = await dialog.Result;

        if (!result.Canceled)
        {
            var customer = (CustomerCatalog)result.Data;

            switch (ShipperOrConsignee)
            {
                case "Shipper":
                    Value!.Shipper!.Name = customer.Name;
                    Value.Shipper!.NameEn = customer.NameEn;
                    Value.Shipper!.CountryRUS = customer.Country!.RUS;
                    Value.Shipper!.CountryENG = customer.Country.ENG;
                    break;

                case "Consignee":                    
                    Value!.Consignee!.Name = customer.Name;
                    Value.Consignee!.NameEn = customer.NameEn;
                    Value.Consignee!.CountryRUS = customer.Country!.RUS;
                    Value.Consignee!.CountryENG = customer.Country.ENG;
                    break;
            }
        }

        dialog.Result.Dispose();
        await InvokeAsync(StateHasChanged);
    }

    private async Task GetCommodity_Click(DocumentRecord documentRecord)
    {
        DialogParameters parameters = new DialogParameters { ["IsSelectable"] = true };
        var options = new DialogOptions { CloseButton = true, DisableBackdropClick = true, MaxWidth = MaxWidth.ExtraLarge };
        var dialog = await DialogService.ShowAsync<CommodityComponent>("SELECT COMMODITY", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var commodity = (CommodityCatalog)result.Data;

            documentRecord.CommodityName = commodity.Name!;
            documentRecord.CommodityEngName = commodity.NameEn!;
            documentRecord.CommodityHSCode = commodity.HSCode;
            documentRecord.IMO = commodity.IMO;
            documentRecord.UNNO = commodity.UNNO;
            documentRecord.IsIMO = commodity.IsIMO;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void AddRecord_Click()
    {
        Value!.Records!.Add(new() { Seq = Value!.Records.Count() + 1, NetWt = 0, GrossWt = 0  });
    }

    private async Task RemoveRecord(DocumentRecord record)
    {
        if (record is null)
            return;

        bool? result = await DialogService.ShowMessageBox(
                 "Delete record",
                 (MarkupString)$"<b>Do you want to remove record No {record.Seq.ToString()}?<b>",
                 yesText: "REMOVE", cancelText: "NO");

        if (!result.HasValue) return;

        if (result.Value)
        {
            Value!.Records!.Remove(record);

            var seq = 1;
            foreach (var _record in Value!.Records!)
                _record.Seq = seq++;
        }

        await InvokeAsync(StateHasChanged);
    }

