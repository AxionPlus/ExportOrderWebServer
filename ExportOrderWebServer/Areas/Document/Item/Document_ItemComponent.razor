@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>

    .Table * .mud-table-cell {
    padding:4px;
    }

    .mud-input > textarea.mud-input-root-outlined.mud-input-root-margin-dense 
    {
    margin: 6px 6px;
    }

    .mud-input > input.mud-input-root.mud-input-root-margin-dense {
    padding: 8px;
    }

    .wrapper-input * .mud-input > input.mud-input-root-outlined.mud-input-root-adorned-end {
    padding-inline-start: 4px;
    }

    .mud-input-control.mud-input-control-margin-dense {
    margin: unset;
    }

    .mud-input-control.mud-input-control-margin-dense.mud-input-outlined-with-label {
    margin-top: unset;
    margin-bottom: unset;
    }

    .mud-input-control.TextField > .mud-input-control-input-container > .mud-input-label-outlined.mud-input-label-inputcontrol {
    line-height: 14px;
    }

    .Document_row {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    }

    .mud-icon-button-edge-margin-end {
    margin-right: unset;
    margin-inline-end: unset;
    margin-inline-start: unset;
    }

    .mud-select {
    flex-grow: 0;
    }

    .mud-icon-button-size-small.mud-icon-button-edge-end {
    margin-inline-end: 3px;
    }

    .GoodWeight {
    display: flex;
    width: 176px;
    }
    .GoodWeight > .numField_Label {
    width: 38px; margin: 4px; text-align: end;
    }

    .GoodWeight * .mud-input.mud-input-outlined {
    width: 130px;
    }

    .IMOWeight {
    display: flex;
    width:90px;
    }

    .IMOWeight> .numField_Label {
    width:30px; margin:4px; text-align:end;
    }

    .IMOWeight * .mud-input.mud-input-outlined {
    width: 50px;
    }

    .mud-input-control.wrapper-input.NoHeader {
    margin-top: 1px;
    }

    .wrapper-input.NoHeader * .mud-input > input.mud-input-root-outlined {
    padding: 3px;
    }

</style>

@if (Value is not null)
{
    <div class="Container-item">
        <div class="container-content">
            <MudSelect Class="wrapper-input-select" Style="width: 120px" T="DocumentType" Label="Type" @bind-Value="@Value.Type"
            ToStringFunc="@(s => s.ToString())"
            Variant="Variant.Outlined" Margin="Margin.Dense">                           
                @foreach (DocumentType type in Enum.GetValues(typeof(DocumentType)))
                {
                    <MudSelectItem Value="@type" />
                }
            </MudSelect>            
            <div style="width:520px">
                <MudTextField Class="TextField" Style="width: 260px; font-weight:500; color:var(--mud-palette-primary)" Label="Number" @bind-Value="Value.Name"
                Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus
                Mask="@MaskDocumentName"
                Required RequiredError="" Clearable/>
            </div>
            <div class="Document_row" style="width:520px">
                <MudTextField Class="TextField" Style="width:360px; font-weight:500" Label="Description" @bind-Value="Value.Description"
                Variant="Variant.Outlined" Margin="Margin.Dense"
                Required RequiredError="" Clearable />
                <MudSelect Class="wrapper-input-select" Style="width:120px" T="EntityStatus" Label="Status" @bind-Value="Value.Status"
                ToStringFunc="@(str => str.ToString())"
                Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (EntityStatus status in Enum.GetValues(typeof(EntityStatus)))
                    {
                        if (status == EntityStatus.New || status == EntityStatus.Completed)
                        {
                            <MudSelectItem Value="@status" />
                        }
                    }
                </MudSelect>
            </div>
        </div>
        <div class="container-content">
            <MudButton Class="Button" Style="width: 120px" OnClick="@(async () => { await GetCustomer_Click("Shipper"); } )"
            Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small"
            StartIcon="@Icons.Material.Filled.ArrowDropDownCircle">
                Shipper
            </MudButton>
            <MudTextField Class="TextField" Placeholder="Shipper Ru" Style="width: 520px" @bind-Value="@Value.Shipper!.Name"
            Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3"
            Required RequiredError="" Clearable />
            <MudTextField Class="TextField" Placeholder="Shipper En" Style="width: 520px" @bind-Value="@Value.Shipper!.NameEn"
            Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3"
            Required RequiredError="" Clearable />
        </div>
        <div class="container-content">
            <MudButton Class="Button" Style="width: 120px" OnClick="@(async () => { await GetCustomer_Click("Consignee"); } )"
            Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small"
            StartIcon="@Icons.Material.Filled.ArrowDropDownCircle" >
                Consignee
            </MudButton>
            <MudTextField Class="TextField" Placeholder="Consignee ru" Style="width: 520px" @bind-Value="@Value.Consignee!.Name"
            Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3"
            Required RequiredError="" Clearable />
            <MudTextField Class="TextField" Placeholder="Consignee en" Style="width: 520px" @bind-Value="@Value.Consignee.NameEn"
            Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3"
            Required RequiredError="" Clearable />
        </div>
    </div>    

    <div class="Container-table">

        <MudTable @ref="mudTable" Class="Table" Items="@Value.Records" RowsPerPage="10" HorizontalScrollbar="true" Height="520px">

            <HeaderContent>
                <MudTh Style="width:40px;">
                    <div class="controlIconButtons">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" OnClick="AddRecord_Click" Size="Size.Small" Color="Color.Primary"/>
                    </div>                
                </MudTh>
                <MudTh Style="width:40px">Seq</MudTh>
                <MudTh Style="width:100px">HS code</MudTh>
                <MudTh Style="width:360px">Товар (рус.)</MudTh>
                <MudTh Style="width:360px">Goods (in english) </MudTh>
                <MudTh Style="width:188px">Weight</MudTh>
                <MudTh Style="width:38px">IMO</MudTh>
                <MudTh Style="width:106px">details</MudTh>
            </HeaderContent>

            <RowTemplate>                
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(async ()=>{ await RemoveRecord_Click(context);})"
                                   Color="Color.Error" Size="Size.Small" />
                </MudTd>
                <MudTd>
                    @context.Seq.ToString("000")
                </MudTd>
                <MudTd>
                    <b>@context.CommodityHSCode</b>
                </MudTd>
                <MudTd>                    
                    <MudTextField Class="TextField" T="string" Style="width: 352px" @bind-Value="@context.CommodityName"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Lines=2 ReadOnly />                    
                </MudTd>
                <MudTd>
                    <MudTextField Class="TextField" T="string" Style="width: 352px" @bind-Value="@context.CommodityEngName"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Lines=2 ReadOnly />                    
                </MudTd>                
                <MudTd>
                    <div class="GoodWeight">
                        <div class="numField_Label">gross</div>
                        <MudNumericField Class="wrapper-input NoHeader" @bind-Value="@context.GrossWt"
                                         Variant="Variant.Outlined" Format="N3" HideSpinButtons="true" ReadOnly/>
                    </div>
                    <div class="GoodWeight">
                        <div class="numField_Label">net</div>
                        <MudNumericField Class="wrapper-input NoHeader" @bind-Value="@context.NetWt"
                                         Variant="Variant.Outlined" Format="N3" HideSpinButtons="true" ReadOnly />
                    </div>                    
                </MudTd>
                <MudTd>
                    <div class="wrapper-checkBox" style="width:30px">
                        <MudCheckBox @bind-Value="@context.IsIMO"></MudCheckBox>
                    </div>
                </MudTd>
                <MudTd>
                    <div class="IMOWeight">
                        <div class="numField_Label">IMO</div>
                        <MudTextField Class="wrapper-input NoHeader" T="string" @bind-Value="@context.IMO"
                        Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(!context.IsIMO)" />
                    </div>
                    <div class="IMOWeight">
                        <div class="numField_Label">UN</div>
                        <MudTextField Class="wrapper-input NoHeader" T="string" @bind-Value="@context.UNNO"
                        Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="4" Disabled="@(!context.IsIMO)" />
                    </div>
                </MudTd>
            </RowTemplate>

        </MudTable>
    </div>

    <div class="totalFooter pt-3">
        <div>
            <h6>Total commodity records: @Value.Records.Count().ToString("000")</h6>
        </div>
    </div>    
}

@code {
    private MudTable<DocumentRecord> mudTable = new();

    [Parameter]
    public DocumentEntity? Value { get; set; }
    [Parameter]
    public EventCallback<DocumentEntity> ValueChanged { get; set; }    
    
    private PatternMask MaskDocumentName = new PatternMask("00000000/000000/0000000") { Placeholder = '_' };

    private async Task GetCustomer_Click(string ShipperOrConsignee)
    {
        if (Value is null) return;

        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsSelectable"] = true };
        DialogOptions options = new DialogOptions { CloseButton = true, BackdropClick = false, MaxWidth = MaxWidth.ExtraLarge };
        dialog = await DialogService.ShowAsync<CustomerComponent>("Select Customer", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            if (result.Data is null) return;

            var customer = (CustomerCatalog)result.Data;

            switch (ShipperOrConsignee)
            {
                case "Shipper":
                    Value.Shipper!.Name = customer.Name;
                    Value.Shipper!.NameEn = customer.NameEn;
                    Value.Shipper!.CountryRUS = customer.Country!.RUS;
                    Value.Shipper!.CountryENG = customer.Country.ENG;
                    break;

                case "Consignee":                    
                    Value.Consignee!.Name = customer.Name;
                    Value.Consignee!.NameEn = customer.NameEn;
                    Value.Consignee!.CountryRUS = customer.Country!.RUS;
                    Value.Consignee!.CountryENG = customer.Country.ENG;
                    break;
            }
        }

        dialog.Result.Dispose();
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddRecord_Click()
    {
        if (Value is null) return;

        DialogParameters parameters = new DialogParameters { ["IsSelectable"] = true };
        DialogOptions options = new DialogOptions { CloseButton = true, BackdropClick = false, MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<CommodityComponent>("SELECT COMMODITY", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is not null)
        {
            var commodity = (CommodityCatalog)result.Data;

            if (commodity is null) return;

            Value.Records.Add(new ()
            {
                Seq = Value.Records.Count() + 1,
                CommodityName = commodity.Name,
                CommodityEngName = commodity.NameEn,
                CommodityHSCode = commodity.HSCode,
                NetWt = 1,
                GrossWt = 1,
                IMO = commodity.IMO,
                UNNO = commodity.UNNO,
                IsIMO = commodity.IsIMO
            });

            await InvokeAsync(StateHasChanged);
        }

        //await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveRecord_Click(DocumentRecord record)
    {
        if (record is null || Value is null)
            return;

        bool? result = await DialogService.ShowMessageBox(
                 "Delete record",
                 (MarkupString)$"<b>Do you want to remove record No {record.Seq.ToString()}?<b>",
                 yesText: "REMOVE", cancelText: "NO");

        if (!result.HasValue) return;

        if (result.Value)
        {
            Value.Records.Remove(record);

            int seq = 0;
            foreach (var item in Value.Records)
                item.Seq = ++seq;
        }

        await InvokeAsync(StateHasChanged);
    }

    // private PatternMask MaskDocumentName = new PatternMask("########/d#m###/#######")
    // {
    //     MaskChars = new[]
    //     {
    //             new MaskChar('#', @"[0-9]"),
    //             new MaskChar('d', @"[0-3]"),
    //             new MaskChar('m', @"[0-1]"),
    //     },
    //     Placeholder = '_'
    // };
}
