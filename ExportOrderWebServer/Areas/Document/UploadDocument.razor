@page "/uploadDocumentXmlFile"
@using Newtonsoft.Json

@inject ISnackbar Snackbar
@inject IHttpClientFactory httpClient

<MudStack Style="width: 100%">
    <MudFileUpload Class="flex-1" T="IBrowserFile" OnFilesChanged="OnInputFileChanged" Accept=".xml" MaximumFileCount="1"                    
                   InputClass="absolute mud-width-full mud-height-full overflow-hidden z-20" InputStyle="opacity:0"
                   @ondragenter="@SetDragClass" @ondragleave="@ClearDragClass" @ondragend="@ClearDragClass">
        <ActivatorContent>
            <MudPaper Height="100px" Outlined="true" Class="@DragClass">
                <MudText Typo="Typo.h6">Drag and drop files here or click</MudText>
                @if (_BrowserFile != null)
                {
                    <MudChip T="string" Color="Color.Dark" Text="@_BrowserFile.Name" />
                }       
            </MudPaper>
        </ActivatorContent>
    </MudFileUpload>
    <MudToolBar Class="gap-4">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CheckAndUploadFile"
                   Style="margin-inline-start:10px"
                   Disabled="@(_BrowserFile == null)"
                   StartIcon="@Icons.Material.Filled.UploadFile">
            @(IsChecked ? "Upload" : "Check") @(" ") File(s)
        </MudButton>
        <MudSpacer />
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ClearDragClass"
                   Style="margin-inline-end:10px"
                   Disabled="@(_BrowserFile == null)"
                   StartIcon="@Icons.Material.Filled.Clear">
            Clear
        </MudButton>
    </MudToolBar>
    @if (_AppObjResponse is not null)
    {
        <MudDivider Class="my-2"></MudDivider>
        <h4 style="padding-inline:10px">@(_AppObjResponse.Description)<br></h4>
        <div class="container-content column" style="width:100%; display: flex; flex-direction:column; padding-inline:10px">
            @if (_AppObjResponse.HasErrors)
            {
                <h6 style="color:brown"><b>Описание ошибки:</b></h6>
                @foreach (var error in _AppObjResponse.Errors)
                {
                    @(error)
                }
            }
        </div>
        <MudDivider Class="my-2"></MudDivider>
    }
</MudStack>

<OverlayLoadingData Visible="IsLoadingData" Text="@(IsChecked ? "Uploading..." : "Checking...")" />

@code {
    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public string? ApplicationUser { get; set; }
    [Parameter]
    public string DocumentName { get; set; } = string.Empty;

    private static string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full z-10";
    private string DragClass = DefaultDragClass;
    IBrowserFile? _BrowserFile { get; set; }

    private AppObjectResponse? _AppObjResponse { get; set; }

    private bool IsLoadingData = false;
    private bool IsChecked { get; set; }

    private void OnInputFileChanged(InputFileChangeEventArgs e)
    {
        ClearDragClass();
        _BrowserFile = (IBrowserFile)e.File;
        // BrowserFiles = e.GetMultipleFiles();
        // foreach (var file in BrowserFiles)
        //     FileNames.Add(file.Name);
    }

    private void SetDragClass()
    {
        DragClass = $"{DefaultDragClass} mud-border-primary";
    }

    private void ClearDragClass()
    {
        DragClass = DefaultDragClass;
        IsChecked = false;

        _BrowserFile = null;
        _AppObjResponse = null;        
    }

    private async Task CheckAndUploadFile()
    {
        if (IsChecked)
        {
            /// UPLOAD DATA
            if (_AppObjResponse is not null && _AppObjResponse.Object is not null)
            {
                var uploadResult = (List<DocumentRecord>)_AppObjResponse.Object;

                if (uploadResult is not null && uploadResult.Any())
                {
                    MudDialog.Close(uploadResult);
                    return;
                }
            }

            Snackbar.Add($"Данные не загружены.", Severity.Error);
            ClearDragClass();

            return;
        }
                
        if (_BrowserFile is null) return;

        /// CHECK file before upload
        IsLoadingData = true;

        long maxFileSize = 1024 * 1000;

        var fileContent = new StreamContent(_BrowserFile.OpenReadStream(maxFileSize));

        fileContent.Headers.ContentType = new MediaTypeHeaderValue(_BrowserFile.ContentType);

        var content = new MultipartFormDataContent();

        content.Add(
            content: fileContent,
            name: "\"file\"",
            fileName: _BrowserFile.Name);

        content.Add(new StringContent(DocumentName, System.Text.Encoding.UTF8, "application/txt"));

        using (var client = httpClient.CreateClient())
        {
            client.Timeout = new TimeSpan(0, 10, 0);        // TimeSpan.FromMinutes(10);

            var response = await client.PostAsync($"{ApplicationParameter.PostUploadFileUrl}UploadFromFileXML", content);

            if (response.IsSuccessStatusCode)
            {
                var readResponse = await response.Content.ReadFromJsonAsync<AppObjectResponse>();

                if (readResponse is null)
                    Snackbar.Add($"Data wasn't read.", Severity.Error);
                else
                {
                    _AppObjResponse = new()
                    {
                        Errors = readResponse.Errors,
                        Description = readResponse.Description,                        
                        Object = readResponse.Object == null ? null : JsonConvert.DeserializeObject<List<DocumentRecord>>(readResponse.Object?.ToString()!)
                    };
                    
                    /// CHECKED AND READY TO UPLOAD
                    if (_AppObjResponse.Object != null)
                        IsChecked = true;
                }                
            }
            else
                Snackbar.Add($"File not uploaded.", Severity.Error);
        }

        IsLoadingData = false;
    }
}
