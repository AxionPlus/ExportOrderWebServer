@page "/uploadDocumentsXmlFile"
@using Newtonsoft.Json

@inject ISnackbar Snackbar
@inject IHttpClientFactory httpClient
@inject IDocumentProvider _DocumentProvider

<MudStack Style="width: 100%">
    <MudFileUpload T="IReadOnlyList<IBrowserFile>" OnFilesChanged="OnInputFileChanged" Hidden="false" Class="flex-1"
                   InputClass="absolute mud-width-full mud-height-full overflow-hidden z-20" InputStyle="opacity:0"
                   @ondragenter="@SetDragClass" @ondragleave="@ClearDragClass" @ondragend="@ClearDragClass">
        <ActivatorContent>
            <MudPaper Height="100px" Outlined="true" Class="@DragClass">
                <MudText Typo="Typo.h6">Drag and drop files here or click</MudText>
                @if (FileNames is not null && FileNames.Any())
                    foreach (var file in FileNames)
                    {
                        <MudChip T="string" Color="Color.Dark" Text="@file" />
                    }
            </MudPaper>
        </ActivatorContent>
    </MudFileUpload>
    <MudToolBar Class="gap-4">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CheckAndUploadFile"
                   Style="margin-inline-start:10px"
                   Disabled="@(!FileNames.Any())"
                   StartIcon="@Icons.Material.Filled.UploadFile">
            @(IsChecked ? "Upload" : "Check") @(" ") File(s)
        </MudButton>
        <MudSpacer />
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ClearDragClass"
                   Style="margin-inline-end:10px"
                   Disabled="@(!FileNames.Any())">
            Clear
        </MudButton>
    </MudToolBar>
    @if (AppObjResponse is not null)
    {
        <div class="container-content column" style="width:100%; display: flex; flex-direction:column; padding-inline-start:10px">
            @if (AppObjResponse.HasErrors)
            {           
                <MudText><b>Описание ошибки:</b></MudText>
                @foreach (var error in AppObjResponse.Errors)
                {
                    <span style="padding-inline-start:10px">@(error)<br></span>
                }
            }
            else
            {
                <span style="padding-inline-start:10px">@(AppObjResponse.Description)<br></span>
            }            
        </div>
    }
</MudStack>

<OverlayLoadingData Visible="IsLoadingData" Text="@(IsChecked ? "Uploading..." : "Checking...")" />

@code {
    [Parameter]
    public string? ApplicationUser { get; set; }

    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = new();

    private static string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full z-10";
    private string DragClass = DefaultDragClass;    
    private List<string> FileNames = new List<string>();
    //IList<IBrowserFile> BrowserFiles = new List<IBrowserFile>();
    IReadOnlyList<IBrowserFile> BrowserFiles = new List<IBrowserFile>();

    private AppObjectResponse? AppObjResponse { get; set; }

    private bool IsLoadingData = false;
    private bool IsChecked { get; set; }

    private void OnInputFileChanged(InputFileChangeEventArgs e)
    {
        ClearDragClass();

        //BrowserFiles = (IList<IBrowserFile>)e.GetMultipleFiles();
        //var files = e.GetMultipleFiles();
        // foreach (var file in files)
        //     FileNames.Add(file.Name);

        BrowserFiles = e.GetMultipleFiles();
        foreach (var file in BrowserFiles)
            FileNames.Add(file.Name);
    }

    private void SetDragClass()
    {
        DragClass = $"{DefaultDragClass} mud-border-primary";
    }

    private void ClearDragClass()
    {
        DragClass = DefaultDragClass;
        FileNames.Clear();
        AppObjResponse = new();
        IsChecked = false;
    }

    private async Task CheckAndUploadFile()
    {
        if (IsChecked)
        {
            /// UPLOAD DATA
            if (AppObjResponse is not null && AppObjResponse.Object is not null)
            {
                var readDTOs = (List<ReadXmlDocumentDTO>)AppObjResponse.Object;

                if (readDTOs is not null && readDTOs.Any())
                {
                    IsLoadingData = true;
                    var uploadResponse = await _DocumentProvider.NewItemsUploadXmlAsync(readDTOs, ApplicationUser);
                    IsLoadingData = false;

                    if (uploadResponse is not null)
                        if (!uploadResponse.HasErrors)
                        {
                            Snackbar.Add("ДТ загружены.", Severity.Success);
                            MudDialog.Close();
                        }
                        else
                        {
                            Snackbar.Add($"Данные не загружены: {uploadResponse?.Errors.First()!}", Severity.Error);
                            ClearDragClass();
                        }
                }
            }

            return;
        }

        /// CHECK uploaded files
        if (BrowserFiles is null || !BrowserFiles.Any()) return;

        IsLoadingData = true;

        long maxFileSize = 1024 * 1000;

        var content = new MultipartFormDataContent();

        foreach (var file in BrowserFiles)
        {
            var fileContent = new StreamContent(file.OpenReadStream(maxFileSize));

            if (fileContent is null)
                continue;

            fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);

            content.Add(
                content: fileContent,
                name: "\"files\"",
                fileName: file.Name);
        }        

        using (var client = httpClient.CreateClient())
        {
            client.Timeout = new TimeSpan(0, 10, 0);        // TimeSpan.FromMinutes(10);

            var response = await client.PostAsync($"{ApplicationParameter.PostUploadFileUrl}UploadFromFileXML", content);

            if (response.IsSuccessStatusCode)
            {
                var readResponse = await response.Content.ReadFromJsonAsync<AppObjectResponse>();

                if (readResponse is null)
                    Snackbar.Add($"Data wasn't read.", Severity.Error);
                else
                {
                    AppObjResponse = new();

                    AppObjResponse.Description = readResponse.Description;
                    AppObjResponse.Errors = readResponse.Errors;
                    AppObjResponse.Object = JsonConvert.DeserializeObject<List<ReadXmlDocumentDTO>>(readResponse.Object?.ToString()!);
                    
                    IsChecked = true;   /// CHECKED AND READY TO UPLOAD
                }                
            }
            else
                Snackbar.Add($"File not uploaded.", Severity.Error);
        }

        IsLoadingData = false;
    }
}
