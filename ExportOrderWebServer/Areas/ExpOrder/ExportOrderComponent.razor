@using ExportOrderWebServer.Areas.ExpOrder.Item;
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JSRuntime

@inject IExportOrderProvider _exportOrderProvider
@inject IVesselProvider _vesselProvider
@inject IVesselCallProvider _vesselCallProvider
@inject ICarrierProvider _carrierProvider

<style></style>

<MudForm @ref="@FilterForm">

    <div class="Container-item">
        <div class="container-content">
            <MudButton Class="Button" Style="width: 80px" Disabled="@IsLoadingData" OnClick="@(async () => { await AddItem_Click(); })"
                       Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary">
                Add New
            </MudButton>
            <MudSpacer />
            
            <MudTextField Class="TextField" Placeholder="Number" Style="width: 200px" @bind-Value="@Filter.ExportOrderNum"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
            <MudSpacer />

             <MudAutocomplete Class="Autocomplete" T="string" Style="width: 250px" Value="Filter.VesselName" SearchFunc="@SearchVessel"
                              Label="Vessel"
                              ValueChanged="(e)=> { Filter.VesselName = e; }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              CloseIcon="" OpenIcon=""
                              ResetValueOnEmptyText="true" Clearable />
            <MudSpacer />

            <MudAutocomplete Class="Autocomplete" T="string" Style="width: 250px" Value="Filter.Voyage" SearchFunc="@SearchVoyage"
                              Label="Voyage" 
                              ValueChanged="(e)=> { Filter.Voyage = e; }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              CloseIcon="" OpenIcon=""
                              ResetValueOnEmptyText="true" Clearable />
            <MudSpacer />

            <MudAutocomplete Class="Autocomplete" T="string" Style="width: 250px" Value="Filter.Carrier" SearchFunc="@SearchCarrier"
                              Label="Carrier" 
                              ValueChanged="(e)=> { Filter.Carrier= e; }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              CloseIcon="" OpenIcon=""
                              ResetValueOnEmptyText="true" Clearable />
            <MudSpacer />

            <MudTextField Class="TextField" Placeholder="Container" Style="width: 200px" @bind-Value="@Filter.CntrNum"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
            <MudSpacer />

            <MudButton Class="Button" Style="width: 80px" OnClick="@(async () => { await GetItems(); })"
                        Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary">
                Search
            </MudButton>
        </div>
    </div>

    <div class="Container-table">
    @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }
    <MudTable Class="Table" @ref="mudTable" T="ExportOrderEntity" Items="@Items"
              Loading="IsLoadingData" Virtualize="true" RowsPerPage="20">
        <HeaderContent>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:120px">Number</MudTh>
            <MudTh Style="width:100px">Dated</MudTh>
            <MudTh Style="width:150px">Voyage</MudTh>
            <MudTh Style="width:300px">Vessel</MudTh>
            <MudTh Style="text-align:start">Carrier</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudTooltip Text="view details">
                    <MudIconButton Class="wrapper-iconbutton" Disabled="@IsLoadingData" Icon="@Icons.Material.Outlined.Edit"
                                   OnClick="@(async()=>{ await ShowItem_Click(context.Id); })" />
                </MudTooltip>
            </MudTd>
            <MudTd>
                <MudTooltip Text="view Report - export order">
                    <MudIconButton Class="wrapper-iconbutton" Disabled="@IsLoadingData" Icon="@Icons.Material.Outlined.Print"
                                   OnClick="@(async()=>{ await ViewReportExpOrder_Click(context.Id); })" />
                </MudTooltip>
            </MudTd>
            <MudTd>
                <MudTooltip Text="view Report - BL">
                    <MudIconButton Class="wrapper-iconbutton" Disabled="@IsLoadingData" Icon="@Icons.Material.Outlined.Print"
                                    OnClick="@(async()=>{ await ViewReportBL_Click(context.Id); })" />
                </MudTooltip>
            </MudTd>
            <MudTd>@context.Num</MudTd>
            <MudTd>@context.Dated.ToShortDateString()</MudTd>
            <MudTd>@context.VesselCall!.VoyageCarrier</MudTd>
            <MudTd>@context.VesselCall!.Vessel.Name</MudTd>
            <MudTd Style="text-align:start">@context.Carrier.Name</MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>

</div>

</MudForm>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudForm? FilterForm;
    private MudTable<ExportOrderEntity>? mudTable;

    [CascadingParameter]
    MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public IEnumerable<ExportOrderEntity>? Items { get; set; } = new List<ExportOrderEntity>();

    private FilterParameters Filter { get; set; } = new();
    private bool IsLoadingData {get; set; }= false;



    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    private async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _exportOrderProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<ExportOrderEntity>)response.Object!).ToArray();

        await Task.Delay(500);

        await InvokeAsync(StateHasChanged);

        IsLoadingData = false;
    }

    private async Task AddItem_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { FullScreen = true, NoHeader = true, DisableBackdropClick = false };
        dialog = await DialogService.ShowAsync<ExportOrderItem_Dialog>(null, parameters, options);

        DialogResult result = await dialog.Result;

        if (!result.Canceled)
            if (Items!.Count() > 0)
                await GetItems();
    }

    private async Task ShowItem_Click(long id)
    {
        // if (MudDialog is not null)
        //     MudDialog.Close(DialogResult.Ok(id));

        DialogParameters parameters = new DialogParameters { ["Id"] = id };
        DialogOptions options = new DialogOptions { FullScreen = true, NoHeader = true, DisableBackdropClick = false };
        var dialog = await DialogService.ShowAsync<ExportOrderItem_Dialog>(null, parameters, options);

        DialogResult result = await dialog.Result;

        // if (!result.Canceled)
        //     await GetItems();
    }

    private async Task ViewReportExpOrder_Click(long id)
    {
        string path = $"{Navigation.BaseUri}server/ExportOrder/ViewReportExpOrder?Id={id}";
        await JSRuntime.InvokeVoidAsync("open", path);
    }

    private async Task ViewReportBL_Click(long id)
    {
        string path = $"{Navigation.BaseUri}server/ExportOrder/ViewReportBL?Id={id}";
        await JSRuntime.InvokeVoidAsync("open", path);
    }

    #region SEARCHERS

    private async Task<IEnumerable<string>> SearchVessel(string value)
    {
        var result = await _vesselProvider.GetNamesEn();

        if (string.IsNullOrWhiteSpace(value))
            return result;

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    private async Task<IEnumerable<string>> SearchVoyage(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _vesselCallProvider.GetVoyagesCarrier();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchCarrier(string value)
    {
        var result = await _carrierProvider.GetNames();

        if (string.IsNullOrWhiteSpace(value))
            return result;

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    #endregion
}
