@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IHttpCustomMethods HttpCustomMethod
@inject IJSRuntime jsRuntime
@inject AuthenticationStateProvider authenticationStateProvider
@inject IHttpClientFactory httpClient
@inject IExportOrderProvider _exportOrderProvider
@inject IVesselProvider _vesselProvider
@inject IVesselCallProvider _vesselCallProvider
@inject ILocationProvider _locationProvider
@inject ICarrierProvider _carrierProvider

<style>
    .mud-icon-button-edge-margin-end {
        margin-right: 2px;
        margin-inline-end: 2px;
        margin-inline-start: unset;
    }
    .mud-input > input.mud-input-root-outlined {
        padding: 8px;
    }

    .mud-input > input.mud-input-root-outlined.mud-input-root-adorned-end {
        padding-inline-start: unset;
    }

    .mud-input > input.mud-input-root-outlined.mud-input-root-margin-dense {
        padding: 8px;
    }

    .mud-input-control.mud-input-control-margin-dense.mud-input-outlined-with-label {
        margin-top: unset;
        margin-bottom: unset;
    }

    .mud-select.mud-autocomplete * .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-inline-end: 6px;
        padding-inline-start: unset;
    }
</style>

<div class="Container-item" style="margin-top:6px">
    <div class="container-content">        
        <MudTextField Class="TextField" Label="Container" Style="width: 165px" @bind-Value="@Filter.CntrNum"                      
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable
                      Immediate MaxLength="11" />

        <MudTextField Class="TextField" Label="Export Order" Style="width: 200px" @bind-Value="@Filter.Num"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
        <div style="width:130px; height:35px">
            <MudDatePicker Class="wrapper-input-date" Label="Dated" @bind-Date="Filter.Dated"                       
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       IconSize=Size.Small
                       DateFormat="dd.MM.yy"
                       ShowWeekNumbers="true"                       
                       AutoClose=true
                       Clearable />
        </div>        
        
        <MudAutocomplete Class="Autocomplete" T="string" Style="width: 220px" @bind-Value="Filter.Vessel" SearchFunc="@SearchVessel"
                         Label="Vessel"                                                  
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon="" MaxItems="20"
                         ResetValueOnEmptyText="true" Clearable />
        
        <MudAutocomplete Class="Autocomplete" T="string" Style="width: 150px" @bind-Value="Filter.Voyage" SearchFunc="@SearchVoyage"
                         Label="Voyage"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon="" MaxItems="20"
                         ResetValueOnEmptyText="true" Clearable
                         Immediate="true"/>
        
        <MudAutocomplete Class="Autocomplete" Style="width: 170px" T="string" @bind-Value="@Filter.POD" SearchFunc="@SearchPort"
                         Label="POD"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon="" MaxItems="20"
                         ResetValueOnEmptyText="true" Clearable />
        
        <MudAutocomplete Class="Autocomplete" T="string" Style="width: 210px" Value="Filter.Carrier" SearchFunc="@SearchCarrier"
                         Label="Carrier"
                         ValueChanged="(e)=> { Filter.Carrier= e; }"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon="" MaxItems="20"
                         ResetValueOnEmptyText="true" Clearable />
        
        <MudSelect Class="wrapper-input-select" T="EntityStatus?" Label="Status" @bind-Value="Filter.Status"
                   Style="width:145px"
                   ToStringFunc="@(s => s is not null ? s.ToString() : string.Empty)"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable>
            @foreach (EntityStatus? status in Enum.GetValues(typeof(EntityStatus)))
            {
                <MudSelectItem Value="@status" />
            }
        </MudSelect>
        
        <MudButton Class="Button" Style="width: 80px" OnClick="@(async () => { await GetItems(); })"
                   Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary">
            Search
        </MudButton>
    </div>
</div>

<div class="Container-table">
    @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)"
                           Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }
    <MudTable Class="Table" @ref="mudTable" Items="@Items" Loading="IsLoadingData" @bind-SelectedItems="SelectedItems"
              Virtualize="true" RowsPerPage="15" MultiSelection="true" >
        <HeaderContent>
            <MudTh Style="max-width:45px">
                <MudTooltip Delay="500" Duration="1000" Text="перенести в другой рейс" Arrow="true" Placement="Placement.Right">
                    <MudIconButton Class="wrapper-iconbutton" Icon="@Icons.Material.Outlined.TransferWithinAStation" Disabled="@(!SelectedItems.Any())"
                                   Size="Size.Small" Color="Color.Secondary" OnClick="SetNewVesselCall" />
                </MudTooltip>
            </MudTh>
            <MudTh Style="max-width:45px">
                <MudTooltip Delay="500" Duration="1000" Text="сохранить выбранные Поручения" Arrow="true" Placement="Placement.Right">
                    <MudIconButton Class="wrapper-iconbutton" Icon="@Icons.Material.Outlined.Save" Disabled="@(IsLoadingData || SelectedItems.Count == 0)"
                                   Size="Size.Small" OnClick="SaveReportsExportOrder_Click" />
                </MudTooltip>
            </MudTh>
            <MudTh Style="max-width:50px">XML</MudTh>
            <MudTh Style="max-width:50px">Rolis</MudTh>
            <MudTh Style="width:130px">
                <MudTooltip Delay="500" Duration="1000" Text="сохранить выбранные Коносаменты" Arrow="true" Placement="Placement.Right">
                    <MudIconButton Class="wrapper-iconbutton" Icon="@Icons.Material.Outlined.Save" Disabled="@(IsLoadingData || SelectedItems.Count == 0)"
                                   Size="Size.Small" OnClick="SaveReportsBL_Click" />
                </MudTooltip>
            </MudTh>
            <MudTh Style="width:160px">
                <MudTableSortLabel SortBy="new Func<ExportOrderComponentDTO, object>(x=>x.Num!)">Number</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:80px">
                <MudTableSortLabel SortBy="new Func<ExportOrderComponentDTO, object>(x=>x.Dated!)">Dated</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:230px">
                <MudTableSortLabel SortBy="new Func<ExportOrderComponentDTO, object>(x=>x.Vessel!)">Vessel</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:110px">
                <MudTableSortLabel SortBy="new Func<ExportOrderComponentDTO, object>(x=>x.VoyageNo!)">Voyage</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:200px">POD</MudTh>
            <MudTh Style="width:200px; text-align:start">
                <MudTableSortLabel SortBy="new Func<ExportOrderComponentDTO, object>(x=>x.Carrier!)">Carrier</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:110px">Terminal</MudTh>
            <MudTh Style="width:50px">IMO</MudTh>
            <MudTh Style="width:64px">Empty</MudTh>
            <MudTh Style="width:100px">
                <MudTableSortLabel SortBy="new Func<ExportOrderComponentDTO, object>(x=>x.Status!)">Status</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:42px"></MudTh>
            <MudTh Style="min-width:20px"></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>
                <MudTooltip Delay="1000" Duration="1000" Text="view Details">
                    <MudIconButton Class="wrapper-iconbutton" Disabled="@IsLoadingData" Icon="@Icons.Material.Outlined.Edit"
                                   OnClick="@(async()=>{ await ShowItem_Click(context.Id); })" />
                </MudTooltip>
            </MudTd>
            <MudTd>
                <MudTooltip Delay="1000" Duration="1000" Text="view Export Order">
                    <MudIconButton Class="wrapper-iconbutton" Disabled="@IsLoadingData" Icon="@Icons.Material.Outlined.Print"
                                   OnClick="@(async()=>{ await ViewReportExpOrder_Click(context.Id); })" />
                </MudTooltip>
            </MudTd>
            <MudTd>
                <MudTooltip Delay="1000" Duration="1000" Text="save xml file">
                    <MudIconButton Class="wrapper-iconbutton" Disabled="@IsLoadingData" Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Medium"
                                   OnClick="@(async()=>{ await SaveXMLfile_Click(context.Id); })" />
                </MudTooltip>
            </MudTd>
            <MudTd>
                <MudTooltip Delay="1000" Duration="1000" Text="save xlsx file for ROLIS">
                    <MudIconButton Class="wrapper-iconbutton" Disabled="@IsLoadingData" Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Medium"
                                   OnClick="@(async()=>{ await SaveFileRolis_Click(context.Id); })" />
                </MudTooltip>
            </MudTd>
            <MudTd>
                <MudButton Class="Button" OnClick="@(async()=>{ await ViewReportBL_Click(context.Id); })"
                           Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Preview">
                    view BL
                </MudButton>
            </MudTd>
            <MudTd>@context.Num</MudTd>
            <MudTd>@context.Dated</MudTd>
            <MudTd>@context.Vessel</MudTd>
            <MudTd>@context.VoyageNo</MudTd>
            <MudTd>@context.POD</MudTd>
            <MudTd Style="text-align:start">@context.Carrier</MudTd>
            <MudTd>@(context.Terminal ?? "---")</MudTd>
            <MudTd>
                @if (context.IsImo.Equals(true))
                {
                    <MudTooltip Text="IMO"><MudIcon Icon="@Icons.Custom.Uncategorized.BioHazard" Color="Color.Error"></MudIcon></MudTooltip>
                }
            </MudTd>
            <MudTd>
                @if (context.IsEmpty.Equals(true))
                {
                    <MudTooltip Text="Empty"><MudIcon Icon="@Icons.Material.Outlined.Battery1Bar"></MudIcon></MudTooltip>
                }
            </MudTd>
            <MudTd>@context.Status.ToString()</MudTd>
            <MudTd>
                <MudIconButton Class="wrapper-iconbutton" Disabled="@(IsLoadingData || IsBtnClicked || !IsRoleForEdit)"
                               Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Secondary"
                               OnClick="@(async()=>{ await RemoveItem_Click(context.Id, context.Num!); })" />
            </MudTd>
            <MudTd></MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudTable<ExportOrderComponentDTO>? mudTable;

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    public IEnumerable<ExportOrderComponentDTO> Items { get; set; } = new List<ExportOrderComponentDTO>();
    private HashSet<ExportOrderComponentDTO> SelectedItems = new HashSet<ExportOrderComponentDTO>();
    private string Voyage = string.Empty;
    private IEnumerable<string>? CntrList { get; set; }
    private FilterParameters Filter { get; set; } = new();

    private bool IsLoadingData { get; set; } = false;
    private bool IsBtnClicked { get; set; } = false;
    private bool IsRoleForEdit = false;


    protected override async Task OnInitializedAsync()
    {
        var user = await authenticationStateProvider.GetAuthenticationStateAsync();

        if (user.User.IsInRole("Admin") || user.User.IsInRole("Top Manager"))
            IsRoleForEdit = true;
    }

    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _exportOrderProvider.GetItemsAsync(Filter);

        if (!response.HasError)
            Items = (IEnumerable<ExportOrderComponentDTO>)response.Object!;

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowItem_Click(long id)
    {
        DialogParameters parameters = new DialogParameters { ["Id"] = id };
        DialogOptions options = new DialogOptions { FullScreen = true, NoHeader = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<ExportOrder_Item>(null, parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await GetItems();
    }

    private async Task RemoveItem_Click(long id, string num)
    {
        IsBtnClicked = true;

        await Task.Delay(1000);

        bool? result = await DialogService.ShowMessageBox(
                 "Delete",
                 (MarkupString)$"Do you want Delete record?<br/><b>{num}</b>",
                 yesText: "DELETE!", cancelText: "NO");

        IsLoadingData = true;

        if (result.HasValue)
            if (result.Value)
            {
                var response = await _exportOrderProvider.RemoveItemAsync(id);
                if (!response.HasError)
                {
                    Items!.ToList().Remove(Items!.FirstOrDefault(eoc => eoc.Id == id)!);
                    Snackbar.Add($"Deleted successfully", Severity.Success);
                }
                else
                    Snackbar.Add($"Record wasn't deleted.<br/>{response.Error.First()}", Severity.Warning);

                await GetItems();
            }

        IsLoadingData = false;

        IsBtnClicked = false;
    }

    public async Task SetNewVesselCall()
    {
        if (SelectedItems is null || SelectedItems.Count == 0)
        {
            Snackbar.Add($"Select at list one record.", Severity.Warning);
            return;
        }

        var Voyages = SelectedItems.GroupBy(s => s.VesselCallId).ToArray();

        if (Voyages.Count() > 1)
        {
            Snackbar.Add($"Export Orders for one Voyage only is available.", Severity.Warning);
            return;
        }

        DialogParameters parameters = new DialogParameters { ["IsSelectable"] = true };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<VesselCallComponent>("select VESSEL CALL", parameters, options);
        var resultDialog = await dialog.Result;

        if (resultDialog is not null && !resultDialog.Canceled && resultDialog.Data is not null)
        {
            bool? questionResult = await DialogService.ShowMessageBox(
                    "Set New Vessel CALL?",
                    "Do you want to Roll Export Order(s)?",
                    yesText: "Yes", cancelText: "No");

            if (!questionResult.HasValue) return;
            if (!questionResult.Value) return;

            IsLoadingData = true;
            //await InvokeAsync(StateHasChanged); // commit this

            var newVesselCallDetailId = (long)resultDialog.Data;

            var selectedEOids = SelectedItems.Select(s => s.Id).ToArray();

            var result = await _exportOrderProvider.SetNewVesselCall(selectedEOids, newVesselCallDetailId);
            if (result.HasError)
            {
                Snackbar.Add(string.Join("; ", result.Error), Severity.Warning);
                IsLoadingData = false;
                return;
            }

            await GetItems();
        }
    }

    private async Task ViewReportExpOrder_Click(long id)
    {
        //string path = $"{Navigation.BaseUri}server/ExportOrder/ViewReportExpOrder?Id={id}";
        string path = $"{ApplicationParameter.ViewReportUrl}ViewReportExpOrder?Id={id}";
        await jsRuntime.InvokeVoidAsync("open", path);
    }

    private async Task ViewReportBL_Click(long id)
    {
        string path = $"{ApplicationParameter.ViewReportUrl}ViewReportBL?Id={id}";
        await jsRuntime.InvokeVoidAsync("open", path);
    }

    private async Task SaveXMLfile_Click(long id)
    {
        string path = $"{ApplicationParameter.UploadFileUrl}SaveXMLfile?Id={id}";
        await jsRuntime.InvokeVoidAsync("open", path);
    }

    private async Task SaveFileRolis_Click(long id)
    {
        string path = $"{ApplicationParameter.UploadFileUrl}SaveFileExcelRolis?expOrderId={id}";
        await jsRuntime.InvokeVoidAsync("open", path);
    }

    private async Task SaveReportsExportOrder_Click()
    {   
        IEnumerable<long> ids = SelectedItems.Select(s => s.Id).ToList();

        var Voyages = SelectedItems.GroupBy(s => s.VesselCallId).Select(g => new { Voyage = g.FirstOrDefault()!.Vessel + "_" + g.FirstOrDefault()!.VoyageNo });

        if (Voyages.Count() > 1)
        {
            Snackbar.Add($"Export Orders for one Voyage only is available.", Severity.Warning);
            return;
        }

        IsLoadingData = true;

        string Voyage = Voyages.FirstOrDefault()!.Voyage;
        var obj = new { Object = ids, Remarks = Voyage };
        var json = Newtonsoft.Json.JsonConvert.SerializeObject(obj);

        using (var Http = httpClient.CreateClient())
        {
            Http.Timeout = new TimeSpan(0, 10, 0);
            var stringContent = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await Http.PostAsync($"{ApplicationParameter.PostUploadFileUrl}SaveExportOrderReportFiles", stringContent).ConfigureAwait(false);

            if (response.IsSuccessStatusCode)
            {
                string fileName = response.Content.Headers.ContentDisposition is null ? string.Empty :
                                    (string.IsNullOrEmpty(response.Content.Headers.ContentDisposition.FileName) ? string.Empty : response.Content.Headers.ContentDisposition.FileName);

                var stream = await response.Content.ReadAsStreamAsync();
                using (var memoryStream = new MemoryStream())
                {
                    stream.CopyTo(memoryStream);

                    await jsRuntime.InvokeVoidAsync("jsSaveAsFile",
                                                    $"ExportOrders_{Voyage}.zip",
                                                    Convert.ToBase64String(memoryStream.ToArray()));
                }

                if (!string.IsNullOrEmpty(fileName))
                {
                    if (File.Exists(fileName)) File.Delete(fileName);
                    if (Directory.Exists(fileName.Substring(0, fileName.Length - 4))) Directory.Delete(fileName.Substring(0, fileName.Length - 4));
                }                
            }
        }

        IsLoadingData = false;
    }

    private async Task SaveReportsBL_Click()
    {
        IEnumerable<long> ids = SelectedItems.Select(s => s.Id).ToList();

        var Voyages = SelectedItems.GroupBy(s => s.VesselCallId).Select(g => new { Voyage = g.FirstOrDefault()!.Vessel + "_" + g.FirstOrDefault()!.VoyageNo });

        if (Voyages.Count() > 1)
        {
            Snackbar.Add($"Bill of Ladings for one Voyage only is available.", Severity.Warning);
            return;
        }

        IsLoadingData = true;

        string Voyage = Voyages.FirstOrDefault()!.Voyage;
        var obj = new { Object = ids, Remarks = Voyage };
        var json = Newtonsoft.Json.JsonConvert.SerializeObject(obj);

        using (var Http = httpClient.CreateClient())
        {
            Http.Timeout = new TimeSpan(0, 10, 0);
            var stringContent = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await Http.PostAsync($"{ApplicationParameter.PostUploadFileUrl}SaveBLReportFiles", stringContent).ConfigureAwait(false);

            if (response.IsSuccessStatusCode)
            {
                string fileName = response.Content.Headers.ContentDisposition is null ? string.Empty :
                                    (string.IsNullOrEmpty(response.Content.Headers.ContentDisposition.FileName) ? string.Empty : response.Content.Headers.ContentDisposition.FileName);

                var stream = await response.Content.ReadAsStreamAsync();
                using (var memoryStream = new MemoryStream())
                {
                    stream.CopyTo(memoryStream);

                    await jsRuntime.InvokeVoidAsync("jsSaveAsFile",
                          $"BLs_{Voyage}.zip", Convert.ToBase64String(memoryStream.ToArray()));
                }

                if (!string.IsNullOrEmpty(fileName))
                {
                    if (File.Exists(fileName)) File.Delete(fileName);
                    if (Directory.Exists(fileName.Substring(0, fileName.Length - 4))) Directory.Delete(fileName.Substring(0, fileName.Length - 4));
                }
            }
        }

        IsLoadingData = false;
    }


    #region SEARCHERS

    private async Task<IEnumerable<string>> SearchVessel(string value, CancellationToken token)
    {
        var result = await _vesselProvider.GetNamesEn();

        if (string.IsNullOrWhiteSpace(value))
            return result;

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    private async Task<IEnumerable<string>> SearchVoyage(string value, CancellationToken token)
    {
        var result = await _vesselCallProvider.GetVoyages(Filter.Vessel);

        if (string.IsNullOrWhiteSpace(value))
            return result.Distinct();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).Distinct();
    }

    private async Task<IEnumerable<string>> SearchPort(string value, CancellationToken token)
    {
        var result = await _locationProvider.GetNames();

        if (string.IsNullOrWhiteSpace(value))
            return result;

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchCarrier(string value, CancellationToken token)
    {
        var result = await _carrierProvider.GetNamesEn();

        if (string.IsNullOrWhiteSpace(value))
            return result;

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    #endregion
}
