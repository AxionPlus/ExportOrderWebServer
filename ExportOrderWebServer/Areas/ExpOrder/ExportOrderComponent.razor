@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime jSRuntime

@inject IExportOrderProvider _exportOrderProvider
@inject IVesselProvider _vesselProvider
@inject IVesselCallProvider _vesselCallProvider
@inject ILocationProvider _locationProvider
@inject ICarrierProvider _carrierProvider

<style>

    .mud-icon-button-edge-margin-end {
        margin-right: 2px;
        margin-inline-end: 2px;
        margin-inline-start: unset;
    }

    .mud-select * .mud-input-label-outlined.mud-input-label-margin-dense {
        transform: translate(4px,8px) scale(1);
    }

    .mud-input > input.mud-input-root-outlined.mud-input-root-adorned-end {
        padding-inline-start: unset;
    }

    .mud-input > input.mud-input-root-outlined.mud-input-root-margin-dense {
        padding: 8px;
    }

    .mud-input-control > .mud-input-control-input-container > .mud-input-label-outlined.mud-input-label-inputcontrol {
        line-height: 12px;
    }

</style>

<div class="Container-item">
    <div class="container-content">
        <MudTextField Class="TextField" Placeholder="Container" Style="width: 160px" @bind-Value="@Filter.CntrNum" Disabled
                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="11" Clearable />
        <MudSpacer />
        <MudTextField Class="TextField" Placeholder="Export Order No" Style="width: 185px" @bind-Value="@Filter.Num"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable />
        <MudSpacer />
        <MudDatePicker Class="wrapper-input-date" Label="Dated" @bind-Date="Filter.Dated"
                        Style="width: 130px;"
                        DateFormat="dd.MM.yy"
                        ShowWeekNumbers="true"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        IconSize=Size.Small
                        AutoClose=true
                        DisableToolbar=false Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Style="width: 220px" Value="Filter.Vessel" SearchFunc="@SearchVessel"
                          Placeholder="Vessel"
                          ValueChanged="(e)=> { Filter.Vessel = e; }"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          CloseIcon="" OpenIcon=""
                          ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Style="width: 150px" @bind-Value="Filter.Voyage" SearchFunc="@SearchVoyage"
                          Placeholder="Voyage"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          CloseIcon="" OpenIcon=""
                          ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" Style="width: 170px" T="string" @bind-Value="@Filter.POD" SearchFunc="@SearchPort"
                          Placeholder="POD"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          CloseIcon="" OpenIcon="" MaxItems="20"
                          ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Style="width: 220px" Value="Filter.Carrier" SearchFunc="@SearchCarrier"
                          Placeholder="Carrier"
                          ValueChanged="(e)=> { Filter.Carrier= e; }"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          CloseIcon="" OpenIcon=""
                          ResetValueOnEmptyText="true" Clearable />

        <MudSpacer />
        <MudSelect Class="wrapper-input select" T="EntityStatus?" Style="width:125px" Label="Status" @bind-Value="Filter.Status"                    
                    ToStringFunc="@(s => s is not null ? s.ToString() : string.Empty)"
                    Variant="Variant.Outlined" Margin="Margin.Dense" Clearable >
            @foreach (EntityStatus? status in Enum.GetValues(typeof(EntityStatus)))
            {
                <MudSelectItem Value="@status" />
            }
        </MudSelect>
        <MudSpacer />
        <MudButton Class="Button" Style="width: 80px" OnClick="@(async () => { await GetItems(); })"
                    Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary">
            Search
        </MudButton>
    </div>
</div>

<div class="Container-table">
    @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)"
                            Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }
    <MudTable Class="Table" @ref="mudTable" Items="@Items" Loading="IsLoadingData" Virtualize="true" Hover="true" RowsPerPage="15">
        
        <HeaderContent>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:120px"></MudTh>            
            <MudTh Style="width:150px">
                <MudTableSortLabel SortBy="new Func<ExportOrderComponentDTO, object>(x=>x.Num!)">Number</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:80px">
                <MudTableSortLabel SortBy="new Func<ExportOrderComponentDTO, object>(x=>x.Dated!)">Dated</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:200px">
                <MudTableSortLabel SortBy="new Func<ExportOrderComponentDTO, object>(x=>x.Vessel!)">Vessel</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:150px">
                <MudTableSortLabel SortBy="new Func<ExportOrderComponentDTO, object>(x=>x.Voyage!)">Voyage</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:200px">POD</MudTh>
            <MudTh Style="width:200px; text-align:start">
                <MudTableSortLabel SortBy="new Func<ExportOrderComponentDTO, object>(x=>x.Carrier!)">Carrier</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width: 80px">
                <MudTableSortLabel SortBy="new Func<ExportOrderComponentDTO, object>(x=>x.Status!)">Status</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width: 35px"></MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudTooltip Text="view Details">
                    <MudIconButton Class="wrapper-iconbutton" Disabled="@IsLoadingData" Icon="@Icons.Material.Outlined.Edit"
                                    OnClick="@(async()=>{ await ShowItem_Click(context.Id); })" />
                </MudTooltip>
            </MudTd>
            <MudTd>
                <MudTooltip Text="view Export Order">
                    <MudIconButton Class="wrapper-iconbutton" Disabled="@IsLoadingData" Icon="@Icons.Material.Outlined.Print"
                                    OnClick="@(async()=>{ await ViewReportExpOrder_Click(context.Id); })" />
                </MudTooltip>
            </MudTd>
            <MudTd>
                <MudTooltip Text="save xml file">
                    <MudIconButton Class="wrapper-iconbutton" Disabled="@IsLoadingData" Icon="@Icons.Material.Outlined.FileDownload"
                                   OnClick="@(async()=>{ await SaveXMLfile_Click(context.Id); })" />
                </MudTooltip>
            </MudTd>
            <MudTd>
                <MudButton Class="Button" OnClick="@(async()=>{ await ViewReportBL_Click(context.Id); })"
                            Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                            StartIcon="@Icons.Material.Filled.Preview">
                    view BL
                </MudButton>
            </MudTd>
            <MudTd>@context.Num</MudTd>
            <MudTd>@context.Dated</MudTd>
            <MudTd>@context.Vessel</MudTd>
            <MudTd>@context.Voyage</MudTd>
            <MudTd>@context.POD</MudTd>
            <MudTd Style="text-align:start">@context.Carrier</MudTd>
            <MudTd>@context.Status.ToString()</MudTd>
            <MudTd>
                <MudIconButton Class="wrapper-iconbutton" Disabled="@IsLoadingData" Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Secondary"
                               OnClick="@(async()=>{ await RemoveItem_Click(context.Id, context.Num!); })" />
            </MudTd>
            <MudTd></MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

    @code {
    private MudTable<ExportOrderComponentDTO>? mudTable;

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    public IEnumerable<ExportOrderComponentDTO>? Items { get; set; } = new List<ExportOrderComponentDTO>();
    private FilterParameters Filter { get; set; } = new();
    private bool IsLoadingData {get; set; } = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _exportOrderProvider.GetItemsAsync(Filter);

        if (!response.HasError)
            Items = ((IEnumerable<ExportOrderComponentDTO>)response.Object!).ToArray();

        await Task.Delay(500);        

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowItem_Click(long id)
    {
        // if (MudDialog is not null)
        //     MudDialog.Close(DialogResult.Ok(id));

        DialogParameters parameters = new DialogParameters { ["Id"] = id };
        DialogOptions options = new DialogOptions { FullScreen = true, NoHeader = true, DisableBackdropClick = false };
        var dialog = await DialogService.ShowAsync<ExportOrder_ItemDialog>(null, parameters, options);

        DialogResult result = await dialog.Result;

        if (!result.Canceled)
            await GetItems();
    }

    private async Task RemoveItem_Click(long id, string num)
    {
        // check Satus before delete
        if (Items!.FirstOrDefault(eoc => eoc.Id == id)!.Status != EntityStatus.New)
        {
            Snackbar.Add($"Удалить можно только новую запись: Status - New.", Severity.Warning);
            return;
        }
        
        bool? result = await DialogService.ShowMessageBox(
                 "Delete record",
                 (MarkupString)$"<b>Do you want to remove record with {num}?<b>",
                 yesText: "REMOVE", cancelText: "NO");

        if (!result.HasValue) return;

        if (result.Value)
        {
            IsLoadingData = true;

            var response = await _exportOrderProvider.RemoveItemAsync(id);
            if (!response.HasError)
            {
                Items!.ToList().Remove(Items!.FirstOrDefault(eoc => eoc.Id == id)!);
                Snackbar.Add($"Deleted successfully", Severity.Success);
            }
            else
                Snackbar.Add($"Record wasn't deleted.<br>{response.Error.First()}", Severity.Warning);                
        }

        await GetItems();

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);

    }

    private async Task ViewReportExpOrder_Click(long id)
    {
        string path = $"{Navigation.BaseUri}server/ExportOrder/ViewReportExpOrder?Id={id}";
        await jSRuntime.InvokeVoidAsync("open", path);
    }

    private async Task ViewReportBL_Click(long id)
    {
        string path = $"{Navigation.BaseUri}server/ExportOrder/ViewReportBL?Id={id}";

        await jSRuntime.InvokeVoidAsync("open", path);
        //TimeSpan timeSpan = new TimeSpan(0,0,0,0,200);
        //await jSRuntime.InvokeVoidAsync("open", timeout: timeSpan, path);
    }

    private async Task SaveXMLfile_Click(long id)
    {
        string path = $"{Navigation.BaseUri}server/ExportOrder/SaveXMLfile?Id={id}";
        await jSRuntime.InvokeVoidAsync("open", path);
    }

    #region SEARCHERS

    private async Task<IEnumerable<string>> SearchVessel(string value)
    {
        var result = await _vesselProvider.GetNamesEn();

        if (string.IsNullOrWhiteSpace(value))
            return result;

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    private async Task<IEnumerable<string>> SearchVoyage(string value)
    {        
        var result = await _vesselCallProvider.GetVoyages(Filter.Vessel);

        if (string.IsNullOrWhiteSpace(value))
            return result.Distinct();                      //return Enumerable.Empty<string>();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).Distinct();
    }

    private async Task<IEnumerable<string>> SearchPort(string value)
    {
        var result = await _locationProvider.GetNames();

        if (string.IsNullOrWhiteSpace(value))
            return result;

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchCarrier(string value)
    {
        var result = await _carrierProvider.GetNamesEn();

        if (string.IsNullOrWhiteSpace(value))
            return result;

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    #endregion
}
