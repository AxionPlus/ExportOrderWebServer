

<MudCarousel Class="mud-width-full" Style="height:200px;" AutoCycle="false" TData="object" ShowBullets="false">
    <PreviousButtonTemplate>
        <div Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
            <span class="mud-icon-button-label">
                <MudIcon Class="mud-ripple mud-ripple-icon mud-icon-button-size-medium" Icon="@Icons.Material.Filled.SkipPrevious" Color="@Color.Inherit" />
            </span>
        </div>
    </PreviousButtonTemplate>
    <NextButtonTemplate>
        <div Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
            <span class="mud-icon-button-label">
                <MudIcon Class="mud-ripple mud-ripple-icon mud-icon-button-size-medium" Icon="@Icons.Material.Filled.SkipNext" Color="@Color.Inherit" />
            </span>
        </div>
    </NextButtonTemplate>
    <ChildContent>
        <MudCarouselItem Transition="@Transition.Slide">
            <div class="d-flex" style="height:100%">
                @foreach (var document in Documents)
                {
                    <div class="d-flex">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(()=>{SelectedDocument=document;})"></MudIconButton>
                        @document
                    </div>                    
                }
            </div>
        </MudCarouselItem>
        <MudCarouselItem Transition="@Transition.Slide">
            <div class="d-flex" style="height:100%">
                @foreach (var record in SelectedDocument.Records)
                {
                    <div class="d-flex">
                        @*<MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(()=>{ExportOrderRecord.DocumentRecord=record;})"></MudIconButton>*@
               
                    </div>
                }
            </div>
        </MudCarouselItem>
                <MudCarouselItem Transition="@Transition.Slide">
            <div class="d-flex" style="height:100%">
@*                @(SelectedDocument is not null ? SelectedDocument.Name)
                @(SelectedDocumentRecord is not null ? SelectedDocumentRecord.CommodityName)*@

@*                <MudAutocomplete T="string" Label="Container" @bind-Value="value1" SearchFunc="@ContainerSearch"
                                 CoerceText="true" CoerceValue="true" />*@

@*                <MudTextField @bind-Value="@ExportOrderRecord.Seal" Label="Standard" Variant="Variant.Outlined"></MudTextField>
                <MudTextField @bind-Value="@ExportOrderRecord.NetWt" Label="Standard" Variant="Variant.Outlined"></MudTextField>
                <MudTextField @bind-Value="@ExportOrderRecord.GrossWt" Label="Standard" Variant="Variant.Outlined"></MudTextField>*@

            </div>
        </MudCarouselItem>
    </ChildContent>


</MudCarousel>



