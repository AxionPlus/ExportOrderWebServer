@inject ISnackbar Snackbar
@inject IDialogService DialogService;
@inject IExportOrderProvider _exportOrderProvider
@inject ICntrTypeProvider _cntrTypeProvider
@inject ICarrierProvider _carrierProvider

<style>

    .Container-item > .container-content{
        justify-content:flex-start;
    }

    .mud-picker-inline {
        flex: unset;
    }

    .sub-Table {
        background-color: lightblue;
        transition: none;
        box-shadow: none;
    }

    .Table * .mud-table-cell {
        padding: 4px;
    }

    .Table * .mud-table-cell *.mud-input-control {
        margin:unset;
    }

    .Table * .mud-table-cell *.mud-input > input.mud-input-root-outlined {
        padding: 4px 4px 1px 4px;
    }

    .tfoot {
        color: #0a58ca;
    }

    .TextField_Sum * .mud-input > input.mud-input-root-outlined {
        text-align: end;
    }

    .NumericField_Content * .mud-input > input.mud-input-root-outlined {
        text-align: end;
    }

    .QuantityField * .mud-input > input.mud-input-root-outlined {
        text-align:center;
    }

    .h6 {
        margin-bottom: 2px;
    }

</style>

@if (Value is not null)
{ 
    <div class="Container-item">
        <div class="container-head">INFO</div>
        <div class="container-content">
            <MudTextField Class="TextField" Style="width: 150px; margin-right: 20px" T="string" Label="Number" Value="@Value!.Num"
                          ValueChanged="async (e) => { Value.Num = e.ToUpper(); }"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Required RequiredError=""
                          ReadOnly="!IsNewItem" Clearable="IsNewItem" />

            <MudDatePicker Class="DatePicker" Style="width: 150px" Label="Date" Date="@Value.Dated"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           DateFormat="dd.MM.yy" IconSize=Size.Small
                           ReadOnly="!IsNewItem" Clearable="IsNewItem" />
            <MudSpacer />

            <MudTextField Class="TextField" Style="width: 400px; margin-right: 20px" @bind-Value="@Value!.VesselCall!.Vessel.Name"
                           Label="Vessel Call" Placeholder="Vessel Call"
                           Text="@(Value.VesselCall!.Vessel.Name is not null ? Value.VesselCall!.Vessel.Name + " / " + Value.VesselCall.VoyageCarrier : "")"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Required RequiredError=""
                           ReadOnly="!IsNewItem" Clearable="IsNewItem"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Waves" OnAdornmentClick="GetVesselCall_Click" />

            <MudAutocomplete T="CarrierCatalog" Style="width: 350px" Label="Carrier" @bind-Value="Value.Carrier"
                             ToStringFunc="@(e => e != null ? e.Name : "")"
                             SearchFunc="@SearchCarrier"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Required RequiredError=""
                             CloseIcon="" OpenIcon=""
                             ResetValueOnEmptyText="true"
                             Placeholder="Carrier"
                             MaxItems="20"
                             IconSize="Size.Small"
                             ReadOnly="!IsNewItem" Clearable="IsNewItem" />
            <MudSpacer />
            <div style="margin-right:20px">
                <h6>@Value.Status.ToString()</h6>
            </div>            
        </div>
    </div>

    <div class="Container-item">
        <div class="container-head">DOCUMENTS</div>
        <div class="container-content">
                <div class="documents">
                    <div class="controlIconButtons">
                        @if (DocumentItems.Count > 0)
                        {
                            <MudCheckBox Class="wrapper-checkBox" Dense="true" Size="Size.Small" @bind-Checked="@MultiSelectionTreeItemData" />
                        }
                        else
                        {
                            <div style="width: 10px"></div>
                        }
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddDocument_Click"></MudIconButton>
                        <MudIconButton Icon="@Icons.Material.Filled.List" Size="Size.Small"></MudIconButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="RemoveDocument"></MudIconButton>
                    </div>

                    <MudPaper Width="450px" Elevation="0" Style="height:246px;overflow: auto;">
@*                          <MudTreeView Items="TreeItems" Dense="true" Hover="true"
                                    MultiSelection="MultiSelectionTreeItemData" @bind-SelectedValues="SelectedValues" >
                            <ItemTemplate>
                            <MudTreeViewItem Items="@context.TreeItems"
                                                Value="@context"
                                                LoadingIconColor="Color.Info"
                                                CanExpand="@context.CanExpand"
                                                Text="@context.Title"
                                                EndText="@context.Number?.ToString()"
                                                EndTextTypo="@Typo.caption"
                                                OnClick="TreeViewItem_Click" />
                            </ItemTemplate>
                        </MudTreeView> *@

                    <MudTreeView MultiSelection="@MultiSelectionTreeItemData" Items="DocumentItems" @bind-SelectedValues="SelectedDocumentValues"
                                     Dense="true" Hover="true">
                            <ItemTemplate>
                                <MudTreeViewItem Value="@context"
                                                 Text="@context.Name"
                                                 EndText="@context.Records.Count().ToString()"
                                                 LoadingIconColor="Color.Info"
                                                 EndTextTypo="@Typo.caption">
    @*                                 <MudDataGrid Items="DocumentRecordItems.Where(x => x.Document.Id == context.Id)">
                                        <Columns>
                                            <PropertyColumn Property="x => x.Seq" />
                                            <PropertyColumn Property="x => x.CommodityHSCode" />
                                            <PropertyColumn Property="x => x.CommodityName" />
                                        </Columns>
                                    </MudDataGrid> *@
                                    <MudTable @ref="mudDocRecordsTable" Class="Table" T="DocumentRecord" Context="DocRecords"
                                              Items="DocumentRecordItems.Where(x => x.Document.Id == context.Id)" >
                                              @* Items="context.Records.Where(x => x.Document.Id == context.Id)" *@
                                    
                                        <RowTemplate>
                                            <MudTd Style="width: 30px">@DocRecords.Seq</MudTd>
                                            <MudTd Style="width: 115px">@DocRecords.CommodityHSCode</MudTd>
                                            <MudTd Style="text-align:left">@DocRecords.CommodityName</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </MudTreeViewItem>
                            </ItemTemplate>
                        </MudTreeView>
                    </MudPaper>
                </div>
            <div class="documents-info" style="margin-left: 20px; min-width:fit-content; max-width:fit-content">
                <h5>Shippers:</h5>
                @foreach (var shipper in Value.Shippers.GroupBy(x => x.Name, (key, group) => new String(group.FirstOrDefault()!.Name)))
                {
                    @(string.Join(" / ", shipper));
                }
                <br />
                <h5>Consignees:</h5>
                @foreach (var consignee in Value.Consignees.GroupBy(x => x.Name, (key, group) => new String(group.FirstOrDefault()!.Name)))
                {
                    @(string.Join("; ", consignee));
                }                
            </div>
        </div>
    </div>

    <div class="Container-item">
        <div class="container-head">CONTAINER RECORDS</div>        
        <div class="Container-table">
            @if (mudTable != null)
            {
                <div class="tableMenu">
                    <MudButton Class="Button" OnClick="@(async()=>{ await UploadFile(); })"
                                Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small"
                                StartIcon="@Icons.Material.Filled.UploadFile">
                        Upload New List
                    </MudButton>
                    <MudSpacer />
                    <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
                    <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Value.Records!.Count())</span>
                </div>
            }

            <MudTable Class="Table" @ref="mudTable" T="ExportOrderRecord" Items="@Value.Records" Context="expOrderRecords"
                      Loading="IsLoadingData" Virtualize="true" FixedHeader="true" FixedFooter="true" RowsPerPage="20">

                <HeaderContent>
                    <MudTh Style="width:40px;">
                        <div class="controlIconButtons">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddContainerRecord_Click" Size="Size.Small" />
                        </div>
                    </MudTh>
                    <MudTh Style="width: 120px">Nr</MudTh>
                    <MudTh Style="width: 80px">Type</MudTh>
                    <MudTh Style="width: 80px">TareWt</MudTh>
                    <MudTh Style="width: 300px">Seals</MudTh>
                    <MudTh Style="width: 30px"></MudTh>
                    <MudTh Style="width: 80px">QTY</MudTh>
                    <MudTh Style="width: 120px">NET</MudTh>
                    <MudTh Style="width: 120px">GROSS</MudTh>
                    <MudTh Style="width: 30px"></MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(async ()=>{ await RemoveContainerRecord(expOrderRecords);})" />
                    </MudTd>
                    <MudTd>
                        <MudTextField Class="TextField" T="string" @bind-Value="expOrderRecords.CntrNum"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Required RequiredError="" />
                    </MudTd>                    
                    <MudTd>
                         <MudSelect Class="SelectField" T="CntrTpSz" @bind-Value="@expOrderRecords.CntrType"
                                    Variant="Variant.Outlined" Margin="Margin.Dense"
                                    CloseIcon="" OpenIcon="">
                             @if (CntrTypes is not null)
                                @foreach (var type in CntrTypes)
                                {
                                    <MudSelectItem Value="@type">@type.Normolize!.ToString()</MudSelectItem>
                                }
                        </MudSelect>
                    </MudTd>
                    <MudTd>
                         <MudNumericField Class="QuantityField" T="double?" @bind-Value="expOrderRecords.CntrTareWt"
                                          
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Required RequiredError="" HideSpinButtons="true"/>
                    </MudTd>
                    <MudTd>
                         <MudTextField Class="TextField" T="string" @bind-Value="expOrderRecords.Seal"
                                       Style="width: 290px"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Required RequiredError="" />
                    </MudTd>
                    <MudTd></MudTd>
                     <MudTd>
                         <MudTextField Class="QuantityField" T="string" Text="@expOrderRecords.Contents.Sum(s => s.Quantity).ToString()"
                                       Style="width: 80px"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" />
                     </MudTd>
                     <MudTd>
                         <MudTextField Class="TextField_Sum" T="string" Text="@expOrderRecords.Contents.Sum(s => s.NetWt).ToString("00 000.000")"
                                       Style="width: 120px"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" />
                     </MudTd>
                     <MudTd>
                         <MudTextField Class="TextField_Sum" T="string" Text="@expOrderRecords.Contents.Sum(s => s.GrossWt).ToString("00 000.000")"
                                       Style="width: 120px"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" />
                     </MudTd>
                    <MudTd>
                         <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Style="@(expOrderRecords.IsShowCntrContent ? "transform: rotate(180deg);" : "")"
                                        Size="@Size.Small" OnClick="(_)=>{expOrderRecords.IsShowCntrContent = !expOrderRecords.IsShowCntrContent;}" />
                    </MudTd>
                </RowTemplate>
                <ChildRowContent>
                    @if (expOrderRecords.IsShowCntrContent)
                    {
                        <MudTr>
                            <td colspan="4"></td>
                            <td colspan="5">
                                <MudTable Class="sub-Table" T="ContainerContent" Context="CntrContent" Items="@expOrderRecords.Contents">
                                    <RowTemplate>

                                        <MudTd Style="width:300px; padding-right:12px; text-align:end">@CntrContent.DocumentRecord.Document.Name</MudTd>
                                        <MudTd Style="width:30px">@CntrContent.DocumentRecord.Seq</MudTd>
                                        <MudTd>
                                            <MudNumericField Class="QuantityField" T="uint" @bind-Value="CntrContent.Quantity"
                                                             Style="width: 80px"
                                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                                             Required RequiredError="" HideSpinButtons=true />
                                        </MudTd>
                                        <MudTd>
                                            <MudNumericField Class="NumericField_Content" T="double" @bind-Value="CntrContent.NetWt"
                                                             Style="width: 120px"
                                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                                             Required RequiredError="" HideSpinButtons=true />
                                        </MudTd>
                                        <MudTd>
                                            <MudNumericField Class="NumericField_Content" T="double" @bind-Value="CntrContent.GrossWt"
                                                             Style="width: 120px"
                                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                                             Required RequiredError="" HideSpinButtons=true />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </td>
                            <td colspan="2"></td>
                         </MudTr>
                    }
                </ChildRowContent>
                <PagerContent></PagerContent>
                <FooterContent>
                    @if (Value.Records!.Count > 0)
                    {
                        <td></td>
                        <td colspan="2">
                            <MudTd><h6>Total containers: @Value.Records!.Count().ToString("000")</h6></MudTd>
                        </td>
                        <MudTd Style="text-align:center"><h6>@Value.Records!.Sum(s => s.CntrTareWt).ToString()</h6></MudTd>
                        <td colspan="2"></td>
                        <MudTd Style="text-align:center"><h6>@Value.Records.Sum(s => s.Contents.Sum(c => c.Quantity)).ToString()</h6></MudTd>
                        <MudTd Style="text-align:end; padding-right: 8px"><h6>@Value.Records.Sum(s => s.Contents.Sum(c => c.NetWt)).ToString("000 000.000")</h6></MudTd>
                        <MudTd Style="text-align:end; padding-right: 8px"><h6>@Value.Records.Sum(s => s.Contents.Sum(c => c.GrossWt)).ToString("000 000.000")</h6></MudTd>
                    }
                </FooterContent>                
            </MudTable>
        </div>
    </div>
}

@code {
    private MudForm? Form;
    private MudTable<ExportOrderRecord>? mudTable;
    private MudTable<DocumentRecord>? mudDocRecordsTable;

    [CascadingParameter]
    MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public ExportOrderEntity? Value { get; set; }
    [Parameter]
    public EventCallback<ExportOrderEntity> ValueChanged { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; }

    private IEnumerable<CntrTpSz> CntrTypes { get; set; } = new List<CntrTpSz>();
    private UploadResult? uploadResult { get; set; }

    bool IsLoadingData = false;
    bool IsItemSelected { get; set; }


    protected override async void OnInitialized()
    {
        CntrTypes = await _cntrTypeProvider.GetCntrTypes();

        DocumentItems = Value!.Documents!.ToHashSet();        

        foreach (var document in DocumentItems)
            foreach (var docRecord in document.Records)
                DocumentRecordItems.Add(docRecord);
    }

    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    #region DOCUMENTS

    async Task AddDocument_Click()
    {
        DialogParameters parameters = new DialogParameters { ["IsSelectable"] = true };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraLarge, DisableBackdropClick = true };
        var dialog = await DialogService.ShowAsync<DocumentComponent>("ADD DOCUMENT", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var documents = (HashSet<DocumentEntity>)result.Data;

            Value!.Documents!.AddRange(documents);

            await ValueChanged.InvokeAsync(Value);

            foreach (var document in documents)
            {
                DocumentItems.Add(document);

                foreach (var docRecord in document.Records)
                    DocumentRecordItems.Add(docRecord);
            }
        }
    }

    private async Task RemoveDocument()
    {
        await Task.Delay(50);

        if (SelectedDocumentValues!.Count > 0)
        {
            foreach (var item in SelectedDocumentValues)
            {
                DocumentItems.Remove(item);
                Value!.Documents!.Remove(item);
            }

            SelectedDocumentValues.Clear();
        }

        await InvokeAsync(StateHasChanged);
    }

    #endregion

    #region CNTR RECORDS

    private async Task AddContainerRecord_Click()
    {
        if (Value!.Documents is null) return;

        if (Value.Documents.Count() == 0) return;

        var parameters = new DialogParameters() { ["Documents"] = Value.Documents };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, DisableBackdropClick = true };
        var dialog = await DialogService.ShowAsync<ExportOrder_ContainerContentComponent>("Container record", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            //await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RemoveContainerRecord(ExportOrderRecord record)
    {
        if (record is null)
            return;

        bool? result = await DialogService.ShowMessageBox(
                 "Delete record",
                 (MarkupString)$"<b>Do you want to remove record with {record.CntrNum}?<b>",
                 yesText: "REMOVE", cancelText: "NO");

        if (!result.HasValue) return;

        if (result.Value)
            Value!.Records!.Remove(record);

        await InvokeAsync(StateHasChanged);
    }


    private async Task UploadFile()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        var options = new DialogOptions() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true, DisableBackdropClick = true };
        dialog = DialogService.Show<UploadExportOrderRecordsFile>("INPUT: list of records", options);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if(result.Data != null)
            {
                uploadResult = (UploadResult)result.Data;

                if (uploadResult._Documents is null)
                {
                    Snackbar.Add($"Document is null", Severity.Warning);
                    Snackbar.Add($"{uploadResult.Summary.FirstOrDefault()}", Severity.Warning);
                    return;
                }

                var records = uploadResult!._ExportOrderRecords!.ToList();
                var documents = uploadResult!._Documents!.ToList();

                foreach (var document in documents)
                {
                    DocumentItems.Add(document);

                    foreach (var docRecord in document.Records)
                    {
                        docRecord.Document = document;
                        DocumentRecordItems.Add(docRecord);
                    }
                }                

                foreach (var record in records)
                    foreach (var cntrContent in record.Contents)
                        cntrContent.DocumentRecord.Document = documents.First(s => s.Records.Any(s => s.Id == cntrContent.DocumentRecord.Id));

                Value!.Records = records;
                Value.Documents = documents;

                Snackbar.Add($"Uploaded", Severity.Success);

                await ValueChanged.InvokeAsync(Value);
            }
        }
    }
        

    #endregion


    #region SEARCH
    private async Task GetVesselCall_Click()
    {
        DialogParameters parameters = new DialogParameters { ["IsSelectable"] = true };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, DisableBackdropClick = true };
        var dialog = await DialogService.ShowAsync<VesselCallComponent>("select VESSEL CALL", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {            
            Value!.VesselCall = (VesselCallEntity)result.Data;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<IEnumerable<CarrierCatalog>> SearchCarrier(string value)
    {
        var Carriers = new List<CarrierCatalog>();

        var response = await _carrierProvider.GetItemsAsync();
        if (!response.HasError)
            Carriers = ((IEnumerable<CarrierCatalog>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Carriers;

        return Carriers.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    #endregion

    #region  TreeItems

    bool MultiSelectionTreeItemData = false;

    private HashSet<DocumentEntity>? SelectedDocumentValues { get; set; }

    private HashSet<DocumentEntity> DocumentItems { get; set; } = new HashSet<DocumentEntity>();

    private HashSet<DocumentRecord> DocumentRecordItems { get; set; } = new HashSet<DocumentRecord>();


