@page "/exportorder"

@inject ISnackbar Snackbar
@inject IJSRuntime jsRuntime
@inject AuthenticationStateProvider authenticationStateProvider
@inject IExportOrderProvider _exportOrderProvider
@inject IVesselCallProvider _vesselCallProvider

<style></style>

<MudContainer MaxWidth="MaxWidth.Large">

    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">
            <div class="ToolBar-iconbutton">
                <MudTooltip Text="EXIT">
                    <MudIconButton Class="ToolBar-IconButton" Style="transform: rotate(180deg)" Icon="@Icons.Material.Outlined.ExitToApp" OnClick="CloseWindow" />
                </MudTooltip>
            </div>
            <MudSpacer />
            <div class="ToolBar-Title">
                <span>Export Order</span>
            </div>
            <MudSpacer />
            <div class="ToolBar-iconbutton" style="margin-right:20px">
                <MudTooltip Class="ExitIconButton" Text=@(IsFormReadOnly ? "Edit" : "Save") Delay="500" Duration="1000">
                    @if (IsFormReadOnly)
                    {
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Edit" OnClick="EditItem" />
                    }
                    else
                    {
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" OnClick="SaveItem" />
                    }
                </MudTooltip>
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
            </div>
        </MudToolBar>
    </div>

    <MudForm @ref="@Form" ReadOnly="IsFormReadOnly">
        @if (Item != null)
        {
            <ExportOrder_ItemComponent @bind-Value="Item" IsFormReadOnly="IsFormReadOnly" />
        }
    </MudForm>

</MudContainer>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudForm? Form;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    [SupplyParameterFromQuery]
    [Parameter]
    public long Id { get; set; }

    [SupplyParameterFromQuery]
    [Parameter]
    public long vcdId { get; set; }

    [SupplyParameterFromQuery]
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private ExportOrderEntity? Item { get; set; }
    public bool IsFormReadOnly { get; set; } = true;
    public bool IsLoadingData { get; set; } = false;
    private bool IsAuth = false;


    protected override async Task OnInitializedAsync()
    {
        await GetItem();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("TopManager") || user.User.IsInRole("ExpDept"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        var response = new AppObjectResponse();
        
        if (IsNewItem)
        {
            var vesselCallDetail = new VesselCallDetail();

            response = await _vesselCallProvider.GetVesselCallDetailItemAsync(vcdId);
            if (!response.HasError)
            {
                vesselCallDetail = (VesselCallDetail)response.Object!;
            }
            else
                Snackbar.Add($"{response.Error.First()}", Severity.Error);
                            
            //Item = new() { Carrier = new(), VesselCallDetail = vesselCallDetail, Person = new(), Status = EntityStatus.New };
            Item = new() { VesselCallDetail = vesselCallDetail };

            IsFormReadOnly = false;
        }
        else
        {
            response = await _exportOrderProvider.GetItemAsync(Id);
            if (!response.HasError)
            {
                Item = (ExportOrderEntity)response.Object!;
            }
        }
    }

    public async Task SaveItem()
    {
        IsLoadingData = true;

        await Form!.Validate();

        if (Form.IsValid)
            if (IsNewItem)
            {
                var response = await _exportOrderProvider.NewItemAsync(Item!);
                if (!response.HasError)
                    Snackbar.Add("Saved Successfully", Severity.Success);
                else
                {
                    Snackbar.Add($"No Success<br>{response.Error.FirstOrDefault()}", Severity.Error);
                    IsLoadingData = false;
                    return;
                }
            }
            else
            {
                var response = await _exportOrderProvider.ModifyItemAsync(Item!);
                if (!response.HasError)
                    Snackbar.Add("Save Successed", Severity.Success);
                else
                {
                    Snackbar.Add($"No Success<br>{response.Error.FirstOrDefault()}", Severity.Error);
                    IsLoadingData = false;
                    return;
                }
            }
        else
        {
            Snackbar.Add("Fill up all reqired fields", Severity.Error);
            IsLoadingData = false;
            return;
        }

        IsNewItem = false;

        Id = Item!.Id;

        await GetItem();

        await Task.Delay(1000);

        IsFormReadOnly = true;
        IsLoadingData = false;
    }

    public async Task EditItem()
    {
        await Task.Delay(10);
        IsFormReadOnly = false;
    }

    public void CloseWindow()
    {
        jsRuntime.InvokeVoidAsync("window.close");
    }
}
