@page "/exportorder"
@attribute [Authorize(Roles = "Admin, Top Manager, Manager")]

@inject ISnackbar Snackbar
@inject IJSRuntime jsRuntime
@inject AuthenticationStateProvider authenticationStateProvider
@inject IExportOrderProvider _exportOrderProvider
@inject IVesselCallProvider _vesselCallProvider

<style></style>

<MudContainer MaxWidth="MaxWidth.Large">

    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">
            <div class="ToolBar-iconbutton">
                <MudTooltip Text="EXIT">
                    <MudIconButton Class="ToolBar-IconButton" Style="transform: rotate(180deg);" OnClick="CloseDialogOrPage"
                                   Icon="@Icons.Material.Outlined.ExitToApp" />
                </MudTooltip>
            </div>

            @if (IsFormReadOnly)
            {
                <div class="ToolBar-iconbutton" style="margin-left:20px">
                    <MudTooltip Class="ExitIconButton" Text="Copy Export Order" Delay="500" Duration="1000">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.CopyAll" OnClick="CopyItem" />
                    </MudTooltip>
                </div>
            }
            else
            {
                <div class="ToolBar-iconbutton" style="margin-left:20px">
                    <MudTooltip Class="ExitIconButton" Text="Refresh page" Delay="500" Duration="1000">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Refresh" OnClick="GetItem" />
                    </MudTooltip>
                </div>
            }
            <MudSpacer />
            <div class="ToolBar-Title">
                <span>Export Order</span>
            </div>
            <MudSpacer />
            @if (IsEditSaveBtnsVisible)
            {
                <div class="ToolBar-iconbutton" style="margin-right:20px">
                    <MudTooltip Class="ExitIconButton" Delay="500" Duration="1000" Text=@(IsFormReadOnly ? "edit" : "save")>
                        @if (IsFormReadOnly)
                        {
                            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Edit" OnClick="EditItem" />
                        }
                        else
                        {
                            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" OnClick="SaveItem" />
                        }
                    </MudTooltip>
                </div>
            }
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
            </div>
        </MudToolBar>
    </div>

    <MudForm @ref="@Form" ReadOnly="IsFormReadOnly">
        @if (Item != null)
        {
            <ExportOrder_ItemComponent @bind-Value="Item" IsFormReadOnly="IsFormReadOnly" IsRoleForEdit="IsRoleForEdit" />
        }
    </MudForm>

</MudContainer>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudForm? Form;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [CascadingParameter] public string? ApplicationUser { get; set; }

    [SupplyParameterFromQuery]
    [Parameter]
    public long Id { get; set; }

    [SupplyParameterFromQuery]
    [Parameter]
    public long vcdId { get; set; }

    [SupplyParameterFromQuery]
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private ExportOrderEntity? Item { get; set; }
    public bool IsFormReadOnly { get; set; } = true;
    public bool IsLoadingData { get; set; } = false;
    private bool IsAuth = false;
    private bool IsRoleForEdit = false;

    public bool IsEditSaveBtnsVisible { get; set; } = true;


    protected override async Task OnInitializedAsync()
    {        
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();

        ApplicationUser = authState.User.Identity?.Name;
        if (authState.User.IsInRole("Admin") || authState.User.IsInRole("Top Manager"))
        {
            IsRoleForEdit = true;
            IsAuth = true;
        }
        else if (authState.User.IsInRole("Manager")) IsAuth = true;        

        await GetItem();
    }

    private async Task GetItem()
    {
        var response = new AppObjectResponse();

        if (IsNewItem)
        {
            IsFormReadOnly = false;

            if (vcdId == 0)
                Item = new();
            else
            {
                response = await _vesselCallProvider.GetVesselCallDetailAsync(vcdId);
                if (!response.HasError && response.Object is not null)
                    Item = new() { VesselCallDetail = (VesselCallDetail)response.Object };
            }   
        }
        else
        {
            response = await _exportOrderProvider.GetItemAsync(Id);
            if (!response.HasError && response.Object is not null)
            {
                Item = (ExportOrderEntity)response.Object;

                if (Item.Status.Equals(EntityStatus.Cancelled))
                    if (!IsRoleForEdit)
                        IsEditSaveBtnsVisible = false;
            }
        }        
    }

    private async Task SaveItem()
    {
        if (Item is null) return;

        IsLoadingData = true;

        await Form!.Validate();

        if (Form.IsValid)
            if (IsNewItem)
            {
                var response = await _exportOrderProvider.NewItemAsync(Item);
                if (!response.HasError)
                    Snackbar.Add("Saved Successfully", Severity.Success);
                else
                {
                    Snackbar.Add($"No Success<br>{response.Error.FirstOrDefault()}", Severity.Error);
                    IsLoadingData = false;
                    return;
                }
            }
            else
            {
                var response = await _exportOrderProvider.ModifyItemAsync(Item, ApplicationUser!);
                if (!response.HasError)
                    Snackbar.Add("Save Successed", Severity.Success);
                else
                {
                    Snackbar.Add($"No Success<br>{response.Error.FirstOrDefault()}", Severity.Error);
                    IsLoadingData = false;
                    return;
                }
            }
        else
        {
            Snackbar.Add("Fill up all reqired fields", Severity.Error);
            IsLoadingData = false;
            return;
        }

        IsNewItem = false;

        Id = Item.Id;

        //await InvokeAsync(StateHasChanged);

        await GetItem();

        //await Task.Delay(1000);

        IsFormReadOnly = true;
        IsLoadingData = false;               
    }    

    private async Task CopyItem()
    {
        if (Item is not null)
        {
            Item.Id = 0;

            foreach (var record in Item.Records)
            {
                record.Id = 0;

                foreach (var content in record.Contents)
                    content.Id = 0;
            }

            Item.Num = Item.Status == EntityStatus.Customs || Item.Status == EntityStatus.Cancelled ? Item.Num + "-" : string.Empty;

            Item!.Status = EntityStatus.New;

            IsEditSaveBtnsVisible = true;

            IsNewItem = true;
            await Task.Delay(100);
            IsFormReadOnly = false;
        }
    }

    private void EditItem()
    {
        //await Task.Delay(100);

        IsFormReadOnly = false;
    }

    private void CloseDialogOrPage()
    {
        if (MudDialog != null)
            MudDialog!.Close();
        else
            jsRuntime.InvokeVoidAsync("window.close");
    }
}
