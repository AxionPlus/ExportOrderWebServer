@page "/exportorder"
@using ExportOrderWebServer.Areas.Import.VesselCall.Provider
@attribute [Authorize(Roles = "Admin, Top Manager, Manager")]

@inject ISnackbar Snackbar
@inject IJSRuntime jsRuntime
@inject IDialogService DialogService
@inject AuthenticationStateProvider authenticationStateProvider
@inject IExportOrderProvider _exportOrderProvider
@inject IVesselCallProvider _vesselCallProvider
@inject IImportVesselCallProvider _importVesselCallProvider
@inject IValidationService ValidationService

<MudContainer MaxWidth="MaxWidth.Large">
    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">
            <div class="ToolBar-iconbutton">
                <MudTooltip Text="EXIT">
                    <MudIconButton Class="ToolBar-IconButton" Style="transform: rotate(180deg);" OnClick="CloseDialogOrPage"
                                   Icon="@Icons.Material.Outlined.ExitToApp" />
                </MudTooltip>
            </div>
            <div class="ToolBar-iconbutton" style="margin-left:20px">
                <MudTooltip Class="ExitIconButton" Text="Copy Export Order" Delay="500" Duration="1000">
                    <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.CopyAll" OnClick="CopyItem" />
                </MudTooltip>
            </div>
            <MudSpacer />
            <div class="ToolBar-Title">
                <span>Export Order</span>
            </div>
            <MudSpacer />            
            <div class="ToolBar-iconbutton" style="margin-right:20px">
                <MudTooltip Delay="500" Duration="1000" Text="Save">
                    <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" Color="Color.Primary" OnClick="SaveItem" />
                </MudTooltip>
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
            </div>
        </MudToolBar>
    </div>

    <MudForm @ref="@Form" >
        <ExportOrder_ItemComponent @bind-Value="Item" IsRoleForEdit="IsRoleForEdit" />
    </MudForm>    
</MudContainer>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudForm? Form;
    public string? ApplicationUser { get; set; }
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    private bool IsDialogResultOk { get; set; } = false;    

    [SupplyParameterFromQuery]
    [Parameter]
    public long Id { get; set; }

    [SupplyParameterFromQuery]
    [Parameter]
    public long vcdId { get; set; }

    private ExportOrderEntity Item { get; set; } = new();

    private bool IsLoadingData { get; set; } = false;    
    private bool IsRoleForEdit = false;

    protected override async Task OnInitializedAsync()
    {        
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();

        ApplicationUser = authState.User.Identity?.Name;

        if (authState.User.IsInRole("Admin") || authState.User.IsInRole("Top Manager"))
            IsRoleForEdit = true;

        await GetItem();
    }

    private async Task GetItem()
    {
        AppObjectResponse response = new();

        if (Id == 0)
        {
            /// create a new Item with a certain VesselCallDetail
            if (vcdId != 0)
            {
                response = await _vesselCallProvider.GetVesselCallDetailAsync(vcdId);
                if (!response.HasErrors && response.Object is not null)
                    Item.VesselCallDetail = (VesselCallDetail)response.Object;
            }   
        }
        else
        {
            response = await _exportOrderProvider.GetItemAsync(Id);
            if (!response.HasErrors && response.Object is not null)
                Item = (ExportOrderEntity)response.Object;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveItem()
    {
        if (Form is null || Item is null) return;

        await Form.Validate();

        if (!Form.IsValid)
        {
            Snackbar.Add("Fill up all reqired fields", Severity.Error);
            return;
        }

        /// Check Container Numbers
        if (Item.Records is not null && Item.Records.Any())
        {
            bool? proceedWithErrors = await ProceedWithCntrNumsErrors();
            if (!proceedWithErrors.HasValue) return;
        }

        /// Save
        IsLoadingData = true;

        AppObjectResponse appObjectResponse = new();

        if (Id == 0)
            appObjectResponse = await _exportOrderProvider.NewItemAsync(Item, ApplicationUser);
        else
            appObjectResponse = await _exportOrderProvider.ModifyItemAsync(Item, ApplicationUser);

        if (appObjectResponse.HasErrors)
            Snackbar.Add($"{appObjectResponse.Errors.FirstOrDefault()}", Severity.Error);
        else
        {
            Id = Item.Id;
            IsDialogResultOk = true;
            Snackbar.Add("Saved Successfully", Severity.Success);
        }

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }    

    private async Task CopyItem()
    {
        Id = 0;
        Item.Id = 0;

        foreach (var record in Item.Records)
        {
            record.Id = 0;

            foreach (var content in record.Contents)
                content.Id = 0;
        }

        Item.Num = Item.Status == EntityStatus.Customs || Item.Status == EntityStatus.Cancelled ? Item.Num + "-" : string.Empty;

        Item.Status = EntityStatus.New;

        await InvokeAsync(StateHasChanged);        
    }

    private void CloseDialogOrPage()
    {
        if (MudDialog != null)
            MudDialog.Close(DialogResult.Ok(IsDialogResultOk));
        else
            jsRuntime.InvokeVoidAsync("window.close");
    }

    private async Task<bool?> ProceedWithCntrNumsErrors()
    {
        if (Item is null || Item.VesselCallDetail is null) return null;

        var cntrNums = Item.Records.Select(r => r.CntrNum).ToArray();

        if (cntrNums is null || !cntrNums.Any()) return null;
        
        var errMessages = await ValidationService.ValidateCntrNums(cntrNums, Item.Id, Item.VesselCallDetail.VesselCall.Id, null);

        if (errMessages is not null && errMessages.Any())
        {
            StringBuilder resultMessage = new();

            foreach (string msg in errMessages)
                resultMessage.Append($"{msg}<br>");

            bool? result = await DialogService.ShowMessageBox(null, (MarkupString)$"{resultMessage.ToString()}", yesText: "Продолжить", cancelText: "Отменить");

            return result;
        }
        
        return true;
    }
}
