        //     Value!.Documents!.AddRange(documents);

        //     await ValueChanged.InvokeAsync(Value);

        //     foreach (var document in documents)
        //     {
        //         DocumentItems.Add(document);

        //         foreach (var docRecord in document.Records)
        //             DocumentRecordItems.Add(docRecord);
        //     }
        // }
    }

    private async Task RemoveDocument()
    {
        await Task.Delay(50);

        if (SelectedDocumentValues!.Count > 0)
        {
            foreach (var item in SelectedDocumentValues)
            {
                DocumentItems.Remove(item);
                Value!.Documents!.Remove(item);
            }

            SelectedDocumentValues.Clear();
        }

        await InvokeAsync(StateHasChanged);
    }

    #endregion

    #region CNTR RECORDS

    private async Task AddContainerRecord_Click()
    {
        if (Value!.Documents is null) return;

        if (Value.Documents.Count() == 0) return;

        var parameters = new DialogParameters() { ["Documents"] = Value.Documents };
        var options = new DialogOptions { CloseButton = true, DisableBackdropClick = true, MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<ExportOrder_ItemRecordDialog>("New Container Record", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (result.Data is null)
                return;

            var exportOrderRecord = (ExportOrderRecord)result.Data;

            Value.Records.Add(exportOrderRecord);
        }
    }

    private async Task RemoveContainerRecord(ExportOrderRecord record)
    {
        if (record is null)
            return;

        bool? result = await DialogService.ShowMessageBox(
                 "Delete record",
                 (MarkupString)$"<b>Do you want to remove record with {record.CntrNum}?<b>",
                 yesText: "REMOVE", cancelText: "NO");

        if (!result.HasValue) return;

        if (result.Value)
            Value!.Records!.Remove(record);

        await InvokeAsync(StateHasChanged);
    }

    #endregion

    private async Task UploadFile()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        var options = new DialogOptions() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true, DisableBackdropClick = true };
        dialog = DialogService.Show<UploadExportOrderRecordsFile>("INPUT: list of records", options);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if(result.Data != null)
            {
                uploadResult = (UploadResult)result.Data;

                if (uploadResult._Documents is null)
                {
                    Snackbar.Add($"Document is null", Severity.Warning);
                    Snackbar.Add($"{uploadResult.Summary.FirstOrDefault()}", Severity.Warning);
                    return;
                }

                var records = uploadResult!._ExportOrderRecords!.ToList();
                var documents = uploadResult!._Documents!.ToList();

                // Remove old documents from the page
                foreach (var documentItem in DocumentItems)
                {
                    foreach (var documentRecordItem in DocumentRecordItems)
                        DocumentRecordItems.Remove(documentRecordItem);

                    DocumentItems.Remove(documentItem);
                }

                // Add new documents to the page
                foreach (var document in documents)
                {
                    DocumentItems.Add(document);

                    foreach (var docRecord in document.Records)
                    {
                        docRecord.Document = document;
                        DocumentRecordItems.Add(docRecord);
                    }
                }                

                foreach (var record in records)
                    foreach (var cntrContent in record.Contents)
                        cntrContent.DocumentRecord.Document = documents.First(s => s.Records.Any(s => s.Id == cntrContent.DocumentRecord.Id));

                Value!.Records = records;
                Value.Documents = documents;

                Snackbar.Add($"Uploaded", Severity.Success);

                await ValueChanged.InvokeAsync(Value);
            }
        }
    }        

    #region SEARCH

    private async Task GetVesselCallDetail_Click()
    {
        DialogParameters parameters = new DialogParameters { ["IsSelectable"] = true };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, DisableBackdropClick = true };
        var dialog = await DialogService.ShowAsync<VesselCallComponent>("select VESSEL CALL", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            string VoyagePOD = (string)result.Data;
            //string pod = Voyage.Split('&')[2];

            var response = await _vesselCallProvider.GetVesselCallDetailItemAsync(VoyagePOD);
            if (!response.HasError)
            {
                Value!.VesselCallDetail = (VesselCallDetail)response.Object!;
                //Value!.IdPOD = Value.VesselCall.Details.FirstOrDefault(d => d.POD!.NameEn == pod)!.POD!.Id;
            }                
            else
                Snackbar.Add($"{response.Error.First()}", Severity.Error);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<IEnumerable<CarrierCatalog>> SearchCarrier(string value)
    {
        string? terminal = string.Empty;

        if (Value!.VesselCallDetail!.VesselCall!.Terminal is not null)
            terminal = Value!.VesselCallDetail!.VesselCall!.Terminal.Name;
        
        if (terminal is null)
            return Enumerable.Empty<CarrierCatalog>();

        var Carriers = new List<CarrierCatalog>();

        var response = await _carrierProvider.GetItemsAsync();
        if (!response.HasError)
            Carriers = ((IEnumerable<CarrierCatalog>)response.Object!).ToList();

        //var carrierDetails = carriers.SelectMany(c => c.CarrierDetails).Where(d => d.TerminalName == Value.VesselCall.Terminal.Name).ToList();

        //return Carriers.OrderBy(x => x.Name).Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
        Carriers = Carriers.OrderBy(x => x.Name).Where(x => x.CarrierDetails.Where(d => d.TerminalName == terminal).ToList().Count > 0).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Carriers;

        return Carriers.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();        
    }

