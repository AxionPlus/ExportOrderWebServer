    private async Task<string> CheckTextFieldCntrNum(string num)
    {
        if (Value is not null && Value.VesselCallDetail is not null && !string.IsNullOrWhiteSpace(num))
        {
            var cntrNums = Value.Records.Select(r => r.CntrNum).ToArray();

            if (cntrNums is not null && cntrNums.Any())
            {
                var errMessages = await _validationService.ValidateCntrNums(cntrNums, Value.Id, Value.VesselCallDetail.VesselCall.Id, num);

                if (errMessages is not null && errMessages.Any())
                {
                    StringBuilder resultMessage = new();

                    foreach (string msg in errMessages)
                        resultMessage.Append($"{msg}<br>");

                    bool? result = await DialogService.ShowMessageBox(null, (MarkupString)$"{resultMessage.ToString()}", yesText: "Продолжить");
                }
            }
        }
        return num;
    }

