@inject ISnackbar Snackbar
@inject IDialogService DialogService;
@inject NavigationManager Navigation
@inject IJSRuntime jsRuntime

@inject IExportOrderProvider _exportOrderProvider
@inject ICntrTypeProvider _cntrTypeProvider
@inject ICarrierProvider _carrierProvider
@inject IVesselCallProvider _vesselCallProvider

<style>

    .Container-item > .container-content {
        align-items: flex-start;
        justify-content: flex-start;
    }

    .mud-picker-inline {
        flex: unset;
    }

    .wrapper-input-date > .mud-input-control {
        margin-top: 3px;
    }

    .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-inline-end: 4px;
        padding-right: 4px;
    }

    .mud-icon-button {
        padding: 3px;
    }

    .wrapper-input * .mud-icon-size-small {
        color:currentColor;
    }

    .wrapper-input * .mud-icon-button-size-small.mud-icon-button-edge-end {
        margin-top: 1px;
    }

    .sub-Table {
        background-color: lightblue;
        transition: none;
        box-shadow: none;
    }

    .mud-table-sticky-footer * .mud-table-root .mud-table-foot > .mud-table-row {
        background-color: lightgrey;
    }

    .Table * .mud-table-cell {
        padding: 4px;
    }

        .Table * .mud-table-cell *.mud-input-control {
            margin: unset;
        }

        .Table * .mud-table-cell *.mud-input > input.mud-input-root-outlined {
            padding: 4px 4px 1px 4px;
        }

    .mud-list-item-gutters {
        padding-left:4px;
        padding-right:4px;
    }

    .mud-list.mud-list-padding {
        padding-top:2px;
        padding-bottom:2px;
    }

    .SelectField * .mud-input > input.mud-input-root-outlined.mud-input-root-margin-dense {
        text-align:center;
    }

/*     .tfoot {
        color: #0a58ca;
    } */

    .TextField_Sum * .mud-input > input.mud-input-root-outlined {
        text-align: end;
    }

    .NumericField_Content * .mud-input > input.mud-input-root-outlined {
        text-align: end;
    }

    .QuantityField * .mud-input > input.mud-input-root-outlined {
        text-align: center;
    }

    .h6 {
        margin-bottom: 2px;
    }

    .container-content-head {
        margin-bottom: unset;
        align-self: center;
    }

    .infoSC {
        margin-bottom: 3px;
    }

</style>

@if (Value is not null)
{
    <div class="Container-item">
        <div class="container-content" style="padding-bottom:unset">
            <MudTextField Class="TextField" Style="width: 200px; margin-right: 10px" T="string" Label="Number" Value="@Value!.Num"
                          ValueChanged="async (e) => { Value.Num = e.ToUpper().Trim(); }"
                          Variant="Variant.Outlined" Margin="Margin.Dense"                          
                          Required RequiredError="" Clearable="!IsFormReadOnly" />

             <MudDatePicker Class="wrapper-input-date" Style="width: 130px; height:40px" Label="Date" @bind-Date="Value.Dated"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            DateFormat="dd.MM.yy"
                            Editable="true"
                            IconSize=Size.Small
                            Required RequiredError="" Clearable="!IsFormReadOnly" />
             <MudSpacer />

             <MudTextField Class="TextField" T="VesselCallDetail" Style="width: 450px" Value="Value.VesselCallDetail"
                           Label="Vessel Call" Placeholder="Vessel Call"
                           Text="@(Value.VesselCallDetail is not null ?
                                        $"{Value.VesselCallDetail!.VesselCall!.Vessel.Name} / {Value.VesselCallDetail!.VesselCall.VoyageNo} / {Value.VesselCallDetail.POD!.NameEn}"
                                        : string.Empty)"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Required RequiredError="" Clearable="!IsFormReadOnly"
                           Adornment="Adornment.Start" IconSize="Size.Small"
                           AdornmentColor="Color.Primary"
                           AdornmentIcon="@Icons.Material.Filled.Waves"
                           OnAdornmentClick="@(async () => { if (!IsFormReadOnly) await GetVesselCallDetail_Click(); })" />
            <MudSpacer />

            <MudAutocomplete T="CarrierCatalog" Style="width: 270px" Label="Carrier" @bind-Value="Value.Carrier"
                             ToStringFunc="@(e => e != null ? e.Name : "")"
                             SearchFunc="@SearchCarrier"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Required RequiredError=""
                             CloseIcon="" OpenIcon="" IconSize="Size.Small"
                             ResetValueOnEmptyText="true"
                             Placeholder="Carrier"
                             MaxItems="20"
                             AdornmentIcon="@Icons.Material.Filled.AddCircle"
                             AdornmentColor="Color.Primary"
                             Adornment="Adornment.End"
                             OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddCarrier_Click(); })"
                             Clearable="!IsFormReadOnly" />
         </div>
         <div class="container-content">
             <MudSelect Class="wrapper-input" T="PersonEntity" Label="Person" @bind-Value="@Value.Person"
                        ToStringFunc="@(str => str is not null ?
                                                $"{str.FamilyName} {str.Name?.Substring(0, 1)}. {str.SurName?.Substring(0, 1)}."
                                                : string.Empty)"

                        Style="width:200px" Placeholder="Person"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        CloseIcon="" OpenIcon="" IconSize="Size.Small"
                        Clearable="!IsFormReadOnly"
                        AdornmentIcon="@Icons.Material.Filled.AddCircle"
                        AdornmentColor="Color.Primary"
                        Adornment="Adornment.End"
                        OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddPerson_Click(); })">

                 @if (Persons.Count() > 0)
                    @foreach (var person in Persons)
                    {
                        <MudSelectItem Value="@person">
                            @($"{person.FamilyName} {person.Name!.Substring(0, 1)}. {person.SurName!.Substring(0, 1)}.")
                        </MudSelectItem>
                    }
            </MudSelect>
            <MudSpacer />
            <MudSelect Class="wrapper-input" T="EntityStatus" Style="width:120px" Label="Status" @bind-Value="Value.Status"
                       ToStringFunc="@(str => str.ToString())"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (EntityStatus status in Enum.GetValues(typeof(EntityStatus)))
                {
                    <MudSelectItem Value="@status" />
                }
            </MudSelect>
        </div>
    </div>

    <div class="Container-item">
        <div class="container-content">
            <div class="documents">
                <div class="controlIconButtons">
                    @if (DocumentItems.Count > 0)
                    {
                        <MudCheckBox Class="wrapper-checkBox" Dense="true" Size="Size.Small" @bind-Checked="@MultiSelectionTreeItemData" Disabled="IsFormReadOnly" />
                    }
                    else
                    {
                        <div style="width: 10px"></div>
                    }
                    <MudSpacer />
                    <h6 class="container-content-head">DOCUMENTS:</h6>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Disabled="IsFormReadOnly" OnClick="AddDocuments_Click"></MudIconButton>
                    <MudIconButton Icon="@Icons.Material.Filled.List" Size="Size.Small" Disabled="IsFormReadOnly"></MudIconButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Disabled="IsFormReadOnly" OnClick="RemoveDocument"></MudIconButton>
                </div>

                <MudPaper Width="450px" Elevation="0" Style="height:246px;overflow: auto;">
                    @*                          <MudTreeView Items="TreeItems" Dense="true" Hover="true"
                MultiSelection="MultiSelectionTreeItemData" @bind-SelectedValues="SelectedValues" >
                <ItemTemplate>
                <MudTreeViewItem Items="@context.TreeItems"
                Value="@context"
                LoadingIconColor="Color.Info"
                CanExpand="@context.CanExpand"
                Text="@context.Title"
                EndText="@context.Number?.ToString()"
                EndTextTypo="@Typo.caption"
                OnClick="TreeViewItem_Click" />
                </ItemTemplate>
                </MudTreeView> *@

                    <MudTreeView MultiSelection="@MultiSelectionTreeItemData" Items="DocumentItems" @bind-SelectedValues="SelectedDocumentValues"
                                 Dense="true" Hover="true">
                        <ItemTemplate>
                            <MudTreeViewItem Value="@context"
                                             Text="@context.Name"
                                             EndText="@context.Records.Count().ToString()"
                                             LoadingIconColor="Color.Info"
                                             EndTextTypo="@Typo.caption">
                                <MudTable @ref="mudDocRecordsTable" Class="Table" T="DocumentRecord" Context="DocRecords"
                                          Items="DocumentRecordItems.Where(x => x.Document.Id == context.Id)">
                                    <RowTemplate>
                                        <MudTd Style="width: 30px">@DocRecords.Seq</MudTd>
                                        <MudTd Style="width: 115px">@DocRecords.CommodityHSCode</MudTd>
                                        <MudTd Style="text-align:left">@DocRecords.CommodityName</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudTreeViewItem>
                        </ItemTemplate>
                    </MudTreeView>
                </MudPaper>
            </div>
            <div class="documents-info" style="margin-left: 15px; max-width:fit-content">
                @if (Value.Documents != null)
                {
                    if (Value.Documents.Count() > 0)
                    {
                        <h6 class="infoSC">Shippers:</h6>
                        @foreach (var shipper in Value.Shippers.GroupBy(x => x.Name, (key, group) => new String(group.FirstOrDefault()!.Name)))
                        {
                            <div style="padding-left:10px">@(shipper);</div>
                        }
                        <br />
                        <h6 class="infoSC">Consignees:</h6>
                        @foreach (var consignee in Value.Consignees.GroupBy(x => x.Name).Select(g => g.Key))
                        {
                            <div style="padding-left:10px">@(consignee);</div>
                        }
                    }
                }
            </div>
        </div>
    </div>
    
    <div class="Container-table">
        @if (mudTable != null)
        {
            <div class="tableMenu">
                <MudButton Class="Button" Size="Size.Small" Style="margin-inline:20px" Disabled="IsFormReadOnly" OnClick="UploadFile"
                            Variant="Variant.Filled" Color="Color.Dark"
                            StartIcon="@Icons.Material.Filled.UploadFile">
                    Upload New List
                </MudButton>
                <MudSpacer />
                <h6 class="container-content-head">CONTAINER RECORDS</h6>
                <MudSpacer />
                <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
                <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Value.Records!.Count())</span>
            </div>
        }

        <MudTable Class="Table" @ref="mudTable" Items="@Value.Records" Context="expOrderRecord"
                  Virtualize="true" RowsPerPage="10">

            <HeaderContent>
                <MudTh Style="width:50px;">
                    <div class="controlIconButtons">
                        <MudTooltip Text="add new Container record">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Disabled="IsFormReadOnly" OnClick="AddContainerRecord_Click" Size="Size.Small" />
                        </MudTooltip>
                    </div>
                </MudTh>
                <MudTh Style="width:35px">
                    <MudTooltip Text="delete All records">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Error" Size="Size.Small" Disabled="IsFormReadOnly"
                                        OnClick="@(async ()=>{ await RemoveAllContainerRecords(Value.Records);})" />
                    </MudTooltip>
                </MudTh>
                <MudTh Style="width: 120px">Nr</MudTh>
                <MudTh Style="width: 64px">Type</MudTh>
                <MudTh Style="width: 80px">TareWt</MudTh>
                <MudTh Style="width: 300px">Seals</MudTh>
                <MudTh Style="width: 30px"></MudTh>
                <MudTh Style="width: 88px">QTY</MudTh>
                <MudTh Style="width: 120px">Pkg Name</MudTh>
                <MudTh Style="width: 120px">NET</MudTh>
                <MudTh Style="width: 120px">GROSS</MudTh>
                <MudTh Style="width: 35px"></MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled
                                    OnClick="@(async ()=>{ await ShowContainerRecord_Click(expOrderRecord.Id);})" />
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Disabled="IsFormReadOnly"
                                    OnClick="@(async ()=>{ await RemoveContainerRecord(expOrderRecord);})" />
                </MudTd>
                <MudTd>
                    <MudTextField Class="TextField" T="string" @bind-Value="expOrderRecord.CntrNum"
                                    Variant="Variant.Outlined" Margin="Margin.Dense" Required RequiredError="" />
                    </MudTd>
                    <MudTd>
                        <MudSelect Class="SelectField" T="CntrTpSz" @bind-Value="@expOrderRecord.CntrType"
                                Variant="Variant.Outlined" Margin="Margin.Dense"
                                AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopLeft"
                                CloseIcon="" OpenIcon="">
                            @if (CntrTypes.Count() > 0)
                            @foreach (var type in CntrTypes)
                            {
                                <MudSelectItem Value="@type">@type.Normolize!.ToString()</MudSelectItem>
                            }
                    </MudSelect>
                </MudTd>
                <MudTd>
                    <MudNumericField Class="QuantityField" T="double" @bind-Value="expOrderRecord.CntrTareWt"
                                        Variant="Variant.Outlined" Margin="Margin.Dense"
                                                        Required RequiredError="" HideSpinButtons="true" />
                </MudTd>
                <MudTd>
                    <MudTextField Class="TextField" T="string" @bind-Value="expOrderRecord.Seal"
                                Style="width: 292px"
                                Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudTd>
                <MudTd></MudTd>
                <MudTd>
                    <MudTextField Class="QuantityField" T="string" Text="@expOrderRecord.Contents.Sum(s => s.PackageQty).ToString()"
                                Style="width: 80px"
                                Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudTd>
                <MudTd></MudTd>
                <MudTd>
                    <MudTextField Class="TextField_Sum" T="string"
                                Text="@(expOrderRecord.Contents.Sum(s => s.NetWt) is not null ? expOrderRecord.Contents.Sum(s => s.NetWt!.Value).ToString("## ###.###") : "-")"
                                Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudTd>
                <MudTd>
                    <MudTextField Class="TextField_Sum" T="string"
                                Text="@(expOrderRecord.Contents.Where(c => c.GrossWt is not null).Sum(s => s.GrossWt!.Value).ToString("## ###.###"))"
                                Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Style="@(expOrderRecord.IsShowCntrContent ? "transform: rotate(180deg);" : "")"
                                Size="@Size.Small" OnClick="(_)=>{expOrderRecord.IsShowCntrContent = !expOrderRecord.IsShowCntrContent;}" />
                </MudTd>
                <MudTd></MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (expOrderRecord.IsShowCntrContent)
                {
                    <MudTr>
                        <td colspan="5"></td>
                        <td colspan="6">
                            <MudTable Class="sub-Table" @ref="mudCntrContentTable" Context="CntrContent" Items="@expOrderRecord.Contents">
                                <RowTemplate>
                                    <MudTd Style="width:300px; padding-right:12px; text-align:end">@CntrContent.DocumentRecord.Document.Name</MudTd>
                                    <MudTd Style="width:30px">@CntrContent.DocumentRecord.Seq</MudTd>
                                    <MudTd Style="width:88px">@CntrContent.PackageQty</MudTd>
                                    <MudTd Style="width: 120px; text-align:center">@CntrContent.PackageName</MudTd>
                                    <MudTd Style="width: 120px">@CntrContent.NetWt</MudTd>
                                    <MudTd Style="width: 120px">@CntrContent.GrossWt</MudTd>
                                    </RowTemplate>
                            </MudTable>
                        </td>
                        <MudTd Style="width: 35px"></MudTd>
                        <MudTd></MudTd>
                    </MudTr>
                }
            </ChildRowContent>
            <PagerContent></PagerContent>
            <FooterContent>
                @if (Value.Records!.Count > 0)
                {
                    <MudTd colspan="3" Style="text-align:end"><h6>Total containers:</h6></MudTd>
                    <MudTd Style="text-align:center"><h6>@Value.Records!.Count().ToString("###")</h6></MudTd>
                    <MudTd Style="text-align:center"><h6>@Value.Records!.Sum(s => s.CntrTareWt).ToString()</h6></MudTd>
                    <MudTd colspan="2"></MudTd>
                    <MudTd Style="text-align:center"><h6>@Value.Records.Sum(s => s.Contents.Sum(c => c.PackageQty)).ToString()</h6></MudTd>
                    <MudTd></MudTd>
                    <MudTd Style="text-align:end; padding-right: 8px">
                        <h6>
                            @(Value.Records.Sum(s => s.Contents.Where(c => c.NetWt is not null).Sum(c => c.NetWt!.Value)).ToString("### ###.###"))
                        </h6>
                    </MudTd>
                    <MudTd Style="text-align:end; padding-right: 8px">
                        <h6>
                            @(Value.Records.Sum(s => s.Contents.Where(c => c.GrossWt is not null).Sum(c => c.GrossWt!.Value)).ToString("### ###.###"))
                        </h6>
                    </MudTd>
                    <MudTd></MudTd>
                }
            </FooterContent>
        </MudTable>
    </div>    
}

@code {
    private MudTable<ExportOrderRecord>? mudTable;
    private MudTable<ContainerContent>? mudCntrContentTable;
    private MudTable<DocumentRecord>? mudDocRecordsTable;

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public ExportOrderEntity? Value { get; set; }
    [Parameter]
    public EventCallback<ExportOrderEntity> ValueChanged { get; set; }    
    [Parameter]
    public bool IsFormReadOnly { get; set; }    

    private IEnumerable<CntrTpSz> CntrTypes { get; set; } = new List<CntrTpSz>();
    private IEnumerable<PersonEntity> Persons { get; set; } = new List<PersonEntity>();

    private UploadResult? uploadResult { get; set; }    

    bool IsItemSelected { get; set; }

    bool MultiSelectionTreeItemData = false;
    private HashSet<DocumentEntity>? SelectedDocumentValues { get; set; }
    private HashSet<DocumentEntity> DocumentItems { get; set; } = new HashSet<DocumentEntity>();
    private HashSet<DocumentRecord> DocumentRecordItems { get; set; } = new HashSet<DocumentRecord>();


    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            CntrTypes = await _cntrTypeProvider.GetCntrTypes();
            Persons = await _exportOrderProvider.GetPersonsAsync();
        }
    }

    protected override async void OnInitialized()
    {
        DocumentItems = Value!.Documents!.ToHashSet();

        foreach (var document in DocumentItems)
            foreach (var docRecord in document.Records)
                DocumentRecordItems.Add(docRecord);
    }

    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    #region DOCUMENTS

    async Task AddDocuments_Click()
    {
        DialogParameters parameters = new DialogParameters { ["IsSelectable"] = true };
        var options = new DialogOptions { FullScreen = true, NoHeader = true, DisableBackdropClick = false };
        var dialog = await DialogService.ShowAsync<Document_Index>("Select DOCUMENTS", parameters, options);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var documents = (HashSet<DocumentEntity>)result.Data;

            Value!.Documents!.AddRange(documents);

            await ValueChanged.InvokeAsync(Value);

            foreach (var document in documents)
            {
                DocumentItems.Add(document);

                foreach (var docRecord in document.Records)
                    DocumentRecordItems.Add(docRecord);
            }
        }
    }

    // NOT USED (DELETE)
    async Task AddDocument_Click()
    {
        await jsRuntime.InvokeVoidAsync("open", $"{Navigation.BaseUri}documents?IsSelectable={true}", "_blank");

        var result = await ValueTask.FromResult(jsRuntime);

        // if (result is not null)
