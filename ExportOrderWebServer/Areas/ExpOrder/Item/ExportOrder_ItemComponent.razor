@inject AuthenticationStateProvider authenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime jsRuntime

@inject IExportOrderProvider _exportOrderProvider
@inject ICntrTypeProvider _cntrTypeProvider
@inject ICarrierProvider _carrierProvider
@inject IVesselCallProvider _vesselCallProvider
@inject IDocumentProvider _documentProvider

<style>

    .Container-item > .container-content {
        align-items: flex-start;
        justify-content: flex-start;
    }

    .mud-picker-inline {
        flex: unset;
    }

    .wrapper-input-date > .mud-input-control {
        margin-top: 3px;
    }

    .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-inline-end: 4px;
        padding-right: 4px;
    }

    .mud-icon-button {
        padding: 3px;
    }

    .wrapper-input * .mud-icon-size-small {
        color:currentColor;
    }

    .wrapper-input * .mud-icon-button-size-small.mud-icon-button-edge-end {
        margin-top: 1px;
    }

    .sub-Table {
        background-color: lightblue;
        transition: none;
        box-shadow: none;
    }

    .Table * .mud-table-cell {
        padding: 4px;
    }

        .Table * .mud-table-cell *.mud-input-control {
            margin: unset;
        }

        .Table * .mud-table-cell *.mud-input > input.mud-input-root-outlined {
            padding: 4px 4px 1px 4px;
        }

        .mud-table-foot > .mud-table-row {
            background-color: lightgray;
        }

    .mud-list-item-gutters {
        padding-left:4px;
        padding-right:4px;
    }

    .mud-list.mud-list-padding {
        padding-top:2px;
        padding-bottom:2px;
    }

    .SelectField * .mud-input > input.mud-input-root-outlined.mud-input-root-margin-dense {
        text-align:center;
    }

    .TextField_Sum * .mud-input > input.mud-input-root-outlined {
        text-align: end;
    }

    .NumericField_Content * .mud-input > input.mud-input-root-outlined {
        text-align: end;
    }

    .QuantityField * .mud-input > input.mud-input-root-outlined {
        text-align: center;
    }

    .h6 {
        margin-bottom: 2px;
    }

    .container-content-head {
        margin-bottom: unset;
        align-self: center;
    }

    .infoSC {
        margin-bottom: 3px;
    }

</style>

@if (Value is not null)
{
    <div class="Container-item">
        <div class="container-content" style="padding-bottom:unset">
            <MudTextField Class="TextField" Style="width: 200px; margin-right: 10px" T="string" Label="Number" Value="@Value.Num"
                          ValueChanged="async (e) => { Value.Num = e.ToUpper().Trim(); }"
                          Variant="Variant.Outlined" Margin="Margin.Dense"                          
                          Required RequiredError="" Clearable="!IsFormReadOnly" />

             <MudDatePicker Class="wrapper-input-date" Style="width: 130px; height:35px" Label="Date" @bind-Date="Value.Dated"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            DateFormat="dd.MM.yy"
                            Editable="true"
                            IconSize=Size.Small
                            Required RequiredError="" Clearable="!IsFormReadOnly" />
             <MudSpacer />

             <MudTextField Class="TextField" T="VesselCallDetail" Style="width: 450px" Value="Value.VesselCallDetail"
                           Label="Vessel / Voyage / Port" Placeholder="Vessel Call"
                           Text="@(Value.VesselCallDetail is not null ?
                                        $"{Value.VesselCallDetail.VesselCall!.Vessel.Name} / {Value.VesselCallDetail.VesselCall.VoyageNo} / {Value.VesselCallDetail.POD!.NameEn}"
                                        : string.Empty)"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Required RequiredError="" Clearable="!IsFormReadOnly"
                           Adornment="Adornment.Start" IconSize="Size.Small"
                           AdornmentColor="Color.Primary"
                           AdornmentIcon="@Icons.Material.Filled.Waves"
                           OnAdornmentClick="@(async () => { if (!IsFormReadOnly) await GetVesselCallDetail_Click(); })" />
            <MudSpacer />

            <MudAutocomplete T="CarrierCatalog" Style="width: 270px" Label="Carrier" @bind-Value="Value.Carrier"
                             ToStringFunc="@(e => e != null ? e.Name : "")"
                             SearchFunc="@SearchCarrier"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Required RequiredError=""
                             CloseIcon="" OpenIcon="" IconSize="Size.Small"
                             ResetValueOnEmptyText="true"
                             Placeholder="Carrier"
                             MaxItems="20"
                             AdornmentIcon="@Icons.Material.Filled.AddCircle"
                             AdornmentColor="Color.Primary"
                             Adornment="Adornment.End"
                             OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddCarrier_Click(); })"
                             Clearable="!IsFormReadOnly" />
         </div>
         <div class="container-content">
             <MudSelect Class="wrapper-input" T="PersonEntity" Label="Person" @bind-Value="@Value.Person"
                        ToStringFunc="@(str => str is not null ?
                                                $"{str.FamilyName} {str.Name?.Substring(0, 1)}. {str.SurName?.Substring(0, 1)}."
                                                : string.Empty)"
                        Style="width:200px" Placeholder="Person"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        CloseIcon="" OpenIcon="" IconSize="Size.Small"
                        Required RequiredError="" Clearable="!IsFormReadOnly"
                        AdornmentIcon="@Icons.Material.Filled.AddCircle"
                        AdornmentColor="Color.Primary"
                        Adornment="Adornment.End"
                        OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddPerson_Click(); })">

                 @if (Persons.Count() > 0)
                    @foreach (var person in Persons)
                    {
                        <MudSelectItem Value="@person">
                            @($"{person.FamilyName} {person.Name!.Substring(0, 1)}. {person.SurName!.Substring(0, 1)}.")
                        </MudSelectItem>
                    }
            </MudSelect>
            <MudSpacer />
            <MudSelect Class="wrapper-input" T="EntityStatus" Style="width:120px" Label="Status" @bind-Value="Value.Status"
                       ToStringFunc="@(str => str.ToString())"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                @switch (Value.Status)
                {
                    case EntityStatus.New:
                        <MudSelectItem Value="@(EntityStatus.Issued)" />
                        <MudSelectItem Value="@(EntityStatus.Cancelled)" />
                        break;
                                
                    case EntityStatus.Issued:
                        <MudSelectItem Value="@(EntityStatus.Cancelled)" />
                        break;

                    case EntityStatus.Cancelled:
                        if (IsRoleForEdit)
                        {
                            <MudSelectItem Value="@(EntityStatus.New)" />
                            <MudSelectItem Value="@(EntityStatus.Issued)" />
                        }
                        break;

                    case EntityStatus.Completed:
                        if (IsRoleForEdit)
                        {
                            <MudSelectItem Value="@(EntityStatus.New)" />
                            <MudSelectItem Value="@(EntityStatus.Issued)" />
                        }
                        break;
                }
            </MudSelect>
        </div>
    </div>

    <div class="Container-item">
        <div class="container-content">
            <div class="documents">
                <div class="controlIconButtons">
                    <div style="width: 10px"></div>
                    <MudSpacer />
                    <h6 class="container-content-head" style="color:cornflowerblue">DOCUMENTS:</h6>                    
                    <MudSpacer />
                    <MudTooltip Text="Add Document (добавить Декларацию)">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Disabled="IsFormReadOnly" OnClick="AddDocuments_Click"></MudIconButton>
                    </MudTooltip>                    
                    <MudTooltip Text="Download Template (загрузить проформу)">
                        <MudIconButton Icon="@Icons.Material.Filled.List" Size="Size.Small" Disabled="IsFormReadOnly" OnClick="DownloadExcelTemplate"></MudIconButton>
                    </MudTooltip>
                    <MudTooltip Text="Remove selected Documents (удалить выбранные Декларации)">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Disabled="IsFormReadOnly" OnClick="RemoveDocument"></MudIconButton>
                    </MudTooltip>                    
                </div>

                <MudPaper Width="450px" Elevation="0" Style="height:240px;overflow: auto;">
                    @if (Value.Documents != null)
                    {
                        <MudTreeView Items="DocumentItems" @bind-SelectedValues="SelectedDocumentValues"
                                     MultiSelection="true" Dense="true" Hover="true">
                            <ItemTemplate>
                                <MudTreeViewItem Value="@context"
                                                 Text="@context.Name"
                                                 EndText="@context.Records.Count().ToString()"
                                                 LoadingIconColor="Color.Info"
                                                 EndTextTypo="@Typo.caption">
                                    <MudTable @ref="mudDocRecordsTable" Class="Table" T="DocumentRecord" Context="DocRecord"
                                              Items="DocumentRecordItems.Where(x => x.Document.Id == context.Id)">
                                        <RowTemplate>
                                            <MudTd Style="width: 30px">@DocRecord.Seq</MudTd>
                                            <MudTd Style="width: 115px">@DocRecord.CommodityHSCode</MudTd>
                                            <MudTd Style="text-align:left">@DocRecord.CommodityName</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </MudTreeViewItem>
                            </ItemTemplate>
                        </MudTreeView>
                    }
                </MudPaper>
            </div>
            <div class="documents-info" style="margin-left: 15px; max-width:fit-content">
                @if (Value.Documents != null)
                {
                    if (Value.Documents.Count() > 0)
                    {
                        <h6 class="infoSC">Shippers:</h6>
                        @* <div style="padding-left:10px">@string.Join(";\n ", Value.Shippers.GroupBy(x => x.Name).Select(g => g.Key))</div> *@
                        @foreach (var shipper in Value.Shippers.GroupBy(x => x.Name).Select(g => g.Key))
                        {
                            <div style="padding-left:10px">@shipper@(Value.Shippers.GroupBy(x => x.Name).Select(g => g.Key).Count() > 1 ? ";" : "")</div>
                        }
                        <br />
                        <h6 class="infoSC">Consignees:</h6>
                        @* <div style="padding-left:10px">@string.Join(";\n ", Value.Consignees.Select(x => x.Name).Distinct())</div> *@
                        @foreach (var consignee in Value.Consignees.GroupBy(x => x.Name).Select(g => g.Key))
                        {
                            <div style="padding-left:10px">@consignee@(Value.Consignees.GroupBy(x => x.Name).Select(g => g.Key).Count() > 1 ? ";" : "")</div>
                        }
                    }
                }
            </div>
        </div>
    </div>
    
    <div class="Container-table" style="min-height:360px; max-height:400px; overflow:auto">
        @if (mudTable != null)
        {
            <div class="tableMenu">
                <MudButton Class="Button" Style="margin-inline:20px; margin-bottom:2px" OnClick="UploadFile_Click"                           
                           Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" 
                           StartIcon="@Icons.Material.Filled.UploadFile"
                           Disabled="IsFormReadOnly">
                    Upload New List
                </MudButton>               
                <MudSpacer />
                <h6 class="container-content-head" style="color:cornflowerblue">CONTAINER RECORDS</h6>
                <MudSpacer />
                <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
                <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Value.Records!.Count())</span>
            </div>
        }
        <MudTable Class="Table" @ref="mudTable" Items="@Value.Records" Context="expOrderRecord"
                  Virtualize="true" HorizontalScrollbar="true" RowsPerPage="8" >

            <HeaderContent>
                <MudTh Style="width:50px;">
                    <div class="controlIconButtons">
                        <MudTooltip Text="add new Container record">
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Disabled="@(IsFormReadOnly || VoyageId == 0)" Color="Color.Primary"
                                            OnClick="AddExportOrderRecord_Click" Size="Size.Small" />
                        </MudTooltip>
                    </div>
                </MudTh>
                <MudTh Style="width:35px">
                    <MudTooltip Text="delete All records">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Error" Size="Size.Small" Disabled="IsFormReadOnly"
                                        OnClick="@(async ()=>{ await RemoveAllContainerRecords(Value.Records);})" />
                    </MudTooltip>
                </MudTh>
                <MudTh Style="width: 120px">Nr</MudTh>
                <MudTh Style="width: 64px">Type</MudTh>
                <MudTh Style="width: 80px">TareWt</MudTh>
                <MudTh Style="width: 300px">Seals</MudTh>
                <MudTh Style="width: 33px">Seq</MudTh>
                <MudTh Style="width: 88px">QTY</MudTh>
                <MudTh Style="width: 120px">Pkg Name</MudTh>
                <MudTh Style="width: 120px">NET</MudTh>
                <MudTh Style="width: 120px">GROSS</MudTh>
                <MudTh Style="width: 35px"></MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="IsFormReadOnly"
                                    OnClick="@(async ()=>{ await ShowRecordContent_Click(expOrderRecord);})" />
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Disabled="IsFormReadOnly"
                                    OnClick="@(async ()=>{ await RemoveContainerRecord(expOrderRecord);})" />
                </MudTd>
                <MudTd>
                    <MudTextField Class="TextField" T="string" @bind-Value="expOrderRecord.CntrNum"
                                    Variant="Variant.Outlined" Margin="Margin.Dense" Required RequiredError="" />
                </MudTd>
                <MudTd>
                    <MudSelect Class="SelectField" T="CntrTpSz" @bind-Value="@expOrderRecord.CntrType"
                                Variant="Variant.Outlined" Margin="Margin.Dense"
                                AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopLeft"
                                CloseIcon="" OpenIcon="">
                        @if (CntrTypes.Count() > 0)
                            @foreach (var type in CntrTypes)
                            {
                                <MudSelectItem Value="@type">@type.Normolize!.ToString()</MudSelectItem>
                            }
                    </MudSelect>
                </MudTd>
                <MudTd>
                    <MudNumericField Class="QuantityField" T="double" @bind-Value="expOrderRecord.CntrTareWt"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Required RequiredError="" HideSpinButtons="true" />
                </MudTd>
                <MudTd>
                    <MudTextField Class="TextField" Style="width: 292px" T="string" @bind-Value="expOrderRecord.Seal"                                
                                Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudTd>
                <MudTd></MudTd>
                <MudTd>
                    <MudTextField Class="QuantityField" Style="width: 80px" T="string" Text="@expOrderRecord.Contents.Sum(s => s.PackageQty).ToString()"                                
                                Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly/>
                </MudTd>
                <MudTd></MudTd>
                <MudTd>
                    <MudTextField Class="TextField_Sum" T="string"
                                  Text="@(expOrderRecord.Contents.Sum(s => s.NetWt) is not null ? expOrderRecord.Contents.Sum(s => s.NetWt!.Value).ToString("## ##0.###") : "-")"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly />
                </MudTd>
                <MudTd>
                    <MudTextField Class="TextField_Sum" T="string"
                                  Text="@(expOrderRecord.Contents.Where(c => c.GrossWt is not null).Sum(s => s.GrossWt!.Value).ToString("## ##0.###"))"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly />
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Style="@(expOrderRecord.IsShowCntrContent ? "transform: rotate(180deg);" : "")"
                                   Size="@Size.Small" OnClick="(_)=>{expOrderRecord.IsShowCntrContent = !expOrderRecord.IsShowCntrContent;}" />
                </MudTd>
                <MudTd></MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (expOrderRecord.IsShowCntrContent)
                {
                    <MudTr>
                        <td colspan="5"></td>
                        <td colspan="6">
                            <MudTable Class="sub-Table" @ref="mudCntrContentTable" Context="CntrContent" Items="@expOrderRecord.Contents">
                                <RowTemplate>
                                    <MudTd Style="width:300px; padding-right:12px; text-align:end">@CntrContent.DocumentRecord.Document.Name</MudTd>
                                    <MudTd Style="width: 33px">@CntrContent.DocumentRecord.Seq</MudTd>
                                    <MudTd Style="width: 88px">@CntrContent.PackageQty</MudTd>
                                    <MudTd Style="width:120px; text-align:center">@CntrContent.PackageName</MudTd>
                                    <MudTd Style="width:120px">@CntrContent.NetWt</MudTd>
                                    <MudTd Style="width:120px">@CntrContent.GrossWt</MudTd>
                                    </RowTemplate>
                            </MudTable>
                        </td>
                        <MudTd Style="width: 35px"></MudTd>
                        <MudTd></MudTd>
                    </MudTr>
                }
            </ChildRowContent>
            <PagerContent></PagerContent>
            <FooterContent>
                @if (Value.Records!.Count > 0)
                {
                    <MudTd colspan="3" Style="text-align:end"><h6>Total containers:</h6></MudTd>
                    <MudTd Style="text-align:center"><h6>@Value.Records!.Count().ToString("###")</h6></MudTd>
                    <MudTd Style="text-align:center"><h6>@Value.Records!.Sum(s => s.CntrTareWt).ToString()</h6></MudTd>
                    <MudTd colspan="2"></MudTd>
                    <MudTd Style="text-align:center"><h6>@Value.Records.Sum(s => s.Contents.Sum(c => c.PackageQty)).ToString()</h6></MudTd>
                    <MudTd></MudTd>
                    <MudTd Style="text-align:end; padding-right: 8px">
                        <h6>
                            @(Value.Records.Sum(s => s.Contents.Where(c => c.NetWt is not null).Sum(c => c.NetWt!.Value)).ToString("### ###.###"))
                        </h6>
                    </MudTd>
                    <MudTd Style="text-align:end; padding-right: 8px">
                        <h6>
                            @(Value.Records.Sum(s => s.Contents.Where(c => c.GrossWt is not null).Sum(c => c.GrossWt!.Value)).ToString("### ###.###"))
                        </h6>
                    </MudTd>
                    <MudTd colspan="2"></MudTd>
                }
            </FooterContent>
        </MudTable>
    </div>    
}

@code {
    private MudTable<ExportOrderRecord>? mudTable;
    private MudTable<ContainerContent>? mudCntrContentTable;
    private MudTable<DocumentRecord>? mudDocRecordsTable;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public ExportOrderEntity? Value { get; set; }
    [Parameter]
    public EventCallback<ExportOrderEntity> ValueChanged { get; set; }    
    [Parameter]
    public bool IsFormReadOnly { get; set; }
    [Parameter]
    public bool IsRoleForEdit { get; set; }


    private long VoyageId { get; set; }

    private IEnumerable<CntrTpSz> CntrTypes { get; set; } = new List<CntrTpSz>();
    private IEnumerable<PersonEntity> Persons { get; set; } = new List<PersonEntity>();

    private CheckedUploadResult? uploadResult { get; set; }

    private HashSet<DocumentEntity>? SelectedDocumentValues { get; set; }
    private HashSet<DocumentEntity> DocumentItems { get; set; } = new HashSet<DocumentEntity>();
    private HashSet<DocumentRecord> DocumentRecordItems { get; set; } = new HashSet<DocumentRecord>();

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            CntrTypes = await _cntrTypeProvider.GetCntrTypes();
            Persons = await _exportOrderProvider.GetPersonsAsync();
        }
    }

    protected override async Task OnInitializedAsync()   // change to: Task OnInitializedAsync (void)
    {
        CheckVoyageState();
        GetDocumentItems();
    }

    private async void GetDocumentItems()
    {
        await Task.Delay(50);

        DocumentItems = Value!.Documents!.ToHashSet();

        foreach (var document in DocumentItems)
            foreach (var docRecord in document.Records)
                DocumentRecordItems.Add(docRecord);

        //-----------------------------------

        // if (Value!.Documents.Count() == 0) return;

        // var usedDocuments = Value!.Documents;

        // foreach (var usedDocument in Value!.Documents)
        // {            
        //     var existedDocRecords = usedDocument.Records.ToList();

        //     foreach (var existedDocRecord in existedDocRecords)
        //     {
        //         if (!usedDocument.Records.Any(dr => dr.Seq == existedDocRecord.Seq))
        //             usedDocument.Records.Remove(existedDocRecord);
        //     }

        //     DocumentItems.Add(usedDocument);

        //     foreach (var document in DocumentItems)
        //         foreach (var docRecord in document.Records)
        //             DocumentRecordItems.Add(docRecord);
        // }

        await InvokeAsync(StateHasChanged);
    }

    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    #region DOCUMENTS

    async Task AddDocuments_Click()
    {
        DialogParameters parameters = new DialogParameters { ["IsSelectable"] = true };
        var options = new DialogOptions { FullScreen = true, NoHeader = true, DisableBackdropClick = false };
        var dialog = await DialogService.ShowAsync<Document_Index>("Select DOCUMENTS", parameters, options);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var documents = (HashSet<DocumentEntity>)result.Data;

            Value!.Documents!.AddRange(documents);

            await ValueChanged.InvokeAsync(Value);
            GetDocumentItems();

            // foreach (var document in documents)
            // {
            //     DocumentItems.Add(document);

            //     foreach (var docRecord in document.Records)
            //         DocumentRecordItems.Add(docRecord);
            // }
        }
    }

    private async Task RemoveDocument()
    {
        await Task.Delay(50);

        if (SelectedDocumentValues!.Count > 0)
        {
            foreach (var item in SelectedDocumentValues)
            {
                // Cntr Records
                var records = Value!.Records.Where(eor => eor.Contents.Any(co => co.DocumentRecord.Document.Id == item.Id)).ToList();

                foreach (var record in records)
                    if (record.Contents.Count() == 1)
                        Value.Records.Remove(record);
                    else
                    {
                        var contents = record.Contents.Where(c => c.DocumentRecord.Document.Id == item.Id).ToList();

                        if (contents.Count() > 0)
                            foreach (var content in contents)
                                record.Contents.Remove(content);

                        // if no any content left in the record after removing, then Remove whole record
                        if (record.Contents.Count() == 0)
                            Value.Records.Remove(record);
                    }

                // Documents
                foreach (var itemRecord in item.Records)
                    DocumentRecordItems.Remove(itemRecord);

                DocumentItems.Remove(item);
                Value!.Documents!.Remove(item);
            }

            SelectedDocumentValues.Clear();

            GetDocumentItems();
        }

        await InvokeAsync(StateHasChanged);
    }

    #endregion

    #region CNTR RECORDS

    private async Task AddExportOrderRecord_Click()
    {
        if (Value is null || Value.Documents is null || Value.Documents.Count() == 0 || VoyageId == 0) return;

        //var parameters = new DialogParameters() { ["IsNewItem"] = true, ["VoyageId"] = VoyageId, ["Documents"] = Value.Documents };
        var parameters = new DialogParameters() { ["VoyageId"] = VoyageId, ["Documents"] = Value.Documents };
        //var parameters = new DialogParameters() { ["IsNewItem"] = true, ["ExportOrderId"] = Value.Id, ["VoyageId"] = VoyageId };
        var options = new DialogOptions { CloseButton = true, DisableBackdropClick = true, MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<ExportOrder_ItemRecordDialog>("New Container Record", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (result.Data is null)
                return;

            var exportOrderRecord = (ExportOrderRecord)result.Data;

            // check for existing Record

            if (exportOrderRecord is not null)
                Value.Records.Add(exportOrderRecord);

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ShowRecordContent_Click(ExportOrderRecord item)
    {
        if (Value is null || Value.Documents is null || Value.Documents.Count() == 0 || VoyageId == 0) return;

        var parameters = new DialogParameters() { ["VoyageId"] = VoyageId, ["Documents"] = Value.Documents, ["Item"] = item };
        var options = new DialogOptions { CloseButton = true, DisableBackdropClick = true, MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<ExportOrder_ItemRecordDialog>("Edit Container Record", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (result.Data is null)
                return;

            var modifiedExportOrderRecord = (ExportOrderRecord)result.Data;

            // re-write ExportOrderRecord
            
            if (modifiedExportOrderRecord is not null)
                item = modifiedExportOrderRecord;

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RemoveContainerRecord(ExportOrderRecord record)
    {
        if (record is null) return;

        bool? result = await DialogService.ShowMessageBox(
                 "Delete record",
                 (MarkupString)$"<b>Do you want to remove record with {record.CntrNum}?<b>",
                 yesText: "REMOVE", cancelText: "NO");

        if (result.HasValue)
            if (result.Value)
                Value!.Records!.Remove(record);

        GetDocumentItems();
        //await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveAllContainerRecords(List<ExportOrderRecord> records)
    {
        if (records.Count() == 0)
            return;

        bool? result = await DialogService.ShowMessageBox(
                 "Delete All records",
                 (MarkupString)$"<b>Do you want to remove all records?<b>",
                 yesText: "REMOVE", cancelText: "NO");

        if (!result.HasValue)
            return;
        else
            Value!.Records.RemoveRange(0, Value.Records.Count());

        await InvokeAsync(StateHasChanged);
    }

    private async Task UploadFile_Click()
    {
        if (VoyageId == 0) return;

        var parameters = new DialogParameters() { ["VoyageId"] = VoyageId };
        var options = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true, DisableBackdropClick = true };
        var dialog = DialogService.Show<UploadExportOrderRecordsFile>("Импорт списка ДТ", parameters, options);

        var result = await dialog.Result;

        try
        {
            if (!result.Canceled)
            {
                if (result.Data != null)
                {
                    uploadResult = (CheckedUploadResult)result.Data;

                    if (uploadResult.UploadedDTO == null) return;

                    var checkedRecords = uploadResult.UploadedDTO.ToList().GroupBy(urd => urd.CntrNum);
                    var checkedDocuments = uploadResult.UploadedDTO.ToList().GroupBy(urd => urd.DocumentName);

                    var records = new List<ExportOrderRecord>();
                    var documents = new List<DocumentEntity>();

                    // RECORDS
                    foreach (var recordResult in checkedRecords)
                    {
                        var newRecord = new ExportOrderRecord()
                        {
                            CntrNum = recordResult.FirstOrDefault()!.CntrNum!,
                            CntrType = CntrTypes.FirstOrDefault(x => x.Normolize == recordResult.FirstOrDefault()!.CntrType),
                            CntrTareWt = recordResult.FirstOrDefault()!.CntrTareWt,
                            Seal = string.IsNullOrEmpty(recordResult.FirstOrDefault()!.Seal) ? string.Empty : recordResult.FirstOrDefault()!.Seal!,
                        };

                        foreach (var contentResult in recordResult)
                        {   
                            var Document = await _documentProvider.GetDocumentAsync(contentResult.DocumentName!);

                            var content = new ContainerContent()
                            {
                                PackageQty = contentResult.PackageQty,
                                PackageName = contentResult.PackageName,
                                NetWt = contentResult.NetWt,
                                GrossWt = contentResult.GrossWt,
                                DocumentRecord = await _documentProvider.GetDocumentRecordAsync(Document!.Name!, (int)contentResult.SeqCommodity!)
                            };

                            content.DocumentRecord.Document = Document;

                            newRecord.Contents.Add(content);
                        }

                        records.Add(newRecord);
                        newRecord = null;
                    }

                    // DOCUMENTS
                    // Remove old documents from the page (export order Records removing too)
                    if (DocumentItems.Count > 0)
                    {
                        foreach (var documentItem in DocumentItems)
                        {
                            foreach (var documentRecordItem in DocumentRecordItems)
                                DocumentRecordItems.Remove(documentRecordItem);

                            DocumentItems.Remove(documentItem);
                        }
                    }

                    // add new documents
                    foreach (var checkedDocument in checkedDocuments)
                    {
                        var Document = await _documentProvider.GetDocumentAsync(checkedDocument.Key!);

                        if (Document is null) continue;

                        var existedRecords = Document.Records.ToList();

                        foreach (var existedRecord in existedRecords)
                        {
                            if (!checkedDocument.Any(d => d.SeqCommodity == existedRecord.Seq))
                                Document!.Records.Remove(existedRecord);
                            // else
                            //     existedRecord.Document = Document;
                        }

                        documents.Add(Document);
                    }

                    Value!.Records = records;
                    Value.Documents = documents;

                    Snackbar.Add($"Uploaded", Severity.Success);

                    await ValueChanged.InvokeAsync(Value);

                    GetDocumentItems();
                }
            }
        }
        catch (Exception ex)
        {
            string msg = ex.Message;
            Console.WriteLine(msg);
        }        
    }

