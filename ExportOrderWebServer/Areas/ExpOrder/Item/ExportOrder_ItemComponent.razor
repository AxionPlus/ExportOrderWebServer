    #region AUXILARY METHODS

    private void SetOriginalRecordContents(List<ContainerContent> contents)
    {
        OriginalRecordContens = new();
        foreach (var content in contents)
        {
            OriginalRecordContens.Add(new ContainerContent()
            {
                Id = content.Id,
                PackageQty = content.PackageQty,
                PackageName = content.PackageName,
                NetWt = content.NetWt,
                GrossWt = content.GrossWt,
                Volume = content.Volume,
                SupplementaryUnitQuantity = content.SupplementaryUnitQuantity,
                SupplementaryUnit = content.SupplementaryUnit,
                DocumentRecord = content.DocumentRecord,
                DocumentName = content.DocumentName,
                ExportOrderRecord = content.ExportOrderRecord
            });
        };
    }

    private void FillUpTreeItems()
    {
        if (Value is not null)
        {
            ClearTreeItems();

            var documentRecords = Value.Records.SelectMany(r => r.Contents).Select(c => c.DocumentRecord)
                                                                           .Where(dr => dr.Document != null && !string.IsNullOrEmpty(dr.Document.Name))
                                                                           .GroupBy(dr => new { dr.Seq, dr.Document.Name })
                                                                           .ToList();

            foreach (var record in documentRecords)
            {
                DocumentRecordsDTO.Add(new ExportOrderDocumentRecordDTO()
                {
                    DocumentId = record.FirstOrDefault()!.Document.Id,
                    Seq = record.Key.Seq,
                    DocumentName = record.Key.Name,
                    CommodityHSCode = record.FirstOrDefault()!.CommodityHSCode,
                    CommodityName = record.FirstOrDefault()!.CommodityName
                });              
            }

            DocumentsDTO = DocumentRecordsDTO.GroupBy(dr => dr.DocumentName).Select(g => new ExportOrderDocumentDTO()
            {
                Id = g.FirstOrDefault()!.DocumentId,
                DocumentName = g.Key,
                DocumentRecords = g.OrderBy(r=>r.Seq).ToList()
            }).ToList();            

            TreeItems = DocumentsDTO.Select(s => new TreeItemData<ExportOrderDocumentDTO>() { Value = s }).ToList();
        }        
    }

    private void ClearTreeItems()
    {
        TreeItems.Clear();
        DocumentsDTO = new();
        DocumentRecordsDTO = new();
    }

    private async Task GetVesselCallDetail_Click()
    {
        if (Value is null) return;

        DialogParameters parameters = new DialogParameters { ["IsSelectable"] = true };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<VesselCallComponent>("select VESSEL CALL", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is not null)
        {
            var response = await _vesselCallProvider.GetVesselCallDetailAsync((long)result.Data);
            if (!response.HasErrors && response.Object is not null)
            {
                Value.VesselCallDetail = (VesselCallDetail)response.Object;

                /// check Carrier for Terminal: is the Carrier has any of Terminals like VesselCall's Terminal
                if (Value.Carrier is not null)
                    if (!Value.Carrier.CarrierDetails.Any(cd => cd.TerminalName.Equals(Value.VesselCallDetail.VesselCall.Terminal.Name)))
                        Value.Carrier = null;
            }
            else
                Snackbar.Add($"{response.Errors.First()}", Severity.Error);
        }

        await InvokeAsync(StateHasChanged);
    }

