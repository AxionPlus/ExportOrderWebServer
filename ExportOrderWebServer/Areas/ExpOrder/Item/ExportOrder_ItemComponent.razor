        if (!result.HasValue)
            return;
        else
            Value!.Records.RemoveRange(0, Value.Records.Count());

        await InvokeAsync(StateHasChanged);
    }

    private async Task UploadFile_Click()
    {
        if (Value is null || Value.VesselCallDetail is null) return;

        var parameters = new DialogParameters() { ["VoyageId"] = Value.VesselCallDetail.VesselCall.Id };
        var options = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true, BackdropClick = false };
        var dialog = DialogService.Show<UploadExportOrderRecordsFile>("Импорт списка ДТ", parameters, options);

        var result = await dialog.Result;

        try
        {
            if (result is not null && !result.Canceled)
            {
                if (result.Data != null)
                {
                    uploadResult = (CheckedUploadResult)result.Data;

                    if (uploadResult.UploadedDTO == null) return;

                    var checkedRecords = uploadResult.UploadedDTO.ToList().GroupBy(urd => urd.CntrNum);
                    var checkedDocuments = uploadResult.UploadedDTO.ToList().GroupBy(urd => urd.DocumentName);

                    var records = new List<ExportOrderRecord>();
                    var documents = new List<DocumentEntity>();

                    /// RECORDS
                    foreach (var recordResult in checkedRecords)
                    {
                        var newRecord = new ExportOrderRecord()
                        {
                            CntrNum = recordResult.FirstOrDefault()!.CntrNum!,
                            CntrType = CntrTypes.FirstOrDefault(x => x.Normolize == recordResult.FirstOrDefault()!.CntrType),
                            CntrTareWt = recordResult.FirstOrDefault()!.CntrTareWt,
                            Seal = string.IsNullOrEmpty(recordResult.FirstOrDefault()!.Seal) ? string.Empty : recordResult.FirstOrDefault()!.Seal!,
                        };

                        foreach (var contentResult in recordResult)
                        {   
                            var Document = await _documentProvider.GetDocumentAsync(contentResult.DocumentName!);

                            var content = new ContainerContent()
                            {
                                PackageQty = contentResult.PackageQty,
                                PackageName = contentResult.PackageName,
                                NetWt = contentResult.NetWt,
                                GrossWt = contentResult.GrossWt,
                                DocumentRecord = await _documentProvider.GetDocumentRecordAsync(Document!.Name!, (int)contentResult.SeqCommodity!)
                            };

                            content.DocumentRecord.Document = Document;

                            newRecord.Contents.Add(content);
                        }

                        records.Add(newRecord);
                        newRecord = null;
                    }

                    /// DOCUMENTS

                    /// Remove old documents from the page       (export order Records removing too)
                    if (DocumentItems.Count > 0)
                    {
                        foreach (var documentItem in DocumentItems)
                        {
                            foreach (var documentRecordItem in DocumentRecordItems)
                                DocumentRecordItems.Remove(documentRecordItem);

                            DocumentItems.Remove(documentItem);
                        }
                    }

                    /// add new documents
                    foreach (var checkedDocument in checkedDocuments)
                    {
                        var Document = await _documentProvider.GetDocumentAsync(checkedDocument.Key!);

                        if (Document is null) continue;

                        var existedRecords = Document.Records.ToList();

                        foreach (var existedRecord in existedRecords)
                        {
                            if (!checkedDocument.Any(d => d.SeqCommodity == existedRecord.Seq))
                                Document!.Records.Remove(existedRecord);                            
                        }

                        documents.Add(Document);
                    }

                    Value.Records = records;
                    Value.Documents = documents;

                    Snackbar.Add($"Uploaded", Severity.Success);

                    await ValueChanged.InvokeAsync(Value);

                }
            }
        }
        catch (Exception ex)
        {
            string msg = ex.Message;
            Console.WriteLine(msg);
        }        
    }

