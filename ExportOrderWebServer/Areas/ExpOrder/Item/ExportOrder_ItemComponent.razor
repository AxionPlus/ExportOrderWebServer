@inject AuthenticationStateProvider authenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime jsRuntime

@inject IExportOrderProvider _exportOrderProvider
@inject ICntrTypeProvider _cntrTypeProvider
@inject ICarrierProvider _carrierProvider
@inject IVesselCallProvider _vesselCallProvider
@inject IDocumentProvider _documentProvider

<style>

    .Container-item > .container-content {
        align-items: flex-start;
        justify-content: flex-start;
    }

    .mud-picker-inline { flex: unset; }

    .wrapper-input-date > .mud-input-control {
        margin-top: 3px;
    }

    .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-inline-end: 4px;
        padding-right: 4px;
    }

    .mud-icon-button { padding: 3px; }

    .wrapper-input * .mud-icon-size-small {
        color:currentColor;
    }

    .wrapper-input * .mud-icon-button-size-small.mud-icon-button-edge-end {
        margin-top: 1px;
    }

    .wrapper-input-select * .mud-icon-button-size-small.mud-icon-button-edge-end {
        margin-inline-end: unset;
    }

    .sub-Table {
        background-color: lightblue;
        transition: none;
        box-shadow: none;
    }

    .Table * .mud-table-cell { padding: 4px; }

        .Table * .mud-table-cell *.mud-input-control {
            margin: unset;
        }

        .Table * .mud-table-cell *.mud-input > input.mud-input-root-outlined {
            padding: 4px 4px 1px 4px;
        }

        .mud-table-foot > .mud-table-row {
            background-color: lightgray;
        }

    .mud-list-item-gutters {
        padding-left:4px;
        padding-right:4px;
    }

    .mud-list.mud-list-padding {
        padding-top:2px;
        padding-bottom:2px;
    }

    .SelectField * .mud-input > input.mud-input-root-outlined.mud-input-root-margin-dense {
        text-align:center;
    }

    .TextField_Sum * .mud-input > input.mud-input-root-outlined {
        text-align: end;
    }

    .NumericField_Content * .mud-input > input.mud-input-root-outlined {
        text-align: end;
    }

    .QuantityField * .mud-input > input.mud-input-root-outlined {
        text-align: center;
    }

    .Summary {
        margin-top: 3px;
        margin-bottom: 3px;
        color: var(--mud-palette-primary);
    }

    .container-content-head {
        margin-bottom: unset;
        align-self: center;
    }

    .infoSC { margin-bottom: 3px; }

</style>

@if (Value is not null)
{
    <div class="Container-item">
        <div class="container-content" style="padding-bottom:2px">
            <MudTextField Class="TextField" Style="width: 200px; margin-right: 10px; color:var(--mud-palette-primary)" T="string" Label="Number"
                          Value="@Value.Num"
                          ValueChanged="async (e) => { Value.Num = e.ToUpper().Trim(); }"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Required RequiredError="" Clearable="!IsFormReadOnly" />
            <div style="width:130px; height:35px">
                <MudDatePicker Class="wrapper-input-date" Label="Date" @bind-Date="Value.Dated"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               DateFormat="dd.MM.yy"
                               Editable="true"
                               IconSize=Size.Small
                               Required RequiredError="" Clearable="!IsFormReadOnly" />
            </div>            
             <MudSpacer />
            <MudTextField Class="TextField" T="string" Style="width: 450px"
                          Label="Vessel / Voyage / Port" Placeholder="select Voyage ..."
                          Text="@(Value.VesselCallDetail != null && Value.VesselCallDetail.VesselCall != null ?
                                        string.Concat(Value.VesselCallDetail.VesselCall.Vessel.Name, " / ",
                                                        Value.VesselCallDetail.VesselCall.VoyageNo, " / ",
                                                        Value.VesselCallDetail.POD == null ? string.Empty : Value.VesselCallDetail.POD.NameEn) :
                                        string.Empty)"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Required RequiredError="" Clearable="!IsFormReadOnly"
                          Adornment="Adornment.Start" IconSize="Size.Small"
                          AdornmentColor="Color.Primary"
                          AdornmentIcon="@Icons.Material.Filled.Waves"
                          OnAdornmentClick="@(async () => { if (!IsFormReadOnly) await GetVesselCallDetail_Click(); })" />
            <MudSpacer />
            <MudAutocomplete T="CarrierCatalog" Style="width: 270px" Label="Carrier" @bind-Value="Value.Carrier"
                             ToStringFunc="@(e => e != null ? e.Name : "")"
                             SearchFunc="@SearchCarrier"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Required RequiredError=""
                             CloseIcon="" OpenIcon="" IconSize="Size.Small"
                             ResetValueOnEmptyText="true"
                             Placeholder="Carrier"
                             MaxItems="20"
                             AdornmentIcon="@Icons.Material.Filled.AddCircle"
                             AdornmentColor="Color.Primary"
                             Adornment="Adornment.End"
                             OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddCarrier_Click(); })"
                             Clearable="!IsFormReadOnly" />
         </div>
        <div class="container-content">            
                <MudSelect Class="wrapper-input-select" T="PersonEntity" Style="width:200px" Label="Person" @bind-Value="@Value.Person"
                           ToStringFunc="@(s => s == null ? string.Empty :
                                             $"{s.FamilyName} " +
                                             $"{(s.Name == null ? string.Empty : s.Name.Substring(0, 1))}. " +
                                             $"{(s.SurName == null ? string.Empty : s.SurName.Substring(0, 1))}.")"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Required RequiredError="">
                    @if (Persons.Count() > 0)
                        @foreach (var person in Persons)
                        {
                            <MudSelectItem Value="@person">
                                @($"{person.FamilyName} {person.Name!.Substring(0, 1)}. {person.SurName!.Substring(0, 1)}.")
                            </MudSelectItem>
                        }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.AddCircle" OnClick="@( async ()=> { if (!IsFormReadOnly) await AddPerson_Click(); })"
                               Style="padding: 8px"
                               Size="Size.Small" Color="Color.Primary" Disabled="IsFormReadOnly" />            
            <MudSpacer />
            <MudSelect Class="wrapper-input-select" T="EntityStatus" Style="width:120px" Label="Status" @bind-Value="Value.Status"
                       ToStringFunc="@(str => str.ToString())"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                @switch (Value.Status)
                {
                    case EntityStatus.New:
                        <MudSelectItem Value="@(EntityStatus.Customs)" />
                        <MudSelectItem Value="@(EntityStatus.Cancelled)" />
                        break;
                                
                    case EntityStatus.Customs:
                        <MudSelectItem Value="@(EntityStatus.Cancelled)" />
                        break;

                    case EntityStatus.Cancelled:
                        if (IsRoleForEdit)
                        {
                            <MudSelectItem Value="@(EntityStatus.New)" />
                            <MudSelectItem Value="@(EntityStatus.Customs)" />
                        }
                        break;

                    case EntityStatus.Completed:
                        if (IsRoleForEdit)
                        {
                            <MudSelectItem Value="@(EntityStatus.New)" />
                            <MudSelectItem Value="@(EntityStatus.Customs)" />
                        }
                        break;
                }
            </MudSelect>
        </div>
    </div>

    <div class="Container-item">
        <div class="container-content">
            <div class="documents">
                <div class="controlIconButtons">
                    <div style="width: 10px"></div>
                    <MudSpacer />
                    <h6 class="container-content-head">Documents:</h6>                    
                    <MudSpacer />
                    <MudTooltip Text="Add Document (добавить Декларацию)" Duration="1500" Delay="500">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Disabled="IsFormReadOnly" OnClick="AddDocuments_Click"></MudIconButton>
                    </MudTooltip>
                    <MudTooltip Text="Download Template (загрузить проформу)" Duration="1500" Delay="500">
                        <MudIconButton Icon="@Icons.Material.Filled.List" Size="Size.Small" Disabled="IsFormReadOnly" OnClick="DownloadExcelTemplate"></MudIconButton>
                    </MudTooltip>
                    <MudTooltip Text="Remove selected Documents (удалить выбранные Декларации)" Duration="1500" Delay="500">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Disabled="IsFormReadOnly" OnClick="RemoveDocument"></MudIconButton>
                    </MudTooltip>                    
                </div>

                <MudPaper Width="450px" Elevation="0" Style="height:240px; overflow:auto">
                    @if (Value.Documents != null)
                    {
                        <MudTreeView T="ExportOrderDocumentDTO" Items="@TreeItems" @bind-SelectedValue="SelectedDocument"
                                     Dense="true" Hover="true" SelectionMode="SelectionMode.ToggleSelection">
                            <ItemTemplate>
                                @if (context.Value != null)
                                {
                                    <MudTreeViewItem Style="width:100%" Value="@context.Value">
                                        <BodyContent Context="item">
                                            <div class="d-flex" style="flex-direction:row; justify-content: space-between; width:100%">
                                                <MudText>@(context.Value.DocumentName)</MudText>
                                                <MudSpacer />
                                                <MudTooltip Text="Кол-во выбранных товаров в этой ДТ" Delay="1000">
                                                    <MudText Typo="@Typo.caption">@(context.Value.DocumentRecords.Count().ToString())</MudText>
                                                </MudTooltip>                                                
                                                <MudSpacer />
                                                <MudTooltip Text="Список поручений по этой ДТ" Delay="1000">
                                                    <MudIconButton Icon="@Icons.Custom.FileFormats.FileDocument" Size="Size.Small"
                                                        OnClick="@(() => TreeItemIcon_OnClick(context.Value.DocumentName is null ? null : context.Value.DocumentName))">
                                                    </MudIconButton>
                                                </MudTooltip>
                                            </div>                                            
                                        </BodyContent>                                        
                                        <ChildContent>
                                            <MudTable Class="Table" T="ExportOrderDocumentRecordDTO" Items="@(context.Value.DocumentRecords)" Context="DocRecord">
                                                <RowTemplate>
                                                    <MudTd Style="width: 30px; color:gray">@DocRecord.Seq</MudTd>
                                                    <MudTd Style="width: 115px; color:gray">@DocRecord.CommodityHSCode</MudTd>
                                                    <MudTd Style="text-align:left; color:gray">@DocRecord.CommodityName</MudTd>
                                                </RowTemplate>
                                            </MudTable>
                                        </ChildContent>                                        
                                    </MudTreeViewItem>
                                    <MudPopover Class="px-4 pb-4 pt-2" Open="IsPopoverOpen" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                                        @if (ExportOrderNums != Enumerable.Empty<string>() && ExportOrderNums.Count() > 0)
                                        {
                                            <div class="d-flex" style="flex-direction:row; justify-content: flex-end">
                                                <MudTooltip Text="Close" Delay="1000">
                                                    <MudIconButton Style="padding:unset" Icon="@Icons.Material.Rounded.Close" Color="Color.Warning" OnClick="@(() => IsPopoverOpen = false)" />
                                                </MudTooltip>
                                            </div>                                            
                                            <MudText Style="padding-top:10px; padding-bottom:10px">Список поручений по этой ДТ:</MudText>
                                            @foreach (string num in ExportOrderNums)
                                            {
                                                <MudText Color="Color.Primary">@num</MudText>
                                            }                                            
                                        }                                            
                                    </MudPopover>
                                }                                
                            </ItemTemplate>
                        </MudTreeView>
                    }
                </MudPaper>
                <div style="display:flex; margin-top:3px">
                    <span style="margin-top:10px; margin-right:6px"><b>Товар кратко:</b></span>
                    <MudTextField Class="TextField" Style="width: 350px" T="string" @bind-Value="@Value.CommodityShort"
                                  Text="@Value.CommodityShort"
                                  TextChanged="async (e) => { Value.CommodityShort = e.ToUpper().Trim(); }"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" Clearable="!IsFormReadOnly" />
                </div>                
            </div>
            <div class="documents-info" style="margin-left: 15px; max-width:fit-content">
                @if (Value.Documents != null)
                {
                    if (Value.Documents.Count() > 0)
                    {
                        <h6 class="infoSC">Shipper(s):</h6>
                        @* <div style="padding-left:10px">@string.Join(";\n ", Value.Shippers.GroupBy(x => x.Name).Select(g => g.Key))</div> *@
                        @foreach (var shipper in Value.Shippers.GroupBy(x => x.Name).Select(g => g.Key))
                        {
                            <div style="padding-left:10px">@shipper@(Value.Shippers.GroupBy(x => x.Name).Select(g => g.Key).Count() > 1 ? ";" : "")</div>
                        }
                        <br />
                        <h6 class="infoSC">Consignee(s):</h6>
                        @* <div style="padding-left:10px">@string.Join(";\n ", Value.Consignees.Select(x => x.Name).Distinct())</div> *@
                        @foreach (var consignee in Value.Consignees.GroupBy(x => x.Name).Select(g => g.Key))
                        {
                            <div style="padding-left:10px">@consignee@(Value.Consignees.GroupBy(x => x.Name).Select(g => g.Key).Count() > 1 ? ";" : "")</div>
                        }
                    }
                }
            </div>
        </div>
    </div>
    
    <div class="Container-table" style="min-height:360px; max-height:400px; overflow:auto">
        @if (mudTable != null)
        {
            <div class="tableMenu">
                <MudButton Class="Button" Style="margin-inline:20px; margin-bottom:2px" OnClick="UploadFile_Click"                           
                           Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" 
                           StartIcon="@Icons.Material.Filled.UploadFile"
                           Disabled="@(IsFormReadOnly || Value.VesselCallDetail is null)">
                    Upload New List
                </MudButton>               
                <MudSpacer />
                <TablePager T="ExportOrderRecord" Table="mudTable" ItemsCount="@Value.Records.Count()" />
            </div>
        }
        <MudTable Class="Table" @ref="mudTable" Items="@Value.Records" Context="expOrderRecord"
                  Virtualize="true" HorizontalScrollbar="true" RowsPerPage="8" >

            <HeaderContent>
                <MudTh Style="width:50px;">
                    <div class="controlIconButtons">
                        <MudTooltip Text="add new Container record" Duration="1500" Delay="500">
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Disabled="@(IsFormReadOnly || Value.VesselCallDetail is null)" Color="Color.Primary"
                                            OnClick="AddExportOrderRecord_Click" Size="Size.Small" />
                        </MudTooltip>
                    </div>
                </MudTh>
                <MudTh Style="width:35px">
                    <MudTooltip Text="delete All records" Duration="1500" Delay="500">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Error" Size="Size.Small" Disabled="IsFormReadOnly"
                                        OnClick="@(async ()=>{ await RemoveAllContainerRecords();})" />
                    </MudTooltip>
                </MudTh>
                <MudTh Style="width: 120px">Nr</MudTh>
                <MudTh Style="width: 64px">Type</MudTh>
                <MudTh Style="width: 80px">TareWt</MudTh>
                <MudTh Style="width: 300px">Seals</MudTh>
                <MudTh Style="width: 33px">Seq</MudTh>
                <MudTh Style="width: 88px">QTY</MudTh>
                <MudTh Style="width: 120px">Pkg Name</MudTh>
                <MudTh Style="width: 120px">NET</MudTh>
                <MudTh Style="width: 120px">GROSS</MudTh>
                <MudTh Style="width: 35px"></MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="IsFormReadOnly"
                                    OnClick="@(async ()=>{ await ShowRecordContent_Click(expOrderRecord);})" />
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Disabled="IsFormReadOnly"
                                    OnClick="@(async ()=>{ await RemoveContainerRecord(expOrderRecord);})" />
                </MudTd>
                <MudTd>
                    <MudTextField Class="TextField" T="string" @bind-Value="expOrderRecord.CntrNum"
                                    Variant="Variant.Outlined" Margin="Margin.Dense" Required RequiredError="" />
                </MudTd>
                <MudTd>
                    <MudSelect Class="SelectField" T="CntrTpSz" @bind-Value="@expOrderRecord.CntrType"
                                Variant="Variant.Outlined" Margin="Margin.Dense"
                                AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopLeft"
                                CloseIcon="" OpenIcon="">
                        @if (CntrTypes.Count() > 0)
                            @foreach (var type in CntrTypes)
                            {
                                <MudSelectItem Value="@type">@type.Normolize!.ToString()</MudSelectItem>
                            }
                    </MudSelect>
                </MudTd>
                <MudTd>
                    <MudNumericField Class="QuantityField" T="double" @bind-Value="expOrderRecord.CntrTareWt"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Required RequiredError="" HideSpinButtons="true" />
                </MudTd>
                <MudTd>
                    <MudTextField Class="TextField" Style="width: 292px" T="string" @bind-Value="expOrderRecord.Seal"
                                  Text="@expOrderRecord.Seal"
                                  TextChanged="@(async (e) => {expOrderRecord.Seal = e.ToUpper();})"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudTd>
                <MudTd></MudTd>
                <MudTd>
                    <MudTextField Class="QuantityField" Style="width: 80px" T="string" Text="@expOrderRecord.Contents.Sum(s => s.PackageQty).ToString()"                                
                                Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly/>
                </MudTd>
                <MudTd></MudTd>
                <MudTd>
                    <MudTextField Class="TextField_Sum" T="string"
                                  Text="@(expOrderRecord.Contents.Where(s => s.NetWt is not null).Sum(s => s.NetWt!.Value).ToString("## ##0.###"))"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly />
                </MudTd>
                <MudTd>
                    <MudTextField Class="TextField_Sum" T="string"
                                  Text="@(expOrderRecord.Contents.Where(c => c.GrossWt is not null).Sum(s => s.GrossWt!.Value).ToString("## ##0.###"))"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly />
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Style="@(expOrderRecord.IsShowCntrContent ? "transform: rotate(180deg);" : "")"
                                   Size="@Size.Small" OnClick="(_)=>{expOrderRecord.IsShowCntrContent = !expOrderRecord.IsShowCntrContent;}" />
                </MudTd>
                <MudTd></MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (expOrderRecord.IsShowCntrContent)
                {
                    <MudTr>
                        <td colspan="5"></td>
                        <td colspan="6">
                            <MudTable Class="sub-Table" @ref="mudCntrContentTable" Context="CntrContent" Items="@expOrderRecord.Contents">
                                <RowTemplate>
                                    <MudTd Style="width:300px; padding-right:12px; text-align:end">@CntrContent.DocumentRecord.Document.Name</MudTd>
                                    <MudTd Style="width: 33px">@CntrContent.DocumentRecord.Seq</MudTd>
                                    <MudTd Style="width: 88px">@CntrContent.PackageQty</MudTd>
                                    <MudTd Style="width:120px; text-align:center">@CntrContent.PackageName</MudTd>
                                    <MudTd Style="width:120px">@CntrContent.NetWt</MudTd>
                                    <MudTd Style="width:120px">@CntrContent.GrossWt</MudTd>
                                    </RowTemplate>
                            </MudTable>
                        </td>
                        <MudTd Style="width: 35px"></MudTd>
                        <MudTd></MudTd>
                    </MudTr>
                }
            </ChildRowContent>
            <PagerContent></PagerContent>
            <FooterContent>
                @if (Value.Records!.Count > 0)
                {
                    <MudTd colspan="3" Style="text-align:end">
                        <h6 class="Summary">Total containers:</h6>
                    </MudTd>
                    <MudTd Style="text-align:center">
                        <h6 class="Summary">@Value.Records!.Count().ToString("###")</h6>
                    </MudTd>
                    <MudTd Style="text-align:center">
                        <h6 class="Summary">@Value.Records!.Sum(s => s.CntrTareWt).ToString()</h6>
                    </MudTd>
                    <MudTd colspan="2"></MudTd>
                    <MudTd Style="text-align:center">
                        <h6 class="Summary">@Value.Records.Sum(s => s.Contents.Sum(c => c.PackageQty)).ToString()</h6>
                    </MudTd>
                    <MudTd></MudTd>
                    <MudTd Style="text-align:end; padding-right: 8px">
                        <h6 class="Summary">
                            @(Value.Records.Sum(s => s.Contents.Where(c => c.NetWt is not null).Sum(c => c.NetWt!.Value)).ToString("### ###.###"))
                        </h6>
                    </MudTd>
                    <MudTd Style="text-align:end; padding-right: 8px">
                        <h6 class="Summary">
                            @(Value.Records.Sum(s => s.Contents.Where(c => c.GrossWt is not null).Sum(c => c.GrossWt!.Value)).ToString("### ###.###"))
                        </h6>
                    </MudTd>
                    <MudTd colspan="2"></MudTd>
                }
            </FooterContent>
        </MudTable>
    </div>

    <OverlayLoadingData Visible="@IsLoadingData" />
}

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    private MudTable<ExportOrderRecord>? mudTable;
    private MudTable<ContainerContent>? mudCntrContentTable;

    [Parameter]
    public ExportOrderEntity? Value { get; set; }
    [Parameter]
    public EventCallback<ExportOrderEntity> ValueChanged { get; set; }    
    [Parameter]
    public bool IsFormReadOnly { get; set; }
    [Parameter]
    public bool IsRoleForEdit { get; set; }    

    private bool IsLoadingData = false;
    private bool IsMenuOpen;
    private bool IsPopoverOpen = false;
    private bool TreeViewItemSelected;

    private IEnumerable<CntrTpSz> CntrTypes { get; set; } = new List<CntrTpSz>();
    private IEnumerable<PersonEntity> Persons { get; set; } = new List<PersonEntity>();
    private IEnumerable<string> ExportOrderNums { get; set; } = new List<string>();

    private CheckedUploadResult? uploadResult { get; set; }

    private List<TreeItemData<ExportOrderDocumentDTO>> TreeItems { get; set; } = new();
    private List<ExportOrderDocumentDTO> DocumentsDTO { get; set; } = new();
    private List<ExportOrderDocumentRecordDTO> DocumentRecordsDTO { get; set; } = new();
    private ExportOrderDocumentDTO? SelectedDocument { get; set; } = null;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            CntrTypes = await _cntrTypeProvider.GetCntrTypes();
            Persons = await _exportOrderProvider.GetPersonsAsync();
        }
    }

    protected override void OnInitialized()
    {
        FillUpTreeItems();
        //return base.OnInitializedAsync();
    }

    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    #region DOCUMENTS

    private async Task AddDocuments_Click()
    {
        if (Value is null) return;

        DialogParameters parameters = new DialogParameters { ["IsSelectable"] = true };
        var options = new DialogOptions { FullScreen = true, NoHeader = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Document_Index>("Select DOCUMENTS", parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is not null)
        {
            var documents = (IEnumerable<DocumentEntity>)result.Data;

            Value.Documents.AddRange(documents);

            DocumentsDTO = new();
            foreach (var document in documents)
            {
                DocumentsDTO.Add(new ExportOrderDocumentDTO()
                    {
                        Id = document.Id,
                        DocumentName = document.Name,
                        DocumentRecords = new List<ExportOrderDocumentRecordDTO>()
                    });
            }

            TreeItems.AddRange(DocumentsDTO.Select(s => new TreeItemData<ExportOrderDocumentDTO>() { Value = s }).ToList());
        }
        // else
        //     Snackbar.Add($"No any Document selected", Severity.Error);
    }

    private async Task RemoveDocument()
    {
        await Task.Delay(50);

        if (Value is null || SelectedDocument is null) return;


        /// Cntr RECORDS
        var records = Value.Records.Where(eor => eor.Contents.Any(co => co.DocumentRecord.Document.Id == SelectedDocument.Id)).ToList();

        foreach (var record in records)
            if (record.Contents.Count() == 1)
                Value.Records.Remove(record);
            else
            {
                var contents = record.Contents.Where(c => c.DocumentRecord.Document.Id == SelectedDocument.Id).ToList();

                if (contents.Count() > 0)
                    foreach (var content in contents)
                        record.Contents.Remove(content);

                /// if no any content left in the record after removing, then Remove whole record
                if (!record.Contents.Any())
                    Value.Records.Remove(record);
            }

        /// Documents
        var removingDocument = Value.Documents.FirstOrDefault(s => s.Id.Equals(SelectedDocument.Id));
        if (removingDocument is not null)
            Value.Documents.Remove(removingDocument);

        /// TreeItems
        var removingItem = TreeItems.FirstOrDefault(s => s.Value != null && s.Value.Id == SelectedDocument.Id);
        if (removingItem is not null)
            TreeItems.Remove(removingItem);


        SelectedDocument = null;
    }

