    private async Task UploadFile_Click()
    {
        if (Value is null || Value.VesselCallDetail is null) return;

        var parameters = new DialogParameters() { ["VoyageId"] = Value.VesselCallDetail.VesselCall.Id };
        var options = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true, BackdropClick = false };
        var dialog = DialogService.Show<UploadExportOrderRecordsFile>("Импорт списка ДТ", parameters, options);

        var result = await dialog.Result;

        try
        {
            if (result is not null && !result.Canceled && result.Data != null)
            {
                IsLoadingData = true;

                uploadResult = (CheckedUploadResult)result.Data;

                if (uploadResult.UploadedDTO == null) return;

                var checkedRecords = uploadResult.UploadedDTO.ToList().GroupBy(urdto => urdto.CntrNum);
                var checkedDocuments = uploadResult.UploadedDTO.ToList().GroupBy(urdto => urdto.DocumentName);

                var records = new List<ExportOrderRecord>();
                var documents = new List<DocumentEntity>();

                /// RECORDS
                foreach (var checkedRecord in checkedRecords)
                {
                    var newRecord = new ExportOrderRecord()
                    {
                        CntrNum = checkedRecord.FirstOrDefault()!.CntrNum!,
                        CntrType = CntrTypes.FirstOrDefault(x => x.Normolize == checkedRecord.FirstOrDefault()!.CntrType),
                        CntrTareWt = checkedRecord.FirstOrDefault()!.CntrTareWt,
                        Seal = string.IsNullOrEmpty(checkedRecord.FirstOrDefault()!.Seal) ? string.Empty : checkedRecord.FirstOrDefault()!.Seal!,
                    };

                    foreach (var checkedContent in checkedRecord)
                    {   
                        var Document = await _documentProvider.GetDocumentAsync(checkedContent.DocumentName!);

                        var content = new ContainerContent()
                        {
                            PackageQty = checkedContent.PackageQty,
                            PackageName = checkedContent.PackageName,
                            NetWt = checkedContent.NetWt,
                            GrossWt = checkedContent.GrossWt,
                            DocumentRecord = await _documentProvider.GetDocumentRecordAsync(Document!.Name!, (int)checkedContent.SeqCommodity!)
                        };

                        content.DocumentRecord.Document = Document;

                        newRecord.Contents.Add(content);
                    }

                    records.Add(newRecord);
                    newRecord = null;
                }

                /// DOCUMENTS

                /// Remove old documents from the page       (export order Records removing too)
                if (Value.Documents.Any())
                {
                    Value.Documents.RemoveRange(0, Value.Documents.Count());
                    TreeItems = new();
                    // foreach (var document in Value.Documents)
                    //     Value.Documents.Remove(document);
                }

                /// add new documents
                foreach (var checkedDocument in checkedDocuments)
                {
                    var Document = await _documentProvider.GetDocumentAsync(checkedDocument.Key!);

                    if (Document is null) continue;

                    var documentRecords = Document.Records.ToArray();   //ToList();

                    foreach (var documentRecord in documentRecords)
                        if (!checkedDocument.Any(d => d.SeqCommodity == documentRecord.Seq))
                            Document.Records.Remove(documentRecord);

                    documents.Add(Document);
                }

                Value.Records = records;
                Value.Documents = documents;
                FillUpTreeItems();

                IsLoadingData = false;

                Snackbar.Add($"Uploaded", Severity.Success);

                await ValueChanged.InvokeAsync(Value);
            }
        }
        catch (Exception ex)
        {
            string msg = ex.Message;
            Console.WriteLine(msg);
            IsLoadingData = false;
        }        
    }

