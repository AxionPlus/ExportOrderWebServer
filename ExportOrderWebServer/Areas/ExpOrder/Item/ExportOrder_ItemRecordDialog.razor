    private void AddContainerContent_Click()
    {
        if (Item is not null)
            Item.Contents.Add(new ContainerContent() { DocumentRecord = new() });   //Item.Contents.Add(new());
    }

    private void RemoveContainerContent_Click(ContainerContent itemContent)
    {
        Item.Contents.Remove(itemContent);
    }

    private async Task SaveItem_Click()
    {
        if (Form is null) return;
        await Form.Validate();

        if (Form.IsValid)
        {
            bool hasError = await HasCntrNumError();

            if (hasError)
            {
                bool? result = await DialogService.ShowMessageBox(null, (MarkupString)$"{ErrMessage}", yesText: "Отменить");
                return;
            }
            else
                ErrMessage = null;

            MudDialog.Close(DialogResult.Ok(Item));
        }
        else
            Snackbar.Add("Fill up all required fields (marked in red)", Severity.Warning);
    }

    private void CancelItem_Click()
    {
        //Item = BackUpItem;
        MudDialog.Cancel();
        //MudDialog.Close(DialogResult.Ok(BackUpItem));
    }

    private async Task<bool> HasCntrNumError()
    {        
        if (VoyageId == 0 || Item is null) return false;

        string num = Item.CntrNum;

        if (num.Equals(InitialCntrNum)) return false;

        if (num.Length < 11)
        {
            //Snackbar.Add($"Нехватает символов в номере Контейнера.", Severity.Error);
            ErrMessage = "Нехватает символов в номере Контейнера.";
            return true;
        }        

        bool hasError = false;

        // Check DUPLICATES
        bool found = await checkCntrNumService.IsCntrNumDuplicates(num, VoyageId);

        if (found)
        {
            //Snackbar.Add($"{num}: Контейнер повторяется в этом рейсе.", Severity.Error);
            ErrMessage = "Контейнер повторяется в этом рейсе.";
            hasError = true;
        }

        // Check CONTROL DIGIT IN CNTR_NUM
        int controlDigit = await checkCntrNumService.ControlDigit(num);

        if (Convert.ToInt32(num.Substring(10, 1)) != controlDigit)
        {
            //Snackbar.Add($"Контрольная цифра в номере контейнера не верна. Правильно - {controlDigit}.", Severity.Error);
            ErrMessage = $"Контрольная цифра в номере контейнера не верна. Правильно - {controlDigit}.";
            hasError = true;
        }

        return hasError;
    }

    private PatternMask _CntrNumMask = new PatternMask("aaaa#######")
    {
        MaskChars = new[]
        {
            new MaskChar('a', @"[a-zA-Z]"),
            new MaskChar('#', @"[0-9]"),
        }
    };
        
