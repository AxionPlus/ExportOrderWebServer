@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICntrTypeProvider _cntrTypeProvider
@inject IDocumentProvider _documentProvider
@inject IExportOrderProvider _exportOrderProvider
@inject CheckCntrNumService checkCntrNumService

<style>
    .QuantityField * .mud-input > input.mud-input-root-outlined {
    text-align: center;
    }

    .Table * .mud-table-cell .mud-input-control * .mud-icon-size-small {
    margin-top: unset;
    }

    .wrapper-input * .mud-icon-button-size-small.mud-icon-button-edge-end {
    margin-top: 2px;
    margin-inline-end: 3px;
    }

    .Summary {
    margin-top: 3px;
    margin-bottom: 3px;
    color:cornflowerblue;
    }
</style>

@if (Item != null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content">

        <div class="ToolBar-container">
            <MudToolBar Class="ToolBar ToolBar-new">
                <div class="ToolBar-iconbutton" style="margin-left: 20px">
                    <MudTooltip Text="Cancel">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Cancel" OnClick="CancelItem_Click" />
                    </MudTooltip>
                </div>
                <MudSpacer />
                <div class="ToolBar-iconbutton" style="margin-right: 20px">
                    <MudTooltip Text="Save">                        
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" Color="Color.Primary" OnClick="SaveItem_Click" />
                    </MudTooltip>
                </div>
            </MudToolBar>
        </div>

        <div class="Container-item">
            <div class="container-content" style="padding-bottom:unset">
                <MudTextField T="string" Label="Container" Value="@Item.CntrNum" ValueChanged="(e) => { Item.CntrNum = e.ToUpper(); }"
                Mask="@_CntrNumMask"
                Style="width:180px"
                Variant="Variant.Outlined" Margin="Margin.Dense"
                Required RequiredError="" Clearable>
                </MudTextField>
                <MudSelect Class="wrapper-input-select" T="CntrTpSz" Label="Type" @bind-Value="@Item.CntrType"
                Style="width: 108px; margin-inline: 20px;"
                Variant="Variant.Outlined" Margin="Margin.Dense"
                Required RequiredError="" Clearable>
                    @if (CntrTypes is not null)
                        @foreach (var type in CntrTypes)
                        {
                            <MudSelectItem Value="@type">@type.Normolize!.ToString()</MudSelectItem>
                        }
                </MudSelect>
                <MudNumericField Class="QuantityField" T="double" Label="TARE wt" @bind-Value="Item.CntrTareWt"
                Style="width:120px; margin-inline-end:20px"
                Variant="Variant.Outlined" Margin="Margin.Dense"
                Required RequiredError="" HideSpinButtons="true">
                </MudNumericField>
                <MudTextField Class="TextField" T="string" Label="SEALS" @bind-Value="@Item.Seal"
                Style="width:280px"
                Variant="Variant.Outlined" Margin="Margin.Dense"
                Required RequiredError="" Clearable>
                </MudTextField>
                <MudSpacer />
            </div>                        
            <div class="container-content">
                <div class="Container-table">
                    <MudTable Class="Table" @ref="mudTable" Items="Item.Contents" RowsPerPage="10">
                        <HeaderContent>
                            <MudTh Style="width:35px">
                                <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" OnClick="AddContainerContent_Click">
                                    ADD new content</MudIconButton>
                            </MudTh>
                            <MudTh Style="width:240px">Document</MudTh>
                            <MudTh Style="width:150px">HS Code</MudTh>
                            <MudTh Style="width:350px">Commodity Name</MudTh>
                            <MudTh Style="width: 75px">PkgQty</MudTh>
                            <MudTh Style="width:120px">PkgName</MudTh>
                            <MudTh Style="width:100px">Net</MudTh>
                            <MudTh Style="width:100px">Gross</MudTh>
                            <MudTh Style="width:100px">Volume</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="@Color.Error" Disabled="@(!Item.Contents.Any())"
                                OnClick="@(async () => { RemoveContainerContent_Click(context); })" />
                            </MudTd>
                            <MudTd>
                                <MudSelect Class="wrapper-input" T="string" Style="width:200px" Value="@context.DocumentName"
                                ValueChanged="@(t => { context.DocumentName = t; context.DocumentRecord = new DocumentRecord(); })"
                                Variant="Variant.Outlined" OpenIcon="" Required RequiredError="" Clearable>
                                    @if (DocumentNames != null)
                                        @foreach (var name in DocumentNames)
                                        {
                                            <MudSelectItem T="string" Value="@name"></MudSelectItem>
                                        }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudSelect Class="wrapper-input" Style="width:120px" T="DocumentRecord" @bind-Value="@context.DocumentRecord"                                      
                                ToStringFunc="@(dr => dr != null ? dr.CommodityHSCode : "")"
                                Variant="Variant.Outlined" Margin="Margin.Dense"
                                OpenIcon="" Required RequiredError="" Clearable>
                                    @if (context.DocumentName != null && Documents != null)
                                        @foreach (DocumentRecord documentRecord in Documents.FirstOrDefault(d => !string.IsNullOrEmpty(d.Name) &&
                                           d.Name == context.DocumentName)!.Records)
                                        {
                                            <MudSelectItem Value="@documentRecord">
                                                @($"({documentRecord.CommodityHSCode}) {documentRecord?.CommodityName}")
                                            </MudSelectItem>
                                        } 
                                </MudSelect>
                            </MudTd>
                            <MudTd>@(context.DocumentRecord is not null ? context.DocumentRecord.CommodityName : "")</MudTd>
                            <MudTd>
                                <MudNumericField Class="wrapper-input NoHeader" T="uint?"  @bind-Value="@context.PackageQty"
                                Variant="Variant.Outlined" HideSpinButtons  />
                            </MudTd>
                            <MudTd>
                                <MudTextField Class="wrapper-input NoHeader" T="string" @bind-Value="@context.PackageName" Variant="Variant.Outlined" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Class="wrapper-input NoHeader" T="double?" @bind-Value="@context.NetWt"
                                Variant="Variant.Outlined" HideSpinButtons />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Class="wrapper-input NoHeader" T="double?" @bind-Value="@context.GrossWt"
                                Variant="Variant.Outlined" HideSpinButtons />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Class="wrapper-input NoHeader" T="double?" @bind-Value="@context.Volume"
                                Variant="Variant.Outlined" HideSpinButtons Disabled />
                            </MudTd>
                            <MudTd></MudTd>
                        </RowTemplate>
                        <FooterContent>
                            @if (Item.Contents.Count(co => co.DocumentRecord != null) > 0)
                            {
                                <MudTd colspan="2" Style="text-align:center">
                                    <h6 class="Summary">
                                        Total documents:@(" ")
                                        @if (Item.Contents.Any(co => co.DocumentRecord != null))
                                            @Item.Contents.Where(co => co.DocumentRecord != null).GroupBy(co => co.DocumentName)!.Count()
                                    </h6>
                                </MudTd>
                                <MudTd Style="text-align:center">
                                    <h6 class="Summary">
                                        goods:
                                        @if (Item.Contents.Any(co => co.DocumentRecord != null))
                                            @Item.Contents.Where(co => co.DocumentRecord != null).GroupBy(co => co.DocumentRecord.CommodityEngName)!.Count()
                                    </h6>
                                </MudTd>
                                <MudTd colspan="6"></MudTd>
                                <MudTd></MudTd>
                            }
                        </FooterContent>
                    </MudTable>
                </div>
            </div>            
        </div>

    </MudForm>       
}

<OverlayLoadingData Visible="@IsLoadingData" />

