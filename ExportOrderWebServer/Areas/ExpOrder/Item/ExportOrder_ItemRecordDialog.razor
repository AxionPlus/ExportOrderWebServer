@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICntrTypeProvider _cntrTypeProvider
@inject IDocumentProvider _documentProvider
@inject IExportOrderProvider _exportOrderProvider
@inject ISupplementaryUnitProvider _supplementaryUnitProvider

<style>
    .Table * .mud-table-cell .mud-input-control * .mud-icon-size-small {
        margin-top: unset;
    }

    .wrapper-input * .mud-icon-button-size-small.mud-icon-button-edge-end {
        margin-top: 2px;
        margin-inline-end: 3px;
    }
</style>

@if (Item != null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content">
        <div class="Container-item">
            <div class="container-content" style="padding-top:unset; padding-bottom:unset">
                <MudSpacer />
                <MudButton Class="Button" Style="margin-inline-end:20px" Size="Size.Small" OnClick="SaveItem_Click"
                Variant="Variant.Filled" Color="Color.Primary" 
                StartIcon="@Icons.Material.Filled.Save">
                    SAVE
                </MudButton>
            </div>
            <div class="container-content" style="padding-top:unset">
                <div class="Container-table">
                    <MudTable Class="Table" @ref="mudTable" Items="Item.Contents" RowsPerPage="10">
                        <HeaderContent>
                            <MudTh Style="width:35px">
                                <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" OnClick="AddContainerContent_Click">
                                    ADD new content</MudIconButton>
                            </MudTh>
                            <MudTh Style="width:240px">Document</MudTh>
                            <MudTh Style="width:130px">HS Code</MudTh>
                            <MudTh Style="width:200px">Commodity Name</MudTh>
                            <MudTh Style="width: 70px">PkgQty</MudTh>
                            <MudTh Style="width:120px">PkgName</MudTh>
                            <MudTh Style="width: 95px">Net</MudTh>
                            <MudTh Style="width: 95px">Gross</MudTh>
                            <MudTh Style="width: 95px">Volume</MudTh>
                            <MudTh Style="width:163px" colspan="2">
                                Доп. еденицы
                                <div style="display:flex; flex-direction:row;">
                                    <MudTh Style="width: 95px">значение</MudTh>
                                    <MudTh Style="width: 60px">код</MudTh>
                                </div>                                
                            </MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="@Color.Error" Disabled="@(!Item.Contents.Any())"
                                               OnClick="@(async () => { RemoveContainerContent_Click(context); })" />
                            </MudTd>
                            <MudTd>
                                <MudSelect Class="wrapper-input" T="string" Style="width:232px" Value="@context.DocumentName"
                                           ValueChanged="@(t => { context.DocumentName = t; context.DocumentRecord = new DocumentRecord(); })"
                                           Variant="Variant.Outlined" OpenIcon="" Required RequiredError="" Clearable>
                                    @if (DocumentNames != null)
                                        @foreach (var name in DocumentNames)
                                        {
                                            <MudSelectItem T="string" Value="@name"></MudSelectItem>
                                        }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudSelect Class="wrapper-input" Style="width:122px" T="DocumentRecord" @bind-Value="@context.DocumentRecord"
                                           ToStringFunc="@(dr => dr != null ? dr.CommodityHSCode : "")"
                                           Variant="Variant.Outlined" Margin="Margin.Dense"
                                           OpenIcon="" Required RequiredError="" Clearable>
                                    @if (context.DocumentName != null && Documents != null)
                                        @foreach (DocumentRecord documentRecord in Documents.FirstOrDefault(d => !string.IsNullOrEmpty(d.Name) &&
                                            d.Name == context.DocumentName)!.Records)
                                            {
                                                <MudSelectItem Value="@documentRecord">
                                                    @($"({documentRecord.CommodityHSCode}) {documentRecord.CommodityName}")
                                                </MudSelectItem>
                                            } 
                                </MudSelect>
                            </MudTd>
                            <MudTd>@(context.DocumentRecord is not null ? context.DocumentRecord.CommodityName : "")</MudTd>
                            <MudTd>
                                @* <MudNumericField Class="wrapper-input NoHeader" T="uint?"  @bind-Value="@context.PackageQty" Variant="Variant.Outlined" HideSpinButtons  /> *@
                                <MudTextField Class="TextField Numeric" T="uint?" @bind-Value="@context.PackageQty" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd>
                                @* <MudTextField Class="wrapper-input NoHeader" T="string" @bind-Value="@context.PackageName" Variant="Variant.Outlined" /> *@
                                <MudTextField Class="TextField" T="string" @bind-Value="@context.PackageName" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd>
                                @* <MudNumericField Class="wrapper-input NoHeader" T="double?" @bind-Value="@context.NetWt" Variant="Variant.Outlined" HideSpinButtons /> *@
                                <MudTextField Class="TextField Numeric" T="double?" @bind-Value="@context.NetWt" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd>
                                @* <MudNumericField Class="wrapper-input NoHeader" T="double?" @bind-Value="@context.GrossWt" Variant="Variant.Outlined" HideSpinButtons /> *@
                                <MudTextField Class="TextField Numeric" T="double?" @bind-Value="@context.GrossWt" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd>
                                @* <MudNumericField Class="wrapper-input NoHeader" T="double?" @bind-Value="@context.Volume" Variant="Variant.Outlined" HideSpinButtons Disabled /> *@
                                <MudTextField Class="TextField Numeric" T="double?" @bind-Value="@context.Volume" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled />
                            </MudTd>
                            <MudTd Style="width: 95px">
                                @* <MudNumericField Class="wrapper-input NoHeader" T="double?" @bind-Value="@context.SupplementaryUnitQuantity" Variant="Variant.Outlined" HideSpinButtons /> *@
                                <MudTextField Class="TextField Numeric" T="double?" @bind-Value="@context.SupplementaryUnitQuantity" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd Style="width: 60px">
                                <MudAutocomplete Class="wrapper-input NoHeader" T="SupplementaryUnitCatalog" @bind-Value="context.SupplementaryUnit"
                                                 ToStringFunc="@(e => e != null ? e.Code.ToString() : "")"
                                                 SearchFunc="@SearchUnit"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense"                                                 
                                                 ResetValueOnEmptyText="true" MaxItems="10"
                                                 CloseIcon="" OpenIcon="" />
                            </MudTd>
                            <MudTd></MudTd>
                        </RowTemplate>
                        <FooterContent>
                            @if (Item.Contents.Count(co => co.DocumentRecord != null) > 0)
                            {
                                <MudTd colspan="2" Style="text-align:center">
                                    <h6 class="Summary">
                                        Total documents:@(" ")
                                        @if (Item.Contents.Any(co => co.DocumentRecord != null))
                                            @Item.Contents.Where(co => co.DocumentRecord != null).GroupBy(co => co.DocumentName)!.Count()
                                    </h6>
                                </MudTd>
                                <MudTd Style="text-align:center">
                                    <h6 class="Summary">
                                        goods:
                                        @if (Item.Contents.Any(co => co.DocumentRecord != null))
                                            @Item.Contents.Where(co => co.DocumentRecord != null).GroupBy(co => co.DocumentRecord.CommodityEngName)!.Count()
                                    </h6>
                                </MudTd>
                                <MudTd colspan="8"></MudTd>
                                <MudTd></MudTd>
                            }
                        </FooterContent>
                    </MudTable>
                </div>
            </div>            
        </div>
    </MudForm>
}

@code {
    private MudForm? Form { get; set; }
    private MudTable<ContainerContent>? mudTable;
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = new();
    [CascadingParameter] public string? ApplicationUser { get; set; }

    [Parameter]
    public ExportOrderRecord Item { get; set; } = new();
    [Parameter]
    public string CntrNum { get; set; } = "";
    [Parameter]
    public IEnumerable<DocumentEntity> Documents { get; set; } = new List<DocumentEntity>();

    private IEnumerable<string?> DocumentNames { get; set; } = new List<string>();
    private IEnumerable<CntrTpSz> CntrTypes { get; set; } = new List<CntrTpSz>();
    

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
            CntrTypes = await _cntrTypeProvider.GetCntrTypes();
    }

    protected override void OnInitialized()    // prev. - async Task OnInitializedAsync()
    {
        if (Item.Contents.Any())
            foreach (var content in Item.Contents)
                content.DocumentName = content.DocumentRecord.Document.Name;

        if (Documents.Any())
            DocumentNames = Documents.Select(s => s.Name).Where(n => !string.IsNullOrEmpty(n)).ToArray();
    }

    private void AddContainerContent_Click()
    {
        if (Item is not null)
            Item.Contents.Add(new ContainerContent() { DocumentRecord = new() });
    }

    private void RemoveContainerContent_Click(ContainerContent itemContent)
    {
        Item.Contents.Remove(itemContent);
    }
    
    private async Task<IEnumerable<SupplementaryUnitCatalog>> SearchUnit(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<SupplementaryUnitCatalog>();

        var units = await _supplementaryUnitProvider.GetItemsAsync();

        if (units is null || !units.Any())
            return Enumerable.Empty<SupplementaryUnitCatalog>();

        return units.Where(x => x.Code.ToString().Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task SaveItem_Click()
    {
        if (Form is null) return;
        await Form.Validate();

        if (Form.IsValid)
            MudDialog.Close(DialogResult.Ok(true));
        else
            Snackbar.Add("Fill up all required fields (marked in red)", Severity.Warning);
    }   
}