@page "/uploadExportOrderRecords"

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IHttpClientFactory httpClient
@inject IUploadResultService _uploadResultService

<MudStack Style="width: 100%">
    <MudFileUpload T="IBrowserFile" OnFilesChanged="OnInputFileChanged" Hidden="false" Class="flex-1"
                   InputClass="absolute mud-width-full mud-height-full overflow-hidden z-20" InputStyle="opacity:0"
                   @ondragenter="@SetDragClass" @ondragleave="@ClearDragClass" @ondragend="@ClearDragClass">
        <ActivatorContent>
            <MudPaper Height="200px" Outlined="true" Class="@DragClass">
                <MudText Typo="Typo.h6">Drag and drop files here or click</MudText>
                @if (!string.IsNullOrEmpty(FileName))
                {
                    <MudChip T="string" Color="Color.Dark" Text="@FileName" />
                }
            </MudPaper>
        </ActivatorContent>
    </MudFileUpload>
    <MudToolBar Class="gap-4">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CheckAndUploadFile"
                   Style="margin-inline-start:10px"
                   Disabled="@(!FileName.Any())"
                   StartIcon="@Icons.Material.Filled.UploadFile">
            @(IsChecked ? "Upload" : "Check") @(" ") File(s)
        </MudButton>
        <MudSpacer />
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Clear"
                   Style="margin-inline-end:10px"
                   Disabled="@(!FileName.Any())">
            Clear
        </MudButton>
    </MudToolBar>
    @if (!string.IsNullOrWhiteSpace(_AppObjectResponse.Description))
    {
        <MudText Style="margin-inline-start:5px"><b>Всего: </b>@_AppObjectResponse.Description</MudText>
        if (_AppObjectResponse.HasCriticalErrors)
        {
            <MudText Style="margin-inline-start:5px" Color="Color.Error">
                <b>Есть критические ошибки. Записи отмеченные как *Critical не будут загружены!</b>
            </MudText>
        }
    }
    @if (_AppObjectResponse.HasErrors)
    {
        <table class="Table_Summary" style="margin-inline:10px; width:900px">
            <tr>
                <th style="width:200px">Декларация</th>
                <th style="width:110px">Контейнер</th>
                <th>Описание ошибки</th>
            </tr>
            @foreach (var error in _AppObjectResponse.Errors)
            {
                <tr>
                    <td>@error.Split(':')[0]</td>
                    <td>@error.Split(':')[1]</td>
                    <td>@error.Split(':')[2]</td>
                </tr>
            }
        </table>
    }
</MudStack>

<OverlayLoadingData Visible="IsLoadingData" Text="Uploading..." />

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = new();

    [Parameter]
    public long EoId { get; set; }      // Id поручения
    [Parameter]
    public long VoyageId { get; set; }  // Id рейса

    private static string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full z-10";
    private string DragClass = DefaultDragClass;
    private int maxAllowedFiles = 1;
    private string FileName = string.Empty;
    private IBrowserFile? BrowserFile;

    private List<UploadExcelDTO>? UploadedExcelDTO { get; set; }
    private AppObjectResponse _AppObjectResponse { get; set; } = new();

    private bool IsLoadingData { get; set; } = false;
    private bool IsChecked { get; set; } = false;


    private void OnInputFileChanged(InputFileChangeEventArgs e) //async Task
    {
        ClearDragClass();
        //await Task.Delay(10);
        BrowserFile = (IBrowserFile)e.File;
        FileName = e.File.Name;
    }

    private void Clear()
    {
        ClearDragClass();

        BrowserFile = null;
        FileName = string.Empty;        
        IsChecked = false;

        _AppObjectResponse = new();
    }

    private void SetDragClass() =>     
        DragClass = $"{DefaultDragClass} mud-border-primary";


    private void ClearDragClass() =>
        DragClass = DefaultDragClass;

    private async Task CheckAndUploadFile()
    {
        if (IsChecked)
        {
            /// GET DATA
            if (UploadedExcelDTO is not null && UploadedExcelDTO.Any())
            {
                IsLoadingData = true;

                var uploadResult = await _uploadResultService.GetUploadedResult_ExportOrder(UploadedExcelDTO);

                IsLoadingData = false;

                if (uploadResult is not null)
                    MudDialog.Close(uploadResult);
            }

            MudDialog.Cancel();
            return;
        }

        if (BrowserFile is null) return;

        IsLoadingData = true;

        long maxFileSize = 1024 * 500;

        var content = new MultipartFormDataContent();

        var streamContent = new StreamContent(BrowserFile.OpenReadStream(maxFileSize));
        streamContent.Headers.ContentType = new MediaTypeHeaderValue(BrowserFile.ContentType);

        content.Add(
            content: streamContent,
            name: "\"file\"",
            fileName: BrowserFile.Name);

        using (var client = httpClient.CreateClient())
        {
            client.Timeout = new TimeSpan(0, 10, 0);        // TimeSpan.FromMinutes(10);

            var response = await client.PostAsync($"{ApplicationParameter.PostUploadFileUrl}UploadFromFileExcel", content);

            if (response.IsSuccessStatusCode)
            {
                UploadedExcelDTO = await response.Content.ReadFromJsonAsync<List<UploadExcelDTO>?>();

                if (UploadedExcelDTO is null)
                    Snackbar.Add($"Data not uploaded", Severity.Error);
                else
                {
                    /// SUMMARY
                    int CntrCount = UploadedExcelDTO.GroupBy(ud => ud.CntrNum).Count();
                    int DocumentCount = UploadedExcelDTO.GroupBy(ud => ud.DocumentName).Count();
                    _AppObjectResponse.Description = $"контейнеров {CntrCount}, деклараций {DocumentCount}.";

                    /// ERRORS
                    var errors = await _uploadResultService.CheckUploadedExportOrder(UploadedExcelDTO, EoId, VoyageId);
                    if (errors is not null && errors.Any())
                    {
                        _AppObjectResponse.Errors = errors.ToList();
                        if (errors.Any(s => s.Contains("*Critical")))
                            _AppObjectResponse.HasCriticalErrors = true;
                    }

                    /// CHECKED AND READY TO UPLOAD
                    IsChecked = true;
                }
            }
            else
                Snackbar.Add($"File not uploaded", Severity.Error);
        }

        ClearDragClass();
        
        IsLoadingData = false;
    }
}