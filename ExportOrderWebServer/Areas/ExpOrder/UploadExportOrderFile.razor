@page "/uploadExportOrderRecords"

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IHttpClientFactory httpClient
@inject CheckUploadResultService CheckUploadResultService

<MudStack Style="width: 100%">
    <MudFileUpload T="IReadOnlyList<IBrowserFile>" OnFilesChanged="OnInputFileChanged" Hidden="false" Class="flex-1"
    InputClass="absolute mud-width-full mud-height-full overflow-hidden z-20" InputStyle="opacity:0"
    @ondragenter="@SetDragClass" @ondragleave="@ClearDragClass" @ondragend="@ClearDragClass">
        <ActivatorContent>
            <MudPaper Height="200px" Outlined="true" Class="@DragClass">
                <MudText Typo="Typo.h6">Drag and drop files here or click</MudText>
                @if (!string.IsNullOrEmpty(FileName))
                {
                    <MudChip T="string" Color="Color.Dark" Text="@FileName" />
                }
            </MudPaper>
        </ActivatorContent>
    </MudFileUpload>
    <MudToolBar Class="gap-4">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CheckAndUploadFile"
        Style="margin-inline-start:10px"
        Disabled="@(!FileName.Any())"
        StartIcon="@Icons.Material.Filled.UploadFile">
            @BtnName @(" ") File(s)
        </MudButton>
        <MudSpacer />
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Clear"
        Style="margin-inline-end:10px"
        Disabled="@(!FileName.Any())">
            Clear
        </MudButton>
    </MudToolBar>

    @if (!string.IsNullOrWhiteSpace(uploadResult.Summary))
    {
        <MudText Style="margin-inline-start:5px"><b>Всего: </b>@uploadResult.Summary</MudText>        
        if (uploadResult.HasCriticalErrors)
        {
            <MudText Style="margin-inline-start:5px" Color="Color.Error">
                <b>Есть критические ошибки. Записи отмеченные Critical не будут загружены!</b>
            </MudText>
        }
    }

    @if (uploadResult.HasErrors)
    {
        <table class="Table_Summary" style="margin-inline:10px; width:900px">
            <tr>
                <th style="width:200px">Декларация</th>
                <th style="width:110px">Контейнер</th>
                <th>Описание ошибки</th>
            </tr>
            @foreach (var error in uploadResult.Errors)
            {
                <tr>
                    <td>@error.Split(':')[0]</td>
                    <td>@error.Split(':')[1]</td>
                    <td>@error.Split(':')[2]</td>
                </tr>
            }
        </table>
    }
</MudStack>

<OverlayLoadingData Visible="IsLoadingData" Text="Uploading..." />

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = new();

    [Parameter]
    public long EoId { get; set; }      // Id поручения

    [Parameter]
    public long VoyageId { get; set; }  // Id рейса

    private static string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full z-10";
    private string DragClass = DefaultDragClass;
    private int maxAllowedFiles = 1;
    private string FileName = string.Empty;
    IList<IBrowserFile> BrowserFiles = new List<IBrowserFile>();

    public CheckedUploadResult uploadResult { get; set; } = new CheckedUploadResult();
    private bool IsLoadingData = false;
    private string BtnName { get; set; } = "Check";
    private bool IsChecked { get; set; } = false;


    private void OnInputFileChanged(InputFileChangeEventArgs e)
    {
        ClearDragClass();

        BrowserFiles = (IList<IBrowserFile>)e.GetMultipleFiles();
        using var content = new MultipartFormDataContent();

        FileName = e.File.Name;
    }

    private void Clear()
    {
        ClearDragClass();

        FileName = string.Empty;
        uploadResult = new CheckedUploadResult();
        BtnName = "Check";
        IsChecked = false;
    }

    private void SetDragClass()
    {
        DragClass = $"{DefaultDragClass} mud-border-primary";
    }

    private void ClearDragClass()
    {
        DragClass = DefaultDragClass;
    }

    private async Task CheckAndUploadFile()
    {
        if (IsChecked)
        {
            if (uploadResult.UploadedDTO is not null && uploadResult.UploadedDTO.Any())
                MudDialog.Close(uploadResult.UploadedDTO);
            else
                MudDialog.Cancel();

            return;
        }

        IsLoadingData = true;

        long maxFileSize = 1024 * 500;
        using var content = new MultipartFormDataContent();

        foreach (var file in BrowserFiles)
        {
            var fileContent = new StreamContent(file.OpenReadStream(maxFileSize));

            fileContent.Headers.ContentType =
                new MediaTypeHeaderValue(file.ContentType);

            content.Add(
                content: fileContent,
                name: "\"files\"",
                fileName: file.Name);
        }

        using (var client = httpClient.CreateClient())
        {
            client.Timeout = new TimeSpan(0, 10, 0);        // TimeSpan.FromMinutes(10);

            var response = await client.PostAsync($"{ApplicationParameter.PostUploadFileUrl}UploadFromExcel", content);

            if (response.IsSuccessStatusCode)
            {
                var uploadedDTO = await response.Content.ReadFromJsonAsync<List<UploadExcelDTO>?>();

                if (uploadedDTO is null)
                    Snackbar.Add($"Data not uploaded", Severity.Error);
                else
                {                    
                    /// DATA
                    uploadResult.UploadedDTO = uploadedDTO;

                    /// SUMMARY
                    int CntrCount = uploadedDTO.GroupBy(ud => ud.CntrNum).Count();
                    int DocumentCount = uploadedDTO.GroupBy(ud => ud.DocumentName).Count();
                    uploadResult.Summary = $"контейнеров {CntrCount}, деклараций {DocumentCount}.";

                    /// ERRORS
                    var errors = await CheckUploadResultService.CheckUploadedResult(uploadedDTO, EoId, VoyageId);
                    if (errors is not null && errors.Any())
                    {
                        uploadResult.Errors = errors;
                        if (errors.Any(s => s.Contains("*Critical")))
                            uploadResult.HasCriticalErrors = true;
                    }                    

                    /// CHECKED AND READY TO UPLOAD
                    IsChecked = true;
                    BtnName = "Upload";
                }
            }
            else
                Snackbar.Add($"File not uploaded", Severity.Error);
        }

        ClearDragClass();
        
        IsLoadingData = false;
    }
}