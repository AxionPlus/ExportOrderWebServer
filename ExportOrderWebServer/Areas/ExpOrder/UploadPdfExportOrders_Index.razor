@page "/uploadPdfExportOrders"
@attribute [Authorize(Roles = "Admin, Top Manager")]

@inject ISnackbar Snackbar
@inject IJSRuntime jsRuntime
@inject IHttpClientFactory httpClient

<AuthorizeView>
    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">
            <ShowMainMenuButton Class="ToolBar-IconButton" ExitHref="/" />
            <MudSpacer />
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
            </div>
        </MudToolBar>
    </div>
</AuthorizeView>

<div class="Container-item">
    <div class="container-content">
        <MudFileUpload T="IReadOnlyList<IBrowserFile>" Accept=".pdf" MaximumFileCount="1" InputStyle="opacity:0" OnFilesChanged="OnInputFileChanged"
                       @ondragenter="@SetDragClass" @ondragleave="@ClearDragClass" @ondragend="@ClearDragClass">
            <ActivatorContent>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">Upload PDF file</MudButton>
            </ActivatorContent>
        </MudFileUpload>
        <div style="width:10px"></div>
        <MudFileUpload T="IReadOnlyList<IBrowserFile>" Accept=".docx" MaximumFileCount="1" InputStyle="opacity:0" OnFilesChanged="OnInputFileChanged"
                       @ondragenter="@SetDragClass" @ondragleave="@ClearDragClass" @ondragend="@ClearDragClass">
            <ActivatorContent>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">Upload WORD file</MudButton>
            </ActivatorContent>
        </MudFileUpload>
        <MudToolBar Class="gap-4">
            @foreach (var file in BrowserFiles)
            {
                <MudChip T="string" Color="Color.Dark" Text="@file.Name" />
            }
            <MudButton OnClick="UploadFilePdfOrWord_Click" Disabled="@(!BrowserFiles.Any())" Color="Color.Success" Variant="Variant.Filled">Convert to Excel</MudButton>
            <MudButton OnClick="ClearDragClass" Disabled="@(!BrowserFiles.Any())" Color="Color.Dark" Variant="Variant.Filled">Clear</MudButton>
        </MudToolBar>
        <MudSpacer />
    </div>
</div>

<OverlayLoadingData Visible="IsLoadingData" Text="Uploading..." />

@code {
    IList<IBrowserFile> BrowserFiles = new List<IBrowserFile>();
    private static string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full z-10";
    private string DragClass = DefaultDragClass;
    private bool IsLoadingData { get; set; } = false;
    private string FilePath { get; set; } = string.Empty;

    private void OnInputFileChanged(InputFileChangeEventArgs e)
    {
        ClearDragClass();
        BrowserFiles = (IList<IBrowserFile>)e.GetMultipleFiles();
    }

    private void SetDragClass()
    {
        DragClass = $"{DefaultDragClass} mud-border-primary";
    }

    private void ClearDragClass()
    {
        DragClass = DefaultDragClass;
        BrowserFiles = new List<IBrowserFile>();
    }

    private async Task UploadFilePdfOrWord_Click()
    {
        if (!BrowserFiles.Any()) return;

        // long maxFileSize = 1024 * 2000;  //500

        // /// Check File size
        // if (BrowserFiles.Any(f => f.Size > maxFileSize))
        // {
        //     Snackbar.Add($"File size should be less then 2 Mb.", Severity.Warning);
        //     ClearDragClass();
        //     return;
        // }

        IsLoadingData = true;

        /// Upload and Save Pdf or Word files
        using var content = new MultipartFormDataContent();
        string postURL = string.Empty;

        foreach (var file in BrowserFiles)
        {
            var fileContent = new StreamContent(file.OpenReadStream(file.Size));    //maxFileSize

            fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);

            content.Add(
                content: fileContent,
                name: "\"file\"",
                fileName: file.Name);
        }
                
        // using (var client = httpClient.CreateClient())
        // {            
        //     client.Timeout = TimeSpan.FromMinutes(10);  //client.Timeout = new TimeSpan(0, 10, 0);

        //     var response = await client.PostAsync($"{ApplicationParameter.PostUploadFileUrl}UploadFilePdfOrWord", content);
        //     //var response = await client.PostAsync($"http://localhost:7070/file/UploadFile/UploadFilePdfOrWord", content);

        //     if (response.IsSuccessStatusCode)
        //     {
        //         var filePath = await response.Content.ReadAsStringAsync();   //dirPath

        //         if (string.IsNullOrEmpty(filePath))
        //             Snackbar.Add($"Data not uploaded", Severity.Error);
        //         else                    
        //             await jsRuntime.InvokeVoidAsync("open", $"{ApplicationParameter.DownloadFileUrl}ReadFileAndDownloadExcelOrder?filePath={filePath}");
        //     }
        //     else
        //         Snackbar.Add($"File not uploaded", Severity.Error);
        // }

        /// Upload File to Server
        using (var client = httpClient.CreateClient())
        {
            client.Timeout = TimeSpan.FromMinutes(10);  //client.Timeout = new TimeSpan(0, 10, 0);

            var response = await client.PostAsync($"{ApplicationParameter.PostUploadFileUrl}UploadFilePdfOrWord", content);
            //var response = await client.PostAsync($"http://localhost:7070/file/UploadFile/UploadFilePdfOrWord", content);

            if (response.IsSuccessStatusCode)
                FilePath = await response.Content.ReadAsStringAsync();
            else
                Snackbar.Add($"File not uploaded", Severity.Error);
        }

        /// Read and Convert Pdf / Word file to Excel file
        if (string.IsNullOrEmpty(FilePath))
            Snackbar.Add($"File not uploaded", Severity.Error);
        else                    
            await jsRuntime.InvokeVoidAsync("open", $"{ApplicationParameter.DownloadFileUrl}ReadFileAndDownloadExcelOrder?filePath={FilePath}");

        ClearDragClass();

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }
}
