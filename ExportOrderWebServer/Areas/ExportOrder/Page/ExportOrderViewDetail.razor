    private async void ShowRecordContent_Click(ExportOrderRecord record)
    {
        if (Item.Documents.Count() == 0 || Item.VesselCallDetail is null) return;

        if (string.IsNullOrWhiteSpace(record.CntrNum))
        {
            Snackbar.Add("Укажите номер Контейнера.", Severity.Warning);
            return;
        }

        /// Serve Original records
        List<ContainerContent> originalContainerContents = FuncOriginalRecordContents(record.Contents);

        var parameters = new DialogParameters() { ["Item"] = record, ["Documents"] = Item.Documents };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, CloseButton = false, CloseOnEscapeKey = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<ExportOrder_ItemRecordDialog>(null, parameters, options);
        var result = await dialog.Result;

        /// Refresh saved records (button Save) or return old one (button Exit)
        if (result is not null && result.Data != null && (bool)result.Data == true)
        {
            FillUpTreeItems();
            await InvokeAsync(StateHasChanged);
        }
        else
            record.Contents = originalContainerContents; /// возврат начальных значений коллекции
    }

