    private async void TreeItemIcon_OnClick(string? docName)
    {
        if (!string.IsNullOrWhiteSpace(docName))
        {
            IsPopoverOpen = !IsPopoverOpen;

            if (IsPopoverOpen)
            {
                var exportOrderNums = await ExportOrderProvider.GetDocumentExportOrderNums(docName, CancellationToken.None);
                double[] total = await ExportOrderProvider.GetDocumentExportOrderTotalWeights(docName, CancellationToken.None);

                if (exportOrderNums != Enumerable.Empty<string>())
                {
                    var numberFormat = (NumberFormatInfo)CultureInfo.CurrentCulture.NumberFormat.Clone();
                    numberFormat.NumberGroupSeparator = " "; // пробел как разделитель тысяч

                    DocumentName = docName;
                    ExportOrderNums = exportOrderNums;
                    ExportOrdersTotalNetWt = total[0].ToString("N3", numberFormat);
                    ExportOrdersTotalGrossWt = total[1].ToString("N3", numberFormat);
                }

                await InvokeAsync(StateHasChanged);
            }
            else
                ExportOrderNums = Enumerable.Empty<string>();
        }
    }    

