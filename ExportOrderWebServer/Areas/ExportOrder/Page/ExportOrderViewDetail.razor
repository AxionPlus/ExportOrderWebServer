    private async Task<IEnumerable<CarrierCatalog>> SearchCarrier(string value, CancellationToken token)
    {
        /// check Terminal for this Carrier before select
        string? terminal = Item.VesselCallDetail?.VesselCall.Terminal.Name;

        if (terminal is null)
            return Enumerable.Empty<CarrierCatalog>();

        /// select Carrier
        IEnumerable<CarrierCatalog> Carriers = new List<CarrierCatalog>();

        var response = await CarrierProvider.GetItemsAsync();
        if (!response.HasErrors && response.Object is not null)
            Carriers = (IEnumerable<CarrierCatalog>)response.Object;

        Carriers = Carriers.OrderBy(x => x.Name).Where(x => x.CarrierDetails.Where(d => d.TerminalName == terminal).ToList().Count > 0).ToArray();   //ToList

        if (string.IsNullOrWhiteSpace(value))
            return Carriers;

        return Carriers.Where(x => !string.IsNullOrWhiteSpace(x.Name) && x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase)); //.ToList();
    }

    private readonly Func<List<ContainerContent>, List<ContainerContent>> FuncOriginalRecordContents = (originals) =>
    {
        List<ContainerContent> contents = new();

        foreach (var original in originals)
        {
            contents.Add(new ContainerContent()
            {
                Id = original.Id,
                PackageQty = original.PackageQty,
                PackageName = original.PackageName,
                NetWt = original.NetWt,
                GrossWt = original.GrossWt,
                Volume = original.Volume,
                SupplementaryUnitQuantity = original.SupplementaryUnitQuantity,
                SupplementaryUnit = original.SupplementaryUnit,
                DocumentRecord = original.DocumentRecord,
                DocumentName = original.DocumentName,
                ExportOrderRecord = original.ExportOrderRecord
            });
        }

        return contents;
    };
