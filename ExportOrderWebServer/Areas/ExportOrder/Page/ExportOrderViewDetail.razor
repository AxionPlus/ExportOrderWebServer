    private async Task<bool> CntrNumHasError(string? text = null)
    {
        if (Item.VesselCallDetail is null) return true;

        var cntrNums = Item.Records.Where(r => !string.IsNullOrWhiteSpace(r.CntrNum)).Select(r => r.CntrNum).ToList()
            ?? new();

        if (!string.IsNullOrWhiteSpace(text))
            cntrNums.Add(text);

        if (!cntrNums.Any())
            return true;

        /// Коллекция существующих номеров кнтр-ов, исключая редактируемую коллекцию (edited)
        var dbVoyageCntrNums = await ExportOrderProvider.GetCntrNumsInVoyage(Item.Id, Item.VesselCallDetail.VesselCall.Id);

        var errMessages = ValidationService.ValidateCntrNums(cntrNums.ToArray(), dbVoyageCntrNums);

        if (string.IsNullOrEmpty(errMessages)) return false;

        bool? dialogResult = await DialogService.ShowMessageBoxAsync(null, (MarkupString)$"{errMessages}", yesText: "Продолжить", cancelText: "Отменить");

        if (dialogResult.HasValue)
            if (dialogResult.Value)
                return false;

        return true;
    }

    private void FillUpTreeItems()
    {
        if (Item.Records.Any())
        {
            ClearTreeItems();

            var documentRecords = Item.Records.SelectMany(r => r.Contents).Select(c => c.DocumentRecord)
                                                                           .Where(dr => dr.Document != null && !string.IsNullOrEmpty(dr.Document.Name))
                                                                           .GroupBy(dr => new { dr.Seq, dr.Document.Name })
                                                                           .ToList();

            foreach (var record in documentRecords)
            {
                DocumentRecordsDTO.Add(new ExportOrderDocumentRecordDTO()
                {
                    DocumentId = record.FirstOrDefault()!.Document.Id,
                    Seq = record.Key.Seq,
                    DocumentName = record.Key.Name,
                    CommodityHSCode = record.FirstOrDefault()!.CommodityHSCode,
                    CommodityName = record.FirstOrDefault()!.CommodityName
                });
            }

            DocumentsDTO = DocumentRecordsDTO.GroupBy(dr => dr.DocumentName).Select(g => new ExportOrderDocumentDTO()
            {
                Id = g.FirstOrDefault()!.DocumentId,
                DocumentName = g.Key,
                DocumentRecords = g.OrderBy(r => r.Seq).ToList()
            }).ToList();

            TreeItems = DocumentsDTO.Select(s => new TreeItemData<ExportOrderDocumentDTO>() { Value = s }).ToList();

            //StateHasChanged();
        }
    }

    private void ClearTreeItems()
    {
        TreeItems.Clear();
        DocumentsDTO = new();
        DocumentRecordsDTO = new();
    }

