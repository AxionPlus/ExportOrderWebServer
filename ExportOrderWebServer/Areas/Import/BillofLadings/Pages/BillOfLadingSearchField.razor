
@inject IDialogService DialogService

<style>
    .blBadge .mud-badge.mud-badge-top.right.mud-badge-overlap {
        inset: auto auto calc(100% - 23px) calc(100% - 24px);
    }

    .blBadge .mud-badge {
        font-size: 11px;
        height: 18px;
        min-width: 18px;
    }
</style>
<div class="FieldContainer" style="min-width:150px; @Style">
    <div class="fieldName">@Label</div>
    <div style="display: inline-flex; width:100%;">
        <MudTextField T="string" Class="TextField"
                      Value="BlNo"
                      ValueChanged="@(async(e)=>{await BlNoChanged.InvokeAsync(e.ToUpper());})"
                      Variant="Variant.Outlined"
                      Required="@Required" RequiredError=""
                      Immediate
                      Clearable
                      OnClearButtonClick="async(_)=> {await BlNoChanged.InvokeAsync(string.Empty);await BlsNoChanged.InvokeAsync( new());}">
         </MudTextField>
         <div style="margin-inline:2px"></div>
         <MudBadge Class="blBadge" Color="Color.Info" Origin="@Origin.TopCenter" Content="@(BlsNo.Count())">
             <MudIconButton Style="margin-top:5px" Class="TextFieldIconButton" Icon="@Icons.Material.Filled.DensitySmall" Size="Size.Small" OnClick="BillsList"></MudIconButton>
         </MudBadge>
     </div>
 </div>
@code {
    [Parameter]
    public string Label { get; set; } = "Bill of Lading";
    [Parameter]
    public string? Style { get; set; }    
    [Parameter]
    public string? BlNo { get; set; }
    [Parameter]
    public EventCallback<string> BlNoChanged { get; set; }
    [Parameter]
    public bool Required { get; set; }
    [Parameter]
    public List<string?> BlsNo { get; set; }
    [Parameter]
    public EventCallback<List<string>> BlsNoChanged { get; set; }

    private async Task BillsList()
    {
        var str = new StringBuilder();
        foreach (var item in BlsNo)
            str.AppendLine(item);

        var parameters = new DialogParameters { ["Text"] = str.ToString() };

        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<BillOfLading_IndexComponent_InputListBL>($"Input {Label}", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            if (result.Data is null) return;

            await BlsNoChanged.InvokeAsync((List<string>)result.Data);
            await BlNoChanged.InvokeAsync("Select many");
        }

        await InvokeAsync(StateHasChanged);
    }
}
