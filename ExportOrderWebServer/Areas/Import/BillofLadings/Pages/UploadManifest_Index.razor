<OverlayLoadingData Visible="IsLoadingData" Text="@(UploadedData ? "Uploading...":"Checking...")" />

@code {
    [CascadingParameter] public string? ApplicationUser { get; set; }
    private static string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full z-10";
    private string DragClass = DefaultDragClass;
    private List<string> fileNames = new List<string>();
    IList<IBrowserFile> BrowserFiles = new List<IBrowserFile>();
    private List<string> UpdateBillOfLadingList = new List<string>();
    private int maxAllowedFiles = 1;
    private bool IsLoadingData = false;
    private bool UploadedData = false;
    private bool HasErrors = false;
    // private UploadedDataBl? UploadedDataBls { get; set; }
    private bool SelectAllItems { get; set; }


    private async Task OnInputFileChanged(InputFileChangeEventArgs e)
    {
        ClearDragClass();

        BrowserFiles = (IList<IBrowserFile>)e.GetMultipleFiles();
        using var content = new MultipartFormDataContent();
        var files = e.GetMultipleFiles();
        foreach (var file in files)
        {
            fileNames.Add(file.Name);
        }

        UploadedData = false;
    }

    private async Task Clear()
    {
        fileNames.Clear();
        ClearDragClass();
        UploadedData = false;
        HasErrors = false;
        await Task.Delay(100);
    }

    private void SetDragClass()
    {
        DragClass = $"{DefaultDragClass} mud-border-primary";
    }

    private void ClearDragClass()
    {
        DragClass = DefaultDragClass;
    }

    private async Task CheckAndUploadFiles()
    {
        IsLoadingData = true;
        long maxFileSize = 1024 * 500;
        using var content = new MultipartFormDataContent();

        foreach (var file in BrowserFiles)
        {
            var fileContent = new StreamContent(file.OpenReadStream(maxFileSize));

            fileContent.Headers.ContentType =
                new MediaTypeHeaderValue(file.ContentType);

            content.Add(
                content: fileContent,
                name: "\"file\"",
                fileName: file.Name);
        }
        content.Add(new StringContent(Newtonsoft.Json.JsonConvert.SerializeObject(ApplicationUser), System.Text.Encoding.UTF8, "application/json"));
        // var client = httpClient.CreateClient();
        // client.Timeout = new TimeSpan(0, 0, 0, 0, -1);

        using (var client = httpClient.CreateClient())
        {
            client.Timeout = new TimeSpan(0, 0, 0, 0, -1);

 
            var response = await client.PostAsync($"http://localhost:7070/file/BillofLading/UploadImportManifest", content);
                if (response.IsSuccessStatusCode)
                {
