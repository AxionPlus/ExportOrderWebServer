@page "/uploadmanifest"
@using ExportOrderWebServer.Areas.Import.VesselCall

@attribute [Authorize(Roles = "Admin, ImpDept,ImpDept_Manager,ImpDept_TopManager,ImpDept_CEO")]

@inject ISnackbar Snackbar
@inject IHttpClientFactory httpClient
@inject NavigationManager Navigation
@inject IJSRuntime jsRuntime
@inject IDialogService DialogService

<div class="ToolBar-container">
    <MudToolBar Class="ToolBar ToolBar-new">
        <ShowMainMenuButton Class="ToolBar-IconButton" ExitHref="/" />

        <MudSpacer />
        <div class="ToolBar-iconbutton">
            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
        </div>
        <div class="ToolBar-iconbutton">
            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
        </div>
    </MudToolBar>
</div>

<div class="Container-item">
    <div class="container-content">
        <MudButton Color="@Color.Success" OnClick="SetVesselCall_Click">  <h5>Set Vessel Call for uploading bill of ladings</h5></MudButton>
        @if (VesselCallDetail is not null)
        {
            <h5>@VesselCallDetail.VesselName @VesselCallDetail.VoyageNo (@VesselCallDetail.POD)</h5>
        }
    </div>
</div>


<MudStack Style="width: 100%">
    <MudFileUpload T="IReadOnlyList<IBrowserFile>" OnFilesChanged="OnInputFileChanged" Hidden="false" Class="flex-1" InputClass="absolute mud-width-full mud-height-full overflow-hidden z-20" InputStyle="opacity:0"
                   @ondragenter="@SetDragClass" @ondragleave="@ClearDragClass" @ondragend="@ClearDragClass">
        <ActivatorContent>
            <MudPaper Height="300px" Outlined="true" Class="@DragClass">
                <MudText Typo="Typo.h6">Drag and drop files here or click</MudText>
                @foreach (var file in fileNames)
                {
                    <MudChip T="string" Color="Color.Dark" Text="@file" />
                }
            </MudPaper>
        </ActivatorContent>
    </MudFileUpload>
    <MudToolBar Class="gap-4">
        <MudButton OnClick="CheckAndUploadFiles" Disabled="@(!fileNames.Any() || VesselCallDetail is null)" Color="Color.Primary" Variant="Variant.Filled">
            @(!UploadedData ? "Upload File(s)" : "Check File(s)")
        </MudButton>
        <AuthorizeView Roles="Admin">
            <MudButton OnClick="XlsUploadFiles" Disabled="@(!fileNames.Any())" Color="Color.Secondary" Variant="Variant.Filled">
            1c File with Translate
            </MudButton>
        </AuthorizeView>

        <MudButton OnClick="Clear" Disabled="@(!fileNames.Any())" Color="Color.Error" Variant="Variant.Filled">Clear</MudButton>
        <div style="width: 50px"></div>
        <MudButton OnClick="DownloadTemplate" Disabled="@IsLoadingData" Color="Color.Dark" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Download">
            Manifest Template
        </MudButton>
    </MudToolBar>
</MudStack>


<OverlayLoadingData Visible="IsLoadingData" Text="@(UploadedData ? "Uploading..." : "Checking...")" />

@code {
    [CascadingParameter] public string? ApplicationUser { get; set; }
    private static string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full z-10";
    private string DragClass = DefaultDragClass;
    private VesselCallDetailDTO? VesselCallDetail;
    private List<string> fileNames = new List<string>();
    IList<IBrowserFile> BrowserFiles = new List<IBrowserFile>();
    private List<string> UpdateBillOfLadingList = new List<string>();
    private int maxAllowedFiles = 1;
    private bool IsLoadingData = false;
    private bool UploadedData = false;
    private bool HasErrors = false;
    // private UploadedDataBl? UploadedDataBls { get; set; }
    private bool SelectAllItems { get; set; }


    private async Task OnInputFileChanged(InputFileChangeEventArgs e)
    {
        ClearDragClass();

        BrowserFiles = (IList<IBrowserFile>)e.GetMultipleFiles();
        using var content = new MultipartFormDataContent();
        var files = e.GetMultipleFiles();
        foreach (var file in files)
        {
            fileNames.Add(file.Name);
        }

        UploadedData = false;
    }

    private async Task Clear()
    {
        fileNames.Clear();
        ClearDragClass();
        UploadedData = false;
        HasErrors = false;
        await Task.Delay(100);
    }

    private void SetDragClass()
    {
        DragClass = $"{DefaultDragClass} mud-border-primary";
    }

    private void ClearDragClass()
    {
        DragClass = DefaultDragClass;
    }

    private async Task CheckAndUploadFiles()
    {
        IsLoadingData = true;
        long maxFileSize = 1024 * 500;
        using var content = new MultipartFormDataContent();

        foreach (var file in BrowserFiles)
        {
            var fileContent = new StreamContent(file.OpenReadStream(maxFileSize));

            fileContent.Headers.ContentType =
                new MediaTypeHeaderValue(file.ContentType);

            content.Add(
                content: fileContent,
                name: "\"file\"",
                fileName: file.Name);
        }
        content.Add(new StringContent(ApplicationUser), "userName");
        content.Add(new StringContent(VesselCallDetail!.Id.ToString()), "vesselCallDetailId");

        // var client = httpClient.CreateClient();
        // client.Timeout = new TimeSpan(0, 0, 0, 0, -1);

        using (var client = httpClient.CreateClient())
        {
            client.Timeout = new TimeSpan(0, 0, 0, 0, -1);


            var response = await client.PostAsync($"http://localhost:7070/file/BillofLading/UploadImportManifest", content);
            if (response.IsSuccessStatusCode)
            {
                // UploadedDataBls = await response.Content.ReadFromJsonAsync<UploadedDataBl>();

                // if (UploadedDataBls is not null)
                //     if (!UploadedDataBls.HasErrors)
                //         UploadedData = true;
                //     else
                //         HasErrors = true;
            }
        }


        IsLoadingData = false;
        //client.Dispose();
    }

    private async Task XlsUploadFiles()
    {
        IsLoadingData = true;
        long maxFileSize = 1024 * 500;
        using var content = new MultipartFormDataContent();

        foreach (var file in BrowserFiles)
        {
            var fileContent = new StreamContent(file.OpenReadStream(maxFileSize));

            fileContent.Headers.ContentType =
                new MediaTypeHeaderValue(file.ContentType);

            content.Add(
                content: fileContent,
                name: "\"file\"",
                fileName: file.Name);
        }
        content.Add(new StringContent(ApplicationUser), "userName");

        using (var client = httpClient.CreateClient())
        {
            client.Timeout = new TimeSpan(0, 0, 0, 0, -1);


            var response = await client.PostAsync($"http://localhost:7070/file/BillofLading/UploadXlsFile", content);
            if (response.IsSuccessStatusCode)
            {
                // UploadedDataBls = await response.Content.ReadFromJsonAsync<UploadedDataBl>();

                // if (UploadedDataBls is not null)
                //     if (!UploadedDataBls.HasErrors)
                //         UploadedData = true;
                //     else
                //         HasErrors = true;
            }
        }


        IsLoadingData = false;
        //client.Dispose();
    }


    private async Task DownloadTemplate()
    {
        // await jsRuntime.InvokeVoidAsync("open", $"{ApplicationParameter.LocalHostGETUrl}file/DownloadFile/DownloadTemplateManifest", "_blank");
    }

    private async Task SetVesselCall_Click(MouseEventArgs obj)
    {

        var paramerts = new DialogParameters();

        var dialogOptions = new DialogOptions() { MaxWidth = MaxWidth.Large, CloseButton = true, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<ImportVesselCall_Index>("Set Vessel Call", paramerts, dialogOptions);

        var result = await dialog.Result;

        if (result is not null)
        {
            if (result.Data is not null)
            {
                VesselCallDetail = (VesselCallDetailDTO)result.Data;
            }

        }
    }

}