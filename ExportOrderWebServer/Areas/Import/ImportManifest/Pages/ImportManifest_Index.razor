@code {
    [CascadingParameter] public string? ApplicationUser { get; set; }
    private MudTable<BillOfLadingContainerRecordDto>? mudTable;
    private MudForm searchForm;
    private FilterParameters Filter { get; set; } = new() { BolNo = "*" };
    bool IsLoadingData;
    private IEnumerable<BillOfLadingDto> BillofLadings { get; set; } = new List<BillOfLadingDto>();
    private IEnumerable<ManifestBillOfLadingDto> ManifestBillofLadings { get; set; } = new List<ManifestBillOfLadingDto>();

    private string? SelectedValue;
    private BillOfLadingDto? BillofLading;
    private VesselCallDetailDTO? VesselCallDetail;


    private async void ItemHasBeenCommitted(object element)
    {
        try
        {
            var record = (BillOfLadingContainerRecordDto)element;
            var upateElement = await ImportManifestProvider.UpdateBillOfLadingContainerRecordAsync(record);
            record.Version = upateElement.Version;

            Snackbar.Add($"Element {((BillOfLadingContainerRecordDto)element).ContainerNum} committed");
        }
        catch (Exception ex)
        {
            // Обязательно обрабатывайте исключения в async void методах
            Snackbar.Add($"Error: {ex.Message}");
            // Логируйте исключение если нужно
        }
    }

    private async Task RefreshBillofLadingData()
    {
        BillofLading = await ImportManifestProvider.GetBillofLadingAsync(BillofLading.Num);
    }
    private async Task SaveBillofLadingData()
    {
        IsLoadingData = true;
        await ImportManifestProvider.UpdateBillofLadingAsync(BillofLading!);
        BillofLading = await ImportManifestProvider.GetBillofLadingAsync(BillofLading!.Num);
        IsLoadingData = false;
    }

    private async Task SelectedValueChanged(string? billofLadingNum)
    {
        if (string.IsNullOrWhiteSpace(billofLadingNum))
            return;

        BillofLading = await ImportManifestProvider.GetBillofLadingAsync(billofLadingNum);
    }

    private async Task SearchItems_Click()
    {
        await searchForm.Validate();

        if (string.IsNullOrWhiteSpace(Filter.BolNo))
            if (string.IsNullOrWhiteSpace(Filter.CntrNum))
            // if (string.IsNullOrWhiteSpace(Filter.VesselName))
            //     if (string.IsNullOrWhiteSpace(Filter.VesselVoyage))
            //         if (string.IsNullOrWhiteSpace(Filter.BookingParty))
            {
                Snackbar.Add("Some search fields should be used", Severity.Warning);
                return;
            }

        IsLoadingData = true;

        BillofLadings = await ImportManifestProvider.GetItemsAsync(Filter);



        IsLoadingData = false;
    }




    private void TransliterationShipper_Click()
    {
        var dictOneLetter = new Dictionary<char, char>()
        {
            { 'A','А'},
            { 'B','Б'},
            { 'C','Ц'},
            { 'D','Д'},
            { 'E','Е'},
            { 'F','Ф'},
            { 'G','Г'},
            { 'H','Х'},
            { 'I','И'},
            { 'J','Й'},
            { 'K','К'},
            { 'L','Л'},
            { 'M','М'},
            { 'N','Н'},
            { 'O','О'},
            { 'P','П'},
            { 'R','Р'},
            { 'S','С'},
            { 'T','Т'},
            { 'U','Ю'},
            { 'V','В'},
            { 'W','В'},
            { 'X','Х'},
            { 'Y','Ы'},
            { 'Z','З'},
        };

        var dictTwoLetter = new Dictionary<string, string>()
        {
            { "CK", "K"},
            { "CH", "Ч"},
            { "SH", "Ш"}

        };

        /// Name
        var shShortName = BillofLading.ShipperName?.ToUpper();

        if (string.IsNullOrWhiteSpace(shShortName)) return;

        var l = shShortName.Length % 2;
        for (int i = 0; i < shShortName.Length - 1 - l; i++)
        {
            if (dictTwoLetter.Any(s => s.Key == shShortName.Substring(i, 2).ToString()))
            {
                var elem = shShortName.Substring(i, 2);
                shShortName = shShortName.Remove(i, 2);
                shShortName = shShortName.Insert(i, dictTwoLetter.FirstOrDefault(s => s.Key == elem).Value);
            }
        }
        shShortName = shShortName.Replace("Q", ""); //.ToString();
        shShortName = shShortName.ReplaceSymbols();
        foreach (var item in dictOneLetter)
        {
            shShortName = shShortName.Replace(item.Key, item.Value).ToString();
        }
        BillofLading.ShipperNameRu = shShortName.ToString();

        /// Address
        shShortName = BillofLading.ShipperAddress?.ToUpper();

        if (string.IsNullOrWhiteSpace(shShortName)) return;

        l = shShortName.Length % 2;
        for (int i = 0; i < shShortName.Length - 1 - l; i++)
        {
            if (dictTwoLetter.Any(s => s.Key == shShortName.Substring(i, 2).ToString()))
            {
                var elem = shShortName.Substring(i, 2);
                shShortName = shShortName.Remove(i, 2);
                shShortName = shShortName.Insert(i, dictTwoLetter.FirstOrDefault(s => s.Key == elem).Value);

            }
        }
        shShortName = shShortName.Replace("Q", ""); //.ToString();
        shShortName = shShortName.ReplaceSymbols();
        foreach (var item in dictOneLetter)
        {
            shShortName = shShortName.Replace(item.Key, item.Value).ToString();
        }
        BillofLading.ShipperAddressRu = shShortName.ToString();
    }

    private async Task SetCargoDescription_Click(MouseEventArgs obj)
    {

        var paramerts = new DialogParameters();
        paramerts.Add("Records", BillofLading.ContainerRecords);
        paramerts.Add("CargoDesctiption", BillofLading.ContainerRecords.FirstOrDefault().GoodsDescription);
        var dialogOptions = new DialogOptions() { MaxWidth = MaxWidth.Small, CloseButton = true, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false };
        var dialog = DialogService.Show<CargoDiscription_Dialog>("Set GoodsDescription Details for all Containers", paramerts, dialogOptions);

        var result = await dialog.Result;

        if (result is not null)
        {

        }
    }

    private async Task SetVesselCall_Click(MouseEventArgs obj)
    {

        var paramerts = new DialogParameters();

        var dialogOptions = new DialogOptions() { MaxWidth = MaxWidth.Large, CloseButton = true, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false };
        var dialog = DialogService.Show<ImportVesselCall_Index>("Set Vessel Call", paramerts, dialogOptions);

        var result = await dialog.Result;

        if (result is not null)
        {
            IsLoadingData = true;
            if (result.Data is not null)
            {
                VesselCallDetail = (VesselCallDetailDTO)result.Data;

                ManifestBillofLadings = await ImportManifestProvider.GetBillofLadingsNumAsync(VesselCallDetail);
            }

        }

        IsLoadingData = false;

    }


    private async Task DownLoadTemplate1C()

    {

        using (var Http = httpClient.CreateClient())
        {
            // Http.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
            Http.Timeout = new TimeSpan(0, 10, 0);

            var content = new StringContent(Newtonsoft.Json.JsonConvert.SerializeObject(VesselCallDetail), Encoding.UTF8, "application/json");
            var response = await Http.PostAsync($"{ApplicationParameter.ImportManifestController}DownLoadTemplate1C", content);
            if (response.IsSuccessStatusCode)
            {

                var bytes = await response.Content.ReadAsByteArrayAsync();


                try
                {
                    if (bytes == Array.Empty<byte>())
                        Snackbar.Add("File Stream error.", Severity.Error);
                    else
                    {
                        await JSRuntime.InvokeVoidAsync("jsSaveAsFile",
                            $"{VesselCallDetail.VesselName}/{VesselCallDetail.VoyageNo}_{VesselCallDetail.POD}.xlsx",
                            Convert.ToBase64String(bytes));
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine(ex.Message);
                    IsLoadingData = false;
                    return;
                }
            }

        }
        
    }




}
