    public Color BlColor(ManifestBillOfLadingDto bl)
    {

        if (bl.IsImo)
            return Color.Error;

        if (!bl.HasShipper || !bl.HasConsignee || !bl.HasTranslate)
            return Color.Warning;

        return Color.Info;
    }

    public string BlIcon(ManifestBillOfLadingDto bl)
    {

        if (bl.IsImo)
            return Icons.Material.Outlined.Dangerous;

        if (!bl.HasShipper || !bl.HasConsignee || !bl.HasTranslate)
            return Icons.Material.Outlined.Info;

        return null;
    }
    public string BlListItemColor(ManifestBillOfLadingDto bl)
    {

        if (!bl.HasShipper || !bl.HasConsignee || !bl.HasTranslate)
            return "var(--mud-palette-warning);";

        return "var(--mud-palette-info)";
    }


    private async void NoTranslate(MouseEventArgs obj)
    {
        IsLoadingData = true;
        ManifestBillofLadings = await ImportManifestProvider.GetBillofLadingsNumAsync(VesselCallDetail);
        ManifestBillofLadings = ManifestBillofLadings.Where(bl => !bl.HasShipper || !bl.HasConsignee || !bl.HasTranslate).ToList();

        await SelectedValueChanged(ManifestBillofLadings.FirstOrDefault()?.Num);

        IsLoadingData = false;
        await InvokeAsync(StateHasChanged);
    }

    private async void AllRecords(MouseEventArgs obj)
    {
        IsLoadingData = true;
        ManifestBillofLadings = await ImportManifestProvider.GetBillofLadingsNumAsync(VesselCallDetail);

        await SelectedValueChanged(ManifestBillofLadings.FirstOrDefault()?.Num);

        IsLoadingData = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ConfirmBillofLadingData(MouseEventArgs obj)
    {
        if (BillofLading is null) return;
        if (BillofLading.ConsigneeName.Replace(" ","").Contains("TEKPOSEIDON", StringComparison.CurrentCultureIgnoreCase))//TEK POSEIDON LTD
        {
            Snackbar.Add("Проверить наличие Switch", Severity.Warning);

        }

        if (string.IsNullOrWhiteSpace(BillofLading.ShipperNameRu) ||
            string.IsNullOrWhiteSpace(BillofLading.ShipperAddressRu) ||
            string.IsNullOrWhiteSpace(BillofLading.ShipperCountryRu) ||
            string.IsNullOrWhiteSpace(BillofLading.ConsigneeNameRu) ||
            string.IsNullOrWhiteSpace(BillofLading.ConsigneeAddressRu) ||
            string.IsNullOrWhiteSpace(BillofLading.ConsigneeCountryRu))
        {
            Snackbar.Add("Отправитель / Получатель не указаны", Severity.Warning);
        }

        if (BillofLading.ContainerRecords.Any(rec => string.IsNullOrWhiteSpace(rec.GoodsDescription) || string.IsNullOrWhiteSpace(rec.GoodsDescriptionRu)))
        {
            Snackbar.Add("Наименование товара не заполнено", Severity.Warning);
        }

    }

    private async void MakeSwitchBillofLadingData()
    {
        var paramerts = new DialogParameters();
        paramerts.Add("BillofLading", BillofLading);
        paramerts.Add("ApplicationUser", ApplicationUser);
        var dialogOptions = new DialogOptions() { MaxWidth = MaxWidth.Medium, CloseButton = true, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false };
        var dialog = DialogService.Show<SwitchBillofLading_Dialog>($"Switch {BillofLading.Num}", paramerts, dialogOptions);

        var result = await dialog.Result;

        if (result is not null)
        {
            IsLoadingData = true;
            var billofLadingNum = (string)result.Data;

            ManifestBillofLadings = await ImportManifestProvider.GetBillofLadingsNumAsync(VesselCallDetail);

            await SelectedValueChanged(billofLadingNum);

            IsLoadingData = false;
            await InvokeAsync(StateHasChanged);


            await Task.Delay(1000);
            Snackbar.Add("Bill of Lading updated successfully!", Severity.Success); // Успешное обновление
        }
    }

