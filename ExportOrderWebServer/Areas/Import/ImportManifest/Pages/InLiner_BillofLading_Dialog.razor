@using ExportOrderEntites.BillofLading.Dto
@using ExportOrderWebServer.Areas.Import.ImportManifest.Provider

@inject IDialogService DialogService
@inject IImportManifestProvider ImportManifestProvider
@inject ISnackbar Snackbar

<MudContainer>
    @if (Record != null)
    {
        <MudForm @ref="_mudForm">
            <div style=" display:flex;">
                <TextField  Label="Container" @bind-Value="@Record.ContainerNum" ReadOnly Required />
                <TextField Style="margin-left:5px" Label="Type" @bind-Value="@Record.ContainerType" ReadOnly Required />
                <NumericField Style="margin-left:5px" T="int" Label="Tare Weight" @bind-Value="@Record.TareWeight" ReadOnly Required />
            </div>
            <div style=" display:flex;">

                <NumericField  T="int" Label="Package Qty" @bind-Value="@Record.PackageQty" ReadOnly Required />
                <NumericField Style="margin-left:5px" T="double" Label="Cargo Weight" @bind-Value="@Record.CargoWeight" ReadOnly Required />
            </div>

            <div style=" display:flex;">
                <TextField  Label="Seal No" @bind-Value="@Record.SealNo" Required />
                <TextField Style="margin-left:5px" Label="Seal Oth" @bind-Value="@Record.SealOth" Required />
                <TextField Style="margin-left:5px" Label="Seal Shr" @bind-Value="@Record.SealShr" Required />
            </div>


            <TextField Label="Container" @bind-Value="@Record.GoodsDescription" Lines="3" Required />
            <TextField Label="Container" @bind-Value="@Record.GoodsDescriptionRu" Lines="3" Required />
            <TextField Label="Container" @bind-Value="@Record.CommodityCode" Required />

            <div style=" display:flex;">
                <CheckBox Label="Imo" @bind-Value="@Record.IsImo" />
                <CheckBox Label="Oog" @bind-Value="@Record.IsOog" />
                <CheckBox Label="Ref" @bind-Value="@Record.IsRef" />
                <CheckBox Label="Soc" @bind-Value="@Record.IsSoc" />
                <CheckBox Label="Empty" @bind-Value="@Record.IsEmpty" />
            </div>
            <div style=" display:flex;">
                <TextField Label="Imo Class" @bind-Value="@Record.ImoClass" Required Disabled="@(!Record.IsImo)" />
                <TextField Style="margin-left:5px" Label="Unno" @bind-Value="@Record.Unno" Disabled="@(!Record.IsImo)" Required />
            </div>
        </MudForm>
        <div style="display:flex;justify-content: space-around; padding:15px">
            <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="MakeSwitch_Click">Make Switch</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="() => MudDialog?.Cancel()">Cancel</MudButton>
        </div>
    }
    else
    {
        <MudSkeleton Height="100px" />
        <MudSkeleton Height="100px" />
        <MudSkeleton Height="100px" />
    }

</MudContainer>
@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    [Parameter] public BillOfLadingContainerRecordDto Record { get; set; }
    MudForm? _mudForm;

     BillOfLadingContainerRecordDto CopyRecord { get; set; }

    private async void MakeSwitch_Click()
    {
        _mudForm?.Validate();
        if (!_mudForm!.IsValid)
            return;

        bool? msgResult = await DialogService.ShowMessageBox(
            "Switch",
            $"Do you want to make  ?",
            yesText: "Yes",
            cancelText: "No");

        if (!msgResult.HasValue || !msgResult.Value)
            return;


        try
        {
            //  await ImportManifestProvider.UpdateBillofLadingAsync(billofLading: BillofLading);

            MudDialog?.Close();
        }
        catch (InvalidOperationException ex) // Ловим конкретное исключение
        {
            Snackbar.Add(ex.Message, Severity.Error); // Показываем ошибку
        }
        catch (Exception ex) // Ловим все остальные исключения
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
    }

}
