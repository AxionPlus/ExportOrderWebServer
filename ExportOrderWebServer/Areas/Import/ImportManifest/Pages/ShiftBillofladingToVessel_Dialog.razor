@using ExportOrderEntites.BillofLading.Dto
@using ExportOrderWebServer.Areas.Import.ImportManifest.Provider
@using ExportOrderWebServer.Areas.Import.VesselCall
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IImportManifestProvider ImportManifestProvider
@inject IVesselProvider _vesselProvider
@inject IImportVesselCallProvider _vesselCallProvider
@inject ILocationProvider _locationProvider
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory httpClient

<div style=" min-width:600px;    display: flex;padding: 10px;    justify-content: center;">
    <div>
        <MudButton Color="@Color.Success" OnClick="SetVesselCall1_Click">
            @if (VesselCallDetail1 is not null)
            {
                <h6>
                    @VesselCallDetail1.VesselName @VesselCallDetail1.VoyageNo (@VesselCallDetail1.POL)
                </h6>
            }
            else
            {
                <h6>Set Vessel Call</h6>
            }
        </MudButton>
        <div style="padding: 10px 10px 5px 5px;">
            <div Style="padding:5px 0px 10px 2px">
                <MudTooltip Text="Обновить список" Arrow="true" Placement="Placement.Right" Delay="1500">
                    <MudIconButton OnClick="RefreshVesselCall1_Click" Icon="@Icons.Material.Outlined.Refresh" Color="@Color.Secondary" Size="Size.Small" />
                </MudTooltip>
                <MudTooltip Text="Кол-во записей в списке" Arrow="true" Placement="Placement.Right" Delay="1500">
                    <div style="padding-left: 5px; display: flex;  align-items: center;     font-weight: 600;">
                        @($"({ManifestBillofLadings1.Count()})")
                    </div>
                </MudTooltip>
            </div>
            <div style="max-height: 800px;min-width:190px;overflow: auto; background-color: var(--grey-08);">
                <MudList @ref="_mudList1" T="string?" SelectedValue="SelectedValue1" SelectedValueChanged="async (val) => { SelectedValue1 = val; await SelectedValueChanged1(val); }" SelectionMode="@SelectionMode.SingleSelection" Color="@Color.Info">
                    @if (ManifestBillofLadings1.Any())
                    {
                        @foreach (var billofLading in ManifestBillofLadings1)
                        {
                            <MudListItem Value="billofLading.Num">
                                <div> @billofLading.Num </div>
                            </MudListItem>
                        }
                    }
                    else
                    {
                        <MudListItem Text="No RECORDS" Disabled></MudListItem>
                    }
                </MudList>
            </div>
        </div>


    </div>
    <div style="margin-inline:10px">
        <div style="display:flex; padding-top:50px;justify-content: center;">
            <MudIconButton OnClick="ShiftBl2" Icon="@Icons.Material.Filled.KeyboardArrowLeft" Size="Size.Small" Disabled="@(VesselCallDetail1 == null)" />
            <MudIconButton OnClick="ShiftAllBl2" Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft" Size="Size.Small" Disabled="@(VesselCallDetail1 == null)" />
            <MudIconButton OnClick="ShiftAllBl1" Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight" Size="Size.Small" Disabled="@(VesselCallDetail2 ==null)" />
            <MudIconButton OnClick="ShiftBl1" Icon="@Icons.Material.Filled.KeyboardArrowRight" Size="Size.Small" Disabled="@(VesselCallDetail2 == null)" />
        </div>

        <TextField Style="min-width:200px" @bind-Value="SelectedValues" Lines="40" />
    </div>
    <div>
        <MudButton Color="@Color.Success" OnClick="SetVesselCall2_Click">
            @if (VesselCallDetail2 is not null)
            {
                <h6>
                    @VesselCallDetail2.VesselName @VesselCallDetail2.VoyageNo (@VesselCallDetail2.POL)
                </h6>
            }
            else
            {
                <h6>Set Vessel Call</h6>
            }
        </MudButton>
        <div style="padding: 10px 10px 5px 5px;">
            <div Style="padding:5px 0px 10px 2px">
                <MudTooltip Text="Обновить список" Arrow="true" Placement="Placement.Right" Delay="1500">
                    <MudIconButton OnClick="RefreshVesselCall2_Click" Icon="@Icons.Material.Outlined.Refresh" Color="@Color.Secondary" Size="Size.Small" />
                </MudTooltip>

                <MudTooltip Text="Кол-во записей в списке" Arrow="true" Placement="Placement.Right" Delay="1500">
                    <div style="padding-left: 5px; display: flex;  align-items: center;     font-weight: 600;">
                        @($"({ManifestBillofLadings2.Count()})")
                    </div>
                </MudTooltip>
            </div>

            <div style="max-height: 800px;min-width:190px;overflow: auto; background-color: var(--grey-08);">
                <MudList @ref="_mudList2" T="string?" SelectedValue="SelectedValue2" SelectedValueChanged="async (val) => { SelectedValue2 = val; await SelectedValueChanged2(val); }" SelectionMode="@SelectionMode.SingleSelection" Color="@Color.Info">
                    @if (ManifestBillofLadings2.Any())
                    {
                        @foreach (var billofLading in ManifestBillofLadings2)
                        {
                            <MudListItem Value="billofLading.Num">
                                <div> @billofLading.Num </div>
                            </MudListItem>
                        }
                    }
                    else
                    {
                        <MudListItem Text="No RECORDS" Disabled></MudListItem>
                    }
                </MudList>
            </div>
        </div>

    </div>
</div>

<OverlayLoadingData Visible="IsLoadingData" />


@code {

    [Parameter] public long? VesselCallDetail1_Id { get; set; }

    bool IsLoadingData;
    private VesselCallDetailDTO? VesselCallDetail1;
    private VesselCallDetailDTO? VesselCallDetail2;
    private IEnumerable<ManifestBillOfLadingDto> ManifestBillofLadings1 = new List<ManifestBillOfLadingDto>();
    private IEnumerable<ManifestBillOfLadingDto> ManifestBillofLadings2 = new List<ManifestBillOfLadingDto>();
    private MudList<string> _mudList1;
    private MudList<string> _mudList2;

    private string? SelectedValue1 = string.Empty;
    private string? SelectedValue2 = string.Empty;
    private string? SelectedValues = string.Empty;


    protected async override Task OnParametersSetAsync()
    {

        if (VesselCallDetail1_Id.HasValue)
        {
            ManifestBillofLadings1 = await ImportManifestProvider.GetBillofLadingsNumAsync(new() { Id = VesselCallDetail1_Id.Value });
        }

    }

    private async Task SelectedValueChanged1(string? billofLadingNum)
    {
        if (string.IsNullOrWhiteSpace(billofLadingNum))
            return;
        SelectedValue2 = String.Empty;
        SelectedValues = SelectedValue1;

    }

    private async Task SelectedValueChanged2(string? billofLadingNum)
    {
        if (string.IsNullOrWhiteSpace(billofLadingNum))
            return;

        SelectedValue1 = String.Empty;
        SelectedValues = SelectedValue2;

    }

    private async Task SetVesselCall1_Click()
    {

        var paramerts = new DialogParameters();

        var dialogOptions = new DialogOptions() { MaxWidth = MaxWidth.Large, CloseButton = true, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false };
        var dialog = DialogService.Show<ImportVesselCall_Index>("Set Vessel Call", paramerts, dialogOptions);

        var result = await dialog.Result;

        if (result is not null)
        {
            IsLoadingData = true;
            if (result.Data is not null)
            {

                var vesselCallDetail = (VesselCallDetailDTO)result.Data;
                if (VesselCallDetail2 != null)
                    if (VesselCallDetail2.Id == vesselCallDetail.Id)
                    {
                        Snackbar.Add($"Данное судно {vesselCallDetail.VesselName} {vesselCallDetail.VoyageNo} уже выбрано", Severity.Warning);
                        return;
                    }

                VesselCallDetail1 = vesselCallDetail;
                await RefreshVesselCall1_Click();
            }
        }

        IsLoadingData = false;

    }

    private async Task SetVesselCall2_Click()
    {
        var paramerts = new DialogParameters();

        var dialogOptions = new DialogOptions() { MaxWidth = MaxWidth.Large, CloseButton = true, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false };
        var dialog = DialogService.Show<ImportVesselCall_Index>("Set Vessel Call", paramerts, dialogOptions);

        var result = await dialog.Result;

        if (result is not null)
        {
            IsLoadingData = true;
            if (result.Data is not null)
            {
                var vesselCallDetail = (VesselCallDetailDTO)result.Data;
                if (VesselCallDetail2 != null)
                    if (VesselCallDetail2.Id == vesselCallDetail.Id)
                    {
                        Snackbar.Add($"Данное судно {vesselCallDetail.VesselName} {vesselCallDetail.VoyageNo} уже выбрано", Severity.Warning);
                        return;
                    }
                VesselCallDetail2 = vesselCallDetail;
                await RefreshVesselCall2_Click();
            }
        }

        IsLoadingData = false;

    }

    private async Task RefreshVesselCall1_Click()
    {
        if (VesselCallDetail1 == null) return;
 
        IsLoadingData = true;
        ManifestBillofLadings1 = await ImportManifestProvider.GetBillofLadingsNumAsync(VesselCallDetail1);

        IsLoadingData = false;
        StateHasChanged();
    }

    private async Task RefreshVesselCall2_Click()
    {
        if (VesselCallDetail2 == null) return;

        IsLoadingData = true;
        ManifestBillofLadings2 = await ImportManifestProvider.GetBillofLadingsNumAsync(VesselCallDetail2);

        IsLoadingData = false;
        StateHasChanged();
    }


    private async void ShiftBl2()
    {
        if (string.IsNullOrWhiteSpace(SelectedValues))
        {
            Snackbar.Add("необходимо указать коносамент(ы)");
            return;
        }

        bool? msgResult = await DialogService.ShowMessageBox(
            "Switch",
            $"Do you want to Shift All Bill of Ladings?",
            yesText: "Yes",
            cancelText: "No");

        if (!msgResult.HasValue || !msgResult.Value)
            return;

        try
        {
            IsLoadingData = true;
            StateHasChanged();
            if (SelectedValues.Contains("/n"))
            {
                var list = SelectedValues.Split("/n");
                await ImportManifestProvider.ShiftBillofLadings(VesselCallDetail1, list);

            }
            else
                await ImportManifestProvider.ShiftBillofLadings(VesselCallDetail1, new[] { SelectedValues });


        }
        catch (Exception e)
        {

            Snackbar.Add(e.Message, Severity.Warning);

            throw;
        }
        finally
        {
            SelectedValues= String.Empty;   
            await RefreshVesselCall1_Click();
            await RefreshVesselCall2_Click();
        }


    }
    private async void ShiftBl1()
    {
        if (string.IsNullOrWhiteSpace(SelectedValues))
        {
            Snackbar.Add("необходимо указать коносамент(ы)");
            return;
        }

        bool? msgResult = await DialogService.ShowMessageBox(
            "Switch",
            $"Do you want to Shift All Bill of Ladings?",
            yesText: "Yes",
            cancelText: "No");

        if (!msgResult.HasValue || !msgResult.Value)
            return;

        try
        {
            IsLoadingData = true;
            StateHasChanged();

            if (SelectedValues.Contains("/n"))
            {
                var list = SelectedValues.Split("/n");
                await ImportManifestProvider.ShiftBillofLadings(VesselCallDetail2, list);

            }
            else
                await ImportManifestProvider.ShiftBillofLadings(VesselCallDetail2, new[] { SelectedValues });


        }
        catch (Exception e)
        {

            Snackbar.Add(e.Message, Severity.Warning);

            throw;
        }
        finally
        {
            SelectedValues = String.Empty;
            await RefreshVesselCall1_Click();
            await RefreshVesselCall2_Click();
        }

    }

    private async void ShiftAllBl2()
    {
        if (!ManifestBillofLadings2.Any() || VesselCallDetail1 == null)
        {
            return;
        }

        bool? msgResult = await DialogService.ShowMessageBox(
            "Switch",
            $"Do you want to Shift All Bill of Ladings?",
            yesText: "Yes",
            cancelText: "No");

        if (!msgResult.HasValue || !msgResult.Value)
            return;

        try
        {
            IsLoadingData = true; StateHasChanged();

            await ImportManifestProvider.ShiftBillofLadings(VesselCallDetail1!, ManifestBillofLadings2.Select(s => s.Num!));
        }
        catch (Exception e)
        {

            Snackbar.Add(e.Message, Severity.Warning);

            throw;
        }
        finally
        {
            SelectedValues= String.Empty;   
            await RefreshVesselCall1_Click();
            await RefreshVesselCall2_Click();
        }


    }
    private async void ShiftAllBl1()
    {
        if (!ManifestBillofLadings1.Any() || VesselCallDetail2 == null)
        {
            return;
        }

        bool? msgResult = await DialogService.ShowMessageBox(
            "Switch",
            $"Do you want to Shift All Bill of Ladings?",
            yesText: "Yes",
            cancelText: "No");

        if (!msgResult.HasValue || !msgResult.Value)
            return;

        try
        {
            IsLoadingData = true; StateHasChanged();

            await ImportManifestProvider.ShiftBillofLadings(VesselCallDetail2!, ManifestBillofLadings1.Select(s => s.Num!));
        }
        catch (Exception e)
        {

            Snackbar.Add(e.Message, Severity.Warning);

            throw;
        }
        finally
        {
            SelectedValues= String.Empty;   
            await RefreshVesselCall1_Click();
            await RefreshVesselCall2_Click();
        }

    }

}
