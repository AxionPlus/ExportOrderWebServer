                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.SkipNext" Size="Size.Small" Style="margin:auto" Color="Color.Success" OnClick="() => CreateReleaseImport_Click(Record)" />
                }
            </MudTd>
            <MudTd> @Record.ContainerNum</MudTd>
            <MudTd> @Record.ContainerType</MudTd>
            <MudTd> @(Record.ReleaseTo.HasValue? Record.ReleaseTo.Value.ToString("dd.MM.yy")   : "--.--.--")</MudTd>
            <MudTd>
