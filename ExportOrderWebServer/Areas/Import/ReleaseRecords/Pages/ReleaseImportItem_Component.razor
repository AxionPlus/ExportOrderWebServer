                            break;
                    } *@
            </MudTd>
            <MudTd> @(Record.ReleaseTo.HasValue? Record.ReleaseMode.ToString() : "-- -- --")</MudTd>
            <AuthorizeView Roles="Admin">
                <MudTd> @(Record.ReleaseTo.HasValue? Record.ReleaseStatus.ToString() : "-- -- --")</MudTd>
            </AuthorizeView>
            <MudTd> @(Record.SentToCustomerNoticeTime.HasValue? Record.SentToCustomerNoticeTime.Value.ToString("dd.MM.yy")   : "--.--.--")</MudTd>
            <MudTd>  @string.Join(';', Record.Remarks) </MudTd>
            <MudTd>   </MudTd>

        </RowTemplate>
    </MudTable>

</div>

