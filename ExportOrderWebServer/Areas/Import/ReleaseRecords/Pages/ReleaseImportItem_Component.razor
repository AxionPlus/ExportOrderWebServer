    protected override async Task OnInitializedAsync()
    {
        if (Reload)
            await BlDataRefresh_Click();
    }
    async Task BlDataRefresh_Click()
    {
        if (string.IsNullOrWhiteSpace(BillOfLadingNo))
        {
            Snackbar.Add("Bill of Lading No can't be null", Severity.Warning);
            return;
        }
        IsLoadingData = true;

        FilterContainerRecords = await ReleaseImportProvider.GetRecords(BillOfLadingNo);

        await BillOfLadingNoChanged.InvokeAsync(BillOfLadingNo);
        IsMultiSelect = false;
        IsLoadingData = false;
    }

    void CheckedChanged(bool select)
    {
        IsSelectRecords = select;
        foreach (var item in FilterContainerRecords)
            if (item.ReleaseStatus != ReleaseStatus.SentTerminal)
                item.IsSelect = select;
    }

    private async Task SendReleaseRepeat_Click()
    {
