    private async Task ExportDGCargoManifestToExcel()
    {
        try
        {
            if (SelectedVesselCallId == Guid.Empty)
            {
                Snackbar.Add("Please select a vessel call first", Severity.Warning);
                return;
            }

            if (!BillOfLadings.Any())
            {
                Snackbar.Add("No bills of lading to export", Severity.Info);
                return;
            }

            isLoading = true;
            StateHasChanged();
            var vesselCall = await VesselCallService.GetByIdForArrivalNoticeAsync(SelectedVesselCallId);
            var fileBytes = await _manifestHazardousExportService.GenerateManifestAsync(vesselCall);

