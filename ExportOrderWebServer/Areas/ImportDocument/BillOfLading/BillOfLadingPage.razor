<style>
    .mud-table-dense * .mud-table-row .mud-table-cell {
        padding-inline-start: 10px;
        padding-inline-end: 10px;
    }

    tr.mud-table-row td:first-child {
        padding-bottom: 6px !important;
        padding-top: 6px !important;
        width: 30px;
    }
</style>

<PageTitle>Bill of Lading Management</PageTitle>
<ToolBar Label="Bill of Lading Management">
    <RightContent>
        <ToolBarIconButton Icon="@Icons.Material.Filled.FileDownloadDone" OnClick="OnCustomerCopy" Color="Color.Info" TooltipText="Customer Copy" />
        <ToolBarIconButton Icon="@Icons.Material.Filled.Upload" OnClick="OpenUploadDialog" Color="Color.Secondary" TooltipText="Upload XML Manifest" />
        <ToolBarIconButton Icon="@Icons.Material.Filled.Upload" OnClick="OpenTsDataUploadDialog" Color="Color.Secondary" TooltipText="TsData Upload" />
        <ToolBarIconButton Icon="@Icons.Material.Filled.Upload" OnClick="OpenEmptyBlUploadDialog" Color="Color.Secondary" TooltipText="Empty Bl Upload" />
    </RightContent>
</ToolBar>
<!-- Заголовок страницы -->
<!-- Верхняя часть: Выбор судозахода -->
<Container>

    <VesselVoaygeSelector @bind-VesselCallId="SelectedVesselCallId" @bind-VesselCall="@SelectedVesselCall" OnClick="OnVesselCallChanged" />


    @if (SelectedVesselCallId != Guid.Parse("00000000-0000-0000-0000-000000000000"))
    {
        <MudButton OnClick="VesselChangeDialog"
                   Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Link">
            Vsl Change
        </MudButton>


        <MudButton OnClick="CaptainNameDialog"
                   Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Link">
            Captain Name Dialog
        </MudButton>
        <MudButton OnClick="OnCustomerTranslate"
                   Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Translate">
            Get Customer Ru
        </MudButton>
        <MudButton OnClick="OnSetGoogleTableUrl"
                   Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Link">
            Url
        </MudButton>
        <MudButton OnClick="OnTranslate"
                   Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Translate" Disabled="@(string.IsNullOrWhiteSpace(SelectedVesselCall!.GoogleTableUrl))">
            Translate
        </MudButton>

        <MudButton OnClick="OnVesselCallChanged"
                   Variant="Variant.Outlined"
                   Color="Color.Warning"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh">
            Refresh
        </MudButton>


        <MudButton OnClick="OnSaveToYandex"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Download">
            ToYandex
        </MudButton>


        <MudMenu Label="@(isLoading ? "Loading..." : "Download Menu")" Dense="true" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" Disabled="@(SelectedVesselCallId == Guid.Empty || isLoading)" Variant="Variant.Outlined">
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowRight" IconColor="Color.Info" Label="Export to Excel" OnClick="ExportBillOfLadingsToExcel" />
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowRight" IconColor="Color.Info" Label="Translate Excel" OnClick="ExportBillOfLadingsForTranslateToExcel" />
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowRight" IconColor="Color.Info" Label="Arrival Notice" OnClick="ExportArrivalNoticeToExcel" />
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowRight" IconColor="Color.Info" Label="Cargo Manifest" OnClick="ExportCargoManifestToExcel" />
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowRight" IconColor="Color.Info" Label="DG Manifest" OnClick="ExportDGCargoManifestToExcel" />
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowRight" IconColor="Color.Info" Label="Feeder Bl" OnClick="ExportFeederBillOfLadingToExcel" />
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowRight" IconColor="Color.Info" Label="Obligation" OnClick="ObligationToExcel" />
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowRight" IconColor="Color.Info" Label="Xml" OnClick="Xml" />
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowRight" IconColor="Color.Info" Label="Fill Bill" OnClick="ExportFillBillToExcel" />
        </MudMenu>
    }
</Container>

<MudGrid Class="mt-1">
    <!-- Основной контент (две колонки) -->
    @if (SelectedVesselCallId != Guid.Empty)
    {
        <MudItem xs="12">
            <MudGrid>
                <!-- Левая колонка: Список коносаментов -->
                <MudItem xs="12" md="3" Class="pr-md-3">
                    <MudPaper Class="pa-4" Elevation="3" Style="height: calc(100vh - 190px); overflow-y: auto;display: flex; flex-direction: column;">
                        <div class="d-flex justify-space-between align-center mb-3">
                            <TextField Value="@SearchText" ValueChanged="(e) => SearchTextChanged(e)" NoHeader Clearable />

                            <MudTooltip Text="Translation state">
                                <CheckBox T="bool?" Value="@NoTranslate" ValueChanged="(e) => SearchBoolChanged(e)" TriState />
                            </MudTooltip>

                            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Color="Color.Warning" />
                            <MudChip T="string" Size="Size.Small" Color="TranslateStateColor">
                                @BillOfLadings.Count()
                            </MudChip>

                        </div>

                        @if (BillOfLadings.Any())
                        {
                            <div style="flex: 1; min-height: 0; overflow-y: auto;">
                                <MudList @bind-SelectedValue="SelectedBillId" Dense="true">
                                    @foreach (var bl in BillOfLadings)
                                    {
                                        <MudListItem Value="@bl.Id" OnClick="() => SelectBill(bl)">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.body2" Color="@(bl.HasTranslate? Color.Primary: Color.Warning)" Style="width:125px">
                                                    <strong>    @bl.Num </strong>
                                                </MudText>
                                                <div style="50px">

                                                    @if (bl.IsRef)
                                                    {
                                                        <img width="25" height="25" src="data:image/png;base64," alt="snowflake">
                                                    }

                                                    @if (bl.IsImo)
                                                    {
                                                        <img width="25" height="25" src="data:image/png;base64," alt="radioactive-emoji">
                                                    }
                                                </div>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                    @(bl.TsPort == null ? "Ts Port: N/A" : @bl.TsPort?.IsoCode)
                                                </MudText>
                                                <MudChip T="string" Class="ml-2" Size="Size.Medium" Color="Color.Primary" Variant="Variant.Filled">
                                                    @(bl.TsDate.HasValue? bl.TsDate?.ToString("dd.MM.yy"): "--.--.--")
                                                </MudChip>
                                            </div>
                                        </MudListItem>
                                    }
                                </MudList>
                            </div>
                        }
                        else
                        {
                            <div style="flex: 1; display: flex; align-items: center; justify-content: center;">
                                <MudAlert Severity="Severity.Info" Elevation="0">
                                    No bills of lading found for this vessel call.
                                </MudAlert>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                <!-- Правая колонка: Детали коносамента -->
                <MudItem xs="12" md="9" Class="pl-md-3">
                    <BillOfLadingViewComponent @ref="billOfLadingView"
                                               BillOfLadingDto="SelectedBill" OnVesselCallChanged="OnVesselCallChanged" />
                </MudItem>
            </MudGrid>
        </MudItem>
    }
</MudGrid>

<OverlayLoadingData Visible="isLoading" />
@code {
    private Guid SelectedVesselCallId = Guid.Empty;
    private VesselCallDto? SelectedVesselCall;

    private Guid SelectedBillId = Guid.Empty;
    private BillOfLadingBaseDto? SelectedBill;
    private IEnumerable<BillOfLadingBaseDto> billOfLadings = new List<BillOfLadingBaseDto>();
    private List<BillOfLadingBaseDto> BillOfLadings = new();

    bool? NoTranslate = null;
    public Color? TranslateStateColor => !NoTranslate.HasValue ? Color.Default : NoTranslate.Value ? Color.Primary : Color.Warning;
    private BillOfLadingViewComponent? billOfLadingView;
    private bool isLoading = false;
    private string? SearchText = string.Empty;

    private void SearchTextChanged(string value)
    {
        SearchText = value;

        if (string.IsNullOrWhiteSpace(SearchText))
        {
            BillOfLadings = billOfLadings.OrderBy(s => s.Num).ToList();
            return;
        }

        var searchTextLower = SearchText.ToLowerInvariant();
        BillOfLadings = billOfLadings
            .Where(b => BillMatchesSearch(b, searchTextLower))
            .OrderBy(s => s.Num)
            .ToList();

        StateHasChanged();
    }

    private bool BillMatchesSearch(BillOfLadingBaseDto bill, string searchTextLower)
    {
        if (string.IsNullOrWhiteSpace(searchTextLower)) return true;

        return
            (!string.IsNullOrWhiteSpace(bill.Num) && bill.Num.Contains(searchTextLower, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(bill.ShipperName) && bill.ShipperName.Contains(searchTextLower, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(bill.ShipperNameRu) && bill.ShipperNameRu.Contains(searchTextLower, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(bill.ConsigneeName) && bill.ConsigneeName.Contains(searchTextLower, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(bill.ConsigneeNameRu) && bill.ConsigneeNameRu.Contains(searchTextLower, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(bill.CargoDescription) && bill.CargoDescription.Contains(searchTextLower, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(bill.CargoDescriptionRu) && bill.CargoDescriptionRu.Contains(searchTextLower, StringComparison.OrdinalIgnoreCase)) ||
            (bill.ContainerRecords != null && bill.ContainerRecords.Any(c => ContainerMatchesSearch(c, searchTextLower)));
    }
    private bool ContainerMatchesSearch(BillOfLadingContainerRecordBaseDto container, string searchTextLower)
    {
        if (string.IsNullOrWhiteSpace(searchTextLower)) return false;

        return
            (!string.IsNullOrWhiteSpace(container.ContainerNo) && container.ContainerNo.Contains(searchTextLower, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(container.SealNo) && container.SealNo.Contains(searchTextLower, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(container.BookingNo) && container.BookingNo.Contains(searchTextLower, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(container.CargoDescriptionRu) && container.CargoDescriptionRu.Contains(searchTextLower, StringComparison.OrdinalIgnoreCase));
    }


    private async Task SaveState()
    {
        try
        {
            await localStorage.SetItemAsStringAsync("SelectedVesselCallId", SelectedVesselCallId.ToString());
            Console.WriteLine("Состояние сохранено");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка сохранения: {ex.Message}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadState();
    }

    private async Task LoadState()
    {
        isLoading = true; StateHasChanged();
        try
        {
            var savedValue = await localStorage.GetItemAsStringAsync("SelectedVesselCallId");
            if (savedValue != null)
            {
                if (Guid.TryParse(savedValue, out Guid Id))
                {
                    SelectedVesselCallId = Id;
                    await OnVesselCallChanged();
                }

            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    private async Task OnVesselCallChanged()
    {

        if (SelectedVesselCallId != Guid.Empty)
        {
            try
            {
                SearchText = string.Empty;
                // Получаем детали выбранного судозахода
                SelectedVesselCall = await VesselCallService.GetByIdAsync(SelectedVesselCallId);

                // Загружаем коносаменты для этого судозахода
                var bills = await BillOfLadingService.GetByVesselCallIdAsync(SelectedVesselCallId);
                billOfLadings = bills.ToList();
                BillOfLadings = billOfLadings.OrderBy(s => s.Num).ToList();
                // Сбрасываем выбранный коносамент
                SelectedBill = null;
                SelectedBillId = Guid.Empty;
                await SaveState();
                Snackbar.Add($"Loaded {BillOfLadings.Count} bills of lading", Severity.Info);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error loading bills of lading: {ex.Message}", Severity.Error);
            }
            finally
            {
                StateHasChanged();
            }
        }
        else
        {
            SelectedVesselCall = null;
            BillOfLadings.Clear();
            SelectedBill = null;
            SelectedBillId = Guid.Empty;
        }

        StateHasChanged();
    }

    private async void SelectBill(BillOfLadingBaseDto bill)
    {
        try
        {
            // Используем новый метод для загрузки данных
            if (billOfLadingView != null)
            {
                await billOfLadingView.LoadBillOfLadingById(bill.Id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading bills of lading: {ex.Message}", Severity.Error);
        }
        // finally
        // {
        //     StateHasChanged();
        // }
    }

    private async Task OpenCreateDialog()
    {
        if (SelectedVesselCallId == Guid.Empty)
        {
            Snackbar.Add("Please select a vessel call first", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["VesselCallId"] = SelectedVesselCallId,
            ["VesselCall"] = SelectedVesselCall
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CreateBillOfLadingDialog>("Create New Bill of Lading", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnVesselCallChanged();
        }
    }







    private async Task OpenUploadDialog()
    {

        var parameters = new DialogParameters
        {
            ["VesselCall"] = SelectedVesselCall
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            BackdropClick = false,
        };

        var dialog = await DialogService.ShowAsync<UploadManifestDialog>("Upload XML Manifest", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnVesselCallChanged();
        }
    }

    private async Task ExportBillOfLadingsToExcel()
    {
        try
        {
            if (SelectedVesselCallId == Guid.Empty)
            {
                Snackbar.Add("Please select a vessel call first", Severity.Warning);
                return;
            }

            if (!BillOfLadings.Any())
            {
                Snackbar.Add("No bills of lading to export", Severity.Info);
                return;
            }

            isLoading = true;
            StateHasChanged();

            var vesselCall = await VesselCallService.GetByIdForArrivalNoticeAsync(SelectedVesselCallId);
            var fileBytes = await _excelService.ExportBillOfLadingToExcelAsync(vesselCall);

            await DownloadFile(fileBytes, $"сводная_таблица_{vesselCall.Vessel.Name}_{vesselCall.VoyageNo}_{DateTime.Now.ToString("ddMMyymmss")} ", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            Snackbar.Add($"Successfully exported {BillOfLadings.Count} сводная_таблица", Severity.Success);

        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting to Excel: {ex.Message}", Severity.Error);
