    private async Task OnCustomerCopy()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Customer Copy",
            (MarkupString)$"Do you want to copy Customers?",
            yesText: "Yes,do it!", cancelText: "No");

        if (!result.HasValue || !result.Value)
            return;

        if (SelectedVesselCallId == Guid.Empty)
        {
            Snackbar.Add("Please select a vessel call first", Severity.Warning);
            return;
        }
        isLoading = true;
        StateHasChanged();
        try
        {
            await _customerService.CopyFromVesselCall(SelectedVesselCallId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting to Excel: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnCustomerTranslate()
    {
        if (SelectedVesselCallId == Guid.Empty)
        {
            Snackbar.Add("Please select a vessel call first", Severity.Warning);
            return;
        }

        bool? result = await DialogService.ShowMessageBoxAsync(
            "Get Customer Ru",
            (MarkupString)$"Do you want to get Customers Ru from Db?",
            yesText: "Yes,do it!", cancelText: "No");

        if (!result.HasValue || !result.Value)
            return;
        try
        {
            await _customerService.GetCustomerTranslateFromVesselCall(SelectedVesselCallId);

            Snackbar.Add("Customers have been updated", Severity.Info);
        }
