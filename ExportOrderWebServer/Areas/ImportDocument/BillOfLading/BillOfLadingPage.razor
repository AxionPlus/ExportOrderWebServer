            yesText: "Yes,do it!", cancelText: "No");

        if (!result.HasValue || !result.Value)
            return;

        isLoading = true;
        StateHasChanged();
        try
        {


            var billOfLadings = await GoogleSheetsParser.ParseSheetViaCsv(SelectedVesselCall.GoogleTableUrl);

            await BillOfLadingService.TranslateAsync(billOfLadings);
            Snackbar.Add($"Successfully Translate", Severity.Success);
