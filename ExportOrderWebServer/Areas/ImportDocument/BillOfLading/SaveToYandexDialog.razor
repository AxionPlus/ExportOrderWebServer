@using ExportOrderWebServer.Areas.ImportDocument.Services
@using ExportOrderWebServer.Areas.ImportDocument.VesselCall.Dto
@using ExportOrderWebServer.Areas.ImportDocument.VesselCall.Services
@using System.Text.Json

@inject IExcelExportService _excelService
@inject IArrivalNoticeExportService _arrivalNoticeExportService
@inject IManifestExportService _manifestExportService
@inject IManifestHazardousExportService _manifestHazardousExportService
@inject IFeederBlExcelService _feederBlExcelService
@inject IFillBillExcelService _fillBillExcelService
@inject IYandexDiskService _diskService
@inject IVesselCallService _vesselCallService
@inject IObligationExcelService _obligationExcelService
@inject ISnackbar Snackbar

<MudContainer>
    <MudList T="string" Disabled="@isLoading" Dense>
        <MudListItem Icon="@Icons.Material.Filled.AttachFile">
            <MudCheckBox Dense T="bool" @bind-Value="@ArrivalNotice" Disabled="@isLoading">ArrivalNotice</MudCheckBox>
        </MudListItem>
        <MudListItem Icon="@Icons.Material.Filled.AttachFile">
            <MudCheckBox Dense T="bool" @bind-Value="@CargoManifest" Disabled="@isLoading">CargoManifest</MudCheckBox>
        </MudListItem>
        <MudListItem Icon="@Icons.Material.Filled.AttachFile">
            <MudCheckBox Dense T="bool" @bind-Value="@DgManifest" Disabled="@isLoading">DgManifest</MudCheckBox>
        </MudListItem>
        <MudListItem Icon="@Icons.Material.Filled.AttachFile">
            <MudCheckBox Dense T="bool" @bind-Value="@FillBill" Disabled="@isLoading">FillBill</MudCheckBox>
        </MudListItem>
        <MudListItem Icon="@Icons.Material.Filled.AttachFile">
            <MudCheckBox Dense T="bool" @bind-Value="@Obligation" Disabled="@isLoading">Obligation</MudCheckBox>
        </MudListItem>
        <MudListItem Icon="@Icons.Material.Filled.AttachFile">
            <MudCheckBox Dense T="bool" @bind-Value="@Xml" Disabled="@isLoading">Xml</MudCheckBox>
        </MudListItem>
        <MudListItem Icon="@Icons.Material.Filled.AttachFile">
            <MudCheckBox Dense T="bool" @bind-Value="@FeederBl" Disabled="@isLoading">Feeder Bl</MudCheckBox>
        </MudListItem>
        <MudListItem Icon="@Icons.Material.Filled.AttachFile">
            <MudCheckBox Dense T="bool" @bind-Value="@Translate" Disabled="@isLoading">Translate</MudCheckBox>
        </MudListItem>
    </MudList>

    <div class="d-flex mt-4">
        <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="OnSave" Disabled="@isLoading">
            @(isLoading ? "Loading..." : "Save")
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="() => MudDialog?.Close()" Disabled="@isLoading">
            Cancel
        </MudButton>
    </div>
</MudContainer>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public VesselCallDto? VesselCall { get; set; }
    
    bool isLoading = false;
    bool ArrivalNotice = false;
    bool FeederBl = false;
    bool CargoManifest = false;
    bool DgManifest = false;
    bool FillBill = false;
    bool Obligation = false;
    bool Xml = false;
    bool Translate = false;

    private async Task OnSave()
    {
        try
        {
            if (VesselCall == null)
            {
                Snackbar.Add("Please select a vessel call first", Severity.Warning);
                return;
            }

            isLoading = true;
            StateHasChanged();

            var original = await _vesselCallService.GetByIdForArrivalNoticeAsync(VesselCall.Id);
            
            if (!original.BillOfLadings.Any())
            {
                Snackbar.Add("No bills of lading to export", Severity.Warning);
                return;
            }

            var timestamp = DateTime.Now.ToString("ddMMyy_HHmmss");
            var tasks = new List<Task>();

            if (ArrivalNotice)
                tasks.Add(ExportAsync("ArrivalNotice", $"УВЕДОМЛЕНИЕ_О_ПРИБЫТИИ_ТОВАРОВ_{original.VesselCallFileNameDisplay}_v{timestamp}.xlsx",
                    async () => await _arrivalNoticeExportService.GenerateArrivalNoticeAsync(DeepClone(original))));

            if (CargoManifest)
                tasks.Add(ExportAsync("CargoManifest", $"CargoManifest_{original.VesselCallFileNameDisplay}_v{timestamp}.xlsx",
                    async () => await _manifestExportService.GenerateManifestAsync(DeepClone(original))));

            if (DgManifest)
                tasks.Add(ExportAsync("DgManifest", $"DG_Manifest_{original.VesselCallFileNameDisplay}_v{timestamp}.xlsx",
                    async () => await _manifestHazardousExportService.GenerateManifestAsync(DeepClone(original))));

            if (FillBill)
                tasks.Add(ExportAsync("FillBill", $"Fill-Bill_{original.VesselCallFileNameDisplay}_v{timestamp}.xlsx",
                    async () => await _fillBillExcelService.GenerateExcel(DeepClone(original))));

            if (Obligation)
                tasks.Add(ExportAsync("Obligation", $"Обязательство_{original.VesselCallFileNameDisplay}_v{timestamp}.xlsx",
                    async () => await _obligationExcelService.GenerateObligationAsync(DeepClone(original))));

            if (Xml)
                tasks.Add(ExportAsync("Xml", $"Xml-{original.Terminal?.Name ?? "Terminal"}_{original.VesselCallFileNameDisplay}_v{timestamp}.xml",
                    () => Task.FromResult(new XmlExportService().CreateManifestXml(DeepClone(original)))));

            if (FeederBl)
                tasks.Add(ExportAsync("FeederBl", $"Feeder-Bl_{original.VesselCallFileNameDisplay}_v{timestamp}.xlsx",
                    async () => await _feederBlExcelService.GenerateFeederBlAsync(DeepClone(original))));

            if (Translate)
                tasks.Add(ExportAsync("Translate", $"Translate_{original.VesselCallFileNameDisplay}_v{timestamp}.xlsx",
                    async () => await _excelService.ExportBillOfLadingToExcelForTranslateAsync(DeepClone(original).BillOfLadings)));

            if (tasks.Any())
                await Task.WhenAll(tasks);
            else
                Snackbar.Add("No export types selected", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            ResetCheckboxes();
            StateHasChanged();
        }
    }

    private async Task ExportAsync(string docName, string fileName, Func<Task<byte[]>> generateFunc)
    {
        try
        {
            var fileBytes = await generateFunc();
            var uploadDto = new YandexFileUploadDto
            {
                VesselName = VesselCall?.Vessel?.Name ?? "UnknownVessel",
                VoyageNo = VesselCall?.VoyageNo ?? "0000",
                FileName = fileName,
                BaseFolderPath = "Документы Импорт"
            };
            await _diskService.UploadFileV1Async(fileBytes, uploadDto);
            
            // Безопасный вызов UI из параллельной задачи
            await InvokeAsync(() => Snackbar.Add($"{docName} - Saved to Yandex", Severity.Success));
        }
        catch (Exception ex)
        {
            await InvokeAsync(() => Snackbar.Add($"{docName} - Error: {ex.Message}", Severity.Error));
        }
    }

    // 🔐 Глубокое клонирование через JSON (изолирует все вложенные ссылки)
    private static T DeepClone<T>(T source)
    {
        var options = new JsonSerializerOptions
        {
            ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles,
            WriteIndented = false,
            DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
        };
        var json = JsonSerializer.Serialize(source, options);
        return JsonSerializer.Deserialize<T>(json, options)!;
    }

    private void ResetCheckboxes()
    {
        ArrivalNotice = FeederBl = CargoManifest = DgManifest = false;
        FillBill = Obligation = Xml = Translate = false;
    }
}