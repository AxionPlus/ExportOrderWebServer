@page "/import/port"
@attribute [Authorize(Roles = "ImportHub")]
@using ExportOrderWebServer.Areas.ImportDocument.Port.Dto
@using ExportOrderWebServer.Areas.ImportDocument.Port.Services
@using ExportOrderWebServer.Areas.ImportDocument.Provider

@inject IPortService PortService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<PageTitle>Ports</PageTitle>

<ToolBar Label="Ports" OnNew="NewPort"></ToolBar>

<Container>
    <!-- Search and filter controls can be added here -->
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ReloadTableData"
               StartIcon="@Icons.Material.Filled.Search" Class="ml-2">
        Search
    </MudButton>
</Container>

<TableWrap T="PortDto" Table="mudTable" PageSelector @bind-RowsPerPage="@RowsPerPage">
    <TableMenu>
    </TableMenu>
    <Content>
        <MudTable @ref="mudTable" T="PortDto" Class="Table P4 MultiSelect"
                  ServerData="ServerReload"
                  RowsPerPage="@RowsPerPage"
                  SelectOnRowClick="false"
                  Hover="true" Virtualize="true">
            <PagerContent />
            <HeaderContent>
                <MudTh Style="width:30px"></MudTh>
                <MudTh Style="width:180px">Name (RU)</MudTh>
                <MudTh Style="width:180px">Name (EN)</MudTh>
                <MudTh Style="width:150px">Country (RU)</MudTh>
                <MudTh Style="width:150px">Country (EN)</MudTh>
                <MudTh Style="width:120px">ISO Code</MudTh>
                <MudTh Style="width:120px">Aux ISO</MudTh>
                <MudTh Style="width:120px">PikYug ISO</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" 
                                   OnClick="(_) => ShowItem_Click(context)" 
                                   Color="Color.Warning" Disabled="@IsLoading" />
                </MudTd>

                <MudTd>@context.NameRu</MudTd>
                <MudTd>@context.NameEn</MudTd>
                <MudTd>@context.CountryRu</MudTd>
                <MudTd>@context.CountryEn</MudTd>
                <MudTd>@context.IsoCode</MudTd>
                <MudTd>@context.AuxIsoCode</MudTd>
                <MudTd>@context.PikYugIsoCode</MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText>No matching records found</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Loading...</MudText>
            </LoadingContent>
            <PagerContent />
        </MudTable>
    </Content>
</TableWrap>

<OverlayLoadingData Visible="@IsLoading" />

@code {
    MudTable<PortDto>? mudTable;
    bool IsLoading;
    private PaginatedResult<PortDto>? PagedResult;
    private int RowsPerPage = 50;

    private async Task<TableData<PortDto>> ServerReload(TableState state, CancellationToken token)
    {
        try
        {
            IsLoading = true;

            PagedResult = await PortService.GetPaginatedAsync(
                state.Page + 1, 
                state.PageSize, 
                token);

            if (mudTable != null)
            {
                mudTable.TotalItems = PagedResult.TotalCount;
                mudTable.Items = PagedResult.Items;
            }

            return new TableData<PortDto>()
            {
                TotalItems = PagedResult.TotalCount,
                Items = PagedResult.Items,
            };
        }
        catch (OperationCanceledException ex)
        {
            return new TableData<PortDto>()
            {
                TotalItems = 0,
                Items = new List<PortDto>()
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
            return new TableData<PortDto>()
            {
                TotalItems = 0,
                Items = new List<PortDto>()
            };
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task ShowItem_Click(PortDto context)
    {
        var parameters = new DialogParameters
        {
            ["PortDto"] = context
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            NoHeader = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = false,
            BackgroundClass = "dialog-blurry"
        };
        var dialog = await DialogService.ShowAsync<PortEditForm>("", parameters, options);
        var result = await dialog.Result;
    }

    private async Task NewPort()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            NoHeader = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = false,
            BackgroundClass = "dialog-blurry"
        };
        var dialog = await DialogService.ShowAsync<PortEditForm>("", parameters, options);
        var result = await dialog.Result;
    }

    private async Task ReloadTableData()
    {
        if (mudTable != null)
            await mudTable.ReloadServerData();
    }
}