@page "/import/vessel"
@attribute [Authorize(Roles = "ImportHub")]
@using ExportOrderWebServer.Areas.ImportDocument.Provider
@using ExportOrderWebServer.Areas.ImportDocument.Vessel.Dto
@using ExportOrderWebServer.Areas.ImportDocument.Vessel.Services

@inject IVesselService VesselService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<PageTitle>Vessels</PageTitle>

<ToolBar Label="Vessels" OnNew="NewVessel"></ToolBar>

<Container>
    
    
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ReloadTableData"
               StartIcon="@Icons.Material.Filled.Search" Class="ml-2">
        Search
    </MudButton>
</Container>

<TableWrap T="VesselDto" Table="mudTable" PageSelector @bind-RowsPerPage="@RowsPerPage">
    <TableMenu>
    </TableMenu>
    <Content>
        <MudTable @ref="mudTable" T="VesselDto" Class="Table P4 MultiSelect"
                  ServerData="ServerReload"
                  RowsPerPage="@RowsPerPage"
                  SelectOnRowClick="false"
                  Hover="true" Virtualize="true">
            <PagerContent />
            <HeaderContent>
                <MudTh Style="width:30px"></MudTh>
                <MudTh Style="width:180px">Name</MudTh>
                <MudTh Style="width:180px">FlagRu</MudTh>
                <MudTh Style="width:170px">FlagEn</MudTh>
                <MudTh Style="width:170px">ShortName</MudTh>
                <MudTh Style="width:170px">RolisCode</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="(_) => ShowItem_Click(context)" Color="Color.Warning" Disabled="@IsLoading" />
                </MudTd>

                <MudTd>@context.Name</MudTd>
                <MudTd>@context.FlagRu</MudTd>
                <MudTd>@context.FlagEn</MudTd>
                <MudTd>@context.ShortName</MudTd>
                <MudTd>@context.RolisCode</MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText>No matching records found</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Loading...</MudText>
            </LoadingContent>
            <PagerContent />
        </MudTable>
    </Content>
</TableWrap>

<OverlayLoadingData Visible="@IsLoading" />

@code {


    MudTable<VesselDto>? mudTable;
    bool IsLoading;
    private PaginatedResult<VesselDto>? PagedResult;
    private int RowsPerPage = 50;


    private async Task<TableData<VesselDto>> ServerReload(TableState state, CancellationToken token)
    {
        try
        {
            IsLoading = true;

            PagedResult = await VesselService.GetPaginatedAsync(state.Page + 1, state.PageSize, token);

            if (mudTable != null)
            {
                mudTable.TotalItems = PagedResult.TotalCount;
                mudTable.Items = PagedResult.Items;
            }

            return new TableData<VesselDto>()
            {
                TotalItems = PagedResult.TotalCount,
                Items = PagedResult.Items,
            };
        }
        catch (OperationCanceledException ex)
        {
            return new TableData<VesselDto>()
            {
                TotalItems = 0,
                Items = new List<VesselDto>()
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
            return new TableData<VesselDto>()
            {
                TotalItems = 0,
                Items = new List<VesselDto>()
            };
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }

    }


    private async Task ShowItem_Click(VesselDto context)
    {

        var parameters = new DialogParameters
        {
            ["VesselDto"] = context
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            NoHeader = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = false,
            BackgroundClass = "dialog-blurry"
        };
        var dialog = await DialogService.ShowAsync<VesselEditForm>("", parameters, options);
        var result = await dialog.Result;
    }

    private async Task NewVessel()
    {
        var parameters = new DialogParameters
        {
           
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            NoHeader = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            BackdropClick = false,
            BackgroundClass = "dialog-blurry"
        };
        var dialog = await DialogService.ShowAsync<VesselEditForm>("", parameters, options);
        var result = await dialog.Result;
    }

    private async Task ReloadTableData()
    {
        if (mudTable != null)
            await mudTable.ReloadServerData();
    }

}
