@using ExportOrderWebServer.Areas.ImportDocument.VesselCall.Dto
@using ExportOrderWebServer.Areas.ImportDocument.VesselCall.Services

@inject IVesselCallService vesselCallService
<MudContainer Class="">
    <TextField Label="Captain Name" @bind-Value="@VesselCall.CaptainName" style="width:300px;" UpperCase />
    <TextField Label="Captain LastName" @bind-Value="@VesselCall.CaptainLastName" Style="width:300px;" UpperCase />
</MudContainer>

<MudButton OnClick="onSave">Save</MudButton>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter]
    public VesselCallDto? VesselCall { get; set; }

    private async Task onSave()
    {
        try
        {
            await vesselCallService.CaptainChangeName(VesselCall);

        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            throw;
        }

        MudDialog?.Close();
    }

}
