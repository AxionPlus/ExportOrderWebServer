@page "/mycompany"

@inject ISnackbar Snackbar
@inject IMyCompanyProvider _myCompanyProvider

<PageTitle>My Company</PageTitle>

<style>
    .wrapper-input * .mud-input > input.mud-input-root-outlined.mud-input-root-margin-dense {
        padding: 6px 6px 6px 12px;
        text-align:left;
    }
</style>

@* <MudContainer MaxWidth="MaxWidth.Large"> *@
    <MudForm @ref="Form" ReadOnly="IsFormReadOnly">
        <div class="ToolBar-container">
            <MudToolBar Class="ToolBar ToolBar-new">
                <ShowMainMenuButton Class="ToolBar-IconButton" ExitHref="/" />
                <MudSpacer />

                <div class="ToolBar-Title"><span>my company</span></div>
                <MudSpacer />
                
                @if (IsFormReadOnly)
                {
                    <div class="ToolBar-iconbutton" style="margin-right: 20px">
                        <MudTooltip Text="add company">
                            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Add" OnClick="AddNewItem_Click" />
                        </MudTooltip>
                    </div>
                    <div class="ToolBar-iconbutton" style="margin-right: 20px">
                        <MudTooltip Text="edit company">
                            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Edit" OnClick="EditItem_Click" />
                        </MudTooltip>
                    </div>
                }
                else
                {
                    <div class="ToolBar-iconbutton" style="margin-right: 20px">
                        <MudTooltip Text="save company">
                            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" Disabled="@IsLoadingData" OnClick="SaveItem_Click" />
                        </MudTooltip>
                    </div>
                }
                
                <div class="ToolBar-iconbutton">
                    <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
                </div>
                <div class="ToolBar-iconbutton">
                    <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
                </div>
            </MudToolBar>
        </div>

        <div class="Container-item">
            <div class="container-content">
                <MudTextField Class="wrapper-input" T="string" Style="width: 400px;" Placeholder="Наименование компании" @bind-Value="@Item!.Name"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Required RequiredError=""
                              Clearable="!IsFormReadOnly" />
            </div>
        </div>

        <div class="Container-table">
            @if (mudTable != null)
            {
                <div class="tableMenu">
                    <MudSpacer />
                    <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
                    <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Item.Persons!.Count())</span>
                </div>
            }
            <MudTable Class="Table" @ref="mudTable" Items="@Item.Persons" Loading="IsLoadingData">
                <HeaderContent>
                    <MudTh Style="width:40px">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddPerson_Click" Disabled="@(IsFormReadOnly || IsLoadingData)" />
                    </MudTh>
                    <MudTh Style="width: 216px">Фамилия</MudTh>
                    <MudTh Style="width: 30px"></MudTh>
                    <MudTh Style="width: 216px">Имя</MudTh>
                    <MudTh Style="width: 216px">Отчество</MudTh>                    
                    <MudTh Style="width: 166px">Телефон</MudTh>
                    <MudTh Style="width: 166px">Компания</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="@Color.Error" OnClick="@(async () => { await RemovePerson_Click(context); })"
                                       Disabled="@(IsFormReadOnly || IsLoadingData)" />
                    </MudTd>
                    <MudTd DataLabel="Фамилия">
                        <MudTextField T="string" Style="width: 200px;" @bind-Value="@context.FamilyName"
                                      Placeholder="Фамилия"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true" Required RequiredError=""
                                      Clearable="!IsFormReadOnly" />
                    </MudTd>
                     <MudTd>
                         <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Style="@(IsShowPersonDetails == true ? "transform: rotate(180deg);" : null)"
                                        Size="@Size.Small" OnClick="(_)=>{IsShowPersonDetails = !IsShowPersonDetails;}" />
                         </MudTd>
                    <MudTd>
                        <MudTextField T="string" Style="width: 200px;" @bind-Value="@context.Name"
                                   Placeholder="Имя"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true" Required RequiredError=""
                                      Clearable="!IsFormReadOnly" />
                    </MudTd>
                    <MudTd DataLabel="Name">
                        <MudTextField T="string" Style="width: 200px;" @bind-Value="@context.SurName"
                                      Placeholder="Отчество"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true" Required RequiredError=""
                                      Clearable="!IsFormReadOnly" />
                    </MudTd>
                    <MudTd DataLabel="Phone">
                        <MudTextField T="string" Style="width: 150px;" @bind-Value="@context.Phone"
                                      Placeholder="+7 000 000 0000"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true" Required RequiredError=""
                                      Clearable="!IsFormReadOnly" />
                    </MudTd>
                    <MudTd></MudTd>
                </RowTemplate>
                <ChildRowContent>
                    @if (IsShowPersonDetails)
                    {
                        <MudTr>
                             <MudTh Style="width: 332px">Год и место рождения</MudTh>
                             <MudTh Style="width: 216px">Место жительства</MudTh>
                             <MudTd DataLabel="year">
                                 <MudTextField T="string" Style="width: 100px;" @bind-Value="@context.BornYear"                                           
                                               Variant="Variant.Outlined" Margin="Margin.Dense"
                                               Immediate="true" Required RequiredError=""
                                               Clearable="!IsFormReadOnly" />
                             </MudTd>
                             <MudTd DataLabel="place">
                                 <MudTextField T="string" Style="width: 200px;" @bind-Value="@context.BornPlace"
                                               Variant="Variant.Outlined" Margin="Margin.Dense"
                                               Immediate="true" Required RequiredError=""
                                               Clearable="!IsFormReadOnly" />
                             </MudTd>
                             <MudTd DataLabel="address">
                                 <MudTextField T="string" Style="width: 200px;" @bind-Value="@context.Address"
                                               Variant="Variant.Outlined" Margin="Margin.Dense"
                                               Immediate="true" Required RequiredError=""
                                               Clearable="!IsFormReadOnly" />
                             </MudTd>
                        </MudTr>
                        <MudTr>
                             <MudTh Style="width: 5116px; text-align:start; padding-left: 20px">Данные паспорта</MudTh>
                             <MudTd DataLabel="PassportData">
                                 <MudTextField T="string" Style="width: 500px;" @bind-Value="@context.Passport"
                                               Variant="Variant.Outlined" Margin="Margin.Dense"
                                               Immediate="true" Required RequiredError=""
                                               Clearable="!IsFormReadOnly" />
                             </MudTd>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>
        </div>

        <OverlayLoadingData Visible="@IsLoadingData" />

    </MudForm>
@* </MudContainer> *@



 @code {
    private MudForm? Form { get; set; }
    private MudTable<PersonEntity>? mudTable;
    private MyCompanyEntity? Item { get; set; } = new();
    private bool IsLoadingData { get; set; } = false;
    private bool IsNewItem { get; set; }
    private bool IsFormReadOnly { get; set; } = true;
    private bool IsShowPersonDetails { get; set; } = false;
    private HashSet<PersonEntity>? Persons { get; set; } = new HashSet<PersonEntity>();

    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    protected override async Task OnInitializedAsync()
    {
        bool IsItemNull = await _myCompanyProvider.IsItemNullAsync();

        if (IsItemNull)
        {
            IsNewItem = true;
            IsFormReadOnly = false;
            Item = new() { Persons = new List<PersonEntity>() { new PersonEntity() } };
        }
        else
        {
            IsNewItem = false;
            await GetItem();
        }
    }

    private async Task AddNewItem_Click()
    {
        // await Task.Delay(50);
        // IsNewItem = true;
        // IsFormReadOnly = false;
        // Item = new() { Persons = new List<PersonEntity>() { new PersonEntity() } };
    }

    private async Task GetItem()
    {
        var response = await _myCompanyProvider.GetLastItemAsync();
        if (!response.HasError)
            Item = (MyCompanyEntity)response.Object!;
        else
            Snackbar.Add($"{response.Error.First()}", Severity.Error);

        if (Item is not null)
            if (Item.Persons!.Count() > 0)
                Persons = Item.Persons!.ToHashSet();

        await Task.Delay(50);
    }

    public async Task SaveItem_Click()
    {
        IsLoadingData = true;
        await Form!.Validate();

        if (Form.IsValid)
            if (IsNewItem)
            {
                await _myCompanyProvider.NewItemAsync(Item!);
                Snackbar.Add("Save Successed", Severity.Success);
            }
            else
            {
                var result = await _myCompanyProvider.ModifyItemAsync(Item!);
                if (!result.HasError)
                    Snackbar.Add("Save Successed", Severity.Success);
                else
                    Snackbar.Add($"{result.Error.First()}", Severity.Error);
            }

        IsNewItem = false;
        IsFormReadOnly = true;
        await GetItem();

        await Task.Delay(500);
        IsLoadingData = false;
    }

    public async Task EditItem_Click()
    {
        await Task.Delay(50);
        IsFormReadOnly = false;
    }

    private void AddPerson_Click()
    {
        Item!.Persons!.Add(new());
    }

    private async Task RemovePerson_Click(PersonEntity item)
    {
        await Task.Delay(50);

        if (Item!.Persons!.Contains(item))
            Item!.Persons!.Remove(item);
    }
}
