@page "/mycompany"
@attribute [Authorize(Roles = "Admin, Top Manager")]

@inject ISnackbar Snackbar
@inject IJSRuntime jsRuntime
@inject IDialogService DialogService
@inject IMyCompanyProvider _MyCompanyProvider
@inject AuthenticationStateProvider authenticationStateProvider

<PageTitle>My Company</PageTitle>

<style>
    .wrapper-input * .mud-input > input.mud-input-root-outlined.mud-input-root-margin-dense {
        padding: 6px 6px 6px 12px;
        text-align:left;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Medium">
    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">            
            <ShowMainMenuButton Class="ToolBar-IconButton" ExitHref="/" />
            <MudSpacer />
            <div class="ToolBar-Title"><span>my company</span></div>
            <MudSpacer />
            <div class="ToolBar-iconbutton" style="margin-right: 20px">
                <MudTooltip Text="Save">
                    <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" Disabled="@(!IsRoleForEdit)" OnClick="SaveItem_Click" />                         
                </MudTooltip>
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
            </div>
        </MudToolBar>
    </div>
    @if (Item != null)
    {
        <MudForm @ref="Form">
            <div class="Container-item">
                <div class="container-content" style="justify-content:flex-start">
                    <MudTextField Class="wrapper-input" T="string" Style="width: 250px" Placeholder="Наименование компании" @bind-Value="@Item.Name"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" Required RequiredError="" Clearable />
                    <MudTextField Class="wrapper-input" T="string" Style="width: 250px; margin-left:10px" Placeholder="Адрес эл.почты" @bind-Value="@Item.Email"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" Required RequiredError="" Clearable />
                </div>
            </div>

            <div class="Container-table">
                <div class="tableMenu">
                    <MudSpacer />
                    <TablePager T="PersonEntity" Table="mudTable" ItemsCount="@Item.Persons.Count()" />
                </div>
                <MudTable Class="Table" @ref="mudTable" Items="@Item.Persons" RowsPerPage="15" Hover Loading="IsLoadingData">
                    <HeaderContent>
                        <MudTh Style="width:40px">
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="@Color.Primary"  Disabled="@(!IsRoleForEdit)" OnClick="@(() => ShowPerson_Click(null))" />
                        </MudTh>
                        <MudTh Style="width: 200px">Фамилия И.О.</MudTh>
                        <MudTh Style="width: 150px">Телефон</MudTh>
                        <MudTh Style="width: 200px">Компания</MudTh>
                        <MudTh Style="width: 40px"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Disabled="@(!IsRoleForEdit)" OnClick="@(() => ShowPerson_Click(context.Id))"/>
                        </MudTd>
                        <MudTd>@string.Concat(context.FamilyName, " ", context.Name?.Substring(0, 1), ". ", context.SurName?.Substring(0, 1), ".")</MudTd>
                        <MudTd>@context.Phone</MudTd>
                        <MudTd>@context.CompanyName</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="@Color.Error" Disabled="@(!IsRoleForEdit)" OnClick="@(()=>RemovePerson_Click(context))" />
                        </MudTd>
                    </RowTemplate>                    
                </MudTable>
            </div>
        </MudForm>
    }
    
</MudContainer>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    private MudForm? Form { get; set; }
    private MudTable<PersonEntity> mudTable = new();
    private MyCompanyEntity? Item { get; set; }
    private bool IsLoadingData { get; set; } = false;
    private bool IsNewItem { get; set; } = false;
    private bool IsRoleForEdit = false;


    protected override async Task OnInitializedAsync()
    {
        var user = await authenticationStateProvider.GetAuthenticationStateAsync();

        if (user.User.IsInRole("Admin") || user.User.IsInRole("Top Manager"))
            IsRoleForEdit = true;

        await GetItem();
        if (Item is null)
            IsNewItem = true;
    }

    private async Task GetItem()
    {
        IsLoadingData = true;

        var response = await _MyCompanyProvider.GetLastItemAsync();
        if (!response.HasErrors && response.Object is not null)
            Item = (MyCompanyEntity)response.Object;
        else
            Snackbar.Add($"{response.Errors.First()}", Severity.Error);

        IsLoadingData = false;
    }

    public async Task SaveItem_Click()
    {
        if (Form is null || Item is null) return;

        IsLoadingData = true;

        await Form.Validate();

        if (Form.IsValid)
            if (IsNewItem)
            {
                await _MyCompanyProvider.NewItemAsync(Item);
                Snackbar.Add("Save Successed", Severity.Success);
            }
            else
            {
                var result = await _MyCompanyProvider.ModifyItemAsync(Item);
                if (!result.HasErrors)
                    Snackbar.Add("Save Successed", Severity.Success);
                else
                    Snackbar.Add($"{result.Errors.First()}", Severity.Error);
            }

        IsNewItem = false;
        IsLoadingData = false;

        await GetItem();
    }

    private void RemovePerson_Click(PersonEntity item)
    {
        if (Item is null || !Item.Persons.Any()) return;

        if (Item.Persons.Contains(item))
            Item.Persons.Remove(item);
    }

    private async void ShowPerson_Click(long? id = null)
    {   
        var parameters = new DialogParameters { ["Id"] = id };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Person_ItemDialog>("Person", parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await GetItem();
            await InvokeAsync(StateHasChanged);
        }
        
    }
}
