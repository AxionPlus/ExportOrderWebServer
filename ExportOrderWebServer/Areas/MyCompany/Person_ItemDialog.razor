@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider authenticationStateProvider
@inject IMyCompanyProvider _myCompanyProvider

<style>
    .container-content-Person {
        display:flex;
    }
    .container-content-column {
        display: flex;
        margin-inline-end: 10px;
    }
</style>

@if (Item is not null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content" Disabled="IsFormReadOnly">
        <div class="Container-item">
            <div class="container-content Person">        
                <MudTextField T="string" Style="width: 200px;" @bind-Value="@Item.FamilyName"
                              Placeholder="Фамилия"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Required RequiredError="" Clearable />
                <MudSpacer />
                <MudTooltip Text="Save person">
                    <MudIconButton Style="margin-inline-end:20px" Icon="@Icons.Material.Outlined.Save" Color="Color.Primary" OnClick="SaveItem_Click" />
                </MudTooltip>
            </div>
            <div class="container-content Person">
                <MudTextField T="string" Style="width: 200px;" @bind-Value="@Item.Name"
                              Placeholder="Имя"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Required RequiredError="" Clearable />
                 <MudTextField T="string" Style="width: 200px; margin-inline:10px" @bind-Value="@Item.SurName"
                               Placeholder="Отчество"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Immediate="true" Required RequiredError="" Clearable />
                 <MudTextField T="string" Style="width: 190px;" @bind-Value="@Item.Phone"
                               Placeholder="+7 000 000 0000"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Immediate="true" Required RequiredError="" Clearable />
            </div>
            <MudDivider Class="my-3" />
            <div class="container-content Person">
                <div class="container-content-column" style="width:200px">место работы:</div>
                <div class="container-content-column" style="width:400px">
                    <MudTextField T="string" Style="width: 400px;" @bind-Value="@Item.Company"
                                  Placeholder="компания"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" Required RequiredError="" Clearable />
                </div>
            </div>
            <div class="container-content Person">
                <div class="container-content-column" style="width:200px">год и место рождения:</div>
                <div class="container-content-column" style="width:630px">
                     <MudTextField T="string" Style="width: 100px; margin-right:10px" @bind-Value="@Item.BirthYear"
                                   Placeholder="год"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Immediate="true" Required RequiredError="" Clearable />
                     <MudTextField T="string" Style="width: 520px;" @bind-Value="@Item.BirthPlace"
                                   Placeholder="место"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Immediate="true" Required RequiredError="" Clearable />
                </div>
            </div>
            <div class="container-content Person">
                <div class="container-content-column" style="width:200px">место жительства:</div>
                <div class="container-content-column" style="width:630px">
                    <MudTextField T="string" Style="width: 630px;" @bind-Value="@Item.Address"
                                  Placeholder="адрес"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" Required RequiredError="" Clearable />
                </div>
            </div>
            <div class="container-content Person">
                <div class="container-content-column" style="width:200px">данные паспорта:</div>
                <div class="container-content-column" style="width:630px">
                    <MudTextField T="string" Style="width: 630px;" @bind-Value="@Item.Passport"
                                  Placeholder="паспорт"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" Required RequiredError="" Clearable />
                </div>
            </div>
        </div>
    </MudForm>

    <OverlayLoadingData Visible="@IsLoadingData" />
}

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    private MudForm? Form { get; set; }

    private PersonEntity? Item { get; set; } = new();

    public long Id { get; set; }
    private bool IsFormReadOnly { get; set; } = false;
    private bool IsAuth = false;
    private bool IsLoadingData { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("Top Manager") || user.User.IsInRole("Manager"))
        {
            IsAuth = true;
        }
    }

    // private async Task GetItem()
    // {
    //     if (IsFormReadOnly)
    //     {
    //         var response = await _myCompanyProvider.GetPersonItemAsync(Id);
    //         if (!response.HasError)
    //             Item = (PersonEntity)response.Object!;
    //     }
    // }

    private async Task SaveItem_Click()
    {
        await Form!.Validate();

        if (Form.IsValid)
        {
            if (Item is not null)
            {
                var response = await _myCompanyProvider.NewPersonItemAsync(Item!);
                if (!response.HasError)
                {
                    Id = Item!.Id;
                    Snackbar.Add("Saved successfully", Severity.Success);
                }
                else
                    Snackbar.Add(response.Error.LastOrDefault(), Severity.Error);
            }

            IsFormReadOnly = true;
        }
    }

    
}
