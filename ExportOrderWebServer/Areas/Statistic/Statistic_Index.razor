@page "/statistic"
@attribute [Authorize(Roles = "Admin, Top Manager")]

@inject ISnackbar Snackbar
@inject AuthenticationStateProvider authenticationStateProvider
@inject StatisticProvider _statisticProvider

<PageTitle>Statistic</PageTitle>

<style>
    .mud-simple-table table thead {
        background-color: lightblue;
    }

    .mud-simple-table table * tr th {
        text-align: center;
        padding: 6px
    }

    .mud-simple-table table * tr td {
        text-align: center;
    }

    .mud-picker-inline {
        flex:unset;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Small">
    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">
            <ShowMainMenuButton Class="ToolBar-IconButton" ExitHref="/" />
            <MudSpacer />
            <div class="ToolBar-Title"><span>statistic</span></div>
            <MudSpacer />

            <div class="ToolBar-iconbutton" style="margin-right: 20px">
                <MudTooltip Text="get statistic">
                    <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.AccountBalance" OnClick="GetItem"/>
                </MudTooltip>
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
            </div>
        </MudToolBar>
    </div>
    <div class="Container-item">
        <div class="container-content" style="justify-content:flex-start; padding-bottom:16px">
            <div style="width:130px; height:35px; margin-right:10px">
                <MudDatePicker Class="wrapper-input-date" Label="from" @bind-Date="Filter.DateFrom"
                               DateFormat="dd.MM.yy"
                               ShowWeekNumbers="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               IconSize=Size.Small
                               AutoClose=true
                               Clearable />
            </div>
            <div style="width:130px; height:35px; margin-right:40px">
                <MudDatePicker Class="wrapper-input-date" Label="to" @bind-Date="Filter.DateTo"
                               DateFormat="dd.MM.yy"
                               ShowWeekNumbers="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               IconSize=Size.Small
                               AutoClose=true
                               Clearable />
            </div>
            
            <MudSpacer />

            <div style="width:130px; height:35px; margin-right:10px">
                <MudDatePicker Class="wrapper-input-date" Label="month" @bind-Date="_month"
                               DateFormat="MMM"
                               ShowWeekNumbers="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               IconSize=Size.Small
                               AutoClose=true
                               Clearable
                               OpenTo="OpenTo.Month" FixYear="@DateTime.Today.Year" FixDay="@DateTime.Today.Day" />
            </div>
            <div style="width:130px; height:35px; margin-right:40px">
                <MudDatePicker Class="wrapper-input-date" Label="year" @bind-Date="_year"
                               DateFormat="yyyy"
                               ShowWeekNumbers="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               IconSize=Size.Small
                               AutoClose=true
                               Clearable
                               OpenTo="OpenTo.Year" FixMonth="@DateTime.Today.Month" FixDay="@DateTime.Today.Day" />
            </div>             
            
            <MudSpacer />

            <MudButton Class="Button" Style="width: 80px" OnClick="ClearAllFilters"
                       Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary">
                Clear
            </MudButton>
        </div>
    </div>
    <div class="Container-item">
        @if (Item is not null)
        {
            <MudSimpleTable Style="overflow-x: auto;">
                <thead>
                    <tr>
                        @foreach (var h in headings)
                        {
                            if (h == "Completed")
                            {
                                <th style="color:dodgerblue">@h</th>
                            }
                            else
                            {
                                <th>@h</th>
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        @foreach (var x in elements)
                        {
                            <td>@x</td>
                        }
                    </tr>
                </tbody>
            </MudSimpleTable>
        }
    </div>
</MudContainer>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    public StatisticEntity? Item { get; set; } = new StatisticEntity();
    
    private FilterParameters Filter { get; set; } = new();
    private DateTime? _month;
    private DateTime? _year;

    private bool IsLoadingData { get; set; } = false;
    private bool IsAuth { get; set; }
    private string[] headings = { "From", "To", "Underway", "Cancelled", "Completed", "Overall" };
    private string[] elements { get; set; } = new string[6];    


    protected override async Task OnInitializedAsync()
    {
        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("Top Manager"))
        {
            IsAuth = true;
        }
    }

    public async Task GetItem()
    {
        IsLoadingData = true;

        SetDatePeriod();

        var response = await _statisticProvider.GetItemsAsync(Filter);
        if (!response.HasError)
        {
            Item = (StatisticEntity)response.Object!;

            if (Item is not null)
            {   
                elements[0] = Item.DatedFrom.HasValue ? Item.DatedFrom.Value.ToShortDateString() : "---";
                elements[1] = Item.DatedTo.HasValue ? Item.DatedTo.Value.ToShortDateString() : "---";
                elements[2] = Item.CntrsUnderway.ToString() + " (" + Item.EOsUnderway.ToString() + ")";
                elements[3] = Item.CntrsCancelled.ToString() + " (" + Item.EOsCancelled.ToString() + ")";
                elements[4] = Item.CntrsCompleted.ToString() + " (" + Item.EOsCompleted.ToString() + ")";
                elements[5] = Item.CntrsOverall.ToString() + " (" + Item.EOsOverall.ToString() + ")";
            }            
        }
        else
            Snackbar.Add($"No Success<br>{response.Error.FirstOrDefault()}", Severity.Error);

        await Task.Delay(100);
        IsLoadingData = false;
    }

    private void ClearAllFilters()
    {
        Filter = new();
        _month = null;
        _year = null;

        InvokeAsync(StateHasChanged);
    }

    private void SetDatePeriod()
    {
        if (_month.HasValue)
        {
            Filter = new();
            _year = null;

            var firstDayOfMonth = new DateTime(_month.Value.Year, _month.Value.Month, 1);
            Filter.DateFrom = firstDayOfMonth;
            Filter.DateTo = firstDayOfMonth.AddMonths(1).AddDays(-1);

            _month = null;
        }

        if (_year.HasValue)
        {
            Filter = new();
            _month = null;

            var firstDayOfYear = new DateTime(_year.Value.Year, 1, 1);
            Filter.DateFrom = firstDayOfYear;
            Filter.DateTo = firstDayOfYear.AddYears(1).AddDays(-1);

            _year = null;
        }

        InvokeAsync(StateHasChanged);
    }
}
