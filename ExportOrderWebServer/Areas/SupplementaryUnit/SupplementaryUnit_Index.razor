@page "/supplementaryUnit"
@attribute [Authorize(Roles = "Admin, Top Manager, Manager")]

@inject ISnackbar Snackbar
@inject IJSRuntime jsRuntime
@inject IDialogService DialogService
@inject ISupplementaryUnitProvider _SupplementaryUnitProvider

<MudContainer MaxWidth="MaxWidth.Medium">
    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">
            <ShowMainMenuButton Class="ToolBar-IconButton" ExitHref="/" />            
            <MudSpacer />
            <div class="ToolBar-Title"><span>Дополнительные ед. измерения</span></div>
            <MudSpacer />
            <div class="ToolBar-iconbutton" style="margin-right: 20px">
                <MudTooltip Text="Add New Item" Duration="1500" Delay="1000" Placement="Placement.End">
                    <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.AddBox" OnClick="AddItem_Click" />
                </MudTooltip>
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
            </div>
        </MudToolBar>
    </div>
    <div class="Container-table">
        <div class="tableMenu">            
            <MudSpacer />
            <TablePager T="SupplementaryUnitCatalog" Table="mudTable" ItemsCount="@Items.Count()" />
        </div>
        <MudTable Class="Table P4" @ref="mudTable" Items="@Items" Virtualize Hover RowsPerPage="20">
            <HeaderContent>
                <MudTh Style="width:80px">
                    <MudTableSortLabel SortBy="new Func<SupplementaryUnitCatalog, object>(x=>x.Code!)">Code</MudTableSortLabel>
                </MudTh>
                <MudTh Style="width:180px">
                    <MudTableSortLabel SortBy="new Func<SupplementaryUnitCatalog, object>(x=>x.ShortName)">Short Name</MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align:start">Full Name</MudTh>
                <MudTh Style="width:40px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Code</MudTd>
                <MudTd>@context.ShortName</MudTd>
                <MudTd Style="text-align:start">@context.FullName</MudTd>  
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async () => { await RemoveItem_Click(context.ShortName, context.Id); })" />
                </MudTd>
            </RowTemplate>
            <PagerContent></PagerContent>
        </MudTable>
    </div>
</MudContainer>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    [CascadingParameter] public string? ApplicationUser { get; set; }    
    private MudTable<SupplementaryUnitCatalog> mudTable = new();   

    private IEnumerable<SupplementaryUnitCatalog> Items { get; set; } = new List<SupplementaryUnitCatalog>();
    private bool IsNewItemActivated = false;
    private bool IsLoadingData = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GetItems();
            StateHasChanged();
        }
    }

    private async Task GetItems()
    {
        IsLoadingData = true;

        var items = await _SupplementaryUnitProvider.GetItemsAsync();

        if (items is null || !items.Any())
            Snackbar.Add($"Records not found.", Severity.Warning);
        else
            Items = items;

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async void AddItem_Click()
    {
        var parameters = new DialogParameters { ["ApplicationUser"] = ApplicationUser };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<SupplementaryUnit_Dialog>(null, parameters, options);

        var result = await dialog.Result;

        if (result != null && result.Data != null && (bool)result.Data == true)        
            await GetItems();
    }

    private async Task RemoveItem_Click(string? name, long id)
    {
        bool? msgResult = await DialogService.ShowMessageBox("REMOVE",
                                        (MarkupString)$"<b>Do you want to remove record?</b> <br/>Доп.ед: {name}<br/>",
                                        yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _SupplementaryUnitProvider.RemoveItemAsync(id);

                if (!response.HasErrors)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);
            }

        await GetItems();
    }
}
