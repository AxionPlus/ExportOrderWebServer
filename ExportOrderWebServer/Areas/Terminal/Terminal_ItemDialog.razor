@inject ISnackbar Snackbar
@inject AuthenticationStateProvider authenticationStateProvider
@inject ITerminalProvider _terminalProvider
@inject ILocationProvider _locationProvider

<style>
/*     .Container-item > .container-content {
        justify-content: unset;
    } */

    .SelectField * .mud-input-slot.mud-input-root-outlined.mud-input-root-adorned-end {
        text-align:left;
    }
</style>

@if (Item is not null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content" ReadOnly="IsFormReadOnly">

        <div class="ToolBar-container">
            <MudToolBar Class="ToolBar ToolBar-new">
                <div class="ToolBar-iconbutton" style="margin-left: 20px">
                    <MudTooltip Text="Edit terminal">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Edit" Disabled="!IsFormReadOnly" OnClick="EditItem_Click" />
                    </MudTooltip>
                </div>
                <MudSpacer />
                <div class="ToolBar-iconbutton" style="margin-right: 20px">
                    <MudTooltip Text="Save terminal">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" Disabled="IsFormReadOnly" OnClick="SaveItem_Click" />
                    </MudTooltip>
                </div>
            </MudToolBar>
        </div>

        <div class="Container-item">
            <div class="container-head"></div>
            <div class="container-content">
                <MudTextField T="string" Style="width: 250px; margin-right:10px" Label="Short Name" Text="@Item.Name"
                              TextChanged="async (e)=> { Item.Name = e.ToUpper(); }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"
                              Required RequiredError=""
                              Clearable="!IsFormReadOnly" />
            </div>
            <div class="container-content">
                 <MudAutocomplete T="LocationCatalog" Style="width: 250px" Label="Location" @bind-Value="Item.Location"
                                  ToStringFunc="@(e => e != null ? e.Name : "")"
                                  SearchFunc="@SearchLocation"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required RequiredError=""
                                  CloseIcon="" OpenIcon=""
                                  ResetValueOnEmptyText="true"
                                  Placeholder="Location"
                                  MaxItems="20"
                                  IconSize="Size.Small"
                                  Clearable="!IsFormReadOnly" />
            </div>
            <div class="container-content">
                <MudSelect Class="SelectField" T="CustomsCatalog" Label="Таможенный пост" @bind-Value="@Item.Customs"
                            Style="width:500px; text-align:left" Placeholder="Таможенный пост"
                            ToStringFunc="@(str=>str is not null ? str.Office : string.Empty)"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            CloseIcon="" OpenIcon=""
                            Clearable="!IsFormReadOnly">
                    @if (CustomOffices is not null)
                        @foreach (var office in CustomOffices)
                        {
                            <MudSelectItem Value="@office">@($"({office.Code}) {office.Office}")</MudSelectItem>
                        }
                </MudSelect>
            </div>            
        </div>

    </MudForm>
}

@code {
    private MudForm? Form { get; set; }

    [CascadingParameter]
    private MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public long Id { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private TerminalCatalog? Item { get; set; }
    private IEnumerable<CustomsCatalog> CustomOffices { get; set; } = new List<CustomsCatalog>();
    private bool IsFormReadOnly { get; set; } = true;
    private bool IsAuth = false;


    protected override async Task OnInitializedAsync()
    {
        CustomOffices = await _terminalProvider.GetCustomsOfficesAsync();

        await GetItem();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("TopManager") || user.User.IsInRole("ExpDept"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        if (IsNewItem)
        {
            Item = new();
            IsFormReadOnly = false;
        }        
        else
        {
            var response = await _terminalProvider.GetItemAsync(Id);
            if (!response.HasError)
                Item = (TerminalCatalog)response.Object!;
        }
    }

    private async Task SaveItem_Click()
    {
        await Form!.Validate();

        if (Form.IsValid)
        {
            if (IsNewItem)
            {
                var response = await _terminalProvider.NewItemAsync(Item!);
                if (!response.HasError)
                {
                    Id = Item!.Id;
                    Snackbar.Add("Saved successfully", Severity.Success);
                }
                else
                    Snackbar.Add(response.Error.LastOrDefault(), Severity.Error);
            }
            else
            {
                var response = await _terminalProvider.ModifyItemAsync(Item!);
                if (!response.HasError)                    
                    Snackbar.Add("Save Successed", Severity.Success);
                else
                    Snackbar.Add(response.Error.Last(), Severity.Error);
            }

            IsNewItem = false;
            IsFormReadOnly = true;

            await GetItem();
        }
    }

    private async Task EditItem_Click()
    {
        await Task.Delay(50);
        IsFormReadOnly = false;
    }

    private async Task<IEnumerable<LocationCatalog>> SearchLocation(string value)
    {
        var Locations = new List<LocationCatalog>();

        var response = await _locationProvider.GetItemsAsync();
        if (!response.HasError)
            Locations = ((IEnumerable<LocationCatalog>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Locations;

        return Locations.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }
}
