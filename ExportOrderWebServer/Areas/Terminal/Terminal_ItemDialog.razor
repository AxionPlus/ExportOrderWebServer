@inject ISnackbar Snackbar
@inject AuthenticationStateProvider authenticationStateProvider
@inject ITerminalProvider _terminalProvider
@inject ILocationProvider _locationProvider

<style>
    .Container-item > .container-content {
        justify-content: unset;
    }
</style>

@if (Value is not null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content">
        <div class="Container-item">
            <div class="container-head"></div>
            <div class="container-content">
                <MudTextField T="string" Style="width: 150px; margin-right:10px" Label="Short Name" Text="@Value.Name"
                              TextChanged="async (e)=> { Value.Name = e.ToUpper(); }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"
                              Required RequiredError=""
                              ReadOnly="!IsNewItem" Clearable="IsNewItem" />

                <MudButton Class="Button" Style="width: 100px; margin-left: 10px" Disabled="!IsNewItem" OnClick="SaveItem_Click"
                            Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">
                    Save
                </MudButton>
             </div>

             <div class="container-content">
                 <MudAutocomplete T="LocationCatalog" Style="width: 350px" @bind-Value="Value.Location"
                                  ToStringFunc="@(e => e != null ? e.Name : "")"
                                  SearchFunc="@SearchLocation"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required RequiredError=""
                                  CloseIcon="" OpenIcon=""
                                  ResetValueOnEmptyText="true"
                                  Placeholder="Location"
                                  MaxItems="20"
                                  IconSize="Size.Small"
                                  ReadOnly="!IsNewItem" Clearable="IsNewItem" />

             </div>
@*             <div class="container-content" style="padding-bottom:unset">
                <h6 style="margin-bottom:unset">Таможенный пост</h6>
            </div> *@
            <div class="container-content">
                <MudSelect Class="SelectField" T="CustomsCatalog" Label="Таможенный пост" @bind-Value="@Value.Customs"
                            Style="width:350px" Placeholder="Таможенный пост"
                            ToStringFunc="@(str=>str is not null ? str.CustomsOffice : string.Empty)"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            CloseIcon="" OpenIcon="">
                    @if (CustomOffices is not null)
                        @foreach (var office in CustomOffices)
                        {
                            <MudSelectItem Value="@office">@($"({office.CustomsCode}) {office.CustomsOffice}")</MudSelectItem>
                        }
                </MudSelect>
            </div>
            
         </div>
     </MudForm>
}

@code {
    private MudForm? Form { get; set; }

    [CascadingParameter]
    private MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public long Id { get; set; } = 0;
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private TerminalCatalog? Value { get; set; }

    private IEnumerable<CustomsCatalog> CustomOffices { get; set; } = new List<CustomsCatalog>();

    private bool IsAuth = false;


    protected override async Task OnInitializedAsync()
    {
        CustomOffices = await _terminalProvider.GetCustomsOfficesAsync();

        await GetItem();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("TopManager") || user.User.IsInRole("ExpDept"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        if (IsNewItem)
            Value = new();
        else
        {
            var response = await _terminalProvider.GetItemAsync(Id);
            if (!response.HasError)
                Value = (TerminalCatalog)response.Object!;
        }
    }

    public async Task SaveItem_Click()
    {
        await Form!.Validate();

        if (Form.IsValid)
        {
            if (IsNewItem)
            {
                var response = await _terminalProvider.NewItemAsync(Value!);
                if (!response.HasError)
                {
                    Snackbar.Add("Saved successfully", Severity.Success);
                    IsNewItem = false;
                }
                else
                    Snackbar.Add(response.Error.LastOrDefault(), Severity.Error);
            }
            else
            {
                // var response = await _terminalProvider.ModifyItemAsync(Value!);
                // if (!response.HasError)
                // {
                //     await GetItem();
                //     Snackbar.Add("Save Successed", Severity.Success);
                // }
                // else
                //     Snackbar.Add(response.Error.Last(), Severity.Error);
            }

            await InvokeAsync(StateHasChanged);

            MudDialog!.Close();
        }
    }

    public async Task ClearItem_Click()
    {
        if (IsNewItem)
        {
            Value!.Name = null;
            Value.Location = null;
        }

        await Task.Delay(50);
    }

    private async Task<IEnumerable<LocationCatalog>> SearchLocation(string value)
    {
        // if (string.IsNullOrWhiteSpace(value))
        //     return Enumerable.Empty<CountryCatalog>();

        var Locations = new List<LocationCatalog>();

        var response = await _locationProvider.GetItemsAsync();
        if (!response.HasError)
            Locations = ((IEnumerable<LocationCatalog>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Locations;

        return Locations.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }
}
