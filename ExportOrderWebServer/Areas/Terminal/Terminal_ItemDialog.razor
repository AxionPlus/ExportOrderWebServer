@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider authenticationStateProvider
@inject ITerminalProvider _terminalProvider
@inject ILocationProvider _locationProvider

<style>

    .SelectField * .mud-input-slot.mud-input-root-outlined.mud-input-root-adorned-end {
        text-align:left;
    }

    .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-inline-end: 4px;
        padding-right: 4px;
    }

</style>

@if (Item is not null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content" ReadOnly="IsFormReadOnly">
        <div class="ToolBar-container">
            <MudToolBar Class="ToolBar ToolBar-new">
                <MudSpacer />
                <div class="ToolBar-iconbutton" style="margin-right: 20px">
                    <MudTooltip Text=@(IsFormReadOnly ? "Edit" : "Save")>
                        @if (IsFormReadOnly)
                        {
                            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Edit" OnClick="EditItem_Click" />
                        }
                        else
                        {
                            <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" OnClick="SaveItem_Click" />
                        }
                    </MudTooltip>
                </div>
            </MudToolBar>
        </div>

        <div class="Container-item">
            <div class="container-content">
                <MudTextField T="string" Style="width: 150px; margin-right:10px" Label="Short Name" Text="@Item.Name"
                              TextChanged="async (e)=> { Item.Name = e.ToUpper(); }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"
                              Required RequiredError=""
                              Clearable="!IsFormReadOnly" />
            </div>
             <div class="container-content" style="justify-content: flex-start">
                 <MudAutocomplete T="LocationCatalog" Style="width: 300px; margin-right:20px" Label="Location" @bind-Value="Item.Location"
                                  ToStringFunc="@(e => e != null ? e.Name : "")"
                                  SearchFunc="@SearchLocation"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required RequiredError=""
                                  CloseIcon="" OpenIcon="" IconSize="Size.Small"
                                  ResetValueOnEmptyText="true"
                                  Placeholder="Location"
                                  MaxItems="20"
                                  AdornmentIcon="@Icons.Material.Filled.AddCircle"
                                  AdornmentColor="Color.Primary"
                                  Adornment="Adornment.End"
                                  OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddLocation_Click(); })"
                                  Clearable="!IsFormReadOnly" />
            </div>
            <div class="container-content">
                <MudSelect Class="SelectField" T="CustomsCatalog" Label="Таможенный пост" @bind-Value="@Item.Customs"
                           Style="width:550px; text-align:left" Placeholder="Таможенный пост"
                           ToStringFunc="@(str => str is not null ? str.OfficeShort : string.Empty)"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           CloseIcon="" OpenIcon=""
                           Clearable="!IsFormReadOnly" >
                    @if (CustomOffices is not null)
                        @foreach (var office in CustomOffices)
                        {
                            <MudSelectItem Value="@office">@($"({office.Code}) {office.OfficeShort}")</MudSelectItem>
                        }
                </MudSelect>
            </div>            
        </div>
    </MudForm>
}

@code {
    private MudForm? Form { get; set; }

    [CascadingParameter]
    private MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public long Id { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private TerminalCatalog? Item { get; set; }
    private IEnumerable<CustomsCatalog> CustomOffices { get; set; } = new List<CustomsCatalog>();
    private bool IsFormReadOnly { get; set; } = true;
    private bool IsAuth = false;


    protected override async Task OnInitializedAsync()
    {
        CustomOffices = await _terminalProvider.GetCustomsOfficesAsync();

        await GetItem();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("Top Manager") || user.User.IsInRole("Manager"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        if (IsNewItem)
        {
            Item = new();
            IsFormReadOnly = false;
        }        
        else
        {
            var response = await _terminalProvider.GetItemAsync(Id);
            if (!response.HasErrors)
                Item = (TerminalCatalog)response.Object!;
        }
    }

    private async Task SaveItem_Click()
    {
        await Form!.Validate();

        if (Form.IsValid)
        {
            if (IsNewItem)
            {
                var response = await _terminalProvider.NewItemAsync(Item!);
                if (!response.HasErrors)
                {
                    Id = Item!.Id;
                    Snackbar.Add("Saved successfully", Severity.Success);
                }
                else
                    Snackbar.Add(response.Errors.LastOrDefault()!, Severity.Error);
            }
            else
            {
                var response = await _terminalProvider.ModifyItemAsync(Item!);
                if (!response.HasErrors)                    
                    Snackbar.Add("Save Successed", Severity.Success);
                else
                    Snackbar.Add(response.Errors.Last(), Severity.Error);
            }

            IsNewItem = false;
            IsFormReadOnly = true;

            await GetItem();
        }
    }

    private async Task AddLocation_Click()
    {
        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Location_ItemDialog>("New Locaion", parameters, options);

        var result = await dialog.Result;
    }

    private async Task EditItem_Click()
    {
        await Task.Delay(50);
        IsFormReadOnly = false;
    }

    private async Task<IEnumerable<LocationCatalog>> SearchLocation(string value, CancellationToken token)
    {
        var Locations = new List<LocationCatalog>();

        var response = await _locationProvider.GetItemsAsync();
        if (!response.HasErrors)
            Locations = ((IEnumerable<LocationCatalog>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Locations;

        return Locations.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }
}
