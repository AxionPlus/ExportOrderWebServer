@page "/user/{UserName}"
@attribute [Authorize(Roles = "Admin, Top Manager")]

@using Microsoft.AspNetCore.Identity;
@inject ISnackbar Snackbar
@inject IUserProvider _userProvider
@inject UserManager<ApplicationUser> _userManager

<PageTitle>User</PageTitle>

<style>
    .Container-item > .container-content{
        justify-content: flex-start;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Small">
    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">
            <ShowMainMenuButton Class="ToolBar-IconButton" ExitHref="/users" />
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Refresh" OnClick="GetUser" />
            </div>
            <MudSpacer />
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
            </div>
        </MudToolBar>
    </div>

    <div class="Container-item">
        @if (User is not null)
        {
            <div class="container-content">
                <h4>@User.UserName</h4>
            </div>
            <div class="container-content">
                <div class="FieldContainer" style="width: 300px; margin-inline: 20px;">
                    <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="SelectedRoles"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Label="Roles">
                        @if (Roles is not null)
                            @foreach (var role in Roles)
                            {
                                <MudSelectItem T="string" Value="@role"></MudSelectItem>
                            }
                    </MudSelect>
                </div>
                <MudButton Class="Button" Style="max-width: 100px" OnClick="SaveRoles"
                           Variant="Variant.Filled" Color="Color.Secondary">Save</MudButton>
            </div>
            <div class="container-content">
                <MudChipSet T="IEnumerable<string>" Style="margin-left: 20px">
                    @if (Roles is not null)
                        @foreach (string value in SelectedRoles)
                        {
                            <MudChip T="string" Text="@value"></MudChip>
                        }
                </MudChipSet>
            </div>
        }
    </div>
</MudContainer>


@code {

    [Parameter]
    public string? UserName { get; set; }

    private ApplicationUser User { get; set; }

    private IEnumerable<string> Roles { get; set; }

    private IEnumerable<string> SelectedRoles = new List<string>();


    protected override async Task OnInitializedAsync()
    {
        await GetUser();
        Roles = await _userProvider.GetRolesAsync();
    }

    private async Task GetUser()
    {
        if (!string.IsNullOrWhiteSpace(UserName))
        {
            User = await _userProvider.GetUserAsync(UserName);
            SelectedRoles = await _userManager.GetRolesAsync(User);
        }
    }

    public async Task SaveRoles()
    {
        await _userProvider.RolesToUserAsync(User, SelectedRoles);

        //await GetUser();

        Snackbar.Add($"User saved successfully", Severity.Success);
    }

}
