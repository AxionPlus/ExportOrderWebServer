@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IVesselProvider _vesselProvider


<div class="Container-item">
    <div class="container-content">
        <MudAutocomplete Class="Autocomplete" T="string" Label="IMO no" Style="width: 140px" SearchFunc="@SearchIMO"
                        Value="Filter.IMO" Dense="true"
                        ValueChanged="(e)=> { Filter.IMO = e; }"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        CloseIcon="" OpenIcon=""
                        ResetValueOnEmptyText="true" Clearable />
            
        <div style="width: 50px"></div>
        <MudAutocomplete Class="Autocomplete" T="string" Label="Name" Style="width: 400px; text-align:center" SearchFunc="@SearchVessel"
                        Value="Filter.Name"
                        ValueChanged="(e)=> { Filter.Name = e; } "
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        CloseIcon="" OpenIcon=""
                        ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudButton Class="Button" Style="max-width: 80px; align-items:end" Disabled="@IsLoadingData"
                Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary"
                OnClick="@(async () => { await GetItems(); })">
            Search
        </MudButton>
        </div>
    </div> 

<div class="Container-table">
    @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }

    <MudTable Class="Table" @ref="mudTable" Items="@Items" Loading="IsLoadingData" Virtualize="true" RowsPerPage="20">

        <HeaderContent>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:360px">
                <MudTableSortLabel SortBy="new Func<VesselEntity, object>(x=>x.Name!)">Name</MudTableSortLabel>
            </MudTh>            
            <MudTh Style="width:100px">IMO number</MudTh>
            <MudTh Style="width:240px">Flag</MudTh>
            <MudTh Style="width:100px">Terrminal id</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.Id); })"></MudIconButton></MudTd>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async()=>{ await RemoveItem_Click(context.Name!, context.Id); })"></MudIconButton></MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.IMO</MudTd>
            <MudTd>@context.Flag!.RUS</MudTd>
            <MudTd>@context.TerminalCode</MudTd>
            <MudTd></MudTd>
        </RowTemplate>

        <PagerContent></PagerContent>

    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudTable<VesselEntity>? mudTable;

    private IEnumerable<VesselEntity>? Items { get; set; } = new List<VesselEntity>();
    private FilterParameters Filter { get; set; } = new();

    private bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _vesselProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<VesselEntity>)response.Object!).ToArray();

        await Task.Delay(500);

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);        
    }

    private async Task ShowItem_Click(long Id)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["Id"] = Id };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<Vessel_ItemDialog>("Vessel", parameters, options);

        DialogResult result = await dialog.Result;

        if (result.Canceled)
            await GetItems();
    }

    private async Task RemoveItem_Click(string name, long id)
    {
        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE  Record",
                          (MarkupString)$"<b>Do you want to remove record?</b> <br/>Vessel:<br/>{name}<br/>",
                          yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _vesselProvider.RemoveItemAsync(id);

                if (!response.HasError)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);
            }

        await GetItems();
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchVessel(string value)
    {
        var result = await _vesselProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchIMO(string value)
    {
        var result = await _vesselProvider.GetIMOnos();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
