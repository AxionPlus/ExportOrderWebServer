@code {
    private MudForm? FilterForm;
    private MudTable<VesselEntity>? mudTable;

    private IEnumerable<VesselEntity>? Items { get; set; } = new List<VesselEntity>();
    private FilterParameters Filter { get; set; } = new();

    bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    private async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _vesselProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<VesselEntity>)response.Object!).ToArray();

        await Task.Delay(500);

        await InvokeAsync(StateHasChanged);

        IsLoadingData = false;
    }

    private async Task SearchItems_Click()
    {


    }

}
