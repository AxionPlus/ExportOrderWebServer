@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IVesselProvider _vesselProvider

<style>
</style>

<MudForm @ref="@FilterForm">
    <div class="Container-item">
        <div class="container-content">
            <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData"
                       Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="@(async () => { await AddItem_Click(); })">Add New</MudButton>
            <MudSpacer />
            <MudAutocomplete Class="Autocomplete" T="string" Label="Name" Style="width: 400px" SearchFunc="@SearchNames"
                             Value="Filter.Name"
                             ValueChanged="(e)=> { Filter.Name = e; }"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             CloseIcon="" OpenIcon=""
                             ResetValueOnEmptyText="true" Clearable />
             <MudSpacer />
             <MudAutocomplete Class="Autocomplete" T="string" Label="IMO no" Style="width: 140px" SearchFunc="@SearchIMO"
                              Value="Filter.IMO"
                              ValueChanged="(e)=> { Filter.IMO = e; }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              CloseIcon="" OpenIcon=""
                              ResetValueOnEmptyText="true" Clearable />
             <MudSpacer />
             <MudButton Class="Button" Style="max-width: 100px" Disabled="@IsLoadingData"
                        Variant="Variant.Filled" Color="Color.Secondary"
                        OnClick="@(async () => { await GetItems(); })">Search</MudButton>
         </div>
     </div>
 </MudForm>

 <div class="Container-table">
     @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }

    <MudTable Class="Table" @ref="mudTable" Items="@Items" T="VesselEntity" Context="vessel"
              Loading="IsLoadingData" Virtualize="true" RowsPerPage="20">

        <HeaderContent>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:30px"></MudTh>
            <MudTh Style="width:400px">
                <MudTableSortLabel SortBy="new Func<VesselEntity, object>(x=>x.Name!)">Name</MudTableSortLabel>
            </MudTh>
            <MudTh></MudTh>
            <MudTh Style="width:100px">
                <MudTableSortLabel SortBy="new Func<VesselEntity, object>(x=>x.IMO!)">IMO number</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:200px">
                <MudTableSortLabel SortBy="new Func<CountryCatalog, object>(x=>x.RUS)">Flag</MudTableSortLabel>
            </MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(vessel.Id); })"></MudIconButton></MudTd>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async()=>{ await RemoveItem_Click(vessel); })"></MudIconButton></MudTd>
            <MudTd>@vessel.Name</MudTd>
            <MudTd></MudTd>
            <MudTd>@vessel.IMO</MudTd>
            <MudTd>@vessel.Flag.RUS</MudTd>            
        </RowTemplate>

        <PagerContent></PagerContent>

    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudForm? FilterForm;
    private MudTable<VesselEntity>? mudTable;

    private IEnumerable<VesselEntity>? Items { get; set; } = new List<VesselEntity>();
    private FilterParameters Filter { get; set; } = new();

    bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    private async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _vesselProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<VesselEntity>)response.Object!).ToArray();

        await Task.Delay(500);

        await InvokeAsync(StateHasChanged);

        IsLoadingData = false;
    }

    private async Task ShowItem_Click(long Id)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["Id"] = Id };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<VesselItem_Dialog>("Vessel", parameters, options);

        DialogResult result = await dialog.Result;
    }

    private async Task AddItem_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<VesselItem_Dialog>("New Vessel", parameters, options);

        DialogResult result = await dialog.Result;

        if (result.Canceled)
            if (Items!.Count() > 0)
                await GetItems();
    }

    private async Task RemoveItem_Click(VesselEntity item)
    {
        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE  Record",
                          (MarkupString)$"<b>Do you want to remove record?</b> <br/>Vessel:<br/>{item.Name}<br/>",
                          yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _vesselProvider.RemoveItemAsync(item);

                if (!response.HasError)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);
            }

        await GetItems();
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchNames(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _vesselProvider.GetNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchIMO(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _vesselProvider.GetIMOnos();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
