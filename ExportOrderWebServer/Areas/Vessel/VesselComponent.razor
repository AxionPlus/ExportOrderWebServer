@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IVesselProvider _vesselProvider

<div class="Container-item">
    <div class="container-content">
        <MudAutocomplete Class="Autocomplete" T="string" Label="IMO no" Style="width: 140px" @bind-Value="Filter.IMO" SearchFunc="@SearchVesselIMO"                        
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon=""
                         ResetValueOnEmptyText="true" Clearable />            
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Label="Name" Style="width: 400px; text-align:center" @bind-Value="Filter.Name" SearchFunc="@SearchVessel"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        CloseIcon="" OpenIcon=""
                        ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudButton Class="Button" Style="max-width: 80px; align-items:end" Disabled="@IsLoadingData" OnClick="@GetItems"
                   Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary" >
            Search
        </MudButton>
    </div>
</div> 

<div class="Container-table">
    <div class="tableMenu">
        <MudSpacer />
        <TablePager T="VesselEntity" Table="mudTable" ItemsCount="@Items?.Count()" />
    </div>
    <MudTable Class="Table P4" @ref="mudTable" Items="@Items" Loading="IsLoadingData" Virtualize="true" RowsPerPage="20">
        <HeaderContent>
            <MudTh Style="width:35px"></MudTh>
            <MudTh Style="width:360px">
                <MudTableSortLabel SortBy="new Func<VesselEntity, object>(x=>x.Name!)">Name</MudTableSortLabel>
            </MudTh>            
            <MudTh Style="width:100px">IMO number</MudTh>
            <MudTh Style="width:240px">Flag</MudTh>
            <MudTh Style="width:100px">Terrminal id</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.Id); })"></MudIconButton></MudTd>            
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.IMO</MudTd>
            <MudTd>@context.Flag?.RUS</MudTd>
            <MudTd>@context.TerminalCode</MudTd>            
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async () => { await RemoveItem_Click(context.Id, context.Name); })" /></MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    [Parameter]
    public string? ApplicationUser { get; set; }
    private MudTable<VesselEntity> mudTable = new();

    private IEnumerable<VesselEntity> Items { get; set; } = new List<VesselEntity>();
    private FilterParameters Filter { get; set; } = new();

    private bool IsLoadingData = false;

    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _vesselProvider.GetItemsAsync(Filter);
        if (!response.HasErrors && response.Object is not null)
            Items = (IEnumerable<VesselEntity>)response.Object;

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);        
    }

    private async Task ShowItem_Click(long Id)
    {
        var parameters = new DialogParameters { ["Id"] = Id };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Vessel_ItemDialog>(null, parameters, options);

        var result = await dialog.Result;

        if (result != null && result.Data != null && (bool)result.Data == true)
            await GetItems();
    }

    private async Task RemoveItem_Click(long id, string? name)
    {
        bool? msgResult = await DialogService.ShowMessageBoxAsync(
            "REMOVE",
            (MarkupString)$"<b>Do you want to remove record?</b> <br/>Vessel: {name}<br/>",
            yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                IsLoadingData = true;
                var response = await _vesselProvider.RemoveItemAsync(id, ApplicationUser);
                IsLoadingData = false;

                if (response.HasErrors)
                    Snackbar.Add($"Unable to delete", Severity.Warning);
                else
                {
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                    await GetItems();
                }
            }
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchVessel(string value, CancellationToken token)
    {
        var result = await _vesselProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchVesselIMO(string value, CancellationToken token)
    {
        var result = await _vesselProvider.GetIMOnos();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
