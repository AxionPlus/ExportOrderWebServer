@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider authenticationStateProvider
@inject IVesselProvider _vesselProvider
@inject ICountryProvider _countryProvider

<style>
/*     .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-inline-end: 4px;
        padding-right: 4px;
    } */
</style>

<MudForm @ref="@Form" Style="max-width:fit-content">
    <DialogToolBar ToolBarTitle="Vessel" SaveButtonDisabled="IsLoadingData" SaveItem="@SaveItem_Click"
                   CloseDialog="@(() => MudDialog?.Close(DialogResult.Ok(IsDialogResultOk)))"></DialogToolBar>
    <div class="Container-item">
        <div class="container-head"></div>
        <div class="container-content">
            <MudTextField Class="TextField" T="string" Style="width: 360px" Label="Name" Value="@Item.Name"
                          ValueChanged="async (e)=> { Item.Name = e.ToUpper(); }"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" AutoFocus="true"
                          Required RequiredError="" Clearable />
         </div>
        <div class="container-content" style="justify-content: flex-start">
            <MudAutocomplete Class="Autocomplete" T="CountryCatalog" Style="width: 280px; margin-right:10px" Label="Flag" @bind-Value="Item.Flag"
                             ToStringFunc="@(e => e != null ? e.RUS : "")"
                             SearchFunc="@SearchCountry"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Required RequiredError="" Clearable
                             CloseIcon="" OpenIcon="" IconSize="Size.Small"
                             ResetValueOnEmptyText="true"                             
                             MaxItems="20"/>
            <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Style="padding: 8px" Size="Size.Small" Color="Color.Primary" OnClick="@AddFlag_Click" />
        </div>
        <div class="container-content" style="justify-content: flex-start">
            <MudTextField Class="TextField" T="string" Style="width: 130px; margin-right: 20px" Label="IMO no" @bind-Text="@Item.IMO"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" MaxLength="10"
                          Required RequiredError="" Clearable />
            <MudTextField Class="TextField" T="string" Style="width: 130px" Label="Terminal code" @bind-Text="@Item.TerminalCode"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true"
                          Required RequiredError="" Clearable />
        </div>
        <div class="container-content">
            <MudTextField Class="TextField" T="string" Style="width: 280px" Label="Captain's Family" @bind-Text="@Item.CaptainFamily"
                          Placeholder="Фамилия"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Clearable />
        </div>
        <div class="container-content">
            <MudTextField Class="TextField" T="string" Style="width: 360px" Label="Captain's Name" @bind-Text="@Item.CaptainName"
                          Placeholder="Имя Отчество"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Clearable />
        </div>
    </div>
</MudForm>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private string? ApplicationUser { get; set; }
    private MudForm? Form { get; set; }
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    private bool IsDialogResultOk { get; set; } = false;

    [Parameter]
    public long Id { get; set; }

    private VesselEntity Item { get; set; } = new();
    private bool IsLoadingData { get; set; } = false;


    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        ApplicationUser = authState.User.Identity?.Name;
        await GetItem();
    }

    private async Task GetItem()
    {
        if (Id == 0) return;

        IsLoadingData = true;

        var response = await _vesselProvider.GetItemAsync(Id);
        if (!response.HasErrors && response.Object is not null)
            Item = (VesselEntity)response.Object;

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    public async Task SaveItem_Click()
    {
        if (Item is null || Form is null) return;

        await Form.Validate();

        if (!Form.IsValid) return;

        IsLoadingData = true;

        AppObjectResponse appObjectResponse = new();

        if (Id == 0)
            appObjectResponse = await _vesselProvider.NewItemAsync(Item, ApplicationUser);
        else
            appObjectResponse = await _vesselProvider.ModifyItemAsync(Item, ApplicationUser);

        if (appObjectResponse.HasErrors)
            Snackbar.Add(appObjectResponse.Errors.Last(), Severity.Warning); 
        else
        {
            Id = Item.Id;
            IsDialogResultOk = true;
            Snackbar.Add("Saved Successfully", Severity.Success);
        }

        IsLoadingData = false;
        
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddFlag_Click()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Country_ItemDialog>(null, parameters, options);
    }

    private async Task<IEnumerable<CountryCatalog>> SearchCountry(string value, CancellationToken token)
    {
        IEnumerable<CountryCatalog> Countries = new List<CountryCatalog>();

        var response = await _countryProvider.GetItemsAsync();

        if (!response.HasErrors && response.Object != null)
            Countries = (IEnumerable<CountryCatalog>)response.Object;

        if (string.IsNullOrWhiteSpace(value))
            return Countries.OrderBy(s => s.RUS).ToList();

        return Countries.Where(x => x.RUS.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
