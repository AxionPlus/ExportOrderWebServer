@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider authenticationStateProvider
@inject IVesselProvider _vesselProvider
@inject ICountryProvider _countryProvider

<style>
    .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-inline-end: 4px;
        padding-right: 4px;
    }
</style>

@if (Item is not null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content">
        <div class="ToolBar-container">
            <MudToolBar Class="ToolBar ToolBar-new">                
                <MudSpacer />
                <div class="ToolBar-iconbutton" style="margin-right: 20px">
                    <MudTooltip Text="Save">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" Disabled="IsLoadingData" OnClick="SaveItem_Click" />
                    </MudTooltip>
                </div>
            </MudToolBar>
        </div>
        <div class="Container-item">
            <div class="container-head"></div>
            <div class="container-content">
                <MudTextField T="string" Style="width: 360px" Label="Name" Text="@Item.Name"
                              TextChanged="async (e)=> { Item.Name = e.ToUpper(); }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" AutoFocus="true"
                              Required RequiredError="" Clearable />
             </div>
            <div class="container-content" style="justify-content: flex-start">
                <MudAutocomplete T="CountryCatalog" Style="width: 280px; margin-right:10px" Label="Flag" @bind-Value="Item.Flag"
                                 ToStringFunc="@(e => e != null ? e.RUS : "")"
                                 SearchFunc="@SearchCountry"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Required RequiredError="" Clearable
                                 CloseIcon="" OpenIcon="" IconSize="Size.Small"
                                 ResetValueOnEmptyText="true"
                                 Placeholder="Flag"
                                 MaxItems="20"                                 
                                 AdornmentIcon="@Icons.Material.Filled.AddCircle"
                                 AdornmentColor="Color.Primary"
                                 Adornment="Adornment.End"
                                 OnAdornmentClick="@( async ()=> { if (!IsLoadingData) await AddFlag_Click(); })" />
            </div>
            <div class="container-content" style="justify-content: flex-start">
                <MudTextField T="string" Style="width: 130px; margin-right: 20px" Label="IMO no" @bind-Text="@Item.IMO"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" MaxLength="10"
                              Required RequiredError="" Clearable />
                <MudTextField T="string" Style="width: 130px" Label="Terminal code" @bind-Text="@Item.TerminalCode"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"
                              Required RequiredError="" Clearable />
            </div>
            <div class="container-content">
                <MudTextField T="string" Style="width: 280px" Label="Captain's Family" @bind-Text="@Item.CaptainFamily"
                              Placeholder="Фамилия"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Clearable />
            </div>
            <div class="container-content">
                <MudTextField T="string" Style="width: 360px" Label="Captain's Name" @bind-Text="@Item.CaptainName"
                              Placeholder="Имя Отчество"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Clearable />
            </div>
        </div>
    </MudForm>
}

@code {
    private string? ApplicationUser { get; set; }
    private MudForm? Form { get; set; }
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = new();

    [Parameter]
    public long Id { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private VesselEntity? Item { get; set; }
    private bool IsLoadingData { get; set; } = false;


    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        ApplicationUser = authState.User.Identity?.Name;
        await GetItem();
    }

    private async Task GetItem()
    {
        if (IsNewItem)
            Item = new();
        else
        {
            var response = await _vesselProvider.GetItemAsync(Id);
            if (!response.HasErrors && response.Object is not null)
                Item = (VesselEntity)response.Object;
        }
    }

    public async Task SaveItem_Click()
    {
        if (Item is null || Form is null) return;

        await Form.Validate();

        if (Form.IsValid)
        {
            IsLoadingData = true;

            AppObjectResponse appObjectResponse = new();

            if (IsNewItem)
                appObjectResponse = await _vesselProvider.NewItemAsync(Item, ApplicationUser);
            else
                appObjectResponse = await _vesselProvider.ModifyItemAsync(Item, ApplicationUser);

            if (!appObjectResponse.HasErrors)
                Snackbar.Add("Save Successed", Severity.Success);
            else
                Snackbar.Add(appObjectResponse.Errors.Last(), Severity.Error);

            IsNewItem = false;
            Id = Item.Id;

            IsLoadingData = false;
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private async Task AddFlag_Click()
    {
        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Country_ItemDialog>("New Country", parameters, options);
    }

    private async Task<IEnumerable<CountryCatalog>> SearchCountry(string value, CancellationToken token)
    {
        var Countries = new List<CountryCatalog>();

        var response = await _countryProvider.GetItemsAsync();
        if (!response.HasErrors)
            Countries = ((IEnumerable<CountryCatalog>)response.Object!).OrderBy(s => s.RUS).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Countries;

        return Countries.Where(x => x.RUS.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }
}
