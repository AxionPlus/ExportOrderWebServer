@inject ISnackbar Snackbar

@inject IVesselProvider _vesselProvider
@inject ITerminalProvider _terminalProvider
@inject ILocationProvider _locationProvider


<div class="Container-item" style="width: 760px">
    <div class="container-content">
        <MudAutocomplete Class="Autocomplete" T="VesselEntity" Label="Vessel" Style="width: 300px" @bind-Value="Value!.Vessel"
                         ToStringFunc="@(e => e != null ? e.Name : "")"
                         SearchFunc="@SearchVessel"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Required RequiredError=""
                          CloseIcon="" OpenIcon=""
                          ResetValueOnEmptyText="true"
                          MaxItems="20"
                          IconSize="Size.Small"
                          ReadOnly="!IsNewItem" Clearable="IsNewItem" />
         <MudSpacer />
         <MudTextField T="string" Style="width: 300px;" Label="Voyage Carrier" Text="@Value.VoyageNo"
                       TextChanged="async (e)=> { Value.VoyageNo = e.ToUpper(); }"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Immediate="true"
                                Required RequiredError=""
                       ReadOnly="!IsNewItem" Clearable="IsNewItem" />
         <MudSpacer />
         <MudTextField T="string" Style="width: 300px" Label="Voyage Terminal" Text="@Value.VoyageNoTerminal"
                       TextChanged="async (e)=> { Value.VoyageNoTerminal = e.ToUpper(); }"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Immediate="true"
                                Required RequiredError=""
                       ReadOnly="!IsNewItem" Clearable="IsNewItem" />
         <MudSpacer />
         <MudAutocomplete Class="Autocomplete" T="TerminalCatalog" Style="width: 300px" Label="Loading Terminal" @bind-Value="Value.Terminal"
                          ToStringFunc="@(e => e != null ? e.Name : "")"
                          SearchFunc="@SearchTerminal"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Required RequiredError=""
                          CloseIcon="" OpenIcon=""
                          ResetValueOnEmptyText="true"
                          MaxItems="20"
                          IconSize="Size.Small"
                          ReadOnly="!IsNewItem" Clearable="IsNewItem" />
         <MudSpacer />
    </div>

    <div class="container-content">
        <MudDatePicker Class="wrapper-input-date" Label="ETA" @bind-Date="Value.ETA"
                       Style="width: 148px; height: 40px; margin-right: 2px"
                       DateFormat="dd.MM.yy"
                       ShowWeekNumbers="true"
                       Variant="Variant.Outlined"
                       IconSize=Size.Small
                       AutoClose=true
                       DisableToolbar=false
                       Required
                       ReadOnly="!IsNewItem"
                       Clearable />
        <MudDatePicker Class="wrapper-input-date" Label="ETS" @bind-Date="Value.ETS"
                       Style="width: 148px; height: 40px; margin-left: 2px"
                       DateFormat="dd.MM.yy"
                       ShowWeekNumbers="true"
                       Variant="Variant.Outlined"
                       IconSize=Size.Small
                       AutoClose=true
                       DisableToolbar=false
                       Required
                       ReadOnly="!IsNewItem"
                       Clearable />         
    </div>

    <div class="Container-table">
         <MudTable Class="Table" Items="@Value.Details" Loading="IsLoadingData">
             <HeaderContent>
                 <MudTh Style="width:30px">
                     <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddDetailItem" Disabled="@IsLoadingData" />
                 </MudTh>
                 <MudTh Style="width: 300px">PORT</MudTh>
                 <MudTh Style="width: 300px">Agent</MudTh>
             </HeaderContent>
             <RowTemplate>
                 <MudTd>
                     <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="@Color.Error" Href=@($"/container/") Disabled="@IsLoadingData" />
                 </MudTd>
                 <MudTd DataLabel="Port">
                     <MudAutocomplete Class="Autocomplete" T="LocationCatalog" Style="width: 300px" Label="Port of Discharge" @bind-Value="context.POD"
                                      ToStringFunc="@(e => e != null ? e.Name : "")"
                                      SearchFunc="@SearchPOD"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Required RequiredError=""
                                      CloseIcon="" OpenIcon=""
                                      ResetValueOnEmptyText="true"
                                      MaxItems="20"
                                      IconSize="Size.Small"
                                      ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                 </MudTd>
                 <MudTd DataLabel="Agent">
                     <MudTextField T="string" Style="width: 300px;" Label="POD Agent" Text="@context.AgentPOD"
                                   TextChanged="async (e)=> { context.AgentPOD = e.ToUpper(); }"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Immediate="true"
                                   Required RequiredError=""
                                   ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                 </MudTd>
             </RowTemplate>
         </MudTable>
     </div>


