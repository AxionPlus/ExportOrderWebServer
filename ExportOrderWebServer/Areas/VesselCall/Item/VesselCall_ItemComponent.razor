@inject ISnackbar Snackbar
@inject IVesselProvider _vesselProvider
@inject ITerminalProvider _terminalProvider
@inject ILocationProvider _locationProvider


<div class="Container-item">

        <div class="container-content">
            <MudAutocomplete Class="Autocomplete" T="VesselEntity" Label="Vessel" Style="width: 300px" @bind-Value="Value!.Vessel"
                             ToStringFunc="@(e => e != null ? e.Name : "")"
                             SearchFunc="@SearchVessel"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Required RequiredError=""
                             CloseIcon="" OpenIcon=""
                             ResetValueOnEmptyText="true"
                             MaxItems="20"
                             IconSize="Size.Small"
                             Clearable="!IsFormReadOnly" />
             <MudSpacer />
             <MudTextField T="string" Style="width: 300px;" Label="Voyage Carrier" Text="@Value.VoyageNo"
                           TextChanged="async (e)=> { Value.VoyageNo = e.ToUpper(); }"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Immediate="true"
                           Required RequiredError=""
                           Clearable="!IsFormReadOnly" />
        </div>

        <div class="container-content">
             <MudAutocomplete Class="Autocomplete" T="TerminalCatalog" Style="width: 300px" Label="Load Terminal" @bind-Value="Value.Terminal"
                              ToStringFunc="@(e => e != null ? e.Name : "")"
                              SearchFunc="@SearchTerminal"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Required RequiredError=""
                              CloseIcon="" OpenIcon=""
                              ResetValueOnEmptyText="true"
                              MaxItems="20"
                              IconSize="Size.Small"
                              Clearable="!IsFormReadOnly" />
             <MudSpacer />
             <MudDatePicker Class="wrapper-input-date" Label="ETA" @bind-Date="Value.ETA"
                            Style="width: 148px; height: 40px; margin-right: 2px"
                            DateFormat="dd.MM.yy"
                            ShowWeekNumbers="true"
                            Variant="Variant.Outlined"
                            IconSize=Size.Small
                            AutoClose=true
                            DisableToolbar=false
                            Required
                            Clearable="!IsFormReadOnly" />
             <MudDatePicker Class="wrapper-input-date" Label="ETS" @bind-Date="Value.ETS"
                            Style="width: 148px; height: 40px; margin-left: 2px"
                            DateFormat="dd.MM.yy"
                            ShowWeekNumbers="true"
                            Variant="Variant.Outlined"
                            IconSize=Size.Small
                            AutoClose=true
                            DisableToolbar=false
                            Required
                            Clearable="!IsFormReadOnly" />
        </div>

         @if (Value.Details != null)
         {
             <div class="Container-table">
                @if (mudTable != null)
                {
                    <div class="tableMenu">
                        <MudSpacer />
                        <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
                        <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Value.Details!.Count())</span>
                    </div>
                }
                <MudTable Class="Table" @ref="mudTable" Items="@Value.Details" Loading="IsLoadingData">
                    <HeaderContent>
                        <MudTh Style="width:30px">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddDetailItem" Disabled="@IsLoadingData" />
                        </MudTh>
                        <MudTh Style="width: 300px">PORT</MudTh>
                        <MudTh Style="width: 300px">Agent</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="@Color.Error" OnClick="@(async () => { await RemoveDetail_Click(context); })"
                                           Disabled="@IsLoadingData" />
                        </MudTd>
                        <MudTd DataLabel="Port">
                            <MudAutocomplete Class="Autocomplete" T="LocationCatalog" Style="width: 300px" Label="Port of Discharge" @bind-Value="context.POD"
                                             ToStringFunc="@(e => e != null ? e.Name : "")"
                                             SearchFunc="@SearchPOD"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Required RequiredError=""
                                             CloseIcon="" OpenIcon=""
                                             ResetValueOnEmptyText="true"
                                             MaxItems="20"
                                             IconSize="Size.Small"
                                             Clearable="!IsFormReadOnly" />
                         </MudTd>
                         <MudTd DataLabel="Agent">
                             <MudTextField T="string" Style="width: 300px;" Label="POD Agent" Text="@context.AgentPOD"
                                           TextChanged="async (e)=> { context.AgentPOD = e.ToUpper(); }"
                                           Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Immediate="true"
                                           Required RequiredError=""
                                           Clearable="!IsFormReadOnly" />
                         </MudTd>
                     </RowTemplate>
                 </MudTable>
             </div>
         }  

    </div>

 @code {
    private MudForm? Form { get; set; }
    private MudTable<VesselCallDetail>? mudTable;

    [Parameter]
    public VesselCallEntity? Value { get; set; }
    [Parameter]
    public EventCallback<VesselCallEntity> ValueChanged { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; }
    [Parameter]
    public bool IsFormReadOnly { get; set; }

    bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    private void AddDetailItem()
    {
        Value!.Details.Add(new());
    }

    private async Task RemoveDetail_Click(VesselCallDetail item)
    {
        await Task.Delay(50);
        if (Value!.Details.Contains(item))
            Value.Details.Remove(item);
    }


    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<VesselEntity>> SearchVessel(string value)
    {
        var Vessels = new List<VesselEntity>();

        var response = await _vesselProvider.GetItemsAsync();
        if (!response.HasError)
            Vessels = ((IEnumerable<VesselEntity>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Vessels;

        return Vessels.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    private async Task<IEnumerable<TerminalCatalog>> SearchTerminal(string value)
    {
        var Terminals = new List<TerminalCatalog>();

        var response = await _terminalProvider.GetItemsAsync();
        if (!response.HasError)
            Terminals = ((IEnumerable<TerminalCatalog>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Terminals;

        return Terminals.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    private async Task<IEnumerable<LocationCatalog>> SearchPOD(string value)
    {
        var Ports = new List<LocationCatalog>();

        var response = await _locationProvider.GetItemsAsync();
        if (!response.HasError)
            Ports = ((IEnumerable<LocationCatalog>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Ports;

        return Ports.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    #endregion
}
