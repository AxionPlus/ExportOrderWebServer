@inject ISnackbar Snackbar
@inject IVesselCallProvider _vesselCallProvider

<MudContainer MaxWidth="MaxWidth.Large">

    <div class="ToolBar-container">
        <MudToolBar Class="ToolBar ToolBar-new">
            @if (MudDialog is not null)
            {
                <div class="ToolBar-iconbutton">
                    <MudTooltip Text="EXIT">
                        <MudIconButton Class="ToolBar-IconButton" Style="transform: rotate(180deg);" Icon="@Icons.Material.Outlined.ExitToApp" OnClick="CloseDialog_Click" />
                    </MudTooltip>
                </div>
            }
            @if (!IsNewItem)
            {
                <div class="ToolBar-iconbutton">
                    <MudTooltip Text="REFRESH" Delay="2000" Duration="1000">
                        <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Refresh" OnClick="GetItem" />
                    </MudTooltip>
                </div>
            }
            <MudSpacer />

            <div class="ToolBar-Title"><span>VESSEL CALL</span></div>
            <MudSpacer />

            <div class="ToolBar-iconbutton" style="margin-right: 20px">
                <MudTooltip Text="SAVE" Delay="2000" Duration="1000">
                    <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" OnClick="SaveItem" Disabled="@IsLoadingData" />
                </MudTooltip>
            </div>            
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PushPin" />
            </div>
            <div class="ToolBar-iconbutton">
                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.PeopleAlt" />
            </div>
        </MudToolBar>
    </div>
    @if (Item is not null)
    {
        <MudForm @ref="Form">
            <VesselCall_ItemComponent @bind-Value="@Item" IsNewItem="@IsNewItem" />
        </MudForm>
    }
    <OverlayLoadingData Visible="@(IsLoadingData|| Item is null)" />
</MudContainer>

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    private MudForm? Form { get; set; }

    bool IsLoadingData = false;

    private VesselCallEntity? Item { get; set; }

    [Parameter]
    public string? Voyage { get; set; }     //   VesselNam + & + Voyage
    [Parameter]
    public bool IsNewItem { get; set; } = false;


    protected override async Task OnInitializedAsync()
    {
        await GetItem();
    }

    private async Task GetItem()
    {
        IsLoadingData = true;

        if (IsNewItem)
            Item = new();
        else
        {
            var response = await _vesselCallProvider.GetItemAsync(Voyage!);
            if (!response.HasError)
                Item = (VesselCallEntity)response.Object!;
            else
                Snackbar.Add($"{response.Error.First()}", Severity.Error);

            //await GetVesselCallCarriersAsync
        }

        await Task.Delay(1000);
        IsLoadingData = false;
    }

    public async Task SaveItem()
    {
        IsLoadingData = true;
        await Form!.Validate();

        if (Form.IsValid)
            if (IsNewItem)
            {
                await _vesselCallProvider.NewItemAsync(Item!);

                Voyage = $"{Item!.Vessel?.Name}&{Item.VoyageNo}";

                await GetItem();
                Snackbar.Add("Save Successed", Severity.Success);
            }
            else
            {
                // var result = await _vesselCallProvider.ModifyItemAsync(Item);
                // if (!result.HasError)
                // {
                //     Voyage = $"{Item.Vessel?.Name}&{Item.VoyageNo}";
                //     await GetItem();

                //     Snackbar.Add("Save Successed", Severity.Success);
                // }
                // else
                //     Snackbar.Add($"{result.Error.First()}", Severity.Error);

            }

        IsNewItem = false;
        await Task.Delay(1500);
        IsLoadingData = false;
    }

    public async Task CloseDialog_Click()
    {
        await Task.Delay(50);
        MudDialog!.Close();
    }
}
