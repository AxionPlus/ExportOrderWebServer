@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider authenticationStateProvider
@inject IVesselCallProvider _vesselCallProvider
@inject IVesselProvider _vesselProvider
@inject ITerminalProvider _terminalProvider
@inject ILocationProvider _locationProvider

<style>

    .VesseCall_Port * .mud-input > input.mud-input-root-outlined {
        text-align: start;
    }

    .container-content * .mud-input > input.mud-input-root-outlined.mud-input-root-margin-dense {
        padding: 6px;
        padding-inline-start: 8px;
    }

    .mud-input > input.mud-input-root-outlined.mud-input-root-adorned-end {
        padding-inline-start: 8px;
    }

    .mud-input-control.mud-input-control-margin-dense.mud-input-outlined-with-label {
        margin-top: unset;
        margin-bottom: unset;
    }

    .mud-select.mud-autocomplete * .mud-icon-button-size-small.mud-icon-button-edge-end {
        margin-right: 0px;
        margin-inline-end: 3px;        
    }

    .mud-select.mud-autocomplete * .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-right: unset;
        padding-inline-end: unset;
        padding-inline-start: unset;
    }

    .mud-select.mud-autocomplete * .mud-icon-button-size-small.mud-icon-button-edge-end {
        margin-inline-end: unset;
    }    

    .Table * .mud-table-cell {
        padding: 5px;
    }

</style>

@if (Item is not null)
{
    <MudForm @ref="@Form" ReadOnly="IsFormReadOnly">

        <div class="ToolBar-container">
            <MudToolBar Class="ToolBar ToolBar-new">
                <MudSpacer />
                <div class="ToolBar-iconbutton" style="margin-right: 20px">
                        <MudTooltip Text="@(IsFormReadOnly ? "Edit" : "Save" )">
                            @if (IsFormReadOnly)
                            {
                                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Edit" Disabled="!IsFormReadOnly" OnClick="EditItem_Click" />
                            }                                
                            else
                            {
                                <MudIconButton Class="ToolBar-IconButton" Icon="@Icons.Material.Outlined.Save" Disabled="IsFormReadOnly" OnClick="SaveItem_Click" />
                            }                            
                        </MudTooltip>
                </div>                
            </MudToolBar>
        </div>

        <div class="Container-item" style="flex-direction:column">
            <div class="container-content" style="justify-content:flex-start">
                <MudAutocomplete Class="Autocomplete" T="VesselEntity" Label="Vessel" Style="width: 300px; margin-right:20px" @bind-Value="Item.Vessel"
                                 ToStringFunc="@(e => e != null ? e.Name : "")"
                                 SearchFunc="@SearchVessel"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Required RequiredError=""
                                 CloseIcon="" OpenIcon="" IconSize="Size.Small"
                                 ResetValueOnEmptyText="true"
                                 MaxItems="20"                                  
                                 AdornmentIcon="@Icons.Material.Filled.AddCircle"
                                 AdornmentColor="Color.Primary"
                                 Adornment="Adornment.End"
                                 OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddVessel_Click(); })"
                                 Clearable="!IsFormReadOnly" />
                 <MudTextField Class="TextField" T="string" Style="width: 200px; margin-right:20px" Label="Voyage" Text="@Item.VoyageNo"
                               TextChanged="async (e)=> { Item.VoyageNo = e.ToUpper(); }"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Immediate="true"
                               Required RequiredError=""
                               Clearable="!IsFormReadOnly" />
                <div style="width:130px; height:35px; margin-right: 4px">
                    <MudDatePicker Class="wrapper-input-date" Label="ETA" @bind-Date="Item.ETA"
                                   DateFormat="dd.MM.yy"
                                   ShowWeekNumbers="true"
                                   Variant="Variant.Outlined"
                                   IconSize=Size.Small
                                   AutoClose=true
                                   Required RequiredError=""
                                   Clearable="!IsFormReadOnly" />
                 </div>                 

                <MudSpacer />
                <MudSelect Class="wrapper-input-select" Style="width:125px" T="EntityStatus" Label="Status" @bind-Value="Item.Status"
                            ToStringFunc="@(str => str.ToString())"
                            Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (EntityStatus status in Enum.GetValues(typeof(EntityStatus)))
                    {
                        if (status == EntityStatus.New || status == EntityStatus.Completed)
                        {
                            <MudSelectItem Value="@status" />
                        }
                    }
                </MudSelect>                 
            </div>

            <div class="container-content" style="justify-content:flex-start">
                 <MudAutocomplete Class="Autocomplete" T="TerminalCatalog" Style="width: 300px; margin-right:20px" Label="Load Terminal" @bind-Value="Item.Terminal"
                                  ToStringFunc="@(e => e != null ? e.Name : "")"
                                  SearchFunc="@SearchTerminal"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required RequiredError=""
                                  CloseIcon="" OpenIcon="" IconSize="Size.Small"
                                  ResetValueOnEmptyText="true"
                                  MaxItems="20"
                                  AdornmentIcon="@Icons.Material.Filled.AddCircle"
                                  AdornmentColor="Color.Primary"
                                  Adornment="Adornment.End"
                                  OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddTerminal_Click(); })"
                                  Clearable="!IsFormReadOnly" />

                 <MudTextField Class="TextField" T="string" Style="width: 200px; margin-right:20px" Label="Voyage Terminal" Text="@Item.VoyageNoTerminal"
                               TextChanged="async (e)=> { Item.VoyageNoTerminal = e.ToUpper(); }"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Immediate="true"
                                        Required RequiredError=""
                               Clearable="!IsFormReadOnly" />

                <div style="width:130px; height:35px">
                    <MudDatePicker Class="wrapper-input-date" Label="ETS" @bind-Date="Item.ETS"
                                DateFormat="dd.MM.yy"
                                ShowWeekNumbers="true"
                                Variant="Variant.Outlined"
                                IconSize=Size.Small
                                AutoClose=true
                                DisableToolbar=true
                                Required RequiredError=""
                                Clearable="!IsFormReadOnly" />
                </div>                 
            </div>

            <div class="Container-table">
                 <MudTable Class="Table" @ref="mudTable" Items="@Item.Details" Loading="IsLoadingData">
                     <HeaderContent>
                         <MudTh Style="width:35px">
                             <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddDetailItem" Disabled="@(IsLoadingData || IsFormReadOnly)" />
                         </MudTh>
                         <MudTh Style="width: 260px">PORT of discharge</MudTh>
                         <MudTh Style="width: 405px">Agent</MudTh>
                         <MudTh Style="width: 260px">FINAL Destination</MudTh>
                     </HeaderContent>
                     <RowTemplate>
                         <MudTd>
                             <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="@Color.Error" OnClick="@(async () => { await RemoveDetail_Click(context); })"
                                            Disabled="@IsFormReadOnly" />
                         </MudTd>
                         <MudTd DataLabel="Port">
                             <MudAutocomplete Class="VesseCall_Port" T="LocationCatalog" Style="width: 250px; text-align:start" @bind-Value="context.POD"
                                              ToStringFunc="@(e => e != null ? e.Name : "")"
                                              SearchFunc="@SearchPOD"
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Required RequiredError=""
                                              CloseIcon="" OpenIcon="" IconSize="Size.Small"
                                              ResetValueOnEmptyText="true"                               
                                              AdornmentIcon="@Icons.Material.Filled.AddCircle"
                                              AdornmentColor="Color.Primary"
                                              Adornment="Adornment.End"
                                              OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddPort_Click(); })"
                                              Clearable="!IsFormReadOnly" />
                         </MudTd>
                         <MudTd DataLabel="Agent">
                             <MudTextField T="string" Style="width: 395px;" Text="@context.AgentPOD"
                                           TextChanged="async (e)=> { context.AgentPOD = e.ToUpper(); }"
                                           Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Immediate="true"
                                           Required RequiredError=""
                                           Clearable="!IsFormReadOnly" />
                         </MudTd>
                         <MudTd DataLabel="Final">
                             <MudAutocomplete Class="VesseCall_Port" T="LocationCatalog" Style="width: 250px" @bind-Value="context.FinalDestination"
                                              ToStringFunc="@(e => e != null ? e.Name : "")"
                                              SearchFunc="@SearchPOD"
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              
                                              CloseIcon="" OpenIcon="" IconSize="Size.Small"
                                              ResetValueOnEmptyText="true"
                                              AdornmentIcon="@Icons.Material.Filled.AddCircle"
                                              AdornmentColor="Color.Primary"
                                              Adornment="Adornment.End"
                                              OnAdornmentClick="@( async ()=> { if (!IsFormReadOnly) await AddPort_Click(); })"
                                              Clearable="!IsFormReadOnly"
                                              Disabled="true" />
                         </MudTd>
                     </RowTemplate>
                 </MudTable>
             </div>
         </div>

    </MudForm>
}

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudForm? Form { get; set; }
    private MudTable<VesselCallDetail>? mudTable;

    [Parameter]
    public long Id { get; set; }
    [Parameter]
    public string? Voyage { get; set; }
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private VesselCallEntity? Item { get; set; }

    private bool IsLoadingData = false;
    private bool IsFormReadOnly { get; set; } = true;
    private bool IsRoleForEdit = false;
    private EntityStatus ItemStatus { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = await authenticationStateProvider.GetAuthenticationStateAsync();

        if (user.User.IsInRole("Admin") || user.User.IsInRole("Top Manager"))
            IsRoleForEdit = true;

        await GetItem();
    }

    private async Task GetItem()
    {
        if (IsNewItem)
        {
            Item = new() { Details = new List<VesselCallDetail>() { new() } };
            IsFormReadOnly = false;
        }        
        else
        {
            var response = await _vesselCallProvider.GetItemAsync(Id);

            if (!response.HasError)
                Item = (VesselCallEntity)response.Object!;
        }
    }

    public async Task SaveItem_Click()
    {
        IsLoadingData = true;
        await Form!.Validate();

        if (Form.IsValid)
        {
            if (!Item!.Details.Any())
            {
                Snackbar.Add("Fill up at least one Port of Discharge", Severity.Warning);
                IsLoadingData = false;
                return;
            }                

            if (IsNewItem)
            {
                if (Item!.Details.Any())
                {
                    await _vesselCallProvider.NewItemAsync(Item!);
                    Snackbar.Add("Saved Successfully", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Fill up at least one Port of Discharge", Severity.Warning);
                    return;
                }                
            }
            else
            {
                //if (ItemStatus == EntityStatus.Completed && !IsRoleForEdit)
                if (Item is not null && Item.Status == EntityStatus.Completed && !IsRoleForEdit)
                {
                    Snackbar.Add($"Voyage is Completed.<br>You can't change this Voyage.", Severity.Warning);
                    //IsFormReadOnly = true;
                    //IsLoadingData = false;
                }                    
                else
                {
                    var result = await _vesselCallProvider.ModifyItemAsync(Item!);
                    if (!result.HasError)
                        Snackbar.Add("Saved Successfully", Severity.Success);
                    else
                    {
                        Snackbar.Add($"{string.Join("; ", result.Error)}", Severity.Error);
                        //IsFormReadOnly = true;
                        //IsLoadingData = false;
                    }                        
                }
            }

            IsNewItem = false;
            IsFormReadOnly = true;

            // Id = Item!.Id;
            // await GetItem();

            await InvokeAsync(StateHasChanged);

            await Task.Delay(500);
            IsLoadingData = false;
        }
        else
        {
            Snackbar.Add("Fill up all reqired fields", Severity.Error);
            IsLoadingData = false;
        }            
    }

    private async Task EditItem_Click()
    {
        await Task.Delay(50);
        IsFormReadOnly = false;
    }

    private void AddDetailItem()
    {
        Item!.Details.Add(new());
    }

    private async Task RemoveDetail_Click(VesselCallDetail item)
    {
        await Task.Delay(50);

        //if (item is null) return;

        if (item.ExportOrders.Count() > 0)
        {
            string portName = item.POD is null ? string.Empty : (string.IsNullOrWhiteSpace(item.POD.Name) ? string.Empty : item.POD.Name);

            Snackbar.Add($"В этом рейсе есть поручения.<br>Чтобы удалить рейс, сначала удалите поручения для этого порта выгрузки:<br>{portName}", Severity.Warning);
            return;            
        }

        Item!.Details.Remove(item);

        // if (!Item.Details.Any())
        //     Item.Details.Add(new());
    }

    #region ADD from Catalog

    private async Task AddVessel_Click()
    {
        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Vessel_ItemDialog>("New Vessel", parameters, options);

        var result = await dialog.Result;
    }

    private async Task AddTerminal_Click()
    {
        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Terminal_ItemDialog>("New Terminal", parameters, options);

        var result = await dialog.Result;
    }

    private async Task AddPort_Click()
    {
        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<Location_ItemDialog>("New Location", parameters, options);

        var result = await dialog.Result;
    }

    # endregion

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<VesselEntity>> SearchVessel(string value, CancellationToken token)
    {
        var Vessels = new List<VesselEntity>();

        var response = await _vesselProvider.GetItemsAsync();
        if (!response.HasError)
            Vessels = ((IEnumerable<VesselEntity>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Vessels;

        return Vessels.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    private async Task<IEnumerable<TerminalCatalog>> SearchTerminal(string value, CancellationToken token)
    {
        var Terminals = new List<TerminalCatalog>();

        var response = await _terminalProvider.GetItemsAsync();
        if (!response.HasError)
            Terminals = ((IEnumerable<TerminalCatalog>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Terminals;

        return Terminals.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    private async Task<IEnumerable<LocationCatalog>> SearchPOD(string value, CancellationToken token)
    {
        var Ports = new List<LocationCatalog>();

        var response = await _locationProvider.GetItemsAsync();
        if (!response.HasError)
            Ports = ((IEnumerable<LocationCatalog>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Ports;

        return Ports.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    #endregion
}
