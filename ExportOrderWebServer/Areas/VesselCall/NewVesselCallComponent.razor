    #region Searchers

    private async Task<IEnumerable<LocationCatalog>> PortSearch(string value)
    {
        IEnumerable<LocationCatalog>? Terminals;
        try
        {
            Terminals = await Http.GetFromJsonAsync<IEnumerable<LocationCatalog>>("api/DictionaryData/Locations");
        }
        catch (Exception)
        {
            return Enumerable.Empty<LocationCatalog>();
        }
        //// if text is null or empty, don't return values (drop-down will not open)
        if (string.IsNullOrEmpty(value))
            return Enumerable.Empty<LocationCatalog>();
        return Terminals!.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase)).Take(5);
    }

