@if (VesselCallItem is not null)
{
    <MudContainer>
        <MudForm @ref="form">
            <MudAutocomplete Class="wrapper-input Vessel_filter pt-2" Label="Vessel"
                         T="VesselEntity" @bind-Value="@VesselCallItem.Vessel"
                         ToStringFunc="@(s=>s.Name)"
                         SearchFunc="@VesselSearch"
                         CloseIcon="" OpenIcon=""
                         MaxItems="5"
                         Variant="Variant.Outlined"
                         ResetValueOnEmptyText="true"
                                  Required RequiredError=""
                                  Clearable IconSize=Size.Small>
            </MudAutocomplete>
            <MudTextField Class="wrapper-input Voyage_filter pt-2"
                      @bind-Value="VesselCallItem.VoyageCarrier"
                      Label="Voyage Carrier"
                      Variant="Variant.Outlined"
                            Required RequiredError=""
                            Clearable></MudTextField>
            <MudTextField Class="wrapper-input Voyage_filter pt-2"
                      @bind-Value="VesselCallItem.VoyageTerminal"
                      Label="Voyage Terminal" Variant="Variant.Outlined"
                            Required RequiredError=""
                            Clearable></MudTextField>
            <MudAutocomplete Class="wrapper-input Terminal_filter pt-2" T="TerminalCatalog"
                         Label="Terminal" @bind-Value="@VesselCallItem.LoadingTerminal" SearchFunc="@TerminalSearch"
                         ToStringFunc="@(s=>s.Name)"
                         CloseIcon="" OpenIcon=""
                         MaxItems="5"
                         Variant="Variant.Outlined"
                         ResetValueOnEmptyText="true"
                                  Required RequiredError=""
                                  Clearable IconSize=Size.Small>
            </MudAutocomplete>
            <MudAutocomplete Class="wrapper-input POD_filter pt-2" T="LocationCatalog" Label="POD" @bind-Value="@VesselCallItem.POD" SearchFunc="@PortSearch"
                         ToStringFunc="@(s=>s.Name)"
                         CloseIcon="" OpenIcon=""
                         MaxItems="5"
                         Variant="Variant.Outlined"
                         ResetValueOnEmptyText="true"
                                  Required RequiredError=""
                                  Clearable IconSize=Size.Small>
            </MudAutocomplete>
            <MudDatePicker Class="wrapper-input-date pt-2" Label="ETA" ShowWeekNumbers="true" @bind-Date="@VesselCallItem.ETA" Variant="Variant.Outlined" />
            <MudDatePicker Class="wrapper-input-date pt-2" Label="ETS" ShowWeekNumbers="true" @bind-Date="@VesselCallItem.ETS" Variant="Variant.Outlined" />
            </MudForm>

            <div class="pt-3">
                <MudButton FullWidth Class="wrapper-button " Variant="Variant.Filled" Color="Color.Secondary"
                   OnClick="@(async()=>{ addBtnDisable = false;
                        await AddItem_Click();
                        await Task.Delay(1000);
                        addBtnDisable = true;
        })">Add</MudButton>
        </div>
        </MudContainer>
    <br />
}

