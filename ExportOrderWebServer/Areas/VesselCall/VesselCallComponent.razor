@using ExportOrderWebServer.Areas.VesselCall
@inject AuthenticationStateProvider authenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IVesselCallProvider _vesselCallProvider
@inject IExportOrderProvider_New ExportOrderProvider
@inject ICarrierProvider _carrierProvider

<style>
    .mud-input-control.mud-input-control-margin-dense {
        margin: unset;
    }

    .mud-input-control.mud-input-control-margin-dense.mud-input-outlined-with-label {
        margin-top: unset;
        margin-bottom: unset;
    }

    .mud-icon-button-edge-margin-end {
        margin-right: 2px;
        margin-inline-end: 2px;
        margin-inline-start: unset;
    }

    .mud-select.mud-autocomplete * .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-inline-end: 6px;
        padding-inline-start: unset;
    }

    .Container-table .tableMenu .mud-table-cell{
        padding:unset;
    }
 </style>

<Container>
    <MudGrid>
        <MudItem xs="2">
            <MudButton Variant="Variant.Filled" Style="margin-top:25px"
                       Color="Color.Primary"
                       OnClick="GetItems"
                       Disabled="IsLoading"
                       StartIcon="@Icons.Material.Filled.Search"
                       Size="Size.Small">
                @(IsLoading ? "Searching..." : "Search")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Style="margin-top:25px"
                       Color="Color.Secondary"
                       OnClick="ResetFilters"
                       Disabled="IsLoading"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Size="Size.Small">
                Reset
            </MudButton>
        </MudItem>
        <MudItem xs="3">
            <Autocomplete T="string" Label="Vessel" Style="width: 250px" @bind-Value="Filter.Vessel" IsVessel Clearable />
            <Autocomplete T="string" Label="Port" Style="width:250px" @bind-Value="Filter.POD" IsLocation Clearable />
        </MudItem>
        <MudItem xs="2">
            <Autocomplete T="string" Label="Voyage" Style="width:170px" @bind-Value="Filter.Voyage" IsVoyage Clearable />
            <Autocomplete T="string" Label="Terminal" Style="width:170px" @bind-Value="Filter.Terminal" IsTerminalOrDepot Clearable />
        </MudItem>
        <MudItem xs="3">
            <div style="display:flex;justify-content:space-between;width:250px">
                <DatePicker Style="width:120px" Label="From" @bind-Date="Filter.DateFrom" Clearable />
                <DatePicker Style="width:120px" Label="To" @bind-Date="Filter.DateTo" Clearable />
            </div>
            <Select T="EntityStatus?" Style="width:150px" Label="Status" @bind-Value="Filter.Status"
                    ToStringFunc="@(s => s == null ? string.Empty : s.ToString())"
                    Disabled="IsSelectable" Clearable>                
                <MudSelectItem T="EntityStatus?" Value="@EntityStatus.New" />
                <MudSelectItem T="EntityStatus?" Value="@EntityStatus.Cancelled" />
                <MudSelectItem T="EntityStatus?" Value="@EntityStatus.Completed" />
            </Select>            
        </MudItem>                
        @if (!IsSelectable)
        {
            <MudItem xs="2">
                <MudButton Class="Button" OnClick="@(async () => { await ViewManifestReport_Click(false); })"
                           Style="width:142px; margin-bottom:5px;"
                           Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Download">
                    CGO Manifest
                </MudButton>
                <MudButton Class="Button" OnClick="@(async () => { await ViewManifestReport_Click(true); })"
                           Style="width:142px; margin-bottom:5px"
                           Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Download">
                    IMO Manifest
                </MudButton>
                <MudButton Class="Button" OnClick="@(async () => { await ViewFileCustomsReport_Click(); })"
                           Style="width:142px; margin-bottom:5px"
                           Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Preview">
                    Explanation
                </MudButton>
                <MudButton Class="Button" OnClick="@(async () => { await SaveFileFillBill_Click(); })"
                           Style="width:105px"
                           Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Download">
                    Fill Bill
                </MudButton>
            </MudItem>
        }        
    </MudGrid>
</Container>

<div class="Container-table">
    <div class="tableMenu">
        <MudSpacer />
        <TablePager T="VesselCallDetailDTO" Table="mudTable" ItemsCount="@Items?.Count()" />
    </div>
        
    <MudTable Class="Table MultiSelection" @ref="mudTable" Items="@Items" Loading="IsLoading" Virtualize="true" RowsPerPage="30" >
        <HeaderContent>
            <MudTh Style="width: 42px"></MudTh>            
            <MudTh Style="width: 42px"></MudTh>
            <MudTh Style="width:270px">
                <MudTableSortLabel SortBy="new Func<VesselCallDetailDTO, object>(x=>x.VesselName!)">Vessel</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:150px">
                <MudTableSortLabel SortBy="new Func<VesselCallDetailDTO, object>(x=>x.VoyageNo!)">Voyage</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:220px">POD</MudTh>
            <MudTh Style="width: 90px">Terminal</MudTh>
            <MudTh Style="width: 120px">ETA</MudTh>
            <MudTh Style="width: 120px">ETS</MudTh>
            <MudTh Style="width: 80px"><MudTableSortLabel SortBy="new Func<VesselCallDetailDTO, object>(x=>x.Status!)">Status</MudTableSortLabel></MudTh>
            <MudTh Style="width: 42px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (!IsSelectable)
            {
                <MudTd>                    
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.VesselCallId); })" />
                </MudTd>
                <MudTd>
                    <MudTooltip Delay="1500" Duration="1000" Text="Add new ExportOrder">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Disabled="context.Status == EntityStatus.Completed"
                                       OnClick="@(async()=>{ await AddExportOrder_Click(context.Id); })" />
                    </MudTooltip>                    
                </MudTd>
            }
            else
            {
                <MudTd>
                    <MudTooltip Text="Upload">
                        <MudIconButton Icon="@Icons.Material.Filled.Upload" Color="Color.Secondary" OnClick="@(()=>SelectItem_Click(context.Id, context.Status))" />
                    </MudTooltip>
                </MudTd>
                <MudTd></MudTd>
            }
            <MudTd>@context.VesselName</MudTd>
            <MudTd>@context.VoyageNo</MudTd>
            <MudTd>@context.POD</MudTd>
            <MudTd>@context.Terminal</MudTd>
            <MudTd>@(context.ETA.HasValue ? context.ETA.Value.ToString("dd.MM.yy") : "---")</MudTd>
            <MudTd>@(context.ETS.HasValue ? context.ETS.Value.ToString("dd.MM.yy") : "---")</MudTd>            
            <MudTd>@context.Status.ToString()</MudTd>
            <MudTd>
                @if (!IsSelectable)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Disabled="@(IsLoading || !IsRoleForEdit)"
                                   OnClick="@(async()=>{ await RemoveVesselCallDetail_Click(context.Id, context.POD); })" />
                }
            </MudTd>            
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoading" />

@code {
    public string? ApplicationUser { get; set; }
    private MudTable<VesselCallDetailDTO> mudTable = new();
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public bool IsSelectable { get; set; } = false;

    private IEnumerable<VesselCallDetailDTO> Items { get; set; } = new List<VesselCallDetailDTO>();
    private FilterParameters Filter { get; set; } = new();

    private bool IsLoading = false;
    public bool IsRoleForEdit { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.IsInRole("Admin") || authState.User.IsInRole("Top Manager"))
            IsRoleForEdit = true;

        ApplicationUser = authState.User.Identity?.Name;
    }

    public async Task GetItems()
    {
        IsLoading = true;

        var response = await _vesselCallProvider.GetItemsAsync(Filter);
        if (!response.HasErrors && response.Object is not null)
            Items = (IEnumerable<VesselCallDetailDTO>)response.Object;

        IsLoading = false;

        await InvokeAsync(StateHasChanged);
    }

    private void ResetFilters()
    {
        Filter = new FilterParameters
        {
            DateFrom = DateTime.Today.AddDays(-7),
            DateTo = DateTime.Today
        };
    }

    private async Task ShowItem_Click(long vesselCallId)
    {
        var parameters = new DialogParameters { ["Id"] = vesselCallId };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<VesselCall_ItemDialog>(null, parameters, options);

        var result = await dialog.Result;

        if (result != null && result.Data != null && (bool)result.Data == true)
            await GetItems();
    }

    private async Task AddExportOrder_Click(long vcdId)
    {
        //var result = await ValueTask.FromResult(JSRuntime.InvokeVoidAsync("open", $"{Navigation.BaseUri}exportorder?IsNewItem={true}&vcdId={vcdId}", "_blank"));        
        await JSRuntime.InvokeVoidAsync("open", $"{NavigationManager.BaseUri}New_ExportOrder/{0}/{vcdId}", "_blank");
    }

    private async Task RemoveVesselCallDetail_Click(long id, string? pod)
    {
        bool? msgResult = await DialogService.ShowMessageBox("REMOVE",
                                        (MarkupString)$"Do you want Delete record?<br/>Discharge port: <b>{pod}</b>",
                                        yesText: "DELETE!", cancelText: "NO");        

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                IsLoading = true;
                var response = await _vesselCallProvider.RemoveItemAsync(id, ApplicationUser);  // substitution of RemoveVesselCallDetailAsync
                IsLoading = false;

                if (response.HasErrors)
                    Snackbar.Add($"Unable to delete", Severity.Warning);
                else
                {
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                    await GetItems();
                }
            }
    }

    private async void SelectItem_Click(long vcdId, EntityStatus? status)
    {
        if (status.Equals(EntityStatus.Completed))
        {
            bool? result = await DialogService.ShowMessageBox("Warning",
                                                              "Unable select Vessel Call due to status - Completed.",
                                                              yesText: "Close");

            return;
        }                

        if (MudDialog is not null)
            MudDialog.Close(vcdId);
    }

    private async Task ViewManifestReport_Click(bool _isImo)
    {
        long vesselcallid = await GetVoyageId();
        if (vesselcallid == 0) return;

        //await JSRuntime.InvokeVoidAsync("open", $"{ApplicationParameter.ViewReportUrl}ViewReportManifest?vslcallid={vesselcallid}&isIMO={_isImo}");

        IsLoading = true;

        // Данные для файла
        var dtoItems = await ExportOrderProvider.GetFileDto(vesselcallid, FileType.Manifest, _isImo, cancellationToken: CancellationToken.None);

        // Вывод файла в новую вкладку браузера
        using ICreatePdfFileService pdfService = new CreatePdfFileService();

        byte[] fileData = await pdfService.CreateFileManifest(dtoItems, _isImo);

        // if (fileData != Array.Empty<byte>())
        //     await JSRuntime.InvokeVoidAsync("jsOpenPdfInNewTab",
        //         Convert.ToBase64String(fileData));

        if (fileData != Array.Empty<byte>())
            await JSRuntime.InvokeVoidAsync("jsSaveAsFile",
                $"Manifest_{Items.FirstOrDefault()?.VoyageNo}.docx",
                Convert.ToBase64String(fileData));

        IsLoading = false;
    }

    private async Task SaveFileFillBill_Click()
    {
        long vesselcallid = await GetVoyageId();
        if (vesselcallid == 0) return;

        //await JSRuntime.InvokeVoidAsync("open", $"{ApplicationParameter.DownloadFileUrl}SaveFileExcelFillBill?vslcallid={vesselcallid}");

        IsLoading = true;

        // Данные для файла
        var dtoItems = await ExportOrderProvider.GetFileDto(vesselcallid, FileType.Manifest, cancellationToken: CancellationToken.None);

        // Сохранение файла
        using ICreateExcelFileService excelService = new CreateExcelFileService();

        byte[] fileData = await excelService.CreateExcelFileFillBill(dtoItems.ToArray());

        if (fileData != Array.Empty<byte>())
            await JSRuntime.InvokeVoidAsync("jsSaveAsFile",
                $"FillBill_{dtoItems.FirstOrDefault()!.VoyageNum}.xlsx",
                Convert.ToBase64String(fileData));

        IsLoading = false;
    }

    private async Task ViewFileCustomsReport_Click()
    {
        long vesselcallid = await GetVoyageId();
        if (vesselcallid == 0) return;

        //await JSRuntime.InvokeVoidAsync("open", $"{ApplicationParameter.ViewReportUrl}ViewReportCustoms?vslcallid={vesselcallid}");

        IsLoading = true;

        // Данные для файла
        var dtoItems = await ExportOrderProvider.GetFileDto(vesselcallid, FileType.Customs, cancellationToken: CancellationToken.None);

        // Вывод файла в новую вкладку браузера
        using ICreatePdfFileService pdfService = new CreatePdfFileService();

        byte[] fileData = await pdfService.CreateFileCustoms(dtoItems);

        if (fileData != Array.Empty<byte>())
            await JSRuntime.InvokeVoidAsync("jsOpenPdfInNewTab",
                Convert.ToBase64String(fileData));

        IsLoading = false;
    }

    private async Task<long> GetVoyageId()
    {
        if (Items is null || Items!.Count() == 0) return 0;
 
        var voyages = Items.GroupBy(g => g.VesselCallId).Select(g => g.Key);
        if (voyages.Count() != 1)
        {
            Snackbar.Add($"More then one Voyage selected.<br>Select one Voyage please.", Severity.Warning);
            return 0;
        }

        long voyageId = voyages.FirstOrDefault();

        string terminal = Items.GroupBy(g => g.VesselCallId).Select(g => g.FirstOrDefault()!.Terminal).FirstOrDefault()!;

        var response = await _carrierProvider.GetTerminalNameAsync(voyageId, terminal);
        if (response.HasErrors)
        {
            Snackbar.Add(response.Errors.FirstOrDefault()!, Severity.Warning);
            await Task.Delay(1000);
            return 0;
        }

        return voyageId;
    }

