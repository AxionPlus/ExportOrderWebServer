@inject IDialogService DialogService
@inject IVesselCallProvider _vesselCallProvider

<style>
    .mud-picker-inline {
        flex: unset;
    }
    .wrapper-input-date > .mud-input-control {
        margin-top:unset;
    }
 </style>

<MudForm @ref="@FilterForm">
    <div class="Container-item">
        <div class="container-head"></div>

        <div class="container-content">
             <MudButton Class="Button" Style="width: 100px" Disabled="@IsLoadingData" OnClick="@(async () => { await AddItem_Click(); })"
                       Variant="Variant.Filled" Color="Color.Primary">
                Add New
             </MudButton>
             <MudSpacer />
             <MudAutocomplete Class="Autocomplete" T="string" Label="Vessel" @bind-Value="@Filter.VesselName" SearchFunc="@VesselSearch"
                              Style="width: 300px"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              CloseIcon="" OpenIcon="" MaxItems="20"
                              ResetValueOnEmptyText="true" Clearable />
             <MudSpacer />
             <MudTextField Class="TextField" T="string" Label="Voyage" Style="width: 300px" @bind-Value="Filter.Voyage"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Clearable></MudTextField>
             <MudSpacer />
             <MudAutocomplete Class="Autocomplete" T="string" Label="POD" @bind-Value="@Filter.POD" SearchFunc="@PortSearch"
                              Style="width: 300px"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              CloseIcon="" OpenIcon="" MaxItems="20"
                              ResetValueOnEmptyText="true" Clearable />
             <MudSpacer />
             <MudAutocomplete Class="Autocomplete" T="string" Label="Terminal" @bind-Value="@Filter.TerminalName" SearchFunc="@TerminalSearch"
                              Style="width: 300px"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              CloseIcon="" OpenIcon="" MaxItems="20"
                              ResetValueOnEmptyText="true" Clearable />
             <MudSpacer />             
             <MudDatePicker Class="wrapper-input-date" Label="From" @bind-Date="Filter.ETA"
                            Style="width: 130px; height: 40px;"
                            DateFormat="dd.MM.yy"
                            ShowWeekNumbers="true"
                            Variant="Variant.Outlined"
                            IconSize=Size.Small                            
                            AutoClose=true
                            DisableToolbar=false Clearable />
             <MudSpacer />
             <MudDatePicker Class="wrapper-input-date" Label="To" @bind-Date="Filter.ETS"
                            Style="width: 130px; height: 40px;"
                            DateFormat="dd.MM.yy"
                            ShowWeekNumbers="true"
                            Variant="Variant.Outlined"
                            IconSize=Size.Small
                            AutoClose=true
                            DisableToolbar=false Clearable />
             <MudSpacer />
             <MudButton Class="Button" Style="width: 100px" Disabled="@IsLoadingData" OnClick="@(async () => { await GetItems(); })"
                        Variant="Variant.Filled" Color="Color.Secondary">
                 Search
             </MudButton>
        </div>
    </div>
 </MudForm>

 <div class="Container-table">
     @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }
    
    <MudTable Class="Table" @ref="mudTable" Items="@Items" T="VesselCallEntity" Loading="IsLoadingData"
              Virtualize="true" RowsPerPage="20">    
        <HeaderContent>
            <MudTh Style="width: 30px"></MudTh>
            <MudTh Style="width: 300px">Vessel</MudTh>
            <MudTh Style="width: 300px">Voyage</MudTh>
            <MudTh Style="width: 300px">Terminal</MudTh>
            <MudTh Style="width: 300px">POD</MudTh>
            <MudTh Style="width: 100px">ETA</MudTh>
            <MudTh Style="width: 100px">ETS</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.AspectRatio"></MudIconButton></MudTd>
            <MudTd>@context.Vessel.Name</MudTd>
            <MudTd>@context.VoyageCarrier</MudTd>
            <MudTd>@context.LoadingTerminal.Name</MudTd>
            <MudTd>@context.POD.Name</MudTd>
            <MudTd>@(context.ETA.HasValue ? context.ETA.Value.ToString("dd.MM.yy") : "---")</MudTd>
            <MudTd>@(context.ETS.HasValue ? context.ETS.Value.ToString("dd.MM.yy") : "---")</MudTd>
            <MudTd></MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>

</div>

@code {
    private MudForm? FilterForm;
    private MudTable<VesselCallEntity>? mudTable;
    private bool IsLoadingData = false;

    public IEnumerable<VesselCallEntity>? Items { get; set; } = new List<VesselCallEntity>();
    private FilterParameters Filter { get; set; } = new();    


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    private async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _vesselCallProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<VesselCallEntity>)response.Object!).ToArray();

        await Task.Delay(500);

        await InvokeAsync(StateHasChanged);

        IsLoadingData = false;
    }

    private async Task ShowItem_Click(long Id)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["Id"] = Id };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<VesselCallItem_Dialog>("Vessel", parameters, options);

        DialogResult result = await dialog.Result;
    }

    private async Task AddItem_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<VesselCallItem_Dialog>("New Vessel Call", parameters, options);

        DialogResult result = await dialog.Result;

        if (result.Canceled)
            if (Items!.Count() > 0)
                await GetItems();
    }

