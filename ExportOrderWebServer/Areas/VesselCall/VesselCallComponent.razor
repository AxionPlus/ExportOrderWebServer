@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime jsRuntime
@inject IVesselCallProvider _vesselCallProvider
@inject IVesselProvider _vesselProvider
@inject ITerminalProvider _terminalProvider
@inject ILocationProvider _locationProvider
@inject ICarrierProvider _carrierProvider

<style>

    .container-content-column {
        margin-inline-start: 10px;
    }
    .mud-picker-inline {
        flex: unset;
    }
    .wrapper-input-date > .mud-input-control {
        margin-top:unset;
    }    

    .mud-input-control.mud-input-control-boolean-input {
        width: 22px;
    }

    .Container-table .tableMenu .mud-table-cell{
        padding:unset;
    }

    /*     .Container-item > .container-content > .container-content-column {
            display:flex;
        } */

/*     .Table.MultiSelection * table tr > th:first-child {
        width: 38px;
    } */

/*     .Table.MultiSelection * table tr > th:nth-child(2n+1){
        width: 180px;
    } */
 </style>


<div class="Container-item" style="display:flex; flex-direction:row; max-height:fit-content">
    <div class="container-content-column" style="width:250px">
        <MudAutocomplete Class="Autocomplete" T="string" Label="Vessel" @bind-Value="@Filter.Vessel" SearchFunc="@SearchVessel"
                         Style="width: 250px"
                         Variant="Variant.Outlined" Margin="Margin.Dense"
                         CloseIcon="" OpenIcon="" MaxItems="20"
                         ResetValueOnEmptyText="true" Clearable />
        <MudButton Class="Button" Style="width: 80px; margin-top:10px" Disabled="@IsLoadingData" OnClick="@(async () => { await GetItems(); })"
                   Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary">
            Search
        </MudButton>
    </div>
    <div class="container-content-column" style="width:150px">
         <MudAutocomplete Class="Autocomplete" T="string" Style="width: 150px" @bind-Value="Filter.Voyage" SearchFunc="@SearchVoyage"
                          Label="Voyage"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          CloseIcon="" OpenIcon=""
                          ResetValueOnEmptyText="true" Clearable />
         <MudAutocomplete Class="Autocomplete" T="string" Label="Terminal" @bind-Value="@Filter.Terminal" SearchFunc="@SearchTerminal"
                          Style="width: 150px"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          CloseIcon="" OpenIcon="" MaxItems="20"
                          ResetValueOnEmptyText="true" Clearable />
    </div>
    <div class="container-content-column" style="width:270px">
        <MudAutocomplete Class="Autocomplete" T="string" Label="POD" @bind-Value="@Filter.POD" SearchFunc="@SearchPort"
                          Style="width: 270px"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          CloseIcon="" OpenIcon="" MaxItems="20"
                          ResetValueOnEmptyText="true" Clearable />
        <div style="width:270px; display:flex; flex-direction:row">
           <MudDatePicker Class="wrapper-input-date" Label="From" @bind-Date="Filter.ETA"
                          Style="width: 130px; height: 40px;"
                          DateFormat="dd.MM.yy"
                          ShowWeekNumbers="true"
                          Variant="Variant.Outlined"
                          IconSize=Size.Small
                          AutoClose=true
                          DisableToolbar=false Clearable />
           <div style="width:10px"></div>
           <MudDatePicker Class="wrapper-input-date" Label="To" @bind-Date="Filter.ETS"
                          Style="width: 130px; height: 40px;"
                          DateFormat="dd.MM.yy"
                          ShowWeekNumbers="true"
                          Variant="Variant.Outlined"
                          IconSize=Size.Small
                          AutoClose=true
                          DisableToolbar=false Clearable />
        </div>
    </div>
    <div class="container-content-column" style="width:120px">
       <div class="wrapper-input-select">
           <MudSelect Class="wrapper-input" T="EntityStatus" Style="width:120px" Label="Status" @bind-Value="@Filter.Status"
                       ToStringFunc="@(str=>str.ToString())"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
               @foreach (EntityStatus status in Enum.GetValues(typeof(EntityStatus)))
               {
                   <MudSelectItem Value="@status" />
               }
           </MudSelect>
       </div>
    </div>
    <MudSpacer />
    @if (!IsSelectable)
    {
        <div class="container-content-column" style="width:220px">
            <MudButton Class="Button" OnClick="@(async()=>{ await ManifestsReport_Click(false); })"
                       Style="margin-bottom:10px"
                        Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Preview">
                View Manifest
            </MudButton>
            <MudButton Class="Button" OnClick="@(async()=>{ await ManifestsReport_Click(true); })"
                       Style="margin-bottom:10px"
                       Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Preview">
                IMO Manifest
            </MudButton>
            <MudButton Class="Button" OnClick="@(async()=>{ await SaveExcelFile_Click(); })"
                       Style="margin-bottom:10px"
                        Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Download">
                Fill Bill
            </MudButton>
            <MudButton Class="Button" OnClick="@(async()=>{ await ViewCustomsReport_Click(); })"
                       Style="margin-bottom:10px"
                        Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Preview">
                Customs Explanation
            </MudButton>
        </div>
    }
</div>
 
<div class="Container-table">
    @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }
    @* MultiSelection="true" *@
    <MudTable Class="Table MultiSelection" @ref="mudTable" Items="@Items" Loading="IsLoadingData" 
              Virtualize="true" RowsPerPage="30" >

        <HeaderContent>
            @if (!IsSelectable)
            {
                <MudTh Style="width: 42px"></MudTh>
            }
            <MudTh Style="width: 42px"></MudTh>
            <MudTh Style="width:220px">Vessel</MudTh>
            <MudTh Style="width:150px">Voyage</MudTh>
            <MudTh Style="width:220px">POD</MudTh>
            <MudTh Style="width: 90px">Terminal</MudTh>
            <MudTh Style="width: 90px">ETA</MudTh>
            <MudTh Style="width: 90px">ETS</MudTh>
            <MudTh Style="width: 75px">Status</MudTh>
            @if (!IsSelectable)
            {
                <MudTh Style="width: 42px"></MudTh>
            }
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (!IsSelectable)
            {
                <MudTd>                    
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.VesselCallId); })" />
                </MudTd>
                <MudTd>
                    <MudTooltip Text="Add new ExportOrder">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Primary" OnClick="@(async()=>{ await AddExportOrder_Click(context.Id); })" />
                    </MudTooltip>                    
                </MudTd>
            }
            else
            {
                <MudTd>
                    <MudTooltip Text="Upload">
                        <MudIconButton Icon="@Icons.Material.Filled.UploadFile" OnClick="@(async()=>{ await SelectItem_Click(context.Id); })" />
                    </MudTooltip>
                </MudTd>
            }
            <MudTd>@context.VesselName</MudTd>
            <MudTd>@context.VoyageNo</MudTd>
            <MudTd>@context.POD</MudTd>
            <MudTd>@context.Terminal</MudTd>
            <MudTd>@(context.ETA.HasValue ? context.ETA.Value.ToString("dd.MM.yy") : "---")</MudTd>
            <MudTd>@(context.ETS.HasValue ? context.ETS.Value.ToString("dd.MM.yy") : "---")</MudTd>            
            <MudTd>@context.Status.ToString()</MudTd>
            @if (!IsSelectable)
            {
                <MudTd Style="text-align:start">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Disabled
                                OnClick="@(async()=>{ await RemoveItemDetail_Click(context.Id, context.POD!); })" />
                </MudTd>                
            }
            <MudTd></MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

    @code {
    private MudTable<VesselCallDetailDTO>? mudTable;

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public bool IsSelectable { get; set; } = false;    

    private IEnumerable<VesselCallDetailDTO>? Items { get; set; } = new List<VesselCallDetailDTO>();
    //private HashSet<VesselCallDetailDTO> SelectedItems = new HashSet<VesselCallDetailDTO>();
    private FilterParameters Filter { get; set; } = new();
    private bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _vesselCallProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<VesselCallDetailDTO>)response.Object!).ToArray();

        await Task.Delay(50);

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowItem_Click(long vesselCallId)    // (string VesselVoyage)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["Id"] = vesselCallId };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<VesselCall_ItemDialog>("Vessel Call", parameters, options);

        DialogResult result = await dialog.Result;

        if (result.Canceled)
            await GetItems();
    }

