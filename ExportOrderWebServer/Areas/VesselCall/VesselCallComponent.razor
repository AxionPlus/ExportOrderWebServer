@inject AuthenticationStateProvider authenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime jsRuntime
@inject IVesselCallProvider _vesselCallProvider
@inject IVesselProvider _vesselProvider
@inject ITerminalProvider _terminalProvider
@inject ILocationProvider _locationProvider
@inject ICarrierProvider _carrierProvider

<style>
    .Container-item {
        display: flex;
        flex-direction: row;
        background-color: var(--grey-08);
        justify-content: space-between;
    }

    .Container-item > .container-column {
        background-color: var(--grey-08);
    }

    .mud-input-control.mud-input-control-margin-dense {
        margin: unset;
    }

    .mud-input-control.mud-input-control-margin-dense.mud-input-outlined-with-label {
        margin-top: unset;
        margin-bottom: unset;
    }

    .mud-icon-button-edge-margin-end {
        margin-right: 2px;
        margin-inline-end: 2px;
        margin-inline-start: unset;
    }

    .mud-select * .wrapper-input * .mud-input > input.mud-input-root-outlined.mud-input-root-adorned-end {
        padding-inline-start: 4px;
        padding-inline-end: 4px;
    }

    .mud-select.mud-autocomplete * .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-inline-end: 6px;
        padding-inline-start: unset;
    }

    .mud-input > input.mud-input-root-outlined.mud-input-root-margin-dense {
        padding: 8px;
    }

    .Container-table .tableMenu .mud-table-cell{
        padding:unset;
    }
 </style>

<div class="Container-item">
    <div class="container-column" style="width:270px;">
        <div class="container-content">
            <MudAutocomplete Class="Autocomplete" T="string" Label="Vessel" @bind-Value="@Filter.Vessel" SearchFunc="@SearchVessel"
                            Style="width: 250px"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            CloseIcon="" OpenIcon="" MaxItems="20"
                            ResetValueOnEmptyText="true" Clearable />
        </div>
        <div class="container-content">
            <MudButton Class="Button" Style="width: 80px" Disabled="@IsLoadingData" OnClick="@(async () => { await GetItems(); })"
                       Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary">
                Search
            </MudButton>
            <MudSpacer />
            <MudSelect Class="wrapper-input-select" Style="width:142px" T="EntityStatus?" Label="Status" @bind-Value="@Filter.Status"
                       ToStringFunc="@(s => s is not null ? s.ToString() : string.Empty)"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable
                       Disabled="IsSelectable">
                @foreach (EntityStatus? status in Enum.GetValues(typeof(EntityStatus)))
                {
                    if (status == EntityStatus.New || status == EntityStatus.Completed)
                    {
                        <MudSelectItem Value="@status" />
                    }
                }
            </MudSelect>            
        </div>
    </div>
    <div class="container-column" style="width:470px; margin-left:30px">
        <div class="container-content">
            <MudAutocomplete Class="Autocomplete" T="string" Label="Voyage" @bind-Value="Filter.Voyage" SearchFunc="@SearchVoyage"
                             Style="width: 170px"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             CloseIcon="" OpenIcon=""
                             ResetValueOnEmptyText="true" Clearable />
            <div style="width:130px; height:35px">
                <MudDatePicker Class="wrapper-input-date" Label="From" @bind-Date="Filter.DateFrom"
                               DateFormat="dd.MM.yy"
                               ShowWeekNumbers="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               IconSize=Size.Small
                               AutoClose=true
                               Clearable />
            </div>
            <div style="width:130px; height:35px">
                <MudDatePicker Class="wrapper-input-date" Label="To" @bind-Date="Filter.DateTo"
                               DateFormat="dd.MM.yy"
                               ShowWeekNumbers="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               IconSize=Size.Small
                               AutoClose=true
                               Clearable />
            </div>            
        </div>
        <div class="container-content">
            <MudAutocomplete Class="Autocomplete" T="string" Label="Terminal" @bind-Value="@Filter.Terminal" SearchFunc="@SearchTerminal"
                             Style="width: 170px"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             CloseIcon="" OpenIcon="" MaxItems="20"
                             ResetValueOnEmptyText="true" Clearable />
            <MudAutocomplete Class="Autocomplete" T="string" Label="POD" @bind-Value="@Filter.POD" SearchFunc="@SearchPort"
                             Style="width: 270px"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             CloseIcon="" OpenIcon="" MaxItems="20"
                             ResetValueOnEmptyText="true" Clearable />
        </div>
    </div>
    
    <MudSpacer/>

    @if (!IsSelectable)
    {
        <div class="container-column" style="width:160px">
            <MudButton Class="Button" OnClick="@(async()=>{ await ManifestReport_Click(false); })"
                        Style="width:142px; margin-bottom:10px;"
                        Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Preview">
                CGO Manifest
            </MudButton>
            <MudButton Class="Button" OnClick="@(async()=>{ await ManifestReport_Click(true); })"
                        Style="width:142px; margin-bottom:10px"
                        Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Preview">
                IMO Manifest
            </MudButton>            
            <MudButton Class="Button" OnClick="@(async()=>{ await ViewReportCustoms_Click(); })"
                        Style="width:142px; margin-bottom:10px"
                        Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Preview">
                Explanation
            </MudButton>
        </div>
        <div class="container-column" style="width:105px; margin-inline:20px">
            <MudButton Class="Button" OnClick="@(async()=>{ await SaveFileFillBill_Click(); })"
                       Style="margin-bottom:10px"
                       Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download">
                Fill Bill
            </MudButton>
        </div>
    }    
</div>

<div class="Container-table">
    <div class="tableMenu">
        <MudSpacer />
        <TablePager T="VesselCallDetailDTO" Table="mudTable" ItemsCount="@Items?.Count()" />
    </div>
        
    <MudTable Class="Table MultiSelection" @ref="mudTable" Items="@Items" Loading="IsLoadingData" 
              Virtualize="true" RowsPerPage="30" >

        <HeaderContent>
            @if (!IsSelectable)
            {
                <MudTh Style="width: 42px"></MudTh>
            }
            <MudTh Style="width: 42px"></MudTh>
            <MudTh Style="width:270px">
                <MudTableSortLabel SortBy="new Func<VesselCallDetailDTO, object>(x=>x.VesselName!)">Vessel</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:150px">
                <MudTableSortLabel SortBy="new Func<VesselCallDetailDTO, object>(x=>x.VoyageNo!)">Voyage</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:220px">POD</MudTh>
            <MudTh Style="width: 90px">Terminal</MudTh>
            <MudTh Style="width: 90px">ETA</MudTh>
            <MudTh Style="width: 90px">ETS</MudTh>
            <MudTh Style="width: 75px">
                <MudTableSortLabel SortBy="new Func<VesselCallDetailDTO, object>(x=>x.Status!)">Status</MudTableSortLabel>
            </MudTh>
            <MudTh></MudTh>
            @if (!IsSelectable)
            {
                <MudTh Style="width: 42px"></MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            @if (!IsSelectable)
            {
                <MudTd>                    
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.VesselCallId); })" />
                </MudTd>
                <MudTd>
                    <MudTooltip Text="Add new ExportOrder">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Disabled="context.Status == EntityStatus.Completed"
                                       OnClick="@(async()=>{ await AddExportOrder_Click(context.Id); })" />
                    </MudTooltip>                    
                </MudTd>
            }
            else
            {
                <MudTd>
                    <MudTooltip Text="Upload">
                        <MudIconButton Icon="@Icons.Material.Filled.Upload" Color="Color.Secondary" OnClick="@(()=>SelectItem_Click(context.Id, context.Status))" />
                    </MudTooltip>
                </MudTd>
            }
            <MudTd>@context.VesselName</MudTd>
            <MudTd>@context.VoyageNo</MudTd>
            <MudTd>@context.POD</MudTd>
            <MudTd>@context.Terminal</MudTd>
            <MudTd>@(context.ETA.HasValue ? context.ETA.Value.ToString("dd.MM.yy") : "---")</MudTd>
            <MudTd>@(context.ETS.HasValue ? context.ETS.Value.ToString("dd.MM.yy") : "---")</MudTd>            
            <MudTd>@context.Status.ToString()</MudTd>
            <MudTd></MudTd>
            @if (!IsSelectable)
            {
                <MudTd Style="text-align:start">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Disabled="@(IsLoadingData || !IsRoleForEdit)"                                   
                                   OnClick="@(async()=>{ await RemoveItemDetail_Click(context.Id, context.POD!); })" />
                </MudTd>                
            }            
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudTable<VesselCallDetailDTO> mudTable = new();

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public bool IsSelectable { get; set; } = false;    

    private IEnumerable<VesselCallDetailDTO>? Items { get; set; } = new List<VesselCallDetailDTO>();
    private FilterParameters Filter { get; set; } = new();

    private bool IsLoadingData = false;
    private bool IsRoleForEdit = false;


    protected override async void OnInitialized()
    {
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.IsInRole("Admin") || authState.User.IsInRole("Top Manager"))
        {
            IsRoleForEdit = true;
        }
    }

    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _vesselCallProvider.GetItemsAsync(Filter);
        if (!response.HasErrors && response.Object is not null)
            Items = (IEnumerable<VesselCallDetailDTO>)response.Object;

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowItem_Click(long vesselCallId)
    {
        DialogParameters parameters = new DialogParameters { ["Id"] = vesselCallId };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<VesselCall_ItemDialog>("Vessel Call", parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await GetItems();
    }

    private async Task AddExportOrder_Click(long vcdId)
    {
        //var result = await ValueTask.FromResult(jsRuntime.InvokeVoidAsync("open", $"{Navigation.BaseUri}exportorder?IsNewItem={true}&vcdId={vcdId}", "_blank"));
        await jsRuntime.InvokeVoidAsync("open", $"{Navigation.BaseUri}exportorder?IsNewItem={true}&vcdId={vcdId}", "_blank");
    }

    private async Task RemoveItemDetail_Click(long id, string pod)
    {
        bool? msgResult = await DialogService.ShowMessageBox("REMOVE",
                                                             (MarkupString)$"Do you want Delete record?<br/>For discharge port:<b>{pod}</b>",
                                                             yesText: "DELETE!", cancelText: "NO");        
        
        IsLoadingData = true;

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _vesselCallProvider.RemoveVesselCallDetailAsync(id);

                if (!response.HasErrors)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete:<br>{response.Errors.FirstOrDefault()}", Severity.Warning);
            }

        IsLoadingData = false;

        await GetItems();
    }

    private async void SelectItem_Click(long vcdId, EntityStatus? status)
    {
        if (status.Equals(EntityStatus.Completed))
        {
            bool? result = await DialogService.ShowMessageBox("Warning",
                                                              "Unable select Vessel Call due to status - Completed.",
                                                              yesText: "Close");

            return;
        }                

        if (MudDialog is not null)
            MudDialog.Close(vcdId);
    }

    private async Task ManifestReport_Click(bool _isImo)
    {
        long vesselcallid = await GetVoyageId();
        if (vesselcallid == 0) return;

        await jsRuntime.InvokeVoidAsync("open", $"{ApplicationParameter.ViewReportUrl}ViewReportManifest?vslcallid={vesselcallid}&isIMO={_isImo}");
    }

    private async Task SaveFileFillBill_Click()
    {
        long vesselcallid = await GetVoyageId();
        if (vesselcallid == 0) return;

        await jsRuntime.InvokeVoidAsync("open", $"{ApplicationParameter.DownloadFileUrl}SaveFileExcelFillBill?vslcallid={vesselcallid}");
    }

    private async Task ViewReportCustoms_Click()
    {
        long vesselcallid = await GetVoyageId();
        if (vesselcallid == 0) return;

        await jsRuntime.InvokeVoidAsync("open", $"{ApplicationParameter.ViewReportUrl}ViewReportCustoms?vslcallid={vesselcallid}");
    }

    private async Task<long> GetVoyageId()
    {
        if (Items is null || Items!.Count() == 0) return 0;
 
        var voyageGroup = Items.GroupBy(g => g.VesselCallId).Select(g => g.Key);
        if (voyageGroup.Count() != 1)
        {
            Snackbar.Add($"More then one Voyage selected.<br>Select one Voyage please.", Severity.Warning);
            return 0;
        }

        long voyageId = voyageGroup.FirstOrDefault();

        string terminal = Items.GroupBy(g => g.VesselCallId).Select(g => g.FirstOrDefault()!.Terminal).FirstOrDefault()!;

        var response = await _carrierProvider.GetTerminalNameAsync(voyageId, terminal);
        if (response.HasErrors)
        {
            Snackbar.Add(response.Errors.FirstOrDefault()!, Severity.Warning);
            await Task.Delay(1000);
            return 0;
        }

        return voyageId;
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchVessel(string value, CancellationToken token)
    {
        var result = await _vesselProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchVoyage(string value, CancellationToken token)
    {
        var result = await _vesselCallProvider.GetVoyages(Filter.Vessel);

        if (string.IsNullOrWhiteSpace(value))
            return result.Distinct();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).Distinct();
    }

    private async Task<IEnumerable<string>> SearchPort(string value, CancellationToken token)
    {
        var result = await _locationProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    
    private async Task<IEnumerable<string>> SearchTerminal(string value, CancellationToken token)
    {
        var result = await _terminalProvider.GetNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        
        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchCarrier(string value, CancellationToken token)
    {
        var result = await _carrierProvider.GetNames();

        if (string.IsNullOrWhiteSpace(value))
            return result;

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    #endregion
}
