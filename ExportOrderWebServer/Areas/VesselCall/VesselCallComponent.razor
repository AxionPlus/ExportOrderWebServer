@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject IVesselCallProvider _vesselCallProvider
@inject IVesselProvider _vesselProvider
@inject ITerminalProvider _terminalProvider
@inject ILocationProvider _locationProvider

<style>
    .mud-picker-inline {
        flex: unset;
    }
    .wrapper-input-date > .mud-input-control {
        margin-top:unset;
    }

    .mud-input-control.mud-input-control-boolean-input {
        width: 22px;
    }

    .Table.MultiSelection * table tr > th:first-child {
        width: 38px;
    }

/*     .Table.MultiSelection * table tr > th:nth-child(2n+1){
        width: 180px;
    } */
 </style>


<div class="Container-item">
    <div class="container-head"></div>
    <div class="container-content">
        <MudAutocomplete Class="Autocomplete" T="string" Label="Vessel" @bind-Value="@Filter.Vessel" SearchFunc="@SearchVessel"
                          Style="width: 270px"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          CloseIcon="" OpenIcon="" MaxItems="20"
                          ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudTextField Class="TextField" T="string" Label="Voyage" Style="width: 130px" @bind-Value="Filter.Voyage"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable></MudTextField>
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Label="POD" @bind-Value="@Filter.POD" SearchFunc="@SearchPort"
                          Style="width: 200px"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          CloseIcon="" OpenIcon="" MaxItems="20"
                          ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudAutocomplete Class="Autocomplete" T="string" Label="Terminal" @bind-Value="@Filter.Terminal" SearchFunc="@SearchTerminal"
                          Style="width: 130px"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          CloseIcon="" OpenIcon="" MaxItems="20"
                          ResetValueOnEmptyText="true" Clearable />
        <MudSpacer />
        <MudDatePicker Class="wrapper-input-date" Label="From" @bind-Date="Filter.ETA"
                        Style="width: 130px; height: 40px;"
                        DateFormat="dd.MM.yy"
                        ShowWeekNumbers="true"
                        Variant="Variant.Outlined"
                        IconSize=Size.Small                            
                        AutoClose=true
                        DisableToolbar=false Clearable />
        <MudSpacer />
        <MudDatePicker Class="wrapper-input-date" Label="To" @bind-Date="Filter.ETS"
                        Style="width: 130px; height: 40px;"
                        DateFormat="dd.MM.yy"
                        ShowWeekNumbers="true"
                        Variant="Variant.Outlined"
                        IconSize=Size.Small
                        AutoClose=true
                        DisableToolbar=false Clearable />
        <MudSpacer />
        <MudSelect Class="wrapper-input" T="EntityStatus" Style="width:120px" Label="Status" @bind-Value="@Filter.Status"
                    ToStringFunc="@(str=>str.ToString())"
                    Variant="Variant.Outlined" Margin="Margin.Dense">
             @foreach (EntityStatus status in Enum.GetValues(typeof(EntityStatus)))
            {
                <MudSelectItem Value="@status" />
            }
        </MudSelect>
        <MudSpacer />
        <MudButton Class="Button" Style="width: 80px" Disabled="@IsLoadingData" OnClick="@(async () => { await GetItems(); })"
                    Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary">
             Search
         </MudButton>
    </div>
</div>
 
<div class="Container-table">
    @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }    
    <MudTable Class="Table MultiSelection" @ref="mudTable" Items="@Items" Loading="IsLoadingData"
              Virtualize="true" RowsPerPage="30" >

        <HeaderContent>
            @if (!IsSelectable)
            {
                <td colspan="2">
                    <MudTh Style="width: 180px">
                        <MudButton Class="Button" OnClick="@(async()=>{ await ManifestsReport_Click(); })"
                                   Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Preview">
                            View Manifest
                        </MudButton>
                    </MudTh>
                </td>                
            }
            else
            {
                <MudTh Style="width: 42px"></MudTh>
            }            
            <MudTh Style="width:270px">Vessel</MudTh>
            <MudTh Style="width:200px">Voyage</MudTh>
            <MudTh Style="width:270px">POD</MudTh>
            <MudTh Style="width:200px">Terminal</MudTh>
            <MudTh Style="width:130px">ETA</MudTh>
            <MudTh Style="width:130px">ETS</MudTh>
            <MudTh Style="width: 80px">Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (!IsSelectable)
            {
                <MudTd Style="width:90px">
                    @* <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click($"{context.VesselName}&{context.VoyageNo}"); })" /> *@
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.VesselCallId); })" />
                </MudTd>
                <MudTd Style="width:90px">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async()=>{ await RemoveItem_Click(context); })" />
                </MudTd>
            }
            else
            {
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.AddCircle"
                                   OnClick="@(async()=>{ await SelectItem_Click($"{context.VesselName}&{context.VoyageNo}&{context.POD}"); })" />
                </MudTd>
            }
            <MudTd>@context.VesselName</MudTd>
            <MudTd>@context.VoyageNo</MudTd>
            <MudTd>@context.POD</MudTd>
            <MudTd>@context.Terminal</MudTd>
            <MudTd>@(context.ETA.HasValue ? context.ETA.Value.ToString("dd.MM.yy") : "---")</MudTd>
            <MudTd>@(context.ETS.HasValue ? context.ETS.Value.ToString("dd.MM.yy") : "---")</MudTd>            
            <MudTd>@context.Status.ToString()</MudTd>
            <MudTd></MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

    @code {
    private MudTable<VesselCallDetailDTO>? mudTable;

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public bool IsSelectable { get; set; } = false;    

    private IEnumerable<VesselCallDetailDTO>? Items { get; set; } = new List<VesselCallDetailDTO>();
    //private HashSet<VesselCallDetailDTO> SelectedItems = new HashSet<VesselCallDetailDTO>();
    private FilterParameters Filter { get; set; } = new();
    private bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _vesselCallProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<VesselCallDetailDTO>)response.Object!).ToArray();

        await Task.Delay(50);

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowItem_Click(long vesselCallId)    // (string VesselVoyage)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        //DialogParameters parameters = new DialogParameters { ["Voyage"] = VesselVoyage };
        DialogParameters parameters = new DialogParameters { ["Id"] = vesselCallId };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Small, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<VesselCall_ItemDialog>("Vessel Call", parameters, options);

        DialogResult result = await dialog.Result;

        if (result.Canceled)
            await GetItems();
    }

    private async Task RemoveItem_Click(VesselCallDetailDTO item)
    {
        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE  Record",
                          (MarkupString)$"<b>Do you want to remove record?</b> <br/>Vessel Call:<br/>{item.VesselName}<br/>",
                          yesText: "YES", cancelText: "NO");

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _vesselCallProvider.RemoveItemDTOAsync(item);

                if (!response.HasError)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete", Severity.Warning);
            }

        await GetItems();
    }


    private async Task SelectItem_Click(string voyagePOD)      // change to VesselCallDetailId
    {
        await Task.Delay(50);
        MudDialog!.Close(voyagePOD);
    }

    private async Task ManifestsReport_Click()
    {
        // int voyageCount = SelectedItems.Select(s => new { voyage = s.VesselName + "&" + s.VoyageNo }).GroupBy(g => g.voyage).Count();
        // if (voyageCount != 1) return;

        // string voyage = SelectedItems.Select(s => s.VesselName + "*" + s.VoyageNo).FirstOrDefault()!;

        // ------------------------------------

        //HashSet<long> vesselCallDetailIds = SelectedItems.Select(s => s.Id).ToHashSet();
        // ------------------------------------
        //var vesselCallDetailIds = SelectedItems.Select(s => s.Id).ToList();
        // ------------------------------------

        if (Items is null) return;        

        // int voyageCount = Items.Select(s => new { voyage = s.VesselName + "*" + s.VoyageNo }).GroupBy(g => g.voyage).Count();
        // if (voyageCount != 1) return;
                        
        var voyageGroup = Items.Select(s => new { voyage = s.VesselName + "*" + s.VoyageNo }).GroupBy(g => g.voyage);
        if (voyageGroup.Count() != 1) return;

        string voyage = Items.Select(s => s.VesselName + "*" + s.VoyageNo).FirstOrDefault()!;

        await Task.Delay(100);
        string path = $"{Navigation.BaseUri}server/ExportOrder/ViewReportManifest?Voyage={voyage}";
        //string path = $"{Navigation.BaseUri}server/ExportOrder/ViewReportManifests?Ids={vesselCallDetailIds}";
        await JSRuntime.InvokeVoidAsync("open", path);
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchVessel(string value)
    {
        var result = await _vesselProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchPort(string value)
    {
        var result = await _locationProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    
    private async Task<IEnumerable<string>> SearchTerminal(string value)
    {
        var result = await _terminalProvider.GetNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        
        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
