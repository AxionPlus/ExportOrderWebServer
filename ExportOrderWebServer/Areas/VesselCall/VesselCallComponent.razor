@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime jsRuntime
@inject IVesselCallProvider _vesselCallProvider
@inject IVesselProvider _vesselProvider
@inject ITerminalProvider _terminalProvider
@inject ILocationProvider _locationProvider
@inject ICarrierProvider _carrierProvider

<style>
    .mud-picker-inline {
        flex: unset;
    }
    .wrapper-input-date > .mud-input-control {
        margin-top: 2px;
    }

    .mud-icon-button-edge-margin-end {
        margin-right: 2px;
        margin-inline-end: 2px;
        margin-inline-start: unset;
    }

    .mud-select * .mud-input-label-outlined.mud-input-label-margin-dense {
        transform: translate(8px,7px) scale(1);
    }

    .mud-select * .wrapper-input * .mud-input > input.mud-input-root-outlined.mud-input-root-adorned-end {
        padding-inline-start: 4px;
        padding-inline-end: 4px;
    }

    .mud-select.mud-autocomplete * .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-right: unset;
        padding-inline-end: unset;
        padding-inline-start: unset;
    }

    .mud-input > input.mud-input-root-outlined.mud-input-root-margin-dense {
        padding: 8px;
    }

    .mud-input-control > .mud-input-control-input-container > .mud-input-label-outlined.mud-input-label-inputcontrol {
        line-height: 12px;
    }

    .Container-table .tableMenu .mud-table-cell{
        padding:unset;
    }

 </style>

<div class="Container-item" style="display:flex; flex-direction:row; max-height:fit-content">
    <div class="container-column" style="width:850px; max-height:fit-content">
        <div class="container-content" style="padding-bottom: unset">
            <MudAutocomplete Class="Autocomplete" T="string" Placeholder="Vessel" @bind-Value="@Filter.Vessel" SearchFunc="@SearchVessel"
                            Style="width: 250px"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            CloseIcon="" OpenIcon="" MaxItems="20"
                            ResetValueOnEmptyText="true" Clearable />
            <MudAutocomplete Class="Autocomplete" T="string" Placeholder="Voyage" @bind-Value="Filter.Voyage" SearchFunc="@SearchVoyage"
                            Style="width: 150px"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            CloseIcon="" OpenIcon=""
                            ResetValueOnEmptyText="true" Clearable />
            <MudAutocomplete Class="Autocomplete" T="string" Placeholder="POD" @bind-Value="@Filter.POD" SearchFunc="@SearchPort"
                            Style="width: 270px"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            CloseIcon="" OpenIcon="" MaxItems="20"
                            ResetValueOnEmptyText="true" Clearable />
            <MudSelect Class="wrapper-input select" Style="width:125px" T="EntityStatus?" Label="Status" @bind-Value="@Filter.Status"
                        ToStringFunc="@(s => s is not null ? s.ToString() : string.Empty)"
                        Variant="Variant.Outlined" Margin="Margin.Dense" Clearable
                        Disabled="IsSelectable">
                @foreach (EntityStatus? status in Enum.GetValues(typeof(EntityStatus)))
                {
                    if (status == EntityStatus.New || status == EntityStatus.Completed)
                    {
                        <MudSelectItem Value="@status" />
                    }
                }
            </MudSelect>
        </div>
        <div class="container-content">
            <div style="width:250px">
                <MudButton Class="Button" Style="width: 80px" Disabled="@IsLoadingData" OnClick="@(async () => { await GetItems(); })"
                            Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary">
                    Search
                </MudButton>
            </div>
            <MudAutocomplete Class="Autocomplete" T="string" Placeholder="Terminal" @bind-Value="@Filter.Terminal" SearchFunc="@SearchTerminal"
                             Style="width: 150px"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             CloseIcon="" OpenIcon="" MaxItems="20"
                             ResetValueOnEmptyText="true" Clearable />
            <MudDatePicker Class="wrapper-input-date" Label="From" @bind-Date="Filter.ETA"
                            Style="width: 130px"
                            DateFormat="dd.MM.yy"
                            ShowWeekNumbers="true"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            IconSize=Size.Small
                            AutoClose=true
                            DisableToolbar=false Clearable />
            <MudDatePicker Class="wrapper-input-date" Label="To" @bind-Date="Filter.ETS"
                            Style="width: 130px"
                            DateFormat="dd.MM.yy"
                            ShowWeekNumbers="true"
                            Variant="Variant.Outlined" Margin="Margin.Dense"
                            IconSize=Size.Small
                            AutoClose=true
                            DisableToolbar=false Clearable />
            <div style="width:125px"></div>
        </div>
    </div>
    
    @if (!IsSelectable)
    {
        <div class="container-column" style="width:180px; max-height:fit-content; margin-left:20px">
            <MudButton Class="Button" OnClick="@(async()=>{ await ManifestReport_Click(false); })"
                        Style="width:142px; margin-bottom:10px;"
                        Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Preview">
                CGO Manifest
            </MudButton>
            <MudButton Class="Button" OnClick="@(async()=>{ await ManifestReport_Click(true); })"
                        Style="width:142px; margin-bottom:10px"
                        Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Preview">
                IMO Manifest
            </MudButton>
            <MudButton Class="Button" OnClick="@(async()=>{ await SaveExcelFile_Click(); })"
                        Style="margin-bottom:10px"
                        Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Download">
                Fill Bill
            </MudButton>
            <MudButton Class="Button" OnClick="@(async()=>{ await ViewCustomsReport_Click(); })"
                        Style="width:142px; margin-bottom:10px"
                        Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Preview">
                Explanation
            </MudButton>
        </div>
    }    
</div>

<div class="Container-table">
    @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }    
    <MudTable Class="Table MultiSelection" @ref="mudTable" Items="@Items" Loading="IsLoadingData" 
              Virtualize="true" RowsPerPage="30" >

        <HeaderContent>
            @if (!IsSelectable)
            {
                <MudTh Style="width: 42px"></MudTh>
            }
            <MudTh Style="width: 42px"></MudTh>
            <MudTh Style="width:220px">
                <MudTableSortLabel SortBy="new Func<VesselCallDetailDTO, object>(x=>x.VesselName!)">Vessel</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:150px">
                <MudTableSortLabel SortBy="new Func<VesselCallDetailDTO, object>(x=>x.VoyageNo!)">Voyage</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:220px">POD</MudTh>
            <MudTh Style="width: 90px">Terminal</MudTh>
            <MudTh Style="width: 90px">ETA</MudTh>
            <MudTh Style="width: 90px">ETS</MudTh>
            <MudTh Style="width: 75px">
                <MudTableSortLabel SortBy="new Func<VesselCallDetailDTO, object>(x=>x.Status!)">Status</MudTableSortLabel>
            </MudTh>
            @if (!IsSelectable)
            {
                <MudTh Style="width: 42px"></MudTh>
            }
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (!IsSelectable)
            {
                <MudTd>                    
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.VesselCallId); })" />
                </MudTd>
                <MudTd>
                    <MudTooltip Text="Add new ExportOrder">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Primary" OnClick="@(async()=>{ await AddExportOrder_Click(context.Id); })" />
                    </MudTooltip>                    
                </MudTd>
            }
            else
            {
                <MudTd>
                    <MudTooltip Text="Upload">
                        <MudIconButton Icon="@Icons.Material.Filled.UploadFile" OnClick="@(async()=>{ await SelectItem_Click(context.Id, context.Status); })" />
                    </MudTooltip>
                </MudTd>
            }
            <MudTd>@context.VesselName</MudTd>
            <MudTd>@context.VoyageNo</MudTd>
            <MudTd>@context.POD</MudTd>
            <MudTd>@context.Terminal</MudTd>
            <MudTd>@(context.ETA.HasValue ? context.ETA.Value.ToString("dd.MM.yy") : "---")</MudTd>
            <MudTd>@(context.ETS.HasValue ? context.ETS.Value.ToString("dd.MM.yy") : "---")</MudTd>            
            <MudTd>@context.Status.ToString()</MudTd>
            @if (!IsSelectable)
            {
                <MudTd Style="text-align:start">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Secondary"
                                   Disabled="@(ApplicationParameter.ApplicationUser == "Manager")"                                   
                                   OnClick="@(async()=>{ await RemoveItemDetail_Click(context.Id, context.POD!); })" />
                </MudTd>                
            }
            <MudTd></MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>
</div>

<OverlayLoadingData Visible="@IsLoadingData" />

@code {
    private MudTable<VesselCallDetailDTO>? mudTable;

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public bool IsSelectable { get; set; } = false;    

    private IEnumerable<VesselCallDetailDTO>? Items { get; set; } = new List<VesselCallDetailDTO>();
    private FilterParameters Filter { get; set; } = new();
    private bool IsLoadingData = false;


    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    public async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _vesselCallProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<VesselCallDetailDTO>)response.Object!).ToArray();

        await Task.Delay(50);

        IsLoadingData = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowItem_Click(long vesselCallId)    // (string VesselVoyage)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["Id"] = vesselCallId };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<VesselCall_ItemDialog>("Vessel Call", parameters, options);

        DialogResult result = await dialog.Result;

        if (result.Canceled)
            await GetItems();
    }

    private async Task AddExportOrder_Click(long id)
    {
        var result = await ValueTask.FromResult(jsRuntime.InvokeVoidAsync("open", $"{Navigation.BaseUri}exportorder?IsNewItem={true}&vcdId={id}", "_blank"));

        // if (result.IsCompletedSuccessfully)
        //     await component!.GetItems();
    }

    private async Task RemoveItemDetail_Click(long id, string pod)
    {
        bool? msgResult = await DialogService.ShowMessageBox(
                          "REMOVE",
                          (MarkupString)$"Do you want Delete record?<br/>For discharge port:<b>{pod}</b>",
                          yesText: "DELETE!", cancelText: "NO");

        IsLoadingData = true;

        if (msgResult.HasValue)
            if (msgResult.Value)
            {
                var response = await _vesselCallProvider.RemoveVesselCallDetailAsync(id);

                if (!response.HasError)
                    Snackbar.Add($"Deleted Successfully", Severity.Success);
                else
                    Snackbar.Add($"Unable to delete:<br>{response.Error.FirstOrDefault()}", Severity.Warning);
            }

        IsLoadingData = false;

        await GetItems();
    }

    private async Task SelectItem_Click(long vcdId, EntityStatus? status)
    {
        await Task.Delay(50);

        if (status.Equals(EntityStatus.Completed))
        {
            bool? result = await DialogService.ShowMessageBox(
                "Warning",
                "Unable select Vessel Call due to status - Completed.",
                yesText: "Close", cancelText: null);

            await InvokeAsync(StateHasChanged);
            return;
        }                

        MudDialog!.Close(vcdId);
    }

    private async Task ManifestReport_Click(bool _isImo)
    {        
        long vesselcallid = await GetVoyageId();
        if (vesselcallid == 0) return;

        string path = $"{Navigation.BaseUri}server/ExportOrder/ViewReportManifest?vslcallid={vesselcallid}&isIMO={_isImo}";
        await jsRuntime.InvokeVoidAsync("open", path);
    }

    private async Task SaveExcelFile_Click()
    {
        long vesselcallid = await GetVoyageId();
        if (vesselcallid == 0) return;

        string path = $"{Navigation.BaseUri}server/ExportOrder/SaveFillBillExcelFile?vslcallid={vesselcallid}";
        await jsRuntime.InvokeVoidAsync("open", path);
    }

    private async Task ViewCustomsReport_Click()
    {
        long vesselcallid = await GetVoyageId();
        if (vesselcallid == 0) return;

        string path = $"{Navigation.BaseUri}server/ExportOrder/ViewCustomsExplanation?vslcallid={vesselcallid}";
        await jsRuntime.InvokeVoidAsync("open", path);
    }

    private async Task<long> GetVoyageId()
    {
        if (Items!.Count() == 0) return 0;

        // if (Items!.Any(s => s.Status == 0))
        //     Snackbar.Add($"Some of the Records has no Export Order issued yet", Severity.Warning);

        await Task.Delay(500);

        var voyageGroup = Items!.GroupBy(g => g.VesselCallId).Select(g => g.Key);
        if (voyageGroup.Count() != 1)
        {
            Snackbar.Add($"More then one Voyage selected.<br>Select one Voyage please.", Severity.Warning);
            return 0;
        }

        long voyageId = voyageGroup.FirstOrDefault();

        string terminal = Items!.GroupBy(g => g.VesselCallId).Select(g => g.FirstOrDefault()!.Terminal).FirstOrDefault()!;

        var response = await _carrierProvider.GetTerminalNameAsync(voyageId, terminal);
        if (response.HasError)
        {
            Snackbar.Add(response.Error.FirstOrDefault(), Severity.Warning);
            await Task.Delay(1000);
            return 0;
        }

        return voyageId;
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchVessel(string value)
    {
        var result = await _vesselProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchVoyage(string value)
    {
        var result = await _vesselCallProvider.GetVoyages(Filter.Vessel);

        if (string.IsNullOrWhiteSpace(value))
            return result.Distinct();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).Distinct();
    }

    private async Task<IEnumerable<string>> SearchPort(string value)
    {
        var result = await _locationProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    
    private async Task<IEnumerable<string>> SearchTerminal(string value)
    {
        var result = await _terminalProvider.GetNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        
        if (string.IsNullOrWhiteSpace(value))
            return result;
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchCarrier(string value)
    {
        var result = await _carrierProvider.GetNames();

        if (string.IsNullOrWhiteSpace(value))
            return result;

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    #endregion
}
