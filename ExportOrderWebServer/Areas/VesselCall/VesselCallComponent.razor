@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IVesselCallProvider _vesselCallProvider
@inject IVesselProvider _vesselProvider
@inject ITerminalProvider _terminalProvider
@inject ILocationProvider _locationProvider

<style>
    .mud-picker-inline {
        flex: unset;
    }
    .wrapper-input-date > .mud-input-control {
        margin-top:unset;
    }
 </style>

<MudForm @ref="@FilterForm">

    <div class="Container-item">
        <div class="container-head"></div>

        <div class="container-content">
             <MudButton Class="Button" Style="width: 80px" Disabled="@IsLoadingData" OnClick="@(async () => { await AddItem_Click(); })"
                       Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary">
                Add New
             </MudButton>
             <MudSpacer />
             <MudAutocomplete Class="Autocomplete" T="string" Label="Vessel" @bind-Value="@Filter.VesselName" SearchFunc="@SearchVessel"
                              Style="width: 270px"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              CloseIcon="" OpenIcon="" MaxItems="20"
                              ResetValueOnEmptyText="true" Clearable />
             <MudSpacer />
             <MudTextField Class="TextField" T="string" Label="Voyage" Style="width: 150px" @bind-Value="Filter.Voyage"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Clearable></MudTextField>
             <MudSpacer />
             <MudAutocomplete Class="Autocomplete" T="string" Label="POD" @bind-Value="@Filter.POD" SearchFunc="@SearchPort"
                              Style="width: 170px"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              CloseIcon="" OpenIcon="" MaxItems="20"
                              ResetValueOnEmptyText="true" Clearable />
             <MudSpacer />
             <MudAutocomplete Class="Autocomplete" T="string" Label="Terminal" @bind-Value="@Filter.TerminalName" SearchFunc="@SearchTerminal"
                              Style="width: 150px"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              CloseIcon="" OpenIcon="" MaxItems="20"
                              ResetValueOnEmptyText="true" Clearable />
             <MudSpacer />             
             <MudDatePicker Class="wrapper-input-date" Label="From" @bind-Date="Filter.ETA"
                            Style="width: 130px; height: 40px;"
                            DateFormat="dd.MM.yy"
                            ShowWeekNumbers="true"
                            Variant="Variant.Outlined"
                            IconSize=Size.Small                            
                            AutoClose=true
                            DisableToolbar=false Clearable />
             <MudSpacer />
             <MudDatePicker Class="wrapper-input-date" Label="To" @bind-Date="Filter.ETS"
                            Style="width: 130px; height: 40px;"
                            DateFormat="dd.MM.yy"
                            ShowWeekNumbers="true"
                            Variant="Variant.Outlined"
                            IconSize=Size.Small
                            AutoClose=true
                            DisableToolbar=false Clearable />
             <MudSpacer />
             <MudButton Class="Button" Style="width: 80px" Disabled="@IsLoadingData" OnClick="@(async () => { await GetItems(); })"
                        Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary">
                 Search
             </MudButton>
        </div>
    </div>
 
    <div class="Container-table">
     @if (mudTable != null)
    {
        <div class="tableMenu">
            <MudSpacer />
            <MudPagination SelectedChanged="PageChanged" Count="@((mudTable.GetFilteredItemsCount() + mudTable.RowsPerPage - 1) / mudTable.RowsPerPage)" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin: auto; padding-left: 10px;">(@Items!.Count())</span>
        </div>
    }
    
    <MudTable Class="Table" @ref="mudTable" Items="@Items" T="VesselCallEntity" Loading="IsLoadingData"
              Virtualize="true" RowsPerPage="20">    
        <HeaderContent>
            @if (!IsSelectable)
            {
                <MudTh Style="width: 30px"></MudTh>
            }            
            <MudTh Style="width: 30px"></MudTh>
            <MudTh Style="width: 300px">Vessel</MudTh>
            <MudTh Style="width: 280px">Voyage</MudTh>
            <MudTh Style="width: 130px">ETA</MudTh>
            <MudTh Style="width: 130px">ETS</MudTh>
            <MudTh Style="width: 280px">Terminal</MudTh>
            <MudTh Style="width: 280px">POD</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (!IsSelectable)
            {
                <MudTd Style="margin-right:20px"><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(async()=>{ await ShowItem_Click(context.Id); })"></MudIconButton></MudTd>                
                <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(async()=>{ await RemoveItem_Click(context); })"></MudIconButton>
            }
            else
            {
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.AddCircle" OnClick="@(async()=>{ await SelectItem_Click(context); })" /></MudTd>
            }
            <MudTd>@context.Vessel.Name</MudTd>
            <MudTd>@context.VoyageCarrier</MudTd>
            <MudTd>@(context.ETA.HasValue ? context.ETA.Value.ToString("dd.MM.yy") : "---")</MudTd>
            <MudTd>@(context.ETS.HasValue ? context.ETS.Value.ToString("dd.MM.yy") : "---")</MudTd>
            <MudTd>@context.LoadingTerminal.Name</MudTd>
            <MudTd>@context.POD.Name</MudTd>            
            <MudTd></MudTd>
        </RowTemplate>
        <PagerContent></PagerContent>
    </MudTable>

</div>

</MudForm>

<OverlayLoadingData Visible="@IsLoadingData" />

    @code {
    private MudForm? FilterForm;
    private MudTable<VesselCallEntity>? mudTable;

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public bool IsSelectable { get; set; } = false;

    public IEnumerable<VesselCallEntity>? Items { get; set; } = new List<VesselCallEntity>();
    private FilterParameters Filter { get; set; } = new();
    private bool IsLoadingData = false;



    private void PageChanged(int i) => mudTable?.NavigateTo(i - 1);

    private async Task GetItems()
    {
        IsLoadingData = true;

        var response = await _vesselCallProvider.GetItemsAsync(Filter);
        if (!response.HasError)
            Items = ((IEnumerable<VesselCallEntity>)response.Object!).ToArray();

        await Task.Delay(500);

        await InvokeAsync(StateHasChanged);

        IsLoadingData = false;
    }

    private async Task ShowItem_Click(long Id)
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["Id"] = Id };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<VesselCallItem_Dialog>("Vessel Call", parameters, options);

        DialogResult result = await dialog.Result;
    }

    private async Task AddItem_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Medium, CloseButton = true, DisableBackdropClick = true };
        dialog = await DialogService.ShowAsync<VesselCallItem_Dialog>("New Vessel Call", parameters, options);

        DialogResult result = await dialog.Result;

        if (result.Canceled)
            if (Items!.Count() > 0)
                await GetItems();
    }

    private async Task RemoveItem_Click(VesselCallEntity item)
    {
        // bool? msgResult = await DialogService.ShowMessageBox(
        //                   "REMOVE  Record",
        //                   (MarkupString)$"<b>Do you want to remove record?</b> <br/>Vessel Call:<br/>{item.Vessel.Name}<br/>",
        //                   yesText: "YES", cancelText: "NO");

        // if (msgResult.HasValue)
        //     if (msgResult.Value)
        //     {
        //         var response = await _vesselCallProvider.RemoveItemAsync(item);

        //         if (!response.HasError)
        //             Snackbar.Add($"Deleted Successfully", Severity.Success);
        //         else
        //             Snackbar.Add($"Unable to delete", Severity.Warning);
        //     }

        // await GetItems();
    }


    private async Task SelectItem_Click(VesselCallEntity item)
    {
        await Task.Delay(50);
        MudDialog!.Close(item);
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<string>> SearchVessel(string value)
    {
        // if (string.IsNullOrWhiteSpace(value))
        //     return Enumerable.Empty<string>();

        var result = await _vesselProvider.GetNamesEn();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return result;

        return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchPort(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var result = await _locationProvider.GetNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        else
            return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    
    private async Task<IEnumerable<string>> SearchTerminal(string value)
    {
        // if (string.IsNullOrWhiteSpace(value))
        //     return Enumerable.Empty<string>();

        var result = await _terminalProvider.GetNames();

        if (result.Count() == 0)
            return Enumerable.Empty<string>();
        
        if (string.IsNullOrWhiteSpace(value))
            return result;

        return result.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    #endregion
}
