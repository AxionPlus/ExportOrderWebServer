    private async Task SearchVesselCall_Click()
    {
        try
        {
            VesselCalls = await Http.GetFromJsonAsync<IEnumerable<VesselCallEntity>>("api/VesselCall/GetItems");
        }
        catch (Exception)
        {
            VesselCalls = Enumerable.Empty<VesselCallEntity>();
        }


    }
