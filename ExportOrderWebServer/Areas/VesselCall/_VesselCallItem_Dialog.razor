@inject AuthenticationStateProvider authenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JSRuntime

@inject IVesselCallProvider _vesselCallProvider
@inject IVesselProvider _vesselProvider
@inject ITerminalProvider _terminalProvider
@inject ILocationProvider _locationProvider

<style>
    .mud-dialog .mud-dialog-title {
        text-align:center;
    }

    .sub-Table {        
        transition: none;
        box-shadow: none;
    }

    .mud-table-root .mud-table-head {
        /* display: table-header-group; */
        background-color: lightblue;
    }

    .Table * .mud-table-cell {
        padding: 4px;
    }

    .Table * .mud-table-cell {
        padding: 4px;
        text-align: center;
    }

</style>

@if (Item is not null)
{
    <MudForm @ref="@Form" Style="max-width:fit-content">
        <div class="Container-item" style="width: 760px">
            <div class="container-content">
                <MudAutocomplete Class="Autocomplete" T="VesselEntity" Label="Vessel" Style="width: 300px" @bind-Value="Item.Vessel"
                                 ToStringFunc="@(e => e != null ? e.Name : "")"
                                 SearchFunc="@SearchVessel"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Required RequiredError=""
                                 CloseIcon="" OpenIcon=""
                                 ResetValueOnEmptyText="true"                                 
                                 MaxItems="20"
                                 IconSize="Size.Small"
                                 ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                 <MudSpacer />
                 <MudDatePicker Class="wrapper-input-date" Label="ETA" @bind-Date="Item.ETA"
                                Style="width: 148px; height: 40px; margin-right: 2px"
                                DateFormat="dd.MM.yy"
                                ShowWeekNumbers="true"
                                Variant="Variant.Outlined"
                                IconSize=Size.Small
                                AutoClose=true
                                DisableToolbar=false
                                Required
                                ReadOnly="!IsNewItem"
                                Clearable />
                 <MudDatePicker Class="wrapper-input-date" Label="ETS" @bind-Date="Item.ETS"
                                Style="width: 148px; height: 40px; margin-left: 2px"
                                DateFormat="dd.MM.yy"
                                ShowWeekNumbers="true"
                                Variant="Variant.Outlined"
                                IconSize=Size.Small
                                AutoClose=true
                                DisableToolbar=false
                                Required
                                ReadOnly="!IsNewItem"
                                Clearable />
                 <MudSpacer />
                 <MudButton Class="Button" Style="width: 100px; margin-left: 20px" Disabled="!IsNewItem" OnClick="SaveItem_Click"
                            Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                            StartIcon="@Icons.Material.Filled.Save">
                     Save
                 </MudButton>
            </div>
            <div class="container-content" style="margin-bottom: 15px">
                <div style="width:300px"></div>
                <MudSpacer />
                <MudAutocomplete Class="Autocomplete" T="TerminalCatalog" Style="width: 300px" Label="Loading Terminal" @bind-Value="Item.Terminal"
                                  ToStringFunc="@(e => e != null ? e.Name : "")"
                                  SearchFunc="@SearchTerminal"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required RequiredError=""
                                  CloseIcon="" OpenIcon=""
                                  ResetValueOnEmptyText="true"
                                  MaxItems="20"
                                  IconSize="Size.Small"
                                  ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                <MudSpacer />
                <div style="width:100px; margin-left: 20px"></div>
            </div>
            <div class="container-content">
                <MudTextField T="string" Style="width: 300px;" Label="Voyage Carrier" Text="@Item.VoyageNo"
                              TextChanged="async (e)=> { Item.VoyageNo = e.ToUpper(); }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"
                              Required RequiredError=""
                              ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                <MudSpacer />
                <MudTextField T="string" Style="width: 300px" Label="Voyage Terminal" Text="@Item.VoyageNoTerminal"
                              TextChanged="async (e)=> { Item.VoyageNoTerminal = e.ToUpper(); }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"
                              Required RequiredError=""
                              ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                <MudSpacer />
                <div style="width: 100px; margin-left: 20px"></div>
            </div>
            <div class="container-content">
@*                 <MudAutocomplete Class="Autocomplete" T="LocationCatalog" Style="width: 300px" Label="Port of Discharge" @bind-Value="Item.POD"
                                 ToStringFunc="@(e => e != null ? e.Name : "")"
                                 SearchFunc="@SearchPOD"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Required RequiredError=""
                                 CloseIcon="" OpenIcon=""
                                 ResetValueOnEmptyText="true"
                                 MaxItems="20"
                                 IconSize="Size.Small"
                                 ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                <MudSpacer />
                <MudTextField T="string" Style="width: 300px;" Label="POD Agent" Text="@Item.PODAgent"
                              TextChanged="async (e)=> { Item.PODAgent = e.ToUpper(); }"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true"
                              Required RequiredError=""
                              ReadOnly="!IsNewItem" Clearable="IsNewItem" />
                <MudSpacer />
                <div style="width: 100px; margin-left: 20px"></div> *@
            </div>
            <div class="container-content" style="align-items:start">
                 <MudTable Class="Table" @ref="mudTable" Items="@CarrierItems" T="_VesselCallCarrierDTO" Loading="IsLoadingData"
                           Virtualize="true" RowsPerPage="10" Context="carriers" ReadOnly="!IsNewItem">
                    
                    <HeaderContent>
                        <MudTh Style="width: 120px"></MudTh>
                        <MudTh Style="width: 235px">Carrier</MudTh>
                        <MudTh Style="width: 40px"></MudTh>
                        <MudTh Style="width: 135px">Export Order</MudTh>
                        <MudTh Style="width: 80px">Dated</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                         <MudTd>
                             <MudButton Class="Button" Style="width: 100px" OnClick="@(async()=> await ManifestReport_Click(carriers.CarrierId))"
                                        Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" 
                                        StartIcon="@Icons.Material.Filled.Print">
                                 Manifest
                             </MudButton>
                         </MudTd>
                         <MudTd>@carriers.CarrierNameEn</MudTd>
                         <MudTd>
                             <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Style="@(carriers.IsShowRecords ? "transform: rotate(180deg);" : "")"
                                            Size="@Size.Small" OnClick="(_)=>{carriers.IsShowRecords = !carriers.IsShowRecords;}" />
                         </MudTd>

                    </RowTemplate>

                    <ChildRowContent>
                        @if (carriers.IsShowRecords)
                        {
                            <MudTr>
                                <td colspan="2"></td>
                                <td colspan="3">
                                    <MudTable Class="sub-Table" T="VesselCallRecordDTO" Context="carrierExpOrders" Items="@carriers.RecordsDTO">
                                        <RowTemplate>
                                            <MudTd Style="width:40px">
                                                <MudIconButton Icon="@Icons.Material.Filled.FindInPage"
                                                               Size="@Size.Small" OnClick="ViewExportOrder_Click" />
                                            </MudTd>
                                            <MudTd Style="width:135px">@carrierExpOrders.ExportOrderNum</MudTd>
                                            <MudTd Style="width:80px">@carrierExpOrders.ExportOrderDate!.Value.ToString("dd.MM.yy")</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </td>
                            </MudTr>
                        }
                    </ChildRowContent>

                </MudTable>

                 <MudSpacer />
                 <MudButton Class="Button" Style="width: 100px" OnClick="AddExportOrderItem_Click"
                            Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                            StartIcon="@Icons.Material.Filled.Add">
                     New Export Order
                 </MudButton>
            </div>
        </div>
    </MudForm>
}

@code {
    private MudForm? Form { get; set; }
    private MudTable<_VesselCallCarrierDTO>? mudTable;

    [Parameter]
    public long Id { get; set; } = 0;
    [Parameter]
    public bool IsNewItem { get; set; } = false;

    private VesselCallEntity? Item { get; set; }
    private IEnumerable<_VesselCallCarrierDTO> CarrierItems { get; set; } = new List<_VesselCallCarrierDTO>();

    private bool IsAuth = false;
    private bool IsLoadingData { get; set; } = false;


    protected override async Task OnInitializedAsync()
    {
        await GetItem();

        var user = await authenticationStateProvider.GetAuthenticationStateAsync();
        if (user.User.IsInRole("Admin") || user.User.IsInRole("TopManager") || user.User.IsInRole("ExpDept"))
        {
            IsAuth = true;
        }
    }

    private async Task GetItem()
    {
        if (IsNewItem)
            Item = new();
        else
        {
            var response = await _vesselCallProvider.GetItemAsync(Id);
            if (!response.HasError)
                Item = (VesselCallEntity)response.Object!;

            await GetVesselCallCarrierItems();
        }
    }

    public async Task SaveItem_Click()
    {
        await Form!.Validate();

        if (Form.IsValid)
        {
            if (IsNewItem)
            {
                var response = await _vesselCallProvider.NewItemAsync(Item!);
                if (!response.HasError)
                {
                    Snackbar.Add("Saved successfully", Severity.Success);
                    IsNewItem = false;                    
                }
                else
                    Snackbar.Add(response.Error.LastOrDefault(), Severity.Error);
            }
            else
            {
                // var response = await _vesselProvider.ModifyItemAsync(Item!);
                // if (!response.HasError)
                // {
                //     await GetItem();
                //     Snackbar.Add("Save Successed", Severity.Success);
                // }
                // else
                //     Snackbar.Add(response.Error.Last(), Severity.Error);
            }

            //await GetItem();
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task AddExportOrderItem_Click()
    {
        IDialogReference dialog = new DialogReference(Guid.NewGuid(), DialogService);

        DialogParameters parameters = new DialogParameters { ["IsNewItem"] = true };
        DialogOptions options = new DialogOptions { FullScreen = true, NoHeader = true, DisableBackdropClick = false };
        dialog = await DialogService.ShowAsync<ExportOrder_ItemDialog>(null, parameters, options);

        DialogResult result = await dialog.Result;

        if (!result.Canceled)
        {
            if (Item!.Id > 0)
                await GetVesselCallCarrierItems();
        }            
    }

    private async Task GetVesselCallCarrierItems()
    {
        IsLoadingData = true;

        //CarrierItems = await _vesselCallProvider.GetVesselCallCarriersAsync(Id);

        await Task.Delay(500);

        await InvokeAsync(StateHasChanged);

        IsLoadingData = false;
    }

    private async Task ManifestReport_Click(long cId)
    {
        
        string path = $"{Navigation.BaseUri}server/ExportOrder/ViewReportManifest?vslCallId={Id}&carrierId={cId}";
        await JSRuntime.InvokeVoidAsync("open", path);
    }

    private async Task ViewExportOrder_Click()
    {
        
    }

    #region SEARCH FUNCTIONS

    private async Task<IEnumerable<VesselEntity>> SearchVessel(string value)
    {
        // if (string.IsNullOrWhiteSpace(value))
        //     return Enumerable.Empty<VesselEntity>();

        var Vessels = new List<VesselEntity>();

        var response = await _vesselProvider.GetItemsAsync();
        if (!response.HasError)
            Vessels = ((IEnumerable<VesselEntity>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Vessels;

        return Vessels.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    private async Task<IEnumerable<TerminalCatalog>> SearchTerminal(string value)
    {
        // if (string.IsNullOrWhiteSpace(value))
        //     return Enumerable.Empty<TerminalCatalog>();

        var Terminals = new List<TerminalCatalog>();

        var response = await _terminalProvider.GetItemsAsync();
        if (!response.HasError)
            Terminals = ((IEnumerable<TerminalCatalog>)response.Object!).OrderBy(s => s.Name).ToList();
        
        if (string.IsNullOrWhiteSpace(value))
            return Terminals;

        return Terminals.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    private async Task<IEnumerable<LocationCatalog>> SearchPOD(string value)
    {
        // if (string.IsNullOrWhiteSpace(value))
        //     return Enumerable.Empty<LocationCatalog>();

        var Ports = new List<LocationCatalog>();

        var response = await _locationProvider.GetItemsAsync();
        if (!response.HasError)
            Ports = ((IEnumerable<LocationCatalog>)response.Object!).OrderBy(s => s.Name).ToList();

        if (string.IsNullOrWhiteSpace(value))
            return Ports;

        return Ports.Where(x => x.Name!.Contains(value, StringComparison.InvariantCultureIgnoreCase)).ToList();
    }

    #endregion
}
