@typeparam T
<div class="FieldContainer" style=@Style>
    <div class="fieldName checkBox">@Label</div>
    <div style="display:flex; justify-content:center;">
        <MudCheckBox T="T" Class="CheckBox" ReadOnly="@ReadOnly" Disabled="@Disabled" TriState="@TriState"
                     Value="@Value" ValueChanged="@(async(e) => { await ValueChanged.InvokeAsync(e); })" />
    </div>
</div>

@code {

    [Parameter]
    public string? Style { get; set; }
    [Parameter]
    public string? Label { get; set; }
    [Parameter]
    public bool ReadOnly { get; set; }
    [Parameter]
    public bool Disabled { get; set; }
    [Parameter]
    public bool TriState { get; set; }

    [Parameter]
    public T Value { get; set; }
    [Parameter]
    public EventCallback<T> ValueChanged { get; set; }
}