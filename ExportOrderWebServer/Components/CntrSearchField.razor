@inject IDialogService DialogService

<style></style>

<div class="FieldContainer" style="width:165px; @Style">
    <div style="display: inline-flex; width:100%;">
        <MudTextField T="string" Class="TextField" Label="@Label"
                      Value="Value"
                      ValueChanged="@(async(e)=>{ await ValueChanged.InvokeAsync(e); } )"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Required="@Required" RequiredError=""
                      MaxLength="11"                      
                      Immediate
                      Clearable
                      OnClearButtonClick="async(_)=> {await ValueChanged.InvokeAsync(string.Empty);}">
        </MudTextField>
    </div>
</div>

@code {
    [Parameter]
    public string? Label { get; set; }
    [Parameter]
    public string? Style { get; set; }
    [Parameter]
    public bool Required { get; set; }
    [Parameter]
    public string? Value { get; set; }
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }
}