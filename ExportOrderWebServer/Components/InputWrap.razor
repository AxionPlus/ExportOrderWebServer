<div class="FieldContainer" style="@Style">
    <div style ="height:20px">
        <div class="@LabelClass" >
            @Label
            @if (!string.IsNullOrWhiteSpace(TooltipText))
            {
                <MudTooltip text="@TooltipText" Color="Color.Tertiary" Delay="2000" Duration="1000" ShowOnClick="true">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Text="?" />
                </MudTooltip>
            }
        </div>  
        @if (ProgressLinear)
        {
            <div style="margin-inline:5px;">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            </div>
        }
    </div>

    <div style="display: inline-flex; width:100%;">
        @ChildContent
    </div>
</div>
@code {
    [Parameter]
    public bool ProgressLinear { get; set; }
    [Parameter]
    public string? TooltipText { get; set; }
    [Parameter]
    public string? Style { get; set; }
    [Parameter]
    public string? Label { get; set; }
    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    private string LabelClass
    {
        get
        {


            if (Disabled)
                return $"fieldName Label-Disabled";
            else
                return $"fieldName";
        }
    }

}
