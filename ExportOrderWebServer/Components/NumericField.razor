@typeparam T

<style>

    .mud-input-control.mud-input-control-margin-dense {
        margin-bottom: unset;
    }

    .NumericField * .mud-input > input.mud-input-root-outlined {
        text-align: end;
        padding: 4px 4px 1px 6px !important;
    }

</style>

<div class="FieldContainer" style="@Style">
    <div class="fieldName">@Label</div>
    <MudNumericField T="T" Class="NumericField" Value="Value" ValueChanged="@(async(e)=>{await ValueChanged.InvokeAsync(e);})"
                     Variant="Variant.Outlined" Margin="Margin.Dense"
                     Clearable="@Clearable"
                     HideSpinButtons="@HideSpinButtons"
                     Format="@Format"
                     Required="@Required" RequiredError=""
                     Min="@Min"
                     Max="@Max"
                     MaxLength="@MaxLength"
                     ReadOnly="@ReadOnly"
                     Disabled="@Disabled"
                     OnBlur="@OnBlur">
    </MudNumericField>
</div>

@code {
    public NumericField()
    {
        if (typeof(T) == typeof(sbyte) || typeof(T) == typeof(sbyte?))
        {
            _minDefault = (T)(object)sbyte.MinValue;
            _maxDefault = (T)(object)sbyte.MaxValue;
            _stepDefault = (T)(object)(sbyte)1;
        }
        else if (typeof(T) == typeof(byte) || typeof(T) == typeof(byte?))
        {
            _minDefault = (T)(object)(byte)0;
            _maxDefault = (T)(object)byte.MaxValue;
            _stepDefault = (T)(object)(byte)1;
        }
        else if (typeof(T) == typeof(short) || typeof(T) == typeof(short?))
        {
            _minDefault = (T)(object)short.MinValue;
            _maxDefault = (T)(object)short.MaxValue;
            _stepDefault = (T)(object)(short)1;
        }
        else if (typeof(T) == typeof(ushort) || typeof(T) == typeof(ushort?))
        {
            _minDefault = (T)(object)(ushort)0;
            _maxDefault = (T)(object)ushort.MaxValue;
            _stepDefault = (T)(object)(ushort)1;
        }
        else if (typeof(T) == typeof(int) || typeof(T) == typeof(int?))
        {
            _minDefault = (T)(object)int.MinValue;
            _maxDefault = (T)(object)int.MaxValue;
            _stepDefault = (T)(object)1;
        }
        else if (typeof(T) == typeof(uint) || typeof(T) == typeof(uint?))
        {
            _minDefault = (T)(object)0u;
            _maxDefault = (T)(object)uint.MaxValue;
            _stepDefault = (T)(object)1u;
        }
        else if (typeof(T) == typeof(long) || typeof(T) == typeof(long?))
        {
            _minDefault = (T)(object)long.MinValue;
            _maxDefault = (T)(object)long.MaxValue;
            _stepDefault = (T)(object)1L;
        }
        else if (typeof(T) == typeof(ulong) || typeof(T) == typeof(ulong?))
        {
            _minDefault = (T)(object)0uL;
            _maxDefault = (T)(object)ulong.MaxValue;
            _stepDefault = (T)(object)1uL;
        }
        else if (typeof(T) == typeof(float) || typeof(T) == typeof(float?))
        {
            _minDefault = (T)(object)float.MinValue;
            _maxDefault = (T)(object)float.MaxValue;
            _stepDefault = (T)(object)1f;
        }
        else if (typeof(T) == typeof(double) || typeof(T) == typeof(double?))
        {
            _minDefault = (T)(object)double.MinValue;
            _maxDefault = (T)(object)double.MaxValue;
            _stepDefault = (T)(object)1.0;
        }
        else if (typeof(T) == typeof(decimal) || typeof(T) == typeof(decimal?))
        {
            _minDefault = (T)(object)decimal.MinValue;
            _maxDefault = (T)(object)decimal.MaxValue;
            _stepDefault = (T)(object)1m;
        }
    }

    // Сводка:
    //     Fired when the element loses focus.
    [Parameter]
    public EventCallback<FocusEventArgs> OnBlur { get; set; }
    private bool _stepHasValue;

    private T _stepDefault;

    private T _step;
    private bool _minHasValue;

    private T _minDefault;

    private T _min;

    private bool _maxHasValue;

    private T _maxDefault;

    private T _max;
    // Сводка:
    //     The minimum value for the input.
    [Parameter]
    [Category("Validation")]
    public T Min
    {
        get
        {
            if (!_minHasValue)
            {
                return _minDefault;
            }

            return _min;
        }
        set
        {
            _minHasValue = value != null;
            _min = value;
        }
    }

    //
    // Сводка:
    //     The maximum value for the input.
    [Parameter]
    [Category("Validation")]
    public T Max
    {
        get
        {
            if (!_maxHasValue)
            {
                return _maxDefault;
            }

            return _max;
        }
        set
        {
            _maxHasValue = value != null;
            _max = value;
        }
    }
    [Parameter]
    [Category("Validation")]
    public int MaxLength { get; set; } = 524288;
    //
    // Сводка:
    //     The increment added/subtracted by the spin buttons.
    [Parameter]
    [Category("Behavior")]
    public T Step
    {
        get
        {
            if (!_stepHasValue)
            {
                return _stepDefault;
            }

            return _step;
        }
        set
        {
            _stepHasValue = value != null;
            _step = value;
        }
    }
    [Parameter]
    [Category("Behavior")]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Clearable { get; set; }
    [Parameter]
    public bool Required { get; set; }
    [Parameter]
    public string? Style { get; set; }
    [Parameter]
    public string? Label { get; set; }
    [Parameter]
    public bool HideSpinButtons { get; set; } = true;
    [Parameter]
    public string Format { get; set; }
    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public T? Value { get; set; }
    [Parameter]
    public EventCallback<T?> ValueChanged { get; set; }
}