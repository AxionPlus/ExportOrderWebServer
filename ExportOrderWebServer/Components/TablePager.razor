@typeparam T
<style>

    .PageSelector {
        margin: auto;
    }

        .PageSelector * .mud-input > input.mud-input-root-outlined, div.mud-input-slot.mud-input-root-outlined {
            padding: unset;
            padding-left: 3px;
            text-align: center;
            font-size: 0.94em;
        }

        .PageSelector * .mud-input.mud-input-outlined.mud-input-adorned-end {
            padding-right: 0px;
        }

</style>

@if (Table is not null)
{
    @if (PageSelector)
    {
        <div style="width:59px;margin: auto; padding-inline:3px;">
            <MudSelect T="int" Value="@RowsPerPage" ValueChanged="@((v) => { RowsPerPage = v; RowsPerPageChanged.InvokeAsync(v); })" Variant="Variant.Outlined" Class="PageSelector">
                @foreach (int item in Items)
                {
                    <MudSelectItem Value="@item" />
                }
            </MudSelect>
        </div>
    }

    <MudPagination SelectedChanged="PageChanged" Count="Count" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
    <span class="mud-typography-body1" style="margin:auto;padding-left:10px;">(@RecordCount)</span>
}
@code {
    [Parameter]
    public MudTable<T>? Table { get; set; }
    [Parameter]
    public Task ReloadData { get; set; }

    [Parameter]
    public int? ItemsCount { get; set; }
    [Parameter]
    public bool PageSelector { get; set; }
    [Parameter]
    public int RowsPerPage { get; set; }
    [Parameter]
    public EventCallback<int> RowsPerPageChanged { get; set; }
    [Parameter]
    public int[] Items { get; set; } = new int[] { 22, 50, 75, 100 };


    private void PageChanged(int i)
    {
        Table?.NavigateTo(i - 1);
    }
    private int Count
    {
        get
        {
            if (Table == null)
                return 0;

            return (Table.GetFilteredItemsCount() + Table.RowsPerPage - 1) / Table.RowsPerPage;
        }
    }

    private int RecordCount => ItemsCount ?? (Table?.TotalItems ?? 0);

}