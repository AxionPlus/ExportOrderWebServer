@typeparam T

<style>



</style>

<div class="Container-table">

    <div class="tableMenu">
        @TableMenu
        <MudSpacer />
        @if (Table is not null)
        {
            @if (PageSelector)
            {
                <div style="width:59px;margin: auto; padding-inline:3px;">
                        @foreach (int item in Items)
                        {
                            <MudSelectItem Value="@item" />
                        }
                    </MudSelect>
                </div>
            }

            <MudPagination SelectedChanged="PageChanged" Count="Count" Size="Size.Small" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" MiddleCount="3" />
            <span class="mud-typography-body1" style="margin:auto;padding-left:10px;">(@RecordCount)</span>
        }
    </div>
    @if (Content != null)
    {
        @Content
    }
    else
    {
        @ChildContent
    }


</div>

@code {
    [Parameter]
    public int? TotalItems { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
    [Parameter]
    public RenderFragment ChildContent { get; set; }
    [Parameter]
    public RenderFragment? Content { get; set; }
    [Parameter]
    public RenderFragment TableMenu { get; set; }
    [Parameter]
    public string? Style { get; set; }
    [Parameter]
    public string? Label { get; set; }
    [Parameter]
    public MudTable<T>? Table { get; set; }
    [Parameter]
    public bool PageSelector { get; set; }
    [Parameter]
    public int RowsPerPage { get; set; } = 25;
    [Parameter]
    public EventCallback<int> RowsPerPageChanged { get; set; }
    [Parameter]
    public int[] Items { get; set; } = new int[] { 25, 50, 100 };


    private void PageChanged(int i)
    {
        Table?.NavigateTo(i - 1);
    }

    private int Count
    {
        get
        {
            if (Table == null)
                return 0;

            return (RecordCount + Table.RowsPerPage - 1) / Table.RowsPerPage;
        }
    }

    private int RecordCount => TotalItems.HasValue ? TotalItems.Value : Table?.TotalItems ?? 0;

}