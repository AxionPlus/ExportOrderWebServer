
<style>
    .TextFieldIconButton.mud-icon-button {
        padding: 2px;
    }

    .text-upper input {
        text-transform: uppercase;
    }

</style>

<div class="FieldContainer" style="@Style">
    <div class="fieldName">@Label</div>
    <div style="display: inline-flex; width:100%;">

        <MudTextField T="string" Class="@TextClass"
                      Value="Value"
                      ValueChanged="@(async(e)=>{
                            if(UpperCase)
                                await ValueChanged.InvokeAsync(e.ToUpper());
                            else
                                await ValueChanged.InvokeAsync(e);}
                            )"
                      TextChanged="@TextChanged"
                      Variant="Variant.Outlined"
                      Required="@Required" RequiredError="" Error="@Error"
                      Immediate="true"
                      ReadOnly="@ReadOnly"
                      MaxLength="@MaxLength"
                      AutoFocus="@AutoFocus"
                      Lines="@Lines"
                      Disabled="Disabled"
                      Clearable="@Clearable"
                      Placeholder="@Placeholder"
                      OnBlur="@OnBlur"
                      Mask="Mask"
                      OnClearButtonClick="@OnClearButtonClick">
        </MudTextField>

        @if (IsIconButton)
        {
            <MudIconButton Class="TextFieldIconButton" Icon="@Icons.Material.Filled.Dehaze" Size="Size.Small" OnClick="Button_Click"></MudIconButton>
        }

    </div>
</div>

@code {
    [Parameter]
    public IMask? Mask { get; set; }
    [Parameter]
    public bool IsIconButton { get; set; } = false;
    [Parameter]
    public bool UpperCase { get; set; } = false;
    [Parameter]
    public string? Class { get; set; }
    [Parameter]
    public bool Clearable { get; set; }
    [Parameter]
    public bool Required { get; set; }
    [Parameter]
    public bool ReadOnly { get; set; } = false;
    [Parameter]
    public int MaxLength { get; set; } = 256;
    [Parameter]
    public bool AutoFocus { get; set; }
    [Parameter]
    public string? Style { get; set; }
    [Parameter]
    public string? Label { get; set; }
    [Parameter]
    public bool Disabled { get; set; }
    [Parameter]
    public bool Error { get; set; }
    [Parameter]
    public int Lines { get; set; } = 1;
    //[Parameter]
    //public string? Text { get; set; }
    [Parameter]
    public string? Value { get; set; }
    [Parameter]
    public string? Placeholder { get; set; }


    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }
    [Parameter]
    public EventCallback Button_Click { get; set; }
    [Parameter]
    public EventCallback OnClearButtonClick { get; set; }
    [Parameter]
    public EventCallback OnBlur { get; set; }
    [Parameter]
    public EventCallback<string> TextChanged { get; set; }

    private string TextClass
    {
        get
        {
            if (UpperCase)
                return $"TextField text-upper {Class}";
            else
                return $"TextField {Class}";
        }
    }

}