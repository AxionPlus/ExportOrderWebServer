@using System.Linq.Expressions
<style>
    .mud-icon-button.TextFieldIconButton {
        padding: 4px;
    }

    .text-upper input, .text-upper textarea {
        text-transform: uppercase;
    }

    .Label-Disabled
    {
        color:darkred;
    }
</style>

<div class="FieldContainer" style="@Style">
    <div class="fieldName">@Label</div>
    <div style="width:100%">
        <MudTextField T="string" Class="@TextClass"
                      Value="Value"
                      ValueChanged="@(async(e)=>{ await ValueChanged.InvokeAsync(e.ToUpper()); })"
                      Variant="Variant.Outlined"
                      Required="@Required"
                      Error="@Error"
                      RequiredError=""
                      Immediate="true"
                      ReadOnly="@ReadOnly"
                      MaxLength="@MaxLength"
                      AutoFocus="@AutoFocus"
                      Lines="@Lines"
                      Disabled="Disabled"
                      Clearable="@Clearable"
                      Placeholder="@Placeholder"
                      OnBlur="@OnBlur"
                      Mask="Mask"
                      OnClearButtonClick="@OnClearButtonClick"
                      IconSize="@IconSize"
                      Adornment="@Adornment"
                      AdornmentColor="@AdornmentColor"
                      AdornmentIcon="@AdornmentIcon"
                      OnAdornmentClick="@OnAdornmentClick">
        </MudTextField>
        @if (IsIconButton)
        {
            <MudIconButton Class="TextFieldIconButton" Icon="@IconBtn" Color="@IconBtnColor" Size="@IconBtnSize" OnClick="Button_Click"></MudIconButton>
        }
    </div>
</div>

@code {
    [Parameter] public Expression<Func<string>>? For { get; set; }
    [Parameter] public bool ProgressLinear { get; set; }
    [Parameter] public bool NoHeader { get; set; }
    [Parameter] public Size IconSize { get; set; } = Size.Small;
    [Parameter]
    public string? TooltipText { get; set; }
    [Parameter]
    public IMask? Mask { get; set; }
    [Parameter]
    public bool IsIconButton { get; set; } = false;
    [Parameter]
    public bool UpperCase { get; set; } = false;
    [Parameter]
    public string? Class { get; set; }
    [Parameter]
    public bool Clearable { get; set; }
    [Parameter]
    public bool Required { get; set; }
    [Parameter]
    public bool ReadOnly { get; set; } = false;
    [Parameter]
    public int MaxLength { get; set; } = 256;
    [Parameter]
    public bool AutoFocus { get; set; }
    [Parameter]
    public string? Style { get; set; }
    [Parameter]
    public string? Label { get; set; }
    [Parameter]
    public bool Disabled { get; set; }
    [Parameter]
    public bool Error { get; set; }
    [Parameter]
    public int Lines { get; set; } = 1;
    [Parameter]
    public string? Text { get; set; }
    [Parameter]
    public string? Value { get; set; }
    [Parameter]
    public string? Placeholder { get; set; }
    [Parameter]
    public bool Dense { get; set; }

    [Parameter]
    public string? IconBtn { get; set; }
    [Parameter]
    public Color IconBtnColor { get; set; } = Color.Default;
    [Parameter]
    public Size IconBtnSize { get; set; }
    [Parameter]
    public Adornment Adornment { get; set; }
    [Parameter]
    public Color AdornmentColor { get; set; }
    [Parameter]
    public string? AdornmentIcon { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }
    [Parameter]
    public EventCallback Button_Click { get; set; }
    [Parameter]
    public EventCallback OnClearButtonClick { get; set; }
    [Parameter]
    public EventCallback OnBlur { get; set; }
    [Parameter]
    public EventCallback<string> TextChanged { get; set; }
    [Parameter]
    public EventCallback OnAdornmentClick { get; set; }

    private string TextClass
    {
        get
        {
            var dense =  Dense ? " Dense" : "" ;

            if (UpperCase)
                return $"TextField{dense} text-upper {Class}";
            else
                return $"TextField{dense} {Class}";
        }
    }
}