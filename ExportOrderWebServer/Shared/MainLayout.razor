@inherits LayoutComponentBase
@inject AuthenticationStateProvider authenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Export Order</PageTitle>
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />


<MudLayout>
    <MudDrawer @bind-Open="@_drawerOpen" Elevation="2">
        <CascadingValue Value=ShowMainMenu>
            <NavMenu />
        </CascadingValue>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="padding-bottom: 15px;">
            <CascadingValue Value=ShowMainMenu>
                <AuthorizeView>
                    <Authorized>
                        <CascadingValue Value=ApplicationUser>
                            @Body
                        </CascadingValue>
                    </Authorized>
                    <NotAuthorized>
                        <LoginRedirect />
                    </NotAuthorized>
                </AuthorizeView>
            </CascadingValue>
        </MudContainer>
    </MudMainContent>
</MudLayout>


@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    public string? ApplicationUser { get; set; }

    EventCallback ShowMainMenu => EventCallback.Factory.Create(this, ToggleDrawer);

    bool _drawerOpen = false;

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
        StateHasChanged();
    }

    private async Task LogoutApp()
    {
        // NavigationManager.NavigateTo($"{NavigationManager.BaseUri}logoutUser");
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        ApplicationParameter.ApplicationUser = authState?.User.Identity?.Name ?? string.Empty;
        ApplicationUser = authState?.User.Identity?.Name;
    }
}